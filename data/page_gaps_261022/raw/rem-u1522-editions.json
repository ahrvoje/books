feit en dit boek zal dat laten zien. Dawkins' belangrijkste doel is om deze mensen te bereiken die de evolutie niet ontkennen, maar die in hun omgeving wel zo iemand kennen - in hun familie of kerk misschien, en zich onvoldoende voelen toegerust om hun standpunt te onderbouwen."},"contributors":[{"role":"Translator","name":"Mark van Nieuwstadt"}],"covers":[6832257],"physical_format":"Paperback","last_modified":{"type":"/type/datetime","value":"2019-12-03T21:28:00.498710"},"latest_revision":9,"key":"/books/OL24328108M","subtitle":"Bewijs voor evolutie","publish_places":["Amsterdam, Netherlands"],"isbn_13":["9789046806517"],"pagination":"446 p.","classifications":{},"title":"Het grootste spektakel ter wereld","translation_of":"The Greatest Show on Earth, the evidence for evolution","identifiers":{},"created":{"type":"/type/datetime","value":"2010-07-22T08:19:26.034780"},"languages":[{"key":"/languages/dut"}],"publish_date":"2009","oclc_numbers":["464487922"],"works":[{"key":"/works/OL1966487W"}],"type":{"key":"/type/edition"},"physical_dimensions":"23.0 x 15.0 x 4.0 centimeters","revision":9},{"publishers":["Transworld"],"physical_format":"E-book","source_records":["marc_overdrive/InternetArchiveCrMarc-2010-06-11n.mrc:8339628:3017","bwb:9781409085874"],"title":"The Greatest Show on Earth","identifiers":{"overdrive":["44AE348C-AC0F-4FAA-81F5-BBEA444FEB3F"]},"original_isbn":"9780593061732","languages":[{"key":"/languages/eng"}],"publish_date":"2009","publish_country":"nyu","key":"/books/OL24294811M","isbn_13":["9781409085874"],"publish_places":["London"],"works":[{"key":"/works/OL1966487W"}],"type":{"key":"/type/edition"},"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2010-06-23T03:03:35.345494"},"last_modified":{"type":"/type/datetime","value":"2021-11-02T10:10:09.185321"}},{"publishers":["Free Press"],"classifications":{},"source_records":["marc:marc_loc_2016/BooksAll.2016.part38.utf8:106734395:1232","ia:greatestshowonea0000dawk_t0k6","ia