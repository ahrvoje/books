{"links":{"self":"/works/OL7140277W/editions.json?limit=100","work":"/works/OL7140277W"},"size":2,"entries":[{"identifiers":{"goodreads":["134454"],"librarything":["61051"]},"title":"The Reflective Practitioner","subtitle":"How Professionals Think in Action (Arena)","authors":[{"key":"/authors/OL2031583A"}],"publish_date":"September 1995","publishers":["Ashgate Publishing"],"weight":"13.6 ounces","covers":[909381],"physical_format":"Paperback","subjects":["Labour economics","Management & management techniques","Philosophy (Specific Aspects)","Psychology","Science/Mathematics","Cognitive Psychology"],"edition_name":"New Ed edition","languages":[{"key":"/languages/eng"}],"first_sentence":{"type":"/type/text","value":"The professions have become essential to the very functioning of our society."},"isbn_13":["9781857423198"],"isbn_10":["1857423194"],"type":{"key":"/type/edition"},"physical_dimensions":"7.8 x 5.4 x 0.8 inches","source_records":["amazon:1857423194"],"key":"/books/OL8999512M","number_of_pages":374,"works":[{"key":"/works/OL7140277W"}],"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2008-04-30T09:38:13.731961"},"last_modified":{"type":"/type/datetime","value":"2025-12-18T22:17:14.470536"}},{"publishers":["Avebury"],"covers":[8045160],"local_id":["urn:sfpl:31223125642786","urn:cst:10011428725","urn:cst:10011460515"],"key":"/books/OL15052229M","authors":[{"key":"/authors/OL2031583A"}],"ocaid":"reflectivepracti00scho","publish_places":["Aldershot"],"source_records":["ia:reflectivepracti00scho","marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run01.mrc:190725610:1560","marc:marc_claremont_school_theology/CSTMARC1_barcode.mrc:126449586:6564","marc:marc_claremont_school_theology/CSTMARC1_multibarcode.mrc:126628339:6564","bwb:9780465068784","idb:9780465068784","marc:harvard_bibliographic_metadata/20220215_015.bib.mrc:347282895:10012"],"title":"The reflective practitioner","identifiers":{"librarything":["61051"],"goodreads":["1167185"]},"languages":[{"key":"/languages/eng"}],"isbn_10":["0465068782"],"publish_date":"1991","publish_country":"enk","by_statement":"Donald A. Schon.","works":[{"key":"/works/OL7140277W"}],"type":{"key":"/type/edition"},"lccn":["82070855"],"lc_classifications":["HD8038.A1 S35 1983"],"number_of_pages":384,"oclc_numbers":["8709452"],"description":{"type":"/type/text","value":"A leading M.I.T. social scientist and consultant examines five professions, engineering, architecture, management, psychotherapy, and town planning to show how professionals really go about solving problems. The best professionals, Donald Schön maintains, know more than they can put into words. To meet the challenges of their work, they rely less on formulas learned in graduate school than on the kind of improvisation learned in practice. This unarticulated, largely unexamined process is the subject of Schön's provocatively original book, an effort to show precisely how reflection-in-action works and how this vital creativity might be fostered in future professionals."},"latest_revision":11,"revision":11,"created":{"type":"/type/datetime","value":"2008-09-17T14:51:10.558251"},"last_modified":{"type":"/type/datetime","value":"2025-10-07T09:39:58.208024"}}]}