works/OL19669285W"}],"identifiers":{"amazon":["B01N4SKGX3"]},"latest_revision":11,"revision":11,"created":{"type":"/type/datetime","value":"2017-06-22T11:57:08.744046"},"last_modified":{"type":"/type/datetime","value":"2025-05-30T23:55:02.085674"}},{"publishers":["Norton & Company, Incorporated, W. W."],"subtitle":"A Friendship That Changed Our Minds","source_records":["bwb:9780393254600"],"title":"Undoing Project","number_of_pages":320,"isbn_13":["9780393254600"],"languages":[{"key":"/languages/eng"}],"full_title":"Undoing Project A Friendship That Changed Our Minds","lc_classifications":[""],"publish_date":"2016","key":"/books/OL29742579M","authors":[{"key":"/authors/OL7373397A"}],"works":[{"key":"/works/OL19669285W"}],"type":{"key":"/type/edition"},"subjects":["Cognitive neuroscience","Decision making","Statistical decision","Neurosciences","Economics, psychological aspects"],"latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":"2020-08-30T16:26:39.976856"},"last_modified":{"type":"/type/datetime","value":"2025-05-30T23:50:24.062418"}},{"publishers":["Norton & Company, Incorporated, W. W."],"subtitle":"A Friendship That Changed Our Minds","source_records":["bwb:9780393634372","promise:bwb_daily_pallets_2022-03-17"],"title":"Undoing Project","number_of_pages":368,"isbn_13":["9780393634372"],"languages":[{"key":"/languages/eng"}],"full_title":"Undoing Project A Friendship That Changed Our Minds","lc_classifications":[""],"publish_date":"2016","key":"/books/OL29750649M","authors":[{"key":"/authors/OL7373397A"}],"works":[{"key":"/works/OL19669285W"}],"type":{"key":"/type/edition"},"subjects":["Cognitive neuroscience","Decision making","Statistical decision","Neurosciences","Economics, psychological aspects"],"local_id":["urn:bwbsku:P7-EKM-771"],"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2020-08-30T19:27:22.132664"},"last_modified":{"type":"/type/datetime","value":"2025-05-30T23:50:24.062418"}},{"title":"Undoing Project","subtitle":"A Friendship That Changed Our Minds","authors":[{"key":"/authors/OL7373397A"}],"publish_date":"2017","publishers":["Penguin Books, Limited"],"source_records":["bwb:9780141983042","promise:bwb_daily_pallets_2021-05-12","ia:undoingprojectfr0000lewi_b6h0"],"languages":[{"key":"/languages/eng"}],"full_title":"Undoing Project A Friendship That Changed Our Minds","type":{"key":"/type/edition"},"subjects":["Cognitive neuroscience","Decision making","Statistical decision","Neurosciences","Economics, psychological aspects"],"isbn_13":["9780141983042"],"lc_classifications":["QP360.5.L49 2017"],"local_id":["urn:bwbsku:KP-283-033"],"ocaid":"undoingprojectfr0000lewi_b6h0","key":"/books/OL30586289M","number_of_pages":320,"works":[{"key":"/works/OL19669285W"}],"covers":[15265021,14528810],"description":{"type":"/type/text","value":"360 pages ; 20 cm"},"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2020-10-11T13:37:49.545497"},"last_modified":{"type":"/type/datetime","value":"2026-10-14T22:54:40.115047"}},{"description":{"type":"/type/text","value":"Forty years ago, Israeli psychologists Daniel Kahneman and Amos Tversky wrote a series of studies undoing our assumptions about the decision-making process. Their papers showed the ways in which the human mind erred, systematically, when forced to make judgments in uncertain situations. Their work created the field of behavioral economics, revolutionized Big Data studies, advanced evidence-based medicine, led to a new approach to government regulation, and made much of Michael Lewis's own work possible. Kahneman and Tversky are more responsible than anybody for the powerful trend to mistrust human intuition and defer to algorithms. The Undoing Project is about a collaboration between two men who became heroes in the university and on the battlefield -- both had important careers in the Israeli military -- and whose research was deeply linked to their extraordinary life experiences. Amos Tversky was a brilliant, self-confident warrior and extrovert, the center of rapt attention in any room; Kahneman, a fugitive from the Nazis in his childhood, was an introvert whose questing self-doubt was the seedbed of his ideas. They worked together so closely that they couldn't remember whose brain originated which ideas, or who should claim credit. They flipped a coin to decide the lead authorship on the first paper they wrote, and simply alternated thereafter. This story about the workings of the human mind is explored through the personalities of two fascinating individuals so fundamentally different from each other that they seem unlikely friends or colleagues. In the process they may well have changed, for good, mankind's view of its own mind."},"notes":{"type":"/type/text","value":"Includes bibliographical references (pages 547-558)."},"title":"The undoing project","subtitle":"a friendship that changed our minds","authors":[{"key":"/authors/OL7373397A"}],"publish_date":"2017","other_titles":["Friendship that changed our minds"],"table_of_contents":[{"level":0,"label":"","title":"Introduction: The problem that never goes away","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Man boobs","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The outsider","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The insider","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Errors","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The collision","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The mind's rules","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The rules of prediction","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Going viral","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Birth of the warrior psychologist","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The isolation effect","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The rules of undoing","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"This cloud of possibility","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Coda: Bora-Bora.","pagenum":"","type":{"key":"/type/toc_item"}}],"isbn_10":["1410496457"],"series":["Thorndike Press large print popular and narrative nonfiction","Thorndike Press large print popular and narrative nonfiction"],"copyright_date":"2017","full_title":"The undoing project a friendship that changed our minds","lc_classifications":["QP360.5 .L49 2017b"],"subjects":["Neurosciences","Psychologists","Statistical decision","Cognitive neuroscience","Nobel Prize winners","Economics","Decision making","Psychological aspects","Biography"],"languages":[{"key":"/languages/eng"}],"pagination":"563 pages (large print)","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run05.mrc:403365367:5981","amazon:1410496457","promise:bwb_daily_pallets_2020-03-26","ia:undoingprojectfr0000lewi_h8e0"],"lccn":["2016047528"],"isbn_13":["9781410496454"],"edition_name":"Large print edition.","dewey_decimal_class":["612.8/233"],"local_id":["urn:sfpl:31223119541374","urn:sfpl:31223119541325","urn:sfpl:31223119541366","urn:sfpl:31223119541127","urn:sfpl:31223119541382","urn:sfpl:31223119541390","urn:sfpl:31223119541135","urn:sfpl:31223119541358","urn:bwbsku:198-BAA-784"],"subject_people":["Daniel Kahneman (1934-)","Amos Tversky"],"publish_country":"miu","by_statement":"Michael Lewis","oclc_numbers":["959805508"],"type":{"key":"/type/edition"},"ocaid":"undoingprojectfr0000lewi_h8e0","key":"/books/OL27226033M","number_of_pages":563,"works":[{"key":"/works/OL19669285W"}],"covers":[14528811],"publishers":["Thorndike Press, a part of Gale, Cengage Learning"],"latest_revision":6,"revi