:sfpl:31223123035165","urn:sfpl:31223117235607","urn:sfpl:31223118448456","urn:sfpl:31223123035181","urn:sfpl:31223123035207","urn:sfpl:31223117235599","urn:sfpl:31223118448381","urn:sfpl:31223123035223","urn:sfpl:31223117235482","urn:sfpl:31223118448399","urn:sfpl:31223123035256","urn:sfpl:31223123035249","urn:sfpl:31223123035264","urn:sfpl:31223123035272","urn:sfpl:31223123035314","urn:sfpl:31223123035298","urn:sfpl:31223117234725","urn:sfpl:31223118448688","urn:sfpl:31223123035280","urn:sfpl:31223123035330","urn:sfpl:31223117235565","urn:sfpl:31223123035355","urn:sfpl:31223117234733","urn:sfpl:31223123035363","urn:sfpl:31223123035389","urn:bwbsku:262-BAA-725"],"publish_date":"2017","publish_country":"nyu","by_statement":"Michael Lewis","works":[{"key":"/works/OL19669285W"}],"type":{"key":"/type/edition"},"location":["gaaagpl"],"identifiers":{"amazon":["B01GI6S7EK"]},"classifications":{},"isbn_10":["0393254593"],"isbn_13":["9780393254594"],"lccn":["2016046888"],"dewey_decimal_class":["612.8/233"],"lc_classifications":["QP360.5 .L49 2017","QP360.5.L49 2017"],"oclc_numbers":["960905917"],"publishers":["W.W. Norton & Company"],"latest_revision":16,"revision":16,"created":{"type":"/type/datetime","value":"2019-05-15T08:06:36.604155"},"last_modified":{"type":"/type/datetime","value":"2026-01-12T19:17:45.971814"}},{"type":{"key":"/type/edition"},"title":"The Undoing Project","authors":[{"key":"/authors/OL7373397A"}],"publish_date":"Apr 29, 2017","source_records":["amazon:0241254736","bwb:9780241254738","promise:bwb_daily_pallets_2022-03-17","marc:marc_columbia/Columbia-extract-20221130-025.mrc:129979627:3365","marc:harvard_bibliographic_metadata/20220215_017.bib.mrc:82214890:4827"],"publishers":["imusti","W. W. Norton & Company"],"physical_format":"hardcover","full_title":"The Undoing Project A Friendship that Changed the World","subtitle":"A Friendship that Changed the World","notes":"Source title: The Undoing Project: A Friendship that Changed the World","works":[{"key":"/works/OL19669285W"}],"key":"/books/OL37845701M","identifiers":{"amazon":["B01LVTNCRW"]},"isbn_10":["0241254736"],"isbn_13":["9780241254738"],"classifications":{},"lc_classifications":["HB74.P8","QP360.5 .L49 2017"],"local_id":["urn:bwbsku:KP-962-247"],"oclc_numbers":["965325991"],"languages":[{"key":"/languages/eng"}],"description":{"type":"/type/text","value":"Forty years ago, Israeli psychologists Daniel Kahneman and Amos Tversky wrote a series of breathtakingly original studies undoing our assumptions about the decision-making process. Their papers showed the ways in which the human mind erred, systematically, when forced to make judgments in uncertain situations. Their work created the field of behavioral economics, revolutionized Big Data studies, advanced evidence-based medicine, led to a new approach to government regulation, and made much of Michael Lewis's own work possible. Kahneman and Tversky are more responsible than anybody for the powerful trend to mistrust human intuition and defer to algorithms.The Undoing Project is about a compelling collaboration between two men who have the dimensions of great literary figures. They became heroes in the university and on the battlefield--both had important careers in the Israeli military--and their research was deeply linked to their extraordinary life experiences. Amos Tversky was a brilliant, self-confident warrior and extrovert, the center of rapt attention in any room; Kahneman, a fugitive from the Nazis in his childhood, was an introvert whose questing self-doubt was the seedbed of his ideas. They became one of the greatest partnerships in the history of science, working together so closely that they couldn't remember whose brain originated which ideas, or who should claim credit. They flipped a coin to decide the lead authorship on the first paper they wrote, and simply alternated thereafter.This story about the workings of the human mind is explored through the personalities of two fascinating individuals so fundamentally different from each other that they seem unlikely friends or colleagues. In the process they may well have changed, for good, mankind's view of its own mind."},"number_of_pages":362,"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2022-04-29T01:51:37.100688"},"last_modified":{"type":"/type/datetime","value":"2025-09-20T10:47:39.407663"}},{"publishers":["W. W. Norton & Company"],"source_records":["amazon:0393354776","bwb:9780393354775","promise:bwb_daily_pallets_2021-08-13"],"title":"The Undoing Project: A Friendship That Changed Our Minds","number_of_pages":368,"covers":[8574667],"publish_date":"Oct 31, 2017","key":"/books/OL26894616M","authors":[{"key":"/authors/OL7373397A"}],"works":[{"key":"/works/OL19669285W"}],"type":{"key":"/type/edition"},"identifiers":{},"isbn_10":["0393354776"],"isbn_13":["9780393354775"],"classifications":{},"local_id":["urn:bwbsku:P7-CGZ-082"],"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2019-05-17T01:25:48.027519"},"last_modified":{"type":"/type/datetime","value":"2025-05-30T23:50:24.062418"}}]}