{"links":{"self":"/works/OL2661236W/editions.json?limit=100","work":"/works/OL2661236W"},"size":3,"entries":[{"notes":{"type":"/type/text","value":"Includes bibliographical references and index."},"identifiers":{"goodreads":["817876"],"wikidata":["Q33144484"],"librarything":["49814"]},"title":"Under the black flag","subtitle":"the romance and the reality of life among the pirates","authors":[{"key":"/authors/OL388135A"}],"publish_date":"1996","publishers":["Random House"],"isbn_10":["0679425608"],"dewey_decimal_class":["910.4/5"],"covers":[3816642],"lc_classifications":["G535 .C635 1996"],"ocaid":"underblackflagro00cord_0","publish_places":["New York"],"subjects":["Pirates"],"uri_descriptions":["Publisher description"],"edition_name":"1st ed.","pagination":"xxi, 296 p. :","source_records":["marc:marc_records_scriblio_net/part25.dat:21987300:754","marc:CollingswoodLibraryMarcDump10-27-2008/Collingswood.out:16623131:1457","ia:underblackflagro00cord_0","marc:marc_openlibraries_phillipsacademy/PANO_FOR_IA_05072019.mrc:34610997:1239","marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run02.mrc:137202466:1465","marc:marc_loc_2016/BooksAll.2016.part24.utf8:121109038:754","promise:bwb_daily_pallets_2022-09-12","marc:harvard_bibliographic_metadata/20220215_032.bib.mrc:324593314:2559"],"lccn":["95041414"],"languages":[{"key":"/languages/eng"}],"url":["http://www.loc.gov/catdir/description/random0412/95041414.html"],"local_id":["urn:phillips:31867001169346","urn:sfpl:31223043173286","urn:bwbsku:O8-CGS-912"],"publish_country":"nyu","by_statement":"David Cordingly.","type":{"key":"/type/edition"},"uris":["http://www.loc.gov/catdir/description/random0412/95041414.html"],"key":"/books/OL804879M","number_of_pages":296,"works":[{"key":"/works/OL2661236W"}],"oclc_numbers":["36211289"],"description":{"type":"/type/text","value":"Pirates have become so much a part of story and legend that is easy to forget they actually existed. Their roving lives left behind little historical record; thus our image of them is overlaid with three centuries of ballads, plays, epic poems, and films. But how does our conception of pirates compare with the reality, and why has such a romantic aura become associated with murderers and thieves? Author Cordingly, of England's National Maritime Museum, has mined a wealth of original sources--eyewitness accounts, court documents, national archives, and more--to create the most authoritative and definitive account of the great age of piracy: how they attacked, how they governed themselves, what they wore, what ships they used, why they flourished in the years around 1720, and what brought their reign of terror to an end.--From publisher description."},"latest_revision":15,"revision":15,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-03-13T15:29:57.826298"}},{"notes":{"type":"/type/text","value":"Includes bibliographical references (p. [279]-283) and index.\nOriginally published: New York : Random House, c1996."},"identifiers":{"goodreads":["434285"],"librarything":["49814"]},"title":"Under the black flag","subtitle":"the romance and the reality of life among the pirates","authors":[{"key":"/authors/OL388135A"}],"publish_date":"1997","publishers":["Harcourt Brace","Harvest Books"],"series":["A Harvest book"],"covers":[115302],"local_id":["urn:bwbsku:308-BAC-979","urn:phillips:31867001109029","urn:bwbsku:O6-EOD-106","urn:nuls:31786102264592"],"lc_classifications":["G535 .C635 1997","G535.C635 1997"],"url":["http://www.loc.gov/catdir/description/har041/97015048.html"],"publish_places":["San Diego"],"subjects":["Pirates."],"uri_descriptions":["Publisher description"],"edition_name":"1st Harvest ed.","pagination":"xxi, 296 p. :","source_records":["promise:bwb_daily_pallets_2020-12-31:308-BAC-979","marc:marc_openlibraries_phillipsacademy/PANO_FOR_IA_05072019.mrc:38289500:2038","marc:marc_loc_2016/BooksAll.2016.part26.utf8:47034266