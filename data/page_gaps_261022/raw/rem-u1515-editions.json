173 .H38 2018","Q173.H388 2018","Q173 .H388 2018","Q173 .H392 2018"],"key":"/books/OL26967814M","authors":[{"key":"/authors/OL2675573A"}],"edition_name":"First U.S. edition.","pagination":"xxiii, 230 pages","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run06.mrc:184705559:7816","bwb:9781984819192","promise:bwb_daily_pallets_2021-04-20","marc:marc_columbia/Columbia-extract-20221130-028.mrc:78060279:3710","promise:bwb_daily_pallets_2021-05-14","marc:marc_nuls/NULS_PHC_180925.mrc:196091505:3164"],"title":"Brief answers to the big questions","dewey_decimal_class":["500"],"notes":{"type":"/type/text","value":"Includes index."},"number_of_pages":230,"isbn_13":["9781984819192"],"subjects":["Science","Miscellanea"],"publish_date":"2018","publish_country":"nyu","by_statement":"Stephen Hawking","oclc_numbers":["1055766066"],"works":[{"key":"/works/OL19552275W"}],"type":{"key":"/type/edition"},"publishers":["Bantam Books"],"covers":[14362642],"latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2019-05-24T10:44:59.212901"},"last_modified":{"type":"/type/datetime","value":"2024-03-17T14:03:48.889174"}},{"description":{"type":"/type/text","value":"Stephen Hawking was recognized as one of the greatest minds of our time and a figure of inspiration after defying his ALS diagnosis at age twenty-one. He is known for both his breakthroughs in theoretical physics as well as his ability to make complex concepts accessible for all, and was beloved for his mischievous sense of humor. At the time of his death, Hawking was working on a final project: a book compiling his answers to the \"big\" questions that he was so often posed--questions that ranged beyond his academic field. Within these pages, he provides his personal views on our biggest challenges as a human race, and where we, as a planet, are heading next. Each section will be introduced by a leading thinker offering his or her own insight into Professor Hawking's contribution to our understanding. The book will also feature a foreword from Academy Award winning actor Eddie Redmayne, who portrayed Hawking in the film The Theory of Everything, and an afterword by Hawking's daughter, Lucy Hawking, as well as personal photographs and additional archival material."},"isbn_10":["1984887262"],"local_id":["urn:sfpl:31223127089317","urn:sfpl:31223127089309","urn:sfpl:31223127089291","urn:sfpl:31223127089283","urn:bwbsku:T2-BFN-383"],"full_title":"Brief answers to the big questions","lc_classifications":["Q173 .H38 2018b"],"key":"/books/OL26976958M","authors":[{"key":"/authors/OL2675573A"}],"languages":[{"key":"/languages/eng"}],"pagination":"xxx, 316 pages (large print)","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run06.mrc:206202893:3120","promise:bwb_daily_pallets_2022-03-17","bwb:9781984887269"],"title":"Brief answers to the big questions","dewey_decimal_class":["500"],"notes":{"type":"/type/text","value":"Includes index."},"number_of_pages":316,"isbn_13":["9781984887269"],"edition_name":"First large print edition.","subjects":["Science","Miscellanea"],"publish_date":"2018","publish_country":"nyu","copyright_date":"2018","by_statement":"Stephen Hawking","oclc_numbers":["1061287316"],"works":[{"key":"/works/OL19552275W"}],"type":{"key":"/type/edition"},"publishers":["Diversified Publishing"],"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2019-05-31T09:45:27.790764"},"last_modified":{"type":"/type/datetime","value":"2024-03-17T14:03:48.889174"}},{"publishers":["Random House Audio"],"source_records":["amazon:198484461X"],"title":"Brief Answers to the Big Questions","identifiers":{"amazon":["198484461X"]},"isbn_13":["9781984844613"],"covers":[8815165],"physical_format":"audio cd","full_title":"Brief Answers to the Big Questions","isbn_10":["198484461X"],"publish_date":"Nov 13, 2018","key":"/books/OL27351695M","authors":[{"key":"/authors/OL2675573A"}],"works":[