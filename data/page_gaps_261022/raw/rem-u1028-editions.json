 Martin Rees.","pagenum":"","type":{"key":"/type/toc_item"}}],"isbn_10":["0061999776"],"local_id":["urn:sfpl:31223098521819","urn:sfpl:31223098521835","urn:bwbsku:W7-BRK-419"],"full_title":"Seeing further the story of science, discovery, and the genius of the Royal Society","key":"/books/OL27129813M","authors":[{"key":"/authors/OL21718A"},{"key":"/authors/OL409122A"}],"subtitle":"the story of science, discovery, and the genius of the Royal Society","publish_places":["New York, NY"],"languages":[{"key":"/languages/eng"}],"pagination":"506 p.","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run04.mrc:182402721:3679","bwb:9780061999772","ia:seeingfurthersto0000unse_z4z0","promise:bwb_daily_pallets_2022-05-25"],"title":"Seeing further","notes":{"type":"/type/text","value":"\"A hardcover edition of this book was published in 2010 by William Morrow, an imprint of HarperCollins Publishers\" -- T.p. verso.\n\nIncludes bibliographical references (p. 486-489) and index."},"number_of_pages":506,"isbn_13":["9780061999772"],"edition_name":"1st Harper Perennial ed.","subjects":["Royal Society (Great Britain)","Discoveries in science","History"],"publish_date":"2011","publish_country":"nyu","by_statement":"edited & introduced by Bill Bryson ; contributing editor, Jon Turney","oclc_numbers":["703206623"],"works":[{"key":"/works/OL15436252W"}],"type":{"key":"/type/edition"},"covers":[13857705],"ocaid":"seeingfurthersto0000unse_z4z0","latest_revision":8,"revision":8,"created":{"type":"/type/datetime","value":"2019-07-17T02:04:39.033789"},"last_modified":{"type":"/type/datetime","value":"2023-04-07T21:30:21.110303"}},{"publishers":["William Morrow"],"subtitle":"the story of science, discovery, and the genius of the Royal Society","covers":[9475633],"full_title":"Seeing further the story of science, discovery, and the genius of the Royal Society","lc_classifications":["Q41 .S44 2010"],"key":"/books/OL24850201M","authors":[{"key":"/authors/OL2171