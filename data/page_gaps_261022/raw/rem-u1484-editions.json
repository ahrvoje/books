":[{"key":"/languages/eng"}],"pagination":"xii, 340 p. :","source_records":["ia:climbingmountimp00dawk","ia:climbingmountimp00rich"],"title":"Climbing Mount Improbable","notes":"Includes bibliographical references (p. 327-331) and index.","identifiers":{"goodreads":["1134623"],"librarything":["20651"]},"edition_name":"1st American ed.","subjects":["Natural selection.","Evolutionary genetics.","Morphogenesis."],"publish_date":"1996","publish_country":"nyu","by_statement":"Richard Dawkins ; original drawings by Lalla Ward.","works":[{"key":"/works/OL1966483W"}],"type":{"key":"/type/edition"},"isbn_10":["0393039307"],"lccn":["96019138"],"classifications":{},"dewey_decimal_class":["575.01/62"],"lc_classifications":["QH375 .D376 1996"],"latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-03-28T15:39:27.860409"}},{"publishers":["W. W. Norton & Company","Norton"],"number_of_pages":340,"isbn_10":["0393039307"],"covers":[8629029],"local_id":["urn:phillips:31867001162168","urn:sfpl:31223043905646","urn:sfpl:31223043897181","urn:sfpl:31223043899120","urn:sfpl:31223050317032","urn:bwbsku:W7-CFX-629","urn:nuls:31786100839106"],"physical_format":"Hardcover","lc_classifications":["QH375 .D376 1996","QH375.D376 1996"],"key":"/books/OL21577332M","authors":[{"key":"/authors/OL236174A"}],"ocaid":"climbingmountimp00dawk_070","publish_places":["New York"],"pagination":"xii, 340 p. : ill. ; 24 cm.","classifications":{},"source_records":["marc:marc_laurentian/openlibrary.mrc:433424120:920","marc:marc_ithaca_college/ic_marc.mrc:156227838:773","marc:marc_openlibraries_phillipsacademy/PANO_FOR_IA_05072019.mrc:77731986:1228","marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run02.mrc:145516558:2148","ia:climbingmountimp00dawk_070","ia:climbingmountimp00dawk_428","ia:climbingmountimp0000dawk","bwb:9780393039306","marc:marc_loc_2016/BooksAll.2016.part25.utf8:87110623:739","ia:climbingmountimp0000dawk_p7d0","promise:bwb_daily_pallets_2022-06-30","marc:marc_nuls/NULS_PHC_180925.mrc:326681976:1279","marc:marc_columbia/Columbia-extract-20221130-004.mrc:512887403:2708","marc:harvard_bibliographic_metadata/20220215_031.bib.mrc:255640116:3349"],"title":"Climbing mount improbable","lccn":["96019138"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. 327-331) and index.\r\n\r\n6"},"identifiers":{"librarything":["20651"],"goodreads":["1134623"]},"edition_name":"1st American ed.","subjects":["Evolutionary genetics","Morphogenesis","Natural selection"],"publish_date":"September 1, 1996","by_statement":"Richard Dawkins ; original drawings by Lalla Ward.","works":[{"key":"/works/OL1966483W"}],"type":{"key":"/type/edition"},"oclc_numbers":["34633422"],"description":{"type":"/type/text","value":"The towering cliffs of Mount Improbable can never, it seems, be climbed. In Richard Dawkins's remarkable new book the heights of Mount Improbable represent the combination of perfection and improbability that is epitomized in the seemingly \"designed\" perfection of living things. From the combination of strength and sensitivity of an elephant's trunk to the life-saving camouflage of an ant-mimicking beetle, the living world is populated by creatures that seem miraculously designed for the lives they lead.\n\nBut these complex and brilliantly effective features cannot have come about by undirected chance. That would be equivalent to scaling the sheer face of the mountain in a single leap. The only way to explain seemingly designed objects is by slow, gradual evolution - inching cumulatively, almost infinitely slowly by the standards of human history, up the gentle paths on the far side of Mount Improbable. Dawkins guides the reader through the spectacular mountain passes of the natural world.\n\nWe are led through the silken world of spiders; we are shown how wings gradually sprouted on the bodies of flightless animals; we see how the fig is a garden for its own teeming population of insects; and we learn that the eye has evolved no less than forty times independently. And through it all runs the thread of DNA, the molecule of life, responsible for its own destiny on an unending pilgrimage through geological time."},"languages":[{"key":"/languages/eng"}],"latest_revision":23,"revision":23,"created":{"type":"/type/datetime","value":"2008-11-03T04:58:01.451832"},"last_modified":{"type":"/type/datetime","value":"2026-02-22T07:25:04.229957"}},{"publishers":["Viking"],"identifiers":{"goodreads":["1134628"],"librarything":["20651"],"amazon":[""]},"key":"/books/OL17034969M","authors":[{"key":"/authors/OL236174A"}],"publish_places":["London"],"subjects":["Natural selection","Evolutionary genetics","Morphogenesis"],"pagination":"xi, 308 p. :","source_records":["marc:marc_oregon_summit_records/catalog_files/washs02192008.mrc_revrev.mrc:1054274329:805","ia:climbingmountimp0000dawk_t5q0","bwb:9780670850181","promise:bwb_daily_pallets_2020-07-30"],"title":"Climbing Mount Improbable","notes":{"type":"/type/text","value":"Includes bibliographical references (p. 295-300) and index."},"number_of_pages":308,"languages":[{"key":"/languages/eng"}],"isbn_10":["0670850187"],"publish_date":"1996","publish_country":"enk","by_statement":"Richard Dawkins ; original drawings by Lalla Ward.","oclc_numbers":["35266315"],"works":[{"key":"/works/OL1966483W"}],"type":{"key":"/type/edition"},"covers":[11605270],"ocaid":"climbingmountimp0000dawk_t5q0","lc_classifications":["QH375 .D376 1996"],"local_id":["urn:bwbsku:KN-625-739"],"latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2008-09-27T04:46:19.117657"},"last_modified":{"type":"/type/datetime","value":"2022-12-10T02:26:20.650541"}},{"publishers":["Penguin"],"identifiers":{"goodreads":["248764"],"librarything":["20651"],"amazon":[""]},"lc_classifications":["","QH375 .D38 2006"],"source_records":["bwb:9780141026176","ia:climbingmountimp00