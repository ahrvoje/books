"}],"works":[{"key":"/works/OL25651868W"}],"type":{"key":"/type/edition"},"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2019-07-25T17:44:24.399593"},"last_modified":{"type":"/type/datetime","value":"2021-12-26T15:50:31.107498"}},{"notes":{"type":"/type/text","value":"Translation of: Complications : a surgeon's notes on an imperfect scienc.\n\nIncludes bibliographical references."},"title":"Yi wei wai ke yi shi de xiu lian","subtitle":"Complications : a surgeon's notes on an imperfect science / Atul Gawande","authors":[{"key":"/authors/OL1485501A"}],"publish_date":"2015","publishers":["Yuan jian tian xia wen hua chu ban gu fen you xian gong si"],"isbn_10":["9863208388"],"series":["Jian kang sheng huo = -- Good health -- 164","Jian kang sheng huo -- 164."],"full_title":"Yi wei wai ke yi shi de xiu lian Complications : a surgeon's notes on an imperfect science / Atul Gawande","publish_places":["Taibei Shi"],"contributions":["Liao, Yuejuan, translator"],"subjects":["Surgery","Surgeons","Biography","Anecdotes"],"languages":[{"key":"/languages/chi"}],"pagination":"358 pages","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run05.mrc:252964897:3387"],"work_titles":["Complications"],"isbn_13":["9789863208389"],"edition_name":"Di 3 ban","subject_places":["United States"],"local_id":["urn:sfpl:31223117860180","urn:sfpl:31223117860172","urn:sfpl:31223117860198","urn:sfpl:31223117860164","urn:sfpl:31223117860222","urn:sfpl:31223117860206"],"subject_people":["Atul Gawande"],"publish_country":"ch","by_statement":"Gewende zhu ; Liao Yuejuan yi =","oclc_numbers":["946714690"],"type":{"key":"/type/edition"},"key":"/books/OL27196857M","number_of_pages":358,"works":[{"key":"/works/OL25651868W"}],"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2019-07-19T08:24:29.038912"},"last_modified":{"type":"/type/datetime","value":"2023-05-05T01:58:09.951356"}},{"title":"Complications : a surgeon's notes on an imperfect science","authors":[{"key":"/authors/OL1485501A"}],"source_records":["ia:complicationssu000gawa"],"openlibrary":"OL24962886M","covers":[11487111],"subjects":["Gawande, Atul"],"ocaid":"complicationssu000gawa","type":{"key":"/type/edition"},"languages":[{"key":"/languages/eng"}],"key":"/books/OL26638815M","works":[{"key":"/works/OL25651868W"}],"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2019-01-09T03:36:02.791070"},"last_modified":{"type":"/type/datetime","value":"2023-01-30T00:11:27.729212"}},{"description":{"type":"/type/text","value":"A brilliant and courageous doctor reveals, in gripping accounts of true cases, the power and limits of modern medicine. Sometimes in medicine the only way to know what is truly going on in a patient is to operate, to look inside with one's own eyes. This book is exploratory surgery on medicine itself, laying bare a science not in its idealized form but as it actually is -- complicated, perplexing, and profoundly human. Atul Gawande offers an unflinching view from the scalpel's edge, where science is ambiguous, information is limited, the stakes are high, yet decisions must be made. In dramatic and revealing stories of patients and doctors, he explores how deadly mistakes occur and why good surgeons go bad. He also shows us what happens when medicine comes up against the inexplicable: an architect with incapacitating back pain for which there is no physical cause a young woman with nausea that won't go away a television newscaster whose blushing is so severe that she cannot do her job. Gawande offers a richly detailed portrait of the people and the science, even as he tackles the paradoxes and imperfections inherent in caring for human lives. At once tough-minded and humane, Complications is a new kind of medical writing, nuanced and lucid, unafraid to confront the conflicts and uncertainties that lie at the heart of modern medicine, yet always alive to the possibilities of wisdom in this extraordinary endeavor."},"notes":{"type":"/type/text","value":"\"Several of these pieces have appeared, in slightly different form, in the New Yorker and Slate\"--T.p. verso.\r\n\r\nIncludes bibliographical references (p. 253-264) and index."},"title":"Complications","subtitle":"a surgeon's notes on an imperfect science","authors":[{"key":"/authors/OL1485501A"}],"publish_date":"2002","links":[{"url":"http://www.loc.gov/catdir/bios/hol051/2001055884.html","title":"Contributor biographical information"},{"url":"http://www.loc.gov/catdir/samples/hol041/2001055884.html","title":"Sample text"},{"url":"http://www.loc.gov/catdir/description/hol021/2001055884.html","title":"Publisher description"}],"covers":[6885902],"local_id":["urn:bwbsku:P7-EQR-891","urn:sfpl:31223060636496","urn:sfpl:31223060636728","urn:sfpl:31223060636652","urn:sfpl:31223060636769","urn:bwbsku:P7-DQB-540","urn:bwbsku:O7-CIF-258","urn:bwbsku:P7-APS-538","urn:nuls:31786102604615"],"ia_loaded_id":["complicationssu000gawa"],"languages":[{"key":"/languages/eng"}],"source_records":["promise:bwb_daily_pallets_2021-09-22:P7-EQR-891","ia:complicationssur00gawa","ia:complicationssu000gawa","marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run02.mrc:242558622:2032","ia:complicationssur00gawa_681","bwb:9780312421700","bwb:9780805063196","marc:marc_loc_2016/BooksAll.2016.part28.utf8:232325614:1206","ia:complicationssur0000gawa","promise:bwb_daily_pallets_2021-09-21:P7-DQB-540","promise:bwb_daily_pallets_2021-06-28:O7-CIF-258","promise:bwb_daily_pallets_2021-05-12:P7-APS-538","marc:marc_nuls/NULS_PHC_180925.mrc:157707509:1744","marc:marc_columbia/Columbia-extract-20221130-007.mrc:250937442:3231","idb:9780312421700"],"edition_name":"1st ed.","subjects":["Autobiography","Chirurg","Anecdotes","Surgeons","Surgery","Medical Errors","General Surgery","Biography","Atul Gawande"],"publish_country":"nyu","by_statement":"Atul Gawande","type":{"key":"/type/edition"},"publishers":["Metropolitan B