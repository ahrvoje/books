lishers":["Grand Central Publishing"],"source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run05.mrc:257074044:9297","bwb:9781455586691","marc:marc_loc_2016/BooksAll.2016.part42.utf8:81989631:2915","ia:deepworkrulesfor0000newp","promise:bwb_daily_pallets_2022-08-30","marc:marc_columbia/Columbia-extract-20221130-025.mrc:149601122:3804","marc:marc_nuls/NULS_PHC_180925.mrc:160267368:3314","amazon:1455586692","marc:harvard_bibliographic_metadata/20220215_039.bib.mrc:287175850:6250"],"title":"Deep Work","identifiers":{},"covers":[14859612,15217838,14845480,14831778,7988607,-1],"local_id":["urn:sfpl:31223106606735","urn:sfpl:31223106606800","urn:sfpl:31223106606867","urn:sfpl:31223106606818","urn:sfpl:31223106606883","urn:sfpl:31223106606891","urn:sfpl:31223106606958","urn:sfpl:31223106607097","urn:sfpl:31223106606644","urn:sfpl:31223114386320","urn:sfpl:31223106606651","urn:sfpl:31223125779729","urn:sfpl:31223106606974","urn:sfpl:31223106606982","urn:sfpl:31223106606966","urn:sfpl:31223106606941","urn:sfpl:31223106606909","urn:sfpl:31223106607006","urn:sfpl:31223106607014","urn:sfpl:31223106607022","urn:sfpl:31223106607071","urn:sfpl:31223106607048","urn:sfpl:31223106607030","urn:sfpl:31223106607055","urn:sfpl:31223106607089","urn:sfpl:31223106607105","urn:sfpl:31223106607113","urn:bwbsku:O8-CTS-883"],"publish_date":"2016","key":"/books/OL26314691M","subtitle":"Rules for Focused Success in a Distracted World","works":[{"key":"/works/OL17713267W"}],"type":{"key":"/type/edition"},"number_of_pages":295,"languages":[{"key":"/languages/eng"}],"table_of_contents":[{"level":0,"label":"","title":"Introduction","pagenum":"1","type":{"key":"/type/toc_item"}},{"level":0,"label":"Part 1","title":"The Idea","pagenum":"","type":{"key":"/type/toc_item"}},{"level":1,"label":"Chapter 1","title":"Deep Work Is Valuable","pagenum":"21","type":{"key":"/type/toc_item"}},{"level":1,"label":"Chapter 2","title":"Deep Work Is Rare","pagenum":"49","type":{"key":"/type/toc_item"}},{"level":1,"label":"Chapter 3","title":"Deep Work Is Meaningful","pagenum":"72","type":{"key":"/type/toc_item"}},{"level":0,"label":"Part 2","title":"The Rules","pagenum":"","type":{"key":"/type/toc_item"}},{"level":1,"label":"Rule #1","title":"Work Deeply","pagenum":"95","type":{"key":"/type/toc_item"}},{"level":1,"label":"Rule #2","title":"Embrace Boredom","pagenum":"155","type":{"key":"/type/toc_item"}},{"level":1,"label":"Rule #3","title":"Quit Social Media","pagenum":"181","type":{"key":"/type/toc_item"}},{"level":1,"label":"Rule #4","title":"Drain the Shallows","pagenum":"215","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Conclusion","pagenum":"257","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Notes","pagenum":"265","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Index","pagenum":"289","type":{"key":"/type/toc_item"}}],"ocaid":"deepworkrulesfor0000newp","isbn_10":["1455586692"],"isbn_13":["9781455586691"],"lccn":["2015032646"],"oclc_numbers":["908704985"],"lc_classifications":["BF323.D5 N49 2016","BF323.D5N49 2016"],"description":{"type":"/type/text","value":"\"One of the most valuable skills in our economy is becoming increasingly rare. If you master this skill, you'll achieve extraordinary results. Deep work is the ability to focus without distraction on a cognitively demanding task. It's a skill that allows you to quickly master complicated information and produce better results in less time. Deep work will make you better at what you do and provide the sense of true fulfillment that comes from craftsmanship. In short, deep work is like a super power in our increasingly competitive twenty-first century economy. And yet, most people have lost the ability to go deep-spending their days instead in a frantic blur of e-mail and social media, not even realizing there's a better way. In DEEP WORK, author and professor Cal Newport flips the narrative on impact in a connected age. Instead of arguing distraction is bad, he instead celebrates the power of its opposite. Dividing this book into two parts, he first makes the case that in almost any profession, cultivating a deep work ethic will produce massive benefits. He then presents a rigorous training regimen, presented as a series of four \"rules,\" for transforming your mind and habits to support this skill. A mix of cultural criticism and actionable advice, DEEP WORK takes the reader on a journey through memorable stories-from Carl Jung building a stone tower in the woods to focus his mind, to a social media pioneer buying a round-trip business class ticket to Tokyo to write a book free from distraction in the air-and no-nonsense advice, such as the claim that most serious professionals should quit social media and that you should practice being bored. DEEP WORK is an indispensable guide to anyone seeking focused success in a distracted world\"--"},"latest_revision":35,"revision":35,"created":{"type":"/type/datetime","value":"2017-05-17T22:31:41.393586"},"last_modified":{"type":"/type/datetime","value":"2026-05-25T00:58:44.920486"}}]}