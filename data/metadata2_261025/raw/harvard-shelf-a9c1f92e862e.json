{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Vatikiotis&limit=10&title=Blood and Silk","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":{"title":"Blood and silk ","subTitle":"power and conflict in modern Southeast Asia "},"name":{"@usage":"primary","@type":"personal","namePart":["Vatikiotis, Michael R. J.,",{"@type":"date","#text":"1957-"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},"dateIssued":{"@encoding":"marc","#text":"2017"},"copyrightDate":{"@encoding":"marc","#text":"2017"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"London :"}},"agent":{"namePart":"Weidenfeld & Nicolson, an imprint of the Orion Publishing Group Ltd,","role":{"roleTerm":"publisher"}},"dateIssued":"2017."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"336 pages : map ; 24 cm"},{"form":{"@type":"Illustrative content","#text":"map"}}],"abstract":{"@type":"Summary","#text":"Thought-provoking and eye-opening, BLOOD AND SILK is an accessible, personal look at modern Southeast Asia, written by one of the region's most experienced outside observers. This is a first-hand account of what it's like to sit at the table with deadly Thai Muslim insurgents, mediate between warring clans in the Southern Philippines and console the victims of political violence in Indonesia - all in an effort to negotiate peace, and understand the reasons behind endemic violence."},"tableOfContents":{"@type":"Contents","#text":"Power. Journey into the heart of Southeast Asia -- Land below the winds -- Divine kings and dark princes -- Elephants and long grass -- Bygones be gone -- Orderly opening -- Delusions of democracy -- Greed, graft and gore -- Conflict. Small wars and contested identities -- Clashing beliefs and the new Jihad -- The dragon apparent -- The road ahead."},"note":[{"@type":"statement of responsibility","#text":"Michael Vatikiotis."},{"@type":"bibliography","#text":"Includes bibliographical references (pages 307-319) and index."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"as-----"}},{"@authority":"lcsh","geographic":"Southeast Asia","topic":"Civilization"},{"@authority":"lcsh","geographic":"Southeast Asia","topic":"Social conditions"},{"@authority":"lcsh","geographic":"Southeast Asia","topic":"Politics and government"},{"@authority":"fast","@href":"(OCoLC)fst00862898","topic":"Civilization"},{"@authority":"fast","@href":"(OCoLC)fst01919741","topic":"Politics and government"},{"@authority":"fast","@href":"(OCoLC)fst01919811","topic":"Social conditions"},{"@authority":"fast","@href":"(OCoLC)fst01240499","geographic":"Southeast Asia"}],"classification":[{"@authority":"lcc","#text":"DS526.7 .V356 2017"},{"@authority":"lcc","#text":"DS525 .V38 2017"},{"@edition":"23","@authority":"ddc","#text":"959"}],"relatedItem":[{"@type":"otherFormat","@otherType":"ebook version :","@displayLabel":"ebook version :","identifier":{"@type":"isbn","#text":"9781474602020"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990150596140203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"9781474602006"},{"@type":"isbn","#text":"1474602002"},{"@type":"isbn","#text":"9781474602013"},{"@type":"isbn","#text":"1474602010"},{"@type":"isbn","@invalid":"yes","#text":"9781474602020"},{"@type":"oclc","#text"