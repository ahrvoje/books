{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Green&limit=10&title=The Anthropocene Reviewed","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":[{"nonSort":{"@space":"preserve","#text":"The  "},"title":"Anthropocene reviewed ","subTitle":"essays on a human-centered planet "},{"@type":"uniform","@nameTitleGroup":"1","title":"Essays. Selections"}],"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":["Green, John,",{"@type":"date","#text":"1977-"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}],"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJqk4KDvQPjXTWHWh8BwYP"},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"marcgt","#text":"essay"},{"@authority":"rdacontent","#text":"text"},{"@authority":"Medical Subject Headings","#text":"Essay"},{"@authority":"Medical Subject Headings","#text":"Review"},{"@authority":"aat","#text":"reviews (documents)"},{"@authority":"aat","#text":"essays."},{"@authority":"aat","#text":"miscellanies."},{"@authority":"fast","#text":"Essays"},{"@authority":"fast","#text":"Reviews"},{"@authority":"fast","#text":"Trivia and miscellanea"},{"@authority":"gsafd","#text":"Essays."},{"@authority":"lcgft","#text":"Essays"},{"@authority":"lcgft","#text":"Trivia and miscellanea"},{"@authority":"lcgft","#text":"Reviews"},{"@authority":"rvmgf","#text":"Essais."},{"@authority":"rvmgf","#text":"Comptes rendus."},{"@authority":"rvmgf","#text":"Miscellanées."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},"dateIssued":{"@encoding":"marc","#text":"2021"},"copyrightDate":{"@encoding":"marc","#text":"2021"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"[New York, New York] :"}},"agent":{"namePart":"Dutton, an imprint of Penguin Random House LLC,","role":{"roleTerm":"publisher"}},"dateIssued":"2021"}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"293 pages : illustrations ; 22 cm"},"abstract":{"@type":"Summary","#text":"\"The Anthropocene is the current geological age, in which human activity has profoundly shaped the planet and its biodiversity. In this remarkable symphony of essays adapted and expanded from his groundbreaking podcast, John Green reviews different facets of the human-centered planet-- from the QWERTY keyboard and Staphylococcus aureus to the Taco Bell breakfast menu-- on a five-star scale. John Green's gift for storytelling shines throughout this artfully curated collection that includes both beloved essays and all-new pieces exclusive to the book.\"-- Provided by publisher."},"tableOfContents":{"@type":"Contents","#text":"Introduction -- \"You'll never walk alone\" -- Humanity's temporal range -- Halley's comet -- Our capacity for wonder -- Lascaux cave paintings -- Scratch 'n' sniff stickers -- Diet Dr Pepper -- Velociraptors -- Canada geese -- Teddy bears -- The Hall of Presidents -- Air-conditioning -- Staphylococcus aureus -- The internet -- Academic Decathlon -- Sunsets -- Jerzy Dudek's performance on May 25, 2005 -- 'Penguins of Madagascar' -- Piggly Wiggly -- The Nathan's Famous Hot Dog Eating Contest -- CNN -- 'Harvey' -- The yips -- Auld Lang Syne -- Googling strangers -- Indianapolis -- Kentucky bluegrass -- The Indianapolis 500 -- Monopoly -- 'Super Mario Kart' -- Bonneville Salt Flats -- Hiroyuki Doi's circle drawings -- Whispering -- Viral meningitis -- Plague -- Wintry mix -- The hot dogs of Bæjarins Beztu Pylsur -- The Notes app -- The mountain goats -- The QWERTY keyboard -- The world's largest ball of paint -- Sycamore trees -- \"New Partner\" -- 'Three Farmers on Their Way to a Dance' -- Postscript -- Notes (pages 279-293)."},"note":[{"@type":"statement of responsibility","#text":"by John Green."},{"@type":"bibliography","#text":"Includes bibliographical references."}],"subject":[{"@authority":"lcsh","topic":"Culture","genre":["Miscellanea","Reviews"]},{"@authority":"lcsh","topic":"Science","genre":["Miscellanea","Reviews"]},{"@authority":"lcsh","topic":"Manners and customs","genre":["Miscellanea","Reviews"]},{"@authority":"lcsh","topic":"Civilization, Modern","temporal":"21st century","genre":["Miscellanea","Reviews"]},{"@authority":"bisacsh","topic":["LITERARY COLLECTIONS","Essays"]},{"@authority":"bisacsh","topic":["SOCIAL SCIENCE","Essays"]},{"@authority":"cct","topic":"Culture","genre":"Miscellanea"},{"@authority":"cct","topic":"Science","genre":"Miscellanea"},{"@authority":"cct","topic":"Manners and customs","genre":"Miscellanea"},{"@authority":"cct","topic":"Civilization, Modern","genre":"Miscellanea","geographic":"21st century"},{"@authority":"cct","topic":"Essay"},{"@authority":"cct","topic":"Review"},{"@authority":"fast","topic":"Manners and customs"},{"@authority":"fast","topic":"Civilization, Modern"},{"@authority":"fast","topic":"Culture"},{"@authority":"fast","topic":"Science"},{"@authority":"sears","topic":"Culture"},{"@authority":"sears","topic":"Science"},{"@authority":"sears","topic":"Manners and customs"},{"@authority":"sears","topic":"Modern civilization"},{"topic":"Essays."},{"@authority":"fast","temporal":"2000-2099"}],"classification":[{"@authority":"lcc","#text":"HM621 .G735 2021"},{"@edition":"23","@authority":"ddc","#text":"814.6"},{"@edition":"23","@authority":"ddc","#text":"306"},{"@authority":"clc","#text":"I712.65"}],"relatedItem":[{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":[{"title":"Anthropocene reviewed"},{"