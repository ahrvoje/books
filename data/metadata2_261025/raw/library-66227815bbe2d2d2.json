le":"Nicholas and Alexandra","dewey_decimal_class":["947.08/3/0922","B"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. [589]-594) and index."},"number_of_pages":613,"edition_name":"1st Ballantine ed.","lccn":["99091507"],"local_id":["urn:sfpl:31223056334932","urn:sfpl:31223056334924","urn:sfpl:31223056334999","urn:sfpl:31223056334957","urn:sfpl:31223056334965","urn:sfpl:31223056335004","urn:sfpl:31223085168632","urn:bwbsku:C0-CBN-058"],"publish_date":"2000","publish_country":"nyu","by_statement":"Robert K. Massie.","works":[{"key":"/works/OL84466W"}],"type":{"key":"/type/edition"},"oclc_numbers":["43485080"],"description":{"type":"/type/text","value":"More than a quarter of a century after it was first published in hardcover comes a never-before-issued trade paperback edition of the classic Nicholas and Alexandra. Featuring a new introduction by its Pulitzer Prize -- winning author, this powerful work sweeps us back to the extraordinary world of Imperial Russia to tell the story of the Romanovs' lives: Nicholas's political naivete, Alexandra's obsession with the corrupt mystic Rasputin, and little Alexis's brave struggle with hemophilia. Against a lavish backdrop of luxury and intrigue, Robert K. Massie unfolds a powerful drama of passion and history -- the story of a doomed empire and the death-marked royals who watched it crumble."},"latest_revision":16,"revision":16,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-04-30T01:17:10.524863"}}},"OLID:OL5546145M":{"bib_key":"OLID:OL5546145M","info_url":"http://openlibrary.org/books/OL5546145M/Nicholas_and_Alexandra","preview":"restricted","preview_url":"https://archive.org/details/nicholasalexand00mass","thumbnail_url":"https://covers.openlibrary.org/b/id/6544405-S.jpg","details":{"publishers":["Atheneum"],"number_of_pages":584,"subject_place":["Russia"],"covers":[6544405],"local_id":["urn:phillips:31867000410