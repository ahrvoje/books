":"2 The Great Opportunity - II, 17","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"3 Concept of the Organization, 42","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"4 Prodeuct Policy and its Origins, 58","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"5 The \"Copper-Cooled\" Engine, 71","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"6 Stabilization, 95","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"7 Co-ordination by Committee, 99","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"8 The Development of Financial Controls, 116","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"9 Transformation of the Automobile Market, 149","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"10 Policy Creation, 169","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"11 Financial Growth, 191","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Part Two","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"12 Evolution of the Automobile, 219","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"13 The Annual Model Change, 238","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"14 The Technical Staffs, 248","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"15 Styling, 264","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"16 Distribution and the Dealers, 279","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"17 GMAC, 302","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"18 The Coporation Overseas, 313","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"19 Nonautomotive: Diesel Electric Locomotives, Applianc