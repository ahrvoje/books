nts","#text":"1. The gathering storm.--2. Their finest hour.--3. The Grand Alliance.--4. The hinge of fate.--5. Closing the ring.--6. Triumph and tragedy."},"note":[{"@type":"statement of responsibility","#text":"Winston S. Churchill."},"Includes index."],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"e-uk---"}},{"@authority":"lcsh","topic":"World War, 1939-1945"},{"@authority":"lcsh","topic":"World War, 1939-1945","geographic":"Great Britain"},{"@authority":"fast","temporal":"1939-1945"}],"classification":{"@authority":"lcc","#text":"D743 .C47 1949e"},"relatedItem":[{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":{"title":"Second World War"},"originInfo":{"publisher":"New York, Bantam Books, 1961-1962"},"identifier":{"@type":"local","#text":"(OCoLC)609660535"},"name":{"namePart":"Churchill, Winston, 1874-1965."}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990070244020203941/catalog"}}],"identifier":{"@type":"oclc","#text":"4256990"},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2018017635","#text":"History Departmental Library, Harvard University"},"shelfLocator":"Hist 852.12"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"History Dept."},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990070244020203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"007024402"}},"processingDate":"2026-08-07T04:22Z"}},{"sets":null}],"recordInfo":{"recordContentSource":{"@authority":"marcorg","#text":"COA"},"recordCreationDate":{"@encoding":"marc","#text":"800925"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990070244020203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"titleInfo":{"title":"In command of history","subTitle":"Churchill fighting and writing the Second World War"},"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":["Reynolds, David",{"@type":"date","#text":"1952-"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"fast","#text":"Criticism, interpretation, etc."},{"@authority":"fast","#text":"Personal narratives-British"}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"New York"}}],"publisher":"Random House","dateIssued":["c2005",{"@encoding":"marc","#text":"2005"}],"edition":"1st U.S. ed.","issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"xxiv, 631 p., [16] p. of plates : ill. ; 24 cm."},"abstract":{"@type":"Summary","#text":"As Britain's prime minister from 1940 to 1945, Churchill courageously led his nation and the world away from appeasement, into war, and on to triumph over the Axis dictators. His classic six-volume account of those years has shaped our perceptions of the conflict and secured Churchill's place as its most important chronicler. This book explains how Churchill wrote this masterwork, and in the process enhances and often revises our understanding of one of history's most complex, vivid, and eloquent leaders. It forces us to reconsider much received wisdom about World War II, and peels back the covers from an unjustly neglected period of Churchill's life, his \"second wilderness\" years, 1945-1951.--From publisher description."},"tableOfContents":"July 1945 -- To write or not to write? -- Contracts: Churchill against the publishers -- Papers: Churchill against the bureaucrats -- Reputation: Churchill against mortality -- Taking the plunge -- I: The gathering storm, 1919-1940, 1946-1948 -- Setting a course -- The unnecessary road to Munich -- Twilight for Chamberlain, new dawn for Churchill -- Prophet of the past and the future -- II: Their finest hour, 1940, 1946-1949 -- Between memoir and history -- \"Victory at all costs\" -- The battle of Britain and the Mediterranean gamble -- His finest hour -- III: The grand alliance, 1941-1942, 1948-1950 -- \"In the event of your death\" -- The crisis of spring 1941 -- Forging an alliance -- \"Man of the half-century\" -- IV: The hinge of fate, 1942-1943, 1948-1951 -- \"The worst mess yet\" -- Asian disasters, desert victory, and the silence of Stalingrad -- Second front: when, where, and how? -- Fighting with allies-- and colleagues -- \"The best of Winnie's memoirs\" -- V: Closing the ring, 1943-1944, 1949-1952 -- Deadlines -- Churchill and \"the Mediterranean strategy\" -- The tyranny of overlord -- The future of Europe -- \"On the defensive\" -- VI: Triumph and tragedy, 1944-1945, 1950-1954 -- A very diplomatic history -- Overlord and underdog -- The unnecessary cold war -- \"It seems incredible\" -- Leaving it to history, 1955-1965 -- January 1965.","note":[{"@type":"statement of responsibility","#text":"David Reynolds."},"\"Winner of the Wolfson History Prize\" -- Dustjacket.",{"@type":"bibliography","#text":"Includes bibliographical references (p. [540]-614) and index."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"e-uk---"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Churchill, Winston",{"@type":"date","#text":"1874-1965"}]},"titleInfo":{"title":"Second World War"}},{"@authority":"fast","temporal":"1939-1945"},{"@authority":"lcsh","topic":["World War, 1939-1945","History and criticism"],"genre":"Personal narratives, British"},{"@authority":"lcsh","topic":["World War, 1939-1945","Historiography"]}],"classification":[{"@authority":"lcc","#text":"D743.42 .R48 2005"},{"@edition":"22","@authority":"ddc","#text":"940.53/092"}],"relatedItem":[{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":{"title":"In command of history"},"name":{"namePart":"Reynolds, David, 1952-"},"originInfo":{"publisher":"New York : Random House, ©2005","edition":"1st ed."},"identifier":{"@type":"local","#text":"(OCoLC)646412194"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990101464240203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0679457437 (acid-free paper)"},{"@type":"lccn","#text":"^^2004051087"},{"@type":"oclc","#text":"55877774"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000463633307","#text":"Lamont Library, Harvard University"},"shelfLocator":"D743.42 .R48 2005"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Lamont"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990101464240203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"010146424"}},"processingDate":"2025-07-06T05:13Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"040629"},"recordChangeDate":{"@encoding":"iso8601","#text":"20090113"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990101464240203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}},{"titleInfo":[{"title":"Forged in war","subTitle":"Roosevelt, Churchill, and the Second World War"},{"@type":"alternative","title":"Roosevelt, Churchill, and the Second World War"},{"@type":"alternative","title":"Roosevelt, Churchill, and the 2nd World War"}],"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":"Kimball, Warren F.","role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":{"@authority":"marcgt","#text":"bibliography"},"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"New York"}}],"publisher":"W. Morrow","dateIssued":["c1997",{"@encoding":"marc","#text":"1997"}],"edition":"1st ed.","issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"422 p. : ill. ; 25 cm."},"abstract":[{"@type":"Summary","#text":"Roosevelt and Churchill: Theirs was a partnership that shaped the American Century. Their combined leadership during the crucial years of World War II seized victory for the Allied forces and laid the groundwork for the peace that followed. The story of their relationship is also, inevitably, the story of their nations and the \"good war.\" Now, noted historian Warren Kimball brings to life the political and personal affiance of these two great leaders, set against the."},{"@type":"Summary","#text":"Incredible events of the time. Using various historical sources - including the enormous store of letters that the leaders exchanged, both playful and deadly serious - Kimball paints an intimate portrait of the men and their role in the war. Kimball's lively analysis reveals the men behind the politicians, and shows how they were at the same time idealists yet realists, consistent yet unpredictable, calculating yet impulsive. At times they made mistakes in judgment,"},{"@type":"Summary","#text":"Disagreed about how to win and what the postwar world would and should look like, and focused closely on their own countries' interests. Ultimately, however, their \"Yalta System\" helped shape an era without direct war between the \"Great Powers.\""}],"tableOfContents":"The players : \"a pugnacious looking b[astard]\" and \"this artitst, this seducer\" -- \"If Britain is to survive\" (September 1939-September 1940) -- \"A year of indecision\" (October 1940-June 1941) -- \"History has recorded who fired the first shot\" : the Soviet Union and the United States enter the war (June 1941-December 1941) -- \"It is fun to be in the same decade with you\" (December 1941-July 1942) -- \"The end of the beginning\" : and the \"beginning of the end\" (August 1942-February 1943) -- \"I am not a Wilsonian idealist, I have problems to resolve\" (March-December 1943) -- \"A new heaven and a new earth\" (December 1943-December 1944) -- The \"holy alliance\" (December 1944-war's end) -- Appendix : on health and the history of the Second World War.","note":[{"@type":"statement of responsibility","#text":"Warren F. Kimball."},{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"geographicCode":[{"@authority":"marcgac","#text":"n-us---"},{"@authority":"marcgac","#text":"e-uk---"}]},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Roosevelt, Franklin D. (Franklin Delano)",{"@type":"date","#text":"1882-1945"}]}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Churchill, Winston",{"@type":"date","#text":"1874-1965"}]}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Churchill, Winston",{"@type":"date","#text":"1874-1965"}]},"topic":"Military leadership"},{"@authority":"fast","temporal":"1939-1945"},{"@authority":"lcsh","topic":["World War, 1939-1945","Diplomatic history"]},{"@authority":"lcsh","topic":["World War, 1939-1945","Diplomatic history"]},{"@authority":"lcsh","geographic":["United States","Great Britain"],"topic":"Foreign relations"},{"@authority":"lcsh","geographic":["Great Britain","United States"],"topic":"Foreign relations"}],"classification":[{"@authority":"lcc","#text":"D753 .K48 1996"},{"@edition":"20","@authority":"ddc","#text":"940.53/2241"}],"identifier":[{"@type":"isbn","#text":"0688085237"},{"@type":"lccn","#text":"^^^96028633^"},{"@type":"oclc","#text":"34951437"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990073614590203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"D753 .K48 1997x"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000463633307","#text":"Lamont Library, Harvard University"},"shelfLocator":"D753 .K48 1997x"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":["Lamont","Widener"]},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990073614590203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"007361459"}},"processingDate":"2025-07-06T05:14Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"960611"},"recordChangeDate":{"@encoding":"iso8601","#text":"20090312"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990073614590203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}}]}}