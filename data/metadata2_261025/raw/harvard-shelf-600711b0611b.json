{"pagination":{"maxPageableSet":"10000","numFound":4,"query":"name=Al-Khalili&limit=10&title=Quantum","limit":10,"start":0},"items":{"mods":[{"@version":"3.8","titleInfo":[{"title":"Quantum dots ","subTitle":"a variety of new applications "},{"@type":"alternative","title":"Quantum dots"}],"name":[{"@usage":"primary","@type":"personal","namePart":"Al-Ahmadi, Ameenah","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"code","@authority":"marcrelator","#text":"edt"}}]},{"@type":"personal","namePart":"Al-Ahmadi, Ameenah,","role":{"roleTerm":{"@type":"text","#text":"editor"}}},{"@type":"personal","namePart":"Al-Ahmadi, Ameenah","role":{"roleTerm":{"@type":"code","@authority":"marcrelator","#text":"edt"}}},{"@type":"personal","namePart":"Al-Ahmadi, Ameenah","role":{"roleTerm":{"@type":"code","@authority":"marcrelator","#text":"oth"}}}],"typeOfResource":"text","genre":{"@authority":"rdacontent","#text":"text"},"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"ci"},{"@type":"text","@authority":"marccountry","#text":"Croatia"}]},"issuance":"monographic","agent":{"namePart":"IntechOpen"},"dateIssued":"2012"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Rijeka, Croatia :"}},"agent":{"namePart":"InTech,","role":{"roleTerm":"publisher"}},"dateIssued":[2012]}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marccategory","#text":"electronic resource"},{"@authority":"marcsmd","#text":"remote"},{"@type":"media","@authority":"rdamedia","#text":"computer"},{"@type":"carrier","@authority":"rdacarrier","#text":"online resource"}],"extent":"1 online resource (vi, 280 pages) : illustrations"},"abstract":{"@type":"Summary","#text":"The book “Quantum dots: A variety of a new applications” provides some collections of practical applications of quantum dots. This book is divided into four sections. In section 1 a review of the thermo-optical characterization of CdSe/ZnS core-shell nanocrystal solutions was performed. The Thermal Lens (TL) technique was used, and the thermal self-phase Modulation (TSPM) technique was adopted as the simplest alternative method. Section 2 includes five chapters where novel optical and lasing application are discussed. In section 3 four examples of quantum dot system for different applications in electronics are given. Section 4 provides three examples of using quantum dot system for biological applications. This is a collaborative book sharing and providing fundamental research such as the one conducted in Physics, Chemistry, Biology, Material Science, Medicine with a base text that could serve as a reference in research by presenting up-to-date research work on the field of quantum dot systems."},"note":[{"@type":"statement of responsibility","#text":"edited by Ameenah Al-Ahmadi."},{"@type":"language","#text":"English"},"Description based on: online resource; title from PDF information screen (InTech, viewed October 17, 2022)."],"subject":{"@authority":"lcsh","topic":"Quantum dots"},"classification":[{"@authority":"lcc","#text":"QC611.6.Q35 .Q368 2012"},{"@edition":"23","@authority":"ddc","#text":"621.38152"}],"relatedItem":[{"@type":"otherFormat","identifier":{"@type":"isbn","#text":"9789535104834"}},{"@type":"otherFormat","identifier":{"@type":"isbn","#text":"9535104837"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99153590932303941/catalog"}}],"identifier":[{"@type":"isbn","#text":"9789535156802"},{"@type":"isbn","#text":"9535156802"}],"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99153590932303941","processingDate":"2026-10-01T04:14Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"NjHacI"},"recordCreati