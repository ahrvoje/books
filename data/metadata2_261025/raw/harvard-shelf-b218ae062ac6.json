{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Bizony&limit=10&title=The NASA Archives","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":[{"nonSort":{"@space":"preserve","#text":"The  "},"title":"NASA archives ","subTitle":"from Project Mercury, to the Mars Rovers : 60 years in space "},{"@type":"alternative","title":"National Aeronautics and Space Administration archives"}],"name":[{"@type":"personal","namePart":"Wiener, Nina","role":{"roleTerm":{"@type":"text","#text":"editor"}}},{"@type":"personal","namePart":"Bizony, Piers","role":{"roleTerm":{"@type":"text","#text":"editor"}}},{"@type":"personal","namePart":["Chaikin, Andrew,",{"@type":"date","#text":"1956-"}],"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJth6tPRwDWg9RJ6Rr9MT3"},{"@type":"personal","namePart":"Launius, Roger D."},{"@type":"corporate","namePart":"Lyndon B. Johnson Space Center","nameIdentifier":"https://id.oclc.org/worldcat/entity/E39QQPVp7KRfmjcVBh8KYF3Y7R"}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"rdacontent","#text":"still image"},{"@authority":"aat","#text":"illustrated books."},{"@authority":"fast","#text":"Illustrated works"},{"@authority":"fast","#text":"Pictorial works"},{"@authority":"fast","#text":"History"},{"@authority":"lcgft","#text":"Illustrated works"},{"@authority":"lcgft","#text":"Records (Documents)"},{"@authority":"rvmgf","#text":"Ouvrages illustrés."},{"@authority":"rvmgf","#text":"Documents administratifs."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"gw"},{"@type":"text","@authority":"marccountry","#text":"Germany"}]},"dateIssued":{"@encoding":"marc","#text":"2019"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Köln :"}},"agent":{"namePart":"Taschen,","role":{"roleTerm":"publisher"}},"dateIssued":[2019]}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@authority":"marccategory","#text":"text"},{"@authority":"marcsmd","#text":"regular print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"466 pages : illustrations ; 34 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}}],"abstract":{"@type":"Summary","#text":"\"To Infinity and Beyond. Journey through the U.S. space program's fascinating pictorial history. On October 1, 1958, the world's first civilian space agency opened for business as an emergency response to the Soviet Union's launch of Sputnik a year earlier. Within a decade, the National Aeronautics and Space Administration, universally known as NASA, had evolved from modest research teams experimenting with small converted rockets into one of the greatest technological and managerial enterprises ever known, capable of sending men to the moon\"-- Jacket flap."},"tableOfContents":[{"@type":"Contents","#text":"For all humankind -- The rocket's red glare -- This new ocean -- Islands in the sky -- Pale blue dot -- The final frontier."},{"@type":"Contents","#text":"The greatest exploration / by Piers Bizony -- Higher, faster / by Roger D. Launius -- Red star rising / by Roger D. Launius -- Spam in a can -- The decision -- Gemini twins -- Chariots for Apollo -- Men on the moon -- Apollo's finale -- The workhorse of space -- Inhabiting orbit -- The Sun's closest children -- Red planet Mars -- The outer planets -- Worlds beyond -- Magnificent desolation / by Andrew Chaikin -- NASA mission checklist."}],"note":[{"@type":"statement of responsibility","#text":"[edited by] Piers Bizony ; essays by Andrew Chaikin and Dr. Roger Launius ; edited by Nina Weiner."},{"@type":"bibliography","#text":"Includes bibliographical