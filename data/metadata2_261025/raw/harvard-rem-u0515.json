{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Gates&limit=10&title=Source Code","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":{"title":"Source code ","subTitle":"my beginnings "},"name":{"@usage":"primary","@type":"personal","namePart":["Gates, Bill,",{"@type":"date","#text":"1955-"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}},{"roleTerm":{"@type":"code","@authority":"marcrelator","#text":"http://id.loc.gov/vocabulary/relators/aut"}}],"nameIdentifier":["https://id.oclc.org/worldcat/entity/E39PBJht7KghFW37B8QcPgCG73","http://id.loc.gov/rwo/agents/n91008414"]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"biography"},{"@authority":"rdacontent","@valueURI":"http://id.loc.gov/vocabulary/contentTypes/txt","#text":"text"},{"@authority":"Répertoire de vedettes-matière","#text":"Autobiographies."},{"@authority":"fast","#text":"Biographies"},{"@authority":"fast","#text":"Autobiographies"},{"@authority":"lcgft","#text":"Autobiographies"},{"@authority":"rvmgf","#text":"Autobiographies."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},"dateIssued":{"@encoding":"marc","#text":"2025"},"copyrightDate":{"@encoding":"marc","#text":"2025"},"issuance":"monographic","edition":"First hardcover edition."},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"New York :"}},"agent":{"namePart":"Alfred A. Knopf,","role":{"roleTerm":"publisher"}},"dateIssued":"2025.","issuance":"single unit"}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@authority":"marccategory","#text":"text"},{"@authority":"marcsmd","#text":"regular print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"ix, 318 pages, 8 leaves of plates : illustrations (some color) ; 25 cm"},{"form":{"@type":"Illustrative content","#text":"illustrations"}},{"form":{"@type":"Illustrative content","#text":"plates."}}],"abstract":{"@type":"Summary","#text":"\"The business triumphs of Bill Gates are widely known : the twenty-year-old who dropped out of Harvard to start a software company that became an industry giant and changed the way the world works and lives ; the billionaire many times over who turned his attention to philanthropic pursuits to address climate change, global health, and U.S. education. Source Code is not about Microsoft or the Gates Foundation or the future of technology. It's the human, personal story of how Bill Gates became who he is today: his childhood, his early passions and pursuits. It's the story of his principled grandmother and ambitious parents, his first deep friendships and the sudden death of his best friend ; of his struggles to fit in and his discovery of a world of coding and computers in the dawn of a new era ; of embarking in his early teens on a path that took him from midnight escapades at a nearby computer center to his college dorm room, where he sparked a revolution that would change the world. Bill Gates tells this, his own story, for the first time: wise, warm, revealing, it's a fascinating portrait of an American life.\"-- Provided by publisher."},"tableOfContents":{"@type":"Contents","#text":"Trey -- View Ridge -- Rational -- Lucky kid -- Lakeside -- Free time -- Just kids? -- The real world -- One act and five nines -- Precocious -- Wild card -- Be so correct -- Micro-Soft -- Source code -- Epilogue."},"targetAudience":{"@authority":"marctarget","#text":"adult"},"note":[{"@type":"statement of responsibility","#text":"Bill Gates."},"\"A Borzoi book\"--Title page verso.",{"@type":"biographical/historical","#text":"Bill Gates is a technologist, business leader, and philanthropist. In 1975, he cofounded Microsoft with his childhood friend Paul Allen and today he is chair of the Gates Foundation. Bill is the founder of Breakthrough Energy, an effort to commercialize clean energy and other climate-related technologies, and TerraPower, a company investing in developing groundbreaking nuclear technologies. He has three children."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"n-us---"}},{"@authority":"lcsh","topic":"Businesspeople","geographic":"United States","genre":"Biography"},{"@authority":"lcsh","topic":"Computer scientists","geographic":"United States","genre":"Biography"},{"@authority":"lcsh","topic":"Philanthropists","geographic":"United States","genre":"Biography"},{"@authority":"rvm","topic":"Gens d'affaires","geographic":"États-Unis","genre":"Biographies"},{"@authority":"rvm","topic":"Informaticiens","geographic":"États-Unis","genre":"Biographies"},{"@authority":"fast","topic":"Businesspeople"},{"@authority":"fast","topic":"Computer scientists"},{"@authority":"fast","topic":"Philanthropists"},{"@authority":"sears","topic":"Computer scientists","genre":"Biography"},{"@authority":"sears","topic":"Businessmen","genre":"Biography"},{"@authority":"sears","topic":"Philanthropists","genre":"Biography"},{"@authority":"sears","topic":"Computer software industry"},{"@authority":"fast","geographic":"United States"},{"@authority":"lcsh","name":{"@type":"corporate","namePart":"Microsoft Corporation"},"topic":"History"},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Gates, Bill,",{"@type":"date","#text":"1955-"}]},"topic":"Childhood and youth"},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Gates, Bill,",{"@type":"date","#text":"1955-"}],"nameIdentifier":"http://id.loc.gov/rwo/agents/n91008414"}}],"classification":[{"@authority":"lcc","#text":"HD9696.63.U62 G37427 2025"},{"@edition":"23/eng/20250120","@authority":"ddc","#text":"338.7/610053092 B"}],"relate