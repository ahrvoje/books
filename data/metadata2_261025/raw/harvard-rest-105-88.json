#text":"990004579560203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"@version":"3.8","titleInfo":{"title":"On the medieval origins of the modern state "},"name":{"@usage":"primary","@type":"personal","namePart":["Strayer, Joseph R. (Joseph Reese),",{"@type":"date","#text":"1904-1987"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"fast","#text":"History"}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nju"},{"@type":"text","@authority":"marccountry","#text":"New Jersey"}]},{"placeTerm":{"@type":"text","#text":"Princeton, N.J"}}],"issuance":"monographic","agent":{"namePart":"Princeton University Press"},"dateIssued":"2005","edition":"1st Princeton classic ed."},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"xxviii, 114 p. ; 22 cm."},"abstract":{"@type":"Review","#text":"\"The modern state, however we conceive of it today, is based on a pattern that emerged in Europe in the period from 1100 to 1600. Written out of the experience of a lifetime of teaching and research in the field, this short, clear book is the classic work on what is known about the early history of the European state. Joseph Strayer comments, in particular, on the significance of institutional developments for the administration of justice and finance. Charles Tilly's foreword shows how Strayer's book set the agenda for a whole generation of historical analysts, not just in medieval history but also in the comparative study of state formation.\"--BOOK JACKET."},"tableOfContents":{"@type":"Contents","#text":"Forewords -- Preface -- Chapter I -- III -- Index."},"note":[{"@type":"statement of responsibility","#text":"Joseph R. Strayer ; with new forewords by Charles Tilly and Wililam Chester Jordan."},"Originally published: Princeton, N.J. : Princeton University Press, 1970.",{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"e------"}},{"@authority":"lcsh","geographic":"Europe","topic":"Politics and government"},{"@authority":"lcsh","topic":"Middle Ages"},{"@authority":"lcsh","topic":["State, The","History"],"temporal":"To 1500"},{"@authority":"fast","temporal":"To 1500"}],"classification":[{"@authority":"lcc","#text":"JN7 .S7 2005"},{"@edition":"22","@authority":"ddc","#text":"320.1/1/094"}],"relatedItem":[{"titleInfo":{"title":"A Princeton classic edition"}},{"@type":"series","titleInfo":{"title":"Princeton classic editions"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990097948780203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0691121850 (pbk. : alk. paper)"},{"@type":"lccn","#text":"^^2005043957"},{"@type":"oclc","#text":"58831540"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"JN7 .S7 2005"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990097948780203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"009794878"}},"processingDate":"2025-12-09T05:43Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"050330"},"recordChangeDate":{"@encoding":"iso8601","#text":"20090713"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990097948780203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"titleInfo":{"title":"On the medieval origins of the modern state"},"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":["Strayer, Joseph R. (Joseph Reese)",{"@type":"date","#text":"1904-1987"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author."}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"fast","#text":"History"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nju"},{"@type":"text","@authority":"marccountry","#text":"New Jersey"}]},"dateIssued":{"@encoding":"marc","#text":"2016"},"copyrightDate":{"@encoding":"marc","#text":"2005"},"edition":"First Princeton Classics Edition.","issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Princeton :"}},"publisher":"Princeton University Press,","dateIssued":"2016."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xxviii, 114 pages ; 22 cm."},"abstract":{"@type":"Summary","#text":"\"This is a classic work on what is known about the early history of the European state. This short, clear book book explores the European state in its infancy, especially in institutional developments in the administration of justice and finance. Forewords from Charles Tilly and William Chester Jordan demonstrate the perennial importance of Joseph Strayer's book, and situate it within a contemporary context. Tilly demonstrates how Strayer's work has set the agenda for a whole generation of historical analysts, not only in medieval history but also in the comparative study of state formation. William Chester Jordan's foreword examines the scholarly and pedagogical setting within which Strayer produced his book, and how this both enhanced its accessibility and informed its focus on peculiarly English and French accomplishments in early state formation.\"--"},"tableOfContents":"Forewords -- Preface -- Chapter I -- Chapter II -- Chapter III -- Index.","targetAudience":{"@authority":"marctarget","#text":"specialized"},"note":[{"@type":"statement of responsibility","#text":"Joseph R. Strayer ; with forewords by Charles Tilly and William Chester Jordan."},{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"@authority":"fast","temporal":"To 1500"},{"@authority":"lcsh","topic":"Middle Ages"},{"@authority":"lcsh","topic":["State, The","History"]},{"@authority":"lcsh","topic":["State, The","Origin"]},{"@authority":"fast","topic":"Middle Ages"},{"@authority":"fast","topic":"Politics and government"},{"@authority":"fast","topic":"State, The"},{"@authority":"lcsh","geographic":"Europe","topic":"Politics and government"},{"@authority":"fast","geographic":"Europe"}],"classification":[{"@authority":"lcc","#text":"JN7 .S7 2016"},{"@edition":"23","@authority":"ddc","#text":"320.1/1094"}],"relatedItem":[{"titleInfo":{"title":"Princeton classics"}},{"@type":"series","titleInfo":{"title":"Princeton classics"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990146522270203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"9780691169330"},{"@type":"isbn","#text":"0691169330"},{"@type":"oclc","#text":"948442434"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"JN7 .S7 2016"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"H