n":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99158841849203941","processingDate":"2025-09-27T05:11Z"}},{"sets":null}],"recordInfo":{"recordCreationDate":{"@encoding":"marc","#text":"250912"},"recordChangeDate":{"@encoding":"iso8601","#text":"20250912"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99158841849203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"@version":"3.8","titleInfo":{"title":"The Russo-Ukrainian war "},"name":{"@usage":"primary","@type":"personal","namePart":"Plokhy, Serhii, 1957- author.","role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","originInfo":{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"xx"},{"@type":"text","@authority":"marccountry","#text":"No place, unknown, or undetermined"}]},"issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"}},"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99160521556803941/catalog"}},"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99160521556803941","processingDate":"2026-05-29T04:15Z"}},{"sets":null}],"recordInfo":{"recordCreationDate":{"@encoding":"marc","#text":"260122"},"recordChangeDate":{"@encoding":"iso8601","#text":"20260122"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99160521556803941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"@version":"3.8","titleInfo":{"title":"Ukraine's Maidan, Russia's war ","subTitle":"a chronicle and analysis of the revolution of dignity "},"name":[{"@usage":"primary","@type":"personal","namePart":"Wynnyckyj, Mychailo","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}],"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PCjxkVq8HYb8tCwQHcKFfG3"},{"@type":"personal","namePart":["Plokhy, Serhii,",{"@type":"date","#text":"1957-"}],"role":{"roleTerm":{"@type":"text","#text":"writer of introduction"}},"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJw4CvgHmVXXFjVyPrgVG3"}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"fast","#text":"History"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"gw"},{"@type":"text","@authority":"marccountry","#text":"Germany"}]},"dateIssued":{"@encoding":"marc","#text":"2019"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Stuttgart :"}},"agent":{"namePart":"Ibidem Verlag,","role":{"roleTerm":"publisher"}},"dateIssued":[2019]}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xix, 423 pages : illustrations ; 21 cm."},{"form":{"@type":"Illustrative content","#text":"illustration"}}],"abstract":{"@type":"Summary","#text":"\"In early 2014, sparked by an assault by their government on peaceful students, Ukrainians rose up against a deeply corrupt, Moscow-backed regime. Initially demonstrating under the banner of EU integration, the Maidan protesters proclaimed their right to a dignified existence; they learned to organize, to act collectively, to become a civil society. Most prominently, they established a new Ukrainian identity: territorial, inclusive, and present-focused with powerful mobilizing symbols. Driven by an urban \"bourgeoisie\" that rejected the hierarchies of industrial society in favor of a post-modern heterarchy, a previously passive post-Soviet country experienced a profound social revolution that generated new senses: \"Dignity\" and \"fairness\" became rallying cries for millions. Europe as the symbolic target of political aspiration gradually faded, but the impact (including on Europe) of Ukraine's revolution remained. When Russia invaded-illegally annexing Crimea and then feeding continuous military conflict in the Donbas-, Ukrainians responded with a massive volunteer effort and touching patriotism. In the process, they transformed their country, the region, and indeed the world. This book provides a chronicle of Ukraine's Maidan and Russia's ongoing war, and puts forth an analysis of the Revolution of Dignity from the perspective of a participant observer.\"--www.amazon.com."},"tableOfContents":{"@type":"Contents","#text":"Preface -- Introduction - Antecedents of revolution - Maidan becomes \"Sich\" - Descent into violence - Climax & recoil - War and reform - Making sense of the Maidan and russia's war - A national revolution - A bourgeois revolution - A post-modern revolution - Moving forward - Afterword."},"note":[{"@type":"statement of responsibility","#text":"Mychailo Wynnyckyj ; with a foreword by Serhii Plokhy."},{"@type":"bibliography","#text":"Includes bibliographical references (pages 375-423)."}],"subject":[{"geographicCode":[{"@authority":"marcgac","#text":"e-un---"},{"@authority":"marcgac","#text":"e-ru---"}]},{"@authority":"lcsh","topic":"Russo-Ukrainian War, 2014-"},{"@authority":"rvm","topic":"Guerre russo-ukrainienne, 2014-"},{"@authority":"fast","topic":"Diplomatic relations"},{"@authority":"gnd","topic":"Euromaidan"},{"@authority":"gnd","topic":"Aufstand"},{"@authority":"gnd","topic":"Invasion"},{"@authority":"gnd","topic":"Politischer Wandel"},{"@authority":"gnd","topic":"Russisch-Ukrainischer Krieg"},{"@authority":"lcsh","geographic":"Ukraine","topic":"History","temporal":"Revolution of Dignity, 2013-2014"},{"@authority":"lcsh","geographic":["Ukraine","Russia (Federation)"],"topic":"Foreign relations"},{"@authority":"lcsh","geographic":["Russia (Federation)","Ukraine"],"topic":"Foreign relations"},{"@authority":"lcsh","geographic":"Ukraine","topic":"Politics and government","temporal":"1991-2014"},{"@authority":"lcsh","geographic":"Ukraine","topic":"Politics and government","temporal":"2014-"},{"@authority":"lcsh","geographic":"Ukraine","topic":"History","temporal":"21st century"},{"@authority":"lcsh","geographic":"Ukraine","topic":"History","temporal":"20th century"},{"@authority":"rvm","geographic":"Ukraine","topic":"Histoire","temporal":"2013-2014 (Révolution de la dignité)"},{"@authority":"rvm","geographic":["Ukraine","Russie"],"topic":"Relations extérieures"},{"@authority":"rvm","geographic":"Ukraine","topic":"Histoire","temporal":"21e siècle"},{"@authority":"rvm","geographic":"Ukraine","topic":"Histoire","temporal":"20e siècle"},{"@authority":"fast","geographic":"Russia"},{"@authority":"fast","geographic":"Russia (Federation)"},{"@authority":"fast","geographic":"Ukraine"},{"@authority":"gnd","geographic":"Ukraine"},{"@authority":"gnd","geographic":"Russland"},{"@authority":"gnd","geographic":"Volksrepublik Donezk"},{"@authority":"gnd","geographic":"Volksrepublik Lugansk"},{"topic":"Revolution of Dignity"},{"@authority":"gnd","name":{"@type":"corporate","namePart":"Compagnie Rêvolution"}},{"@authority":"fast","temporal":"1900-2099"}],"classification":[{"@authority":"lcc","#text":"DK508.846 .W96 2019"},{"@authority":"lcc","#text":"DK5419 .W96 2019"},{"@edition":"23","@authority":"ddc","#text":"947.7086"}],"relatedItem":[{"titleInfo":{"title":"Ukrainian voices ","partNumber":"1"}},{"@type":"otherFormat","@otherType":"paperback version","@displayLabel":"paperback version","identifier":{"@type":"isbn","#text":"9783838213279"}},{"