{"pagination":{"maxPageableSet":"10000","numFound":5,"query":"name=Plokhy&limit=10&title=The Russo-Ukrainian War","limit":10,"start":0},"items":{"mods":[{"@version":"3.8","titleInfo":{"title":"David and Goliath ","subTitle":"Commentaries on the Russo-Ukrainian War"},"name":{"@usage":"primary","@type":"personal","namePart":"Plokhy, Serhii.","role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":{"@authority":"rdacontent","#text":"text"},"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"xx"},{"@type":"text","@authority":"marccountry","#text":"No place, unknown, or undetermined"}]},"dateIssued":{"@encoding":"marc","#text":"2026"},"issuance":"monographic","edition":"1st ed."},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Cambridge :"}},"agent":{"namePart":"Harvard University Press,","role":{"roleTerm":"publisher"}},"dateIssued":"2026."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marccategory","#text":"electronic resource"},{"@authority":"marcsmd","#text":"remote"},{"@type":"media","@authority":"rdamedia","#text":"computer"},{"@type":"carrier","@authority":"rdacarrier","#text":"online resource"}],"extent":"1 online resource (0 pages)"},"abstract":{"@type":"Summary","#text":"Ukraine's stubborn resistance to Russian invasion proves that it is possible to mount a successful defense against an enormously larger, better equipped enemy. David and Goliath collects short essays, commentaries, and interviews by Serhii Plokhy, the world's preeminent scholar of Ukrainian history, during the first two years of the war."},"tableOfContents":{"@type":"Contents","#text":"Intro -- Acknowledgments -- A Note on Transliteration -- Preface -- I. The Soviet Collapse -- 1. No End to History -- 2. The Collapse of the USSR Is Still Going On -- 3. Three Decades of Independence -- 4. Books on the War -- II. The Empire Returns -- 5. The Long Shadow -- 6. What Is Happening in Ukraine Is Crucial -- 7. Putin©s Revisionist History of Russia and Ukraine -- 8. Did Lenin Create Ukraine? -- 9. Ukraine©s Dangerous Independence -- III. The Big War -- 10. Appeasement -- 11. The Causes of the Russo-Ukrainian War -- 12. Putin©s War Is Banishing an Outdated Myth -- 13. Annexation -- 14. The Russian Coup -- IV. Nuclear Roulette -- 15. The Ghosts of Chernobyl -- 16. Who Is in Charge? -- 17. Nuclear Terrorism -- 18. Between a Rock and a Hard Place -- 19. Atoms for Peace and Atoms for War -- 20. Nuclear Plants Could Become Dirty Bombs -- 21. Hiroshima Diary -- V. The Western Alliance -- 22. Magical Thinking -- 23. Germany and Ukraine -- 24. Why the Delays? -- 25. Worrying Signs -- 26. The War That Neither Ukraine nor the West Can Afford to Lose -- 27. The Trump Card -- VI. Making Sense of War -- 28. Writing History as It Happens -- 29. Not Since World War II -- 30. Turning Back the Clock of History -- 31. The Zelensky Effect -- 32. The Sources of Russian Conduct -- 33. Decolonizing the Past -- 34. We Have to Make the Russians Think Differently -- References -- Index -- Чиста сторінка."},"note":"Description based on publisher supplied metadata and other sources.","subject":[{"@authority":"bisacsh","topic":"HISTORY / Europe / General"},{"@authority":"bisacsh","topic":"HISTORY / Russia / Post-Soviet"},{"@authority":"bisacsh","topic":"HISTORY / Wars & Conflicts / General"}],"classification":{"@authority":"ddc","#text":"947.7062"},"relatedItem":[{"titleInfo":{"title":"Harvard Series in Ukrainian Studies"}},{"@type":"otherFormat","identifier":{"@type":"isbn","#text":"0-674-30110-2"}},{"@type":"otherFormat","identifier":{"@type":"isbn","#text":"0-674-30109-9"}},{"@type":"series","titleInfo":{"title":"Harvard Series in Ukrainian Studies"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99158904021003941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0-674-30111-0"},{"@type":"isbn","#text":"0-674-30112-9"},{"@type":"oclc","#text":"1565285004"}],"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99158904021003941","processingDate":"2026-04-06T04:14Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda pn","recordContentSource":{"@authority":"marcorg","#text":"MiAaPQ"},"recordCreationDate":{"@encoding":"marc","#text":"260101"},"recordChangeDate":{"@encoding":"iso8601","#text":"20260101"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99158904021003941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"@version":"3.8","titleInfo":{"nonSort":{"@space":"preserve","#text":"The  "},"title":"Russo-Ukrainian war "},"name":{"@usage":"primary","@type":"personal","namePart":["Plokhy, Serhii,",{"@type":"date","#text":"1957-"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"rdacontent","#text":"still image"},{"@authority":"fast","#text":"History"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},"dateIssued":{"@encoding":"marc","#text":"2023"},"copyrightDate":{"@encoding":"marc","#text":"2023"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"London, UK :"}},"agent":{"namePart":"Allen Lane,","role":{"roleTerm":"publisher"}},"dateIssued":"2023."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xxii, 376 pages : maps ; 25 cm"},"abstract":{"@type":"Summary","#text":"On 24 February 2022, Russia stunned the world by launching an invasion of Ukraine. In the midst of checking on the family and friends who were now on the front lines of Europe's largest conflict since the outbreak of the Second World War, acclaimed Ukrainian-American historian Serhii Plokhy inevitably found himself attempting to understand the deeper causes of the invasion, analysing its course and contemplating the wider outcomes.The Russo-Ukrainian War is the comprehensive history of a conflict that has burned since 2014, and that, with Russia's attempt to seize Kyiv, exploded a geo-political order that had been cemented since the end of the Cold War. With an eye for the gripping detail on the ground, both in the halls of power and down in the trenches, as well as a keen sense of the grander sweep of history, Plokhy traces the origins and the evolution of the conflict, from the collapse of the Russian empire to the rise and fall of the USSR and on to the development in Ukraine of a democratic politics.Based on decades of research and his unique insight into the region, he argues that Ukraine's defiance of Russia, and the West's demonstration of unity and strength, has presented a profound challenge to Putin's Great Power ambition, and further polarized the world along a new axis. A riveting, enlightening account, this is present-minded history at its best."},"tableOfContents":{"@type":"Contents","#text":"Preface: making sense of war -- Imperial collapse -- Democracy and autocracy -- Nuclear implosion -- The new Eastern Europe -- The Crimean gambit -- The rise and fall of the New Russia -- Putin's war -- The gates of Kyiv -- Eastern Front -- The Black Sea -- The counteroffensive -- The return of the west -- The pivot to Asia -- Afterword: the new world order."},"targetAudience":{"@authority":"marctarget","#text":"adult"},"note":[{"@type":"statement of responsibility","#text":"Serhii Plokhy."},{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"geographicCode":[{"@authority":"marcgac","#text":"e-un---"},{"@authority":"marcgac","#text":"e-ru---"}]},{"@authority":"lcsh","topic":"Russian Invasion of Ukraine, 2022"},{"@authority":"lcsh","geographic":"Ukraine","topic":"History","temporal":"21st century"},{"@authority":"lcsh","geographic":["Ukraine","Russia (Federation)"],"topic":"Relations"},{"@authority":"lcsh","geographic":["Russia (Federation)","Ukraine"],"topic":"Relations"},{"@authority":"rvm","geographic":"Ukraine","topic":"Histoire","temporal":"2022- (Invasion russe)"},{"@authority":"rvm","geographic":"Ukraine","topic":"Histoire","temporal":"21e siècle"},{"@authority":"fast","geographic":"Ukraine"},{"topic":"21st Century history (Former Soviet Republics (Europe),Russia)"},{"topic":"Political science & theory (Former Soviet Republics (Europe),Russia)"},{"topic":"Military history (Former Soviet Republics (Europe),Russia)"},{"@authority":"fast","temporal":"Since 2022"}],"classification":[{"@authority":"lcc","#text":"DK508.852 .P645 2023"},{"@edition":"23","@authority":"ddc","#text":"947.7086"}],"relatedItem":[{"@type":"otherFormat","@otherType":"ebook version :","@displayLabel":"ebook version :","identifier":{"@type":"isbn","#text":"9781802061796"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99156767747703941/catalog"}}],"identifier":[{"@type":"isbn","#text":"9780241633526"},{"@type":"isbn","#text":"0241633524"},{"@type":"isbn","#text":"9780241617359"},{"@type":"isbn","#text":"0241617359"},{"@type":"isbn","@invalid":"yes","#text":"9781802061796"},{"@type":"oclc","#text":"1373823790"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard rep