":["bwb:9780374522667"],"title":"Adventures on the wine route","identifiers":{"librarything":["423789"],"goodreads":["41301"]},"last_modified":{"type":"/type/datetime","value":"2020-10-07T16:38:21.016542"},"created":{"type":"/type/datetime","value":"2009-03-02T13:23:55.037000"},"languages":[{"key":"/languages/eng"}],"isbn_10":["0374522669"],"publish_date":"1988","publish_country":"xxu","key":"/books/OL23133823M","authors":[{"key":"/authors/OL6597348A","name":"Kermit Lynch"}],"latest_revision":6,"publish_places":["New York"],"works":[{"key":"/works/OL13756112W"}],"type":{"key":"/type/edition"},"revision":6}},"OLID:OL26919750M":{"bib_key":"OLID:OL26919750M","info_url":"http://openlibrary.org/books/OL26919750M/Adventures_on_the_wine_route","preview":"noview","preview_url":"http://openlibrary.org/books/OL26919750M/Adventures_on_the_wine_route","thumbnail_url":"https://covers.openlibrary.org/b/id/13562923-S.jpg","details":{"other_titles":["Wine buyer's tour of France"],"subtitle":"a wine buyer's tour of France","description":{"type":"/type/text","value":"\"The newly designed twenty-fifth anniversary edition of the classic volume, brought up-to-date \"Wine is, above all, about pleasure. Those who make it ponderous make it dull. If you keep an open mind and take each wine on its own terms, there is a world of magic to discover.\" So wrote the renowned wine expert Kermit Lynch in the introduction to Adventures on the Wine Route, his ultimate tour of France, especially its wine cellars. The \"magic\" of wine is Lynch's subject as he takes the reader on a singular journey through the Loire, Bordeaux, the Languedoc, Provence, Northern and Southern Rhone, and Burgundy. In Adventures on the Wine Route, the wine lover will find wisdom without a trace of pretension and hype. As Victor Hazen wrote, \"In Kermit Lynch's small, true, delightful book there is more understanding about what wine really is than in everything else I have read.\" Praise for Lynch and for Adventures on the Wine Route has not ceased since the book's initial publication a quarter century ago. In 2007, The New York Times called it \"one of the finest American books on wine.\" And in June 2012, The Wall Street Journal proclaimed it \"the best book on the wine business.\" Full of vivid portraits of French vintners, memorable evocations of the French countryside, and, of course, vibrant descriptions of French wines, this new edition of Adventures on the Wine Route updates a modern classic for our times\"--"},"links":[{"url":"http://www.netread.com/jcusers2/bk1388/971/9780374100971/image/lgcover.9780374100971.jpg","title":"Cover image"}],"isbn_10":["0374100977"],"full_title":"Adventures on the wine route a wine buyer's tour of France","lc_classifications":["TP553 .L96 2013","TP553.L96 2013"],"key":"/books/OL26919750M","authors":[{"key":"/authors/OL948144A","name":"Kermit Lynch"}],"subjects":["Wine and wine making"],"languages":[{"key":"/languages/eng"}],"pagination":"x, 276 pages","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run05.mrc:10408191:4931","bwb:9780374100971","marc:marc_loc_2016/BooksAll.2016.part40.utf8:224943560:2663","marc:harvard_bibliographic_metadata/ab.bib.14.20150123.full.mrc:149504955:2794","amazon:0374100977"],"title":"Adventures on the wine route","lccn":["2013021679"],"notes":{"type":"/type/text","value":"With new epilogue.\n\nIncludes index."},"number_of_pages":276,"isbn_13":["9780374100971"],"edition_name":"25th anniversary edition.","dewey_decimal_class":["663/.200944"],"subject_places":["France"],"local_id":["urn:sfpl:31223101397652","urn:sfpl:31223101397553","urn:sfpl:31223101397538","urn:sfpl:31223101397520","urn:sfpl:31223101397546","urn:sfpl:31223101397579","urn:sfpl:31223101397561"],"publish_date":"2013","publish_country":"nyu","by_statement":"Kermit Lynch ; photographs by Gail Skoff","oclc_numbers":["827256592"],"works":[{"key":"/works/OL19706578W"}],"type":{"key":"/type/edition"},"covers":[13562923],