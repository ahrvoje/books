ersion":"3.8","titleInfo":{"title":"Unwired ","subTitle":"gaining control over addictive technologies "},"name":{"@usage":"primary","@type":"personal","namePart":"Bernstein, Gaia","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"lcgft","#text":"Self-help publications"},{"@authority":"rvmgf","#text":"Livres de croissance personnelle."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},"dateIssued":{"@encoding":"marc","#text":"2023"},"copyrightDate":{"@encoding":"marc","#text":"2023"},"issuance":"monographic"},{"@eventType":"publication","place":[{"placeTerm":{"@type":"text","#text":"Cambridge, United Kingdom ;"}},{"placeTerm":{"@type":"text","#text":"New York, NY :"}}],"agent":[{"namePart":"Cambridge University Press,","role":{"roleTerm":"publisher"}},{"namePart":"Cambridge University Press,","role":{"roleTerm":"publisher"}}],"dateIssued":"2023."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xiii, 233 pages ; 23 cm"},"abstract":{"@type":"Summary","#text":"\"Our society has a technology problem. Many want to disconnect from screens but can't help themselves. These days we spend more time online than ever. Some turn to self-help-measures to limit their usage, yet repeatedly fail, while parents feel particularly powerless to help their children. Unwired: Gaining Control over Addictive Technologies shows us a way out. Rather than blaming users, the book shatters the illusion that we autonomously choose how to spend our time online. It shifts the moral responsibility and accountability for solutions to corporations. Drawing lessons from the tobacco and food industries, the book demonstrates why government regulation is necessary to curb technology addiction. It describes a grassroots movement already in action across courts and legislative halls. Groundbreaking and urgent, Unwired provides a blueprint to develop this movement for change, to one that will allow us to finally gain control\"-- Provided by publisher."},"tableOfContents":{"@type":"Contents","#text":"The price of the illusion of control. Becoming the choice-makers ; Addiction, our children, our bonds ; Invisible chains -- Who are the choice-makers? Clouds of smoke ; The food wars ; The privacy phoenix ; Lessons from battling titans -- Fighting for choice. The art of redesign ; The tools of awareness ; The ground is burning ; The Achilles heel ; Acupuncture for change."},"note":[{"@type":"statement of responsibility","#text":"Gaia Bernstein."},{"@type":"bibliography","#text":"Includes bibliographical references (pages [183]-224) and index."}],"subject":[{"@authority":"lcsh","topic":"Internet addiction"},{"@authority":"lcsh","topic":"Social media addiction"},{"@authority":"lcsh","topic":"Video game addiction"},{"@authority":"lcsh","topic":"Compulsive gambling"},{"@authority":"rvm","topic":"Cyberdépendance"},{"@authority":"rvm","topic":["Médias sociaux","Comportement compulsif"]},{"@authority":"rvm","topic":["Jeux vidéo","Comportement compulsif"]},{"@authority":"rvm","topic":["Jeux de hasard","Comportement compulsif"]},{"@authority":"bisacsh","topic":"MEDICAL / Internal Medicine"},{"@authority":"fast","topic":"Compulsive gambling"},{"@authority":"fast","topic":"Internet addiction"},{"@authority":"fast","topic":"Social media addiction"},{"@authority":"fast","topic":"Video game addiction"}],"classification":[{"@authority":"lcc","#text":"RC569.5.I54 B47 2023"},{"@edition