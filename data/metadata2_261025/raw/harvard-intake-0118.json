{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Mlodinow&limit=10&title=Feynman's Rainbow","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":{"title":"Feynman's rainbow ","subTitle":"a search for beauty in physics and life "},"name":{"@usage":"primary","@type":"personal","namePart":["Mlodinow, Leonard,",{"@type":"date","#text":"1954-"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"biography"},{"@authority":"Medical Subject Headings","#text":"Autobiography"},{"@authority":"fast","#text":"Autobiographies"},{"@authority":"fast","#text":"Biographies"},{"@authority":"lcgft","#text":"Autobiographies"},{"@authority":"rvmgf","#text":"Autobiographies."}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"New York "}}],"dateIssued":[{"@encoding":"marc","#text":"2003"},"c2003"],"issuance":"monographic","agent":{"namePart":"Warner Books"}},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":{"@authority":"marcform","#text":"print"},"extent":"xiv, 171 p. ; 22 cm."},{"form":{"@type":"Illustrative content","#text":"illustration"}}],"abstract":{"@type":"Summary","#text":"For some, it was that special connection with a grandparent or a football coach, a boss, or a cleric. For a young physicist struggling to find his place in the world, the relationship that would most profoundly influence his life was with his mentor, the Nobel Prize-winning physicist Richard Feynman. Shares Feynman's provocative answers to such questions as \"What is the nature of creativity?\"--And \"How does a scientist think?\" At once a moving portrait of a friendship and an affecting account of Feynman's final, creative years, celebrates the inspiring legacy of one of the greatest thinkers of our time. Annotation. Academic scientist turned Hollywood screen writer, Mlodinow recounts his first year on the faculty at California Technical Institute, beginning in winter 1981, and his interactions there with renowned physicist Richard Feynman during his last years."},"note":[{"@type":"statement of responsibility","#text":"Leonard Mlodinow."},{"@type":"bibliography","#text":"Includes bibliographical references (page 173)."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"n-us---"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Mlodinow, Leonard,",{"@type":"date","#text":"1954-"}]}},{"@authority":"lcsh","name":{"@type":"personal","namePart":"Feynman, Richard Phillips."}},{"@authority":"lcsh","topic":"Physicists","geographic":"United States","genre":"Biography"},{"@authority":"mesh","topic":"Physics"}],"classification":[{"@authority":"lcc","#text":"QC16 .M635 A3 2003"},{"@edition":"21","@authority":"ddc","#text":"530/.092 B"}],"identifier":[{"@type":"isbn","#text":"044653045X"},{"@type":"lccn","#text":"^^2002031137"},{"@type":"oclc","#text":"50315076"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990091117570203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/000000046073724X","#text":"Cabot Science Library, Harvard University"},"shelfLocator":"QC16.M635 A3 2003"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Cabot Science"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990091117570203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"009111757"}},"processingDate":"2026-09-25T04:14Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc