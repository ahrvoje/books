type":"code","@authority":"marcrelator","#text":"http://id.loc.gov/vocabulary/relators/aut"}}]},"typeOfResource":"text","genre":"text","originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"xxk"},{"@type":"text","@authority":"marccountry","#text":"United Kingdom"}]},"dateIssued":{"@encoding":"marc","#text":"2013"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"London :"}},"publisher":"Palgrave Macmillan UK :","dateIssued":"2013."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marccategory","#text":"electronic resource"},{"@authority":"marcsmd","#text":"remote"},{"@type":"media","@authority":"","#text":"computer"},{"@type":"carrier","@authority":"","#text":"online resource"}],"extent":"1 online resource (207 p.)"},"abstract":{"@type":"Summary","#text":"From climate change over shale gas to the race for the Arctic, energy makes headlines in international politics almost daily. Thijs Van de Graaf argues that energy is in dire need of global governance. He traces the history of international energy cooperation from the notorious 'Seven Sisters' oil-companies cartel to the recent creation of the International Renewable Energy Agency (IRENA). He analyses how international institutions have been created for securing oil rents, coordinating consumer-countries' energy security policies, promoting producer-consumer dialogue, managing regional gas markets, and dealing with energy-related environmental externalities. Drawing on the emerging regime complexity literature, he constructs a novel analytical framework to explain the fragmented architecture of global energy governance, and studies prospects for institutional reform at the International Energy Agency (IEA) and the G8/G20."},"tableOfContents":"Introduction -- Energy and global governance -- Morphogenesis of the energy regime complex -- Interpreting the global energy architecture -- Adaptation at the core: reform of the IEA -- Diverging from the path: the creation of IRENA -- The G8 and G20 as energy steering committees? -- Conclusions.","note":[{"@type":"statement of responsibility","#text":"by Thijs Van de Graaf."},"Description based upon print version of record.",{"@type":"bibliography","#text":"Includes bibliographical references (pages 172-185) and index."},{"@type":"language","#text":"English"}],"subject":[{"@authority":"lcsh","topic":"International organization"},{"@authority":"lcsh","topic":"Environmental economics"},{"@authority":"lcsh","topic":"Environmental sociology"},{"@authority":"lcsh","topic":"Environmental policy"},{"@authority":"lcsh","topic":"Political sociology"},{"topic":"International Organization"},{"topic":"Environmental Economics"},{"topic":"Environmental Sociology"},{"topic":"Environmental Politics"},{"topic":"Environmental Geography"},{"topic":"Political Sociology"}],"classification":[{"@authority":"lcc","#text":"HD9502.A2 .G733 2013"},{"@authority":"ddc","#text":"333.79"}],"relatedItem":[{"titleInfo":{"title":"Energy, Climate and the Environment"}},null,null,null,null,{"@type":"series","titleInfo":{"title":"Energy, Climate and the Environment"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99154301572403941/catalog"}}],"identifier":[{"@type":"isbn","#text":"9781349457823"},{"@type":"isbn","#text":"1349457825"},{"@type":"isbn","#text":"9781137320735"},{"@type":"isbn","#text":"1137320737"},{"@type":"doi","#text":"10.1057/9781137320735"},{"@type":"oclc","#text":"862609291"},{"@type":"oclc","#text":"862371365"}],"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99154301572403941","processingDate":"2025-04-18T05:15Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","