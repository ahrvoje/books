/14)"}},{"@version":"3.8","titleInfo":{"title":"Borodino Field, 1812 and 1941 ","subTitle":"how Napoleon and Hitler met their matches outside Moscow "},"name":{"@usage":"primary","@type":"personal","namePart":"Kershaw, Robert,","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"rdacontent","#text":"still image"},{"@authority":"rdacontent","#text":"cartographic image"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},"dateIssued":{"@encoding":"marc","#text":"2021"},"copyrightDate":{"@encoding":"marc","#text":"2021"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Cheltenham :"}},"agent":{"namePart":"The History Press,","role":{"roleTerm":"publisher"}},"dateIssued":"2021."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"334 pages, 8 unnumbered pages of plates : illustrations (some color), maps (some color) ; 25 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Color content","#text":"polychrome"}},{"form":{"@type":"Illustrative content","#text":"map"}}],"abstract":{"@type":"Summary","#text":"\"The Battle of Borodino resonates with the patriotic soul of Mother Russia. The epic confrontation in September 1812 was the single bloodiest day of the Napoleonic Wars, leaving France's Grande Armee limping to the gates of Moscow and on to catastrophe in snow and ice. Generations later, in October 1941, an equally bitter battle was fought at Borodino. This time Hitler's SS and Panzers came up against elite Siberian troops defending Stalin's Moscow. Remarkably, both conflicts took place in the same woods and gullies that follow the sinuous line of the Koloch River. Borodino Field relates the gruelling experience of the French army in Russia, juxtaposed with the personal accounts, diaries and letters of SS and Panzer soldiers during the Second World War.\""},"note":[{"@type":"statement of responsibility","#text":"Robert Kershaw."},{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"@authority":"lcsh","topic":"Borodino, Battle of, Borodino, Mozhaĭskiĭ raĭon, Russia, 1812"},{"@authority":"lcsh","topic":["World War, 1939-1945","Campaigns"],"geographic":["Russia (Federation)","Borodino"]},{"@authority":"rvm","topic":"Bataille de la Moskova, Borodino, Mozhayskiy, Russie, 1812"},{"@authority":"fast","@href":"(OCoLC)fst01710190","topic":"Military campaigns"},{"@authority":"fast","@href":"(OCoLC)fst01313370","geographic":["Russia (Federation)","Borodino (Mozhaĭskiĭ raĭon)"]},{"@authority":"fast","temporal":"1812-1945"}],"classification":[{"@authority":"lcc","#text":"DC235.5.B7 K47 2021"},{"@edition":"23","@authority":"ddc","#text":"940.27"}],"identifier":[{"@type":"isbn","#text":"9780750995955"},{"@type":"isbn","#text":"0750995955"},{"@type":"oclc","#text":"1222807606"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99155749839203941/catalog"}},"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99155749839203941","processingDate":"2026-09-01T18:31Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"UKMGB"},"recordCreationDate":{"@encoding":"marc","#text":"200820"},"recordChangeDate":{"@encoding":"iso8601","#text":"20260827"},"r