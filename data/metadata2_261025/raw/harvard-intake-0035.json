[{"@encoding":"marc","#text":"2008"},"c2008"],"issuance":"monographic","agent":{"namePart":"Films for the Humanities & Sciences"}},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":{"@authority":"gmd","#text":"videorecording "},"extent":"1 videodisc (61min.) : sd., col. ; 4 3/4 in."},{"form":{"@type":"Material base and configuration","#text":"plastic"}},{"extent":"4 3/4 in."},{"form":{"@type":"Type of recording","#text":"digital"}}],"abstract":{"@type":"Summary","#text":"\"Do most people get their values from their parents or from society at large? At what age, and with what tools do children begin to work out what is right and wrong? Can young children distinguish between actions that are morally deviant and those that simply violate a social convention? This program explores those questions by observing a group of 25 six-year olds and the varying levels of honesty and compassion they display\"--Container."},"note":[{"@type":"statement of responsibility","#text":"Films for the Humanities & Sciences, BBC Education & Training ; co-production BBC/The Open University ; produced and directed by Rob Gill and David Berry ; series producer, Dinah Lord."},{"@type":"system details","#text":"DVD-R."},{"@type":"language","#text":"Closed-captioned."},{"@type":"performers","#text":"Presenter, Professor Robert Winston."},{"@type":"creation/production credits","#text":"Photography, Chris Hartley, Ian Salvage ; title music, Elizabeth Parker ; editor, Ben Stark."},"Subtitle from disc surface and container.","Originally produced in 2006.","\"BBC Active\"--Container."],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"e-uk---"}},{"@authority":"lcsh","topic":"Films for hard of hearing people"},{"@authority":"lcsh","topic":"Moral development"},{"@authority":"lcsh","topic":"Identity (Psychology)"},{"@authority":"lcsh","topic":"Socialization"},{"@autho