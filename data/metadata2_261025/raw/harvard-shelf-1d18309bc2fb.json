:"isbn","#text":"0903760010"},{"@type":"oclc","#text":"2814046"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"Phil2905.1.475 vol.7"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990007423620203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"000742362"}},"processingDate":"2025-05-12T05:13Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"PKT"},"recordCreationDate":{"@encoding":"marc","#text":"770318"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990007423620203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}},{"titleInfo":{"title":"Chance and necessity","subTitle":"an essay on the natural philosophy of modern biology"},"name":[{"@usage":"primary","@type":"personal","namePart":"Monod, Jacques","role":{"roleTerm":{"@type":"text","#text":"creator"}}},{"@type":"personal","namePart":"Wainhouse, Austryn","role":{"roleTerm":{"@type":"text","#text":"translator."}}}],"typeOfResource":"text","genre":{"@authority":"marcgt","#text":"bibliography"},"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"New York"}}],"publisher":"Knopf","dateIssued":"1971","edition":["1st American ed."],"issuance":"monographic"},"language":[{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"fre"}}],"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"xiv, 198 p. illus. 22 cm."},"abstract":{"@type":"Summary","#text":"\"A philosophical statement whose explicit intention is to sweep away as both false and dangerous the 'animist' conception of man that has dominated virtually all Western world views from those of primitive cultures to those of dialectical materialists. Monod bases his argument on the evidence of modern biology, which shows, indisputably, that man is the product of chance genetic mutation. He draws upon what we now know about genetic structure (and on what we can theorize) to suggest an entirely new way of looking at ourselves. He argues that objective scientific knowledge, the only knowledge we can rely on, denies the concepts of destiny or evolutionary purpose that underlie traditional philosophies; and he contends that the persistence of those concepts is responsible for the intensifying schizophrenia of a world that accepts, and lives by, the fruits of science while refusing to face its momentous moral implications\"--Publisher description."},"tableOfContents":"1. Of strange objects -- 2. Vitalisms and animisms -- 3. Maxwell's demons -- 4. Microscopic cybernetics -- 5. Molecular ontogenesis -- 6. Invariance and perturbations -- 7. Evolution -- 8. The frontiers -- 9. The kingdom and the darkness.","note":[{"@type":"statement of responsibility","#text":"Translated from the French by Austryn Wainhouse."},"Translation of Le hasard et la nécessité.",{"@type":"bibliography","#text":"Includes bibliographical references."}],"subject":[{"@authority":"lcsh","topic":["Biology","Philosophy"]},{"@authority":"mesh","topic":"Biology"},{"@authority":"mesh","topic":"Philosophy"}],"classification":[{"@authority":"lcc","#text":"QH331 .M55313 1971"},{"@authority":"nlm","#text":"QH 331 M75lh 1971"},{"@authority":"ddc","#text":"574/.01"}],"relatedItem":[{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":