51356040203941/catalog"}}],"identifier":{"@type":"oclc","#text":"23118091"},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000123374118","#text":"Baker Library, Harvard Business School, Harvard University"},"shelfLocator":"WACD W242"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Baker Business"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990051356040203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"005135604"}},"processingDate":"2025-05-21T05:17Z"}},{"sets":null}],"recordInfo":{"recordContentSource":{"@authority":"marcorg","#text":"VA@"},"recordCreationDate":{"@encoding":"marc","#text":"910219"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990051356040203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}},{"titleInfo":{"title":"Thomas J Green to James Gadsden Introducing Mr. Robert Rose as a businessman connected with building the Atlantic and Pacific Railroad, of which Gadsden is an advocate, 12 October 1853"},"name":[{"@usage":"primary","@type":"personal","namePart":["Green, Thomas J., (Thomas Jefferson)",{"@type":"date","#text":"1802-1863"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author."}}]},{"@type":"corporate","namePart":"Gilder Lehrman Institute of American History","role":{"roleTerm":{"@type":"text","#text":"owner."}}}],"typeOfResource":"text","genre":[{"@authority":"rdacontent","#text":"text"},{"@authority":"fast","#text":"Correspondence"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"xx"},{"@type":"text","@authority":"marccountry","#text":"No place, unknown, or undetermined"}]},"dateIssued":{"@encoding":"marc","#text":"1853"},"issuance":"monographic"},{"@eventType":"production","place":{"placeTerm":{"@type":"text","#text":"[Place of production not identified :"}},"publisher":"producer not identified,","dateOther":{"@type":"production","#text":"1853]"}}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"extent":"1 online resource.","form":[{"@type":"media","@authority":"rdamedia","#text":"computer"},{"@type":"carrier","@authority":"rdacarrier","#text":"online resource"}]},"abstract":{"@type":"Summary","#text":"Introduces Mr. Robert Rose, who is hand delivering this letter, as a businessman connected with building the Atlantic and Pacific Railroad, of which Gadsden is an advocate. Writes that if Gadsden is successful in securing a treaty with Mexico for Sonora, he should insist upon 30 degrees north latitude from the Rio Grande to the Gulf of California. He says that the land is rich in silver, is closer to a Chinese trading post, and will be accessible by railroad. Encloses a letter for Hon. Robert J. Walker regarding the Pacific road (not included). Imprint in the upper left corner reads O & H."},"note":["Collection: The Gilder Lehrman Collection, 1493-1859.","Gadsden was a railroad promoter and advocated a Southern rail system, the purpose of which would be to control the trade of the South and the West, thereby freeing those regions from their dependency on the North. To further this end he promoted Southern commercial conventions, and at a convention in 1845 he boldly urged the construction of a railroad to the Pacific. In 1853, when Jefferson Davis was Secretary of War in Pierce's cabinet, Gadsden was appointed minister to Mexico to negotiate for territory along the border. The result was the Gadsden Purchase. He was recalled in 1856 for exceeding his instructions. Green served in the First Senate of California and sponsored the bill creating the University of California. He later became major general of the California militia. Walker, a grandson-in-law of Benjamin Franklin, was Polk's Secretary of the Treasury and later Governor of the Kansas Territory.",{"@type":"original location","#text":"Gilder Lehrman Institute of American History"}],"subject":[{"@authority":"fast","name":{"@type":"personal","namePart":["Gadsden, James",{"@type":"date","#text":"1788-1858"}]}},{"@authority":"fast","name":{"@type":"personal","namePart":["Green, Thomas J. (Thomas Jefferson)",{"@type":"date","#text":"1802-1863"}]}},{"@authority":"fast","name":{"@type":"personal","namePart":["Walker, Robert J. (Robert John)",{"@type":"date","#text":"1801-1869"}]}},{"@authority":"fast","topic":"American statesmen"},{"@authority":"fast","topic":"Boundary disputes"},{"@authority":"fast","topic":"Civics"},{"@authority":"fast","topic":"Commerce"},{"@authority":"fast","topic":"Diplomacy"},{"@authority":"fast","topic":"Emigration and immigration"},{"@authority":"fast","topic":"Industries"},{"@authority":"fast","topic":"Merchants"},{"@authority":"fast","topic":"Military history"},{"@authority":"fast","topic":"Mines and mineral resources"},{"@authority":"fast","topic":"Politics and government"},{"@authority":"fast","topic":"Railroads"},{"@authority":"fast","topic":"Transportation"},{"@authority":"fast","topic":"Treaties"},{"@authority":"fast","geographic":"South America"},{"@authority":"fast","geographic":"West United States"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99157622479703941/catalog"}},"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99157622479703941","processingDate":"2024-04-20T05:12Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"UkMbAM-D"},"recordCreationDate":{"@encoding":"marc","#text":"231013"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99157622479703941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21