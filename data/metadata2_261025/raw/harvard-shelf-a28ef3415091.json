{"pagination":{"maxPageableSet":"10000","numFound":2,"query":"name=Lieberman&limit=10&title=Strange Parallels","limit":10,"start":0},"items":{"mods":[{"titleInfo":{"title":"Strange parallels","subTitle":"Southeast Asia in global context, c 800-1830"},"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":["Lieberman, Victor B.",{"@type":"date","#text":"1945-"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"fast","#text":"History"}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},{"placeTerm":{"@type":"text","#text":"Cambridge, UK"}},{"placeTerm":{"@type":"text","#text":"New York"}}],"publisher":"Cambridge University Press","dateIssued":["2003-",{"@encoding":"marc","@point":"start","#text":"2003"},{"@encoding":"marc","@point":"end","#text":"9999"}],"issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"2 v. ; 24 cm."},"abstract":{"@type":"Summary","#text":"This ambitious work has two novel goals: to overcome the extreme fragmentation of early Southeast Asian historiography, and to connect Southeast Asian to world history. Combining careful local research with wide-ranging theory Lieberman argues that over a thousand years, each of mainland Southeast Asia's great lowland corridors experienced a pattern of accelerating integration punctuated by recurrent collapse. These trajectories were synchronized not only between corridors, but most curiously, between the mainland as a whole, much of Europe, and other sectors of Eurasia. He describes in detail the nature of mainland consolidation - which was simultaneously territorial, religious, ethnic, and commercial - and dissects the mix of endogenous and external factors responsible. Here, then, is a fundamentally original analysis not only of Southeast Asia, but of the pre-modern world."},"tableOfContents":"v. 1. Integration on the mainland -- v. 2. Mainland mirrors, Euope, Japan, China, South Asia, and the islands.","note":[{"@type":"statement of responsibility","#text":"Victor Lieberman."},{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"as-----"}},{"@authority":"swd","temporal":"Geschichte 800-1830"},{"@authority":"lcsh","geographic":"Southeast Asia","topic":"Historiography"},{"@authority":"lcsh","geographic":"Southeast Asia","topic":"History"}],"classification":[{"@authority":"lcc","#text":"DS524.4 .L54 2003"},{"@edition":"21","@authority":"ddc","#text":"959"}],"relatedItem":[{"titleInfo":{"title":"Studies in comparative world history"}},{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":{"title":"Strange parallels"},"name":{"namePart":"Lieberman, Victor B., 1945-"},"originInfo":{"publisher":"New York : Cambridge University Press, 2003-"},"identifier":{"@type":"local","#text":"(OCoLC)252482354"}},{"@type":"series","titleInfo":{"title":"Studies in comparative world history"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990092085150203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0521800862 (v.1)"},{"@type":"isbn","#text":"0521804965 (pbk.)"},{"@type":"isbn","#text":"9780521530361 (v. 2 : pbk.)"},{"@type":"lccn","#text":"^^2002071481"},{"@type":"oclc","#text":"49820972"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000121790804","#text":"Harvard-Yenching Library, Harvard University"},"shelfLocator":"DS524.4 .L54 2003"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type"