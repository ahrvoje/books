{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Harman&limit=10&title=Mind Your Own Business","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":{"title":"Mind your own business "},"name":{"@usage":"primary","@type":"personal","namePart":["Harman, Sidney,",{"@type":"date","#text":"1918-"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"biography"},{"@authority":"fast","#text":"Autobiographies"},{"@authority":"fast","#text":"Biographies"},{"@authority":"fast","#text":"History"},{"@authority":"lcgft","#text":"Autobiographies"}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"New York "}}],"issuance":"monographic","agent":{"namePart":"Currency/Doubleday"},"dateIssued":"2003","edition":"1st U.S. ed."},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"xii, 196 p. ; 22 cm."},"abstract":{"@type":"Summary","#text":"\"In Mind Your Own Business, Harman shares his visionary ideas about leadership, providing a welcome contrast to the bad behavior of business leaders recently dominating the news. Harman focuses on creating a culture of personal responsibility throughout his company. He likens his top management team to a jazz quartet that listens to and improvises with one another to create harmony. He stresses the need to do more for workers at every level because employees are the company’s most valuable asset. At Harman International, he has established in-house classrooms to teach English, basic math, health, and music, and encourages his employees to pursue their potential.\"--Page 2 of cover."},"tableOfContents":{"@type":"Contents","#t