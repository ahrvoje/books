{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Jannetta&limit=10&title=The Vaccinators","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":[{"nonSort":{"@space":"preserve","#text":"The  "},"title":"vaccinators ","subTitle":"smallpox, medical knowledge, and the \"opening\" of Japan "},{"@type":"uniform","title":"University press scholarship online"}],"name":{"@usage":"primary","@type":"personal","namePart":["Jannetta, Ann Bowman,",{"@type":"date","#text":"1932-"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"fast","#text":"History"}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"cau"},{"@type":"text","@authority":"marccountry","#text":"California"}]},{"placeTerm":{"@type":"text","#text":"Stanford, Calif"}}],"dateIssued":[{"@encoding":"marc","#text":"2007"},"c2007"],"issuance":"monographic","agent":{"namePart":"Stanford University Press"}},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":{"@authority":"marcform","#text":"print"},"extent":"xviii, 245 p. : ill., maps ; 24 cm."},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Illustrative content","#text":"map"}}],"abstract":{"@type":"Summary","#text":"\"In Japan, as late as the mid-nineteenth century, smallpox claimed the lives of an estimated 20 percent of all children born - most of them before the age of five. When the apathetic Tokugawa shogunate failed to respond to this health crisis, Japanese physicians, learned in Western medicine and medical technology, became the primary disseminators of Jennerian vaccination - a new medical technology to prevent smallpox. Tracing its origins from rural England, Jannetta investigates the transmission of Jennerian vaccination, via various foreign and domestic networks, to and throughout pre-Meiji Japan. Relying on Dutch, Japanese, Russian, and English sources, the book treats Japanese physicians as leading agents of social and institutional change, showing how they used traditional strategies involving scholarship, marriage, and adoption to forge new local, national, and international networks in the first half of the nineteenth century. With an interesting parallel to the recent SARS crisis, The Vaccinators details the appalling cost of Japan's almost three-hundred-year isolation and examines in depth a nation on the cusp of political and social upheaval.\" --Book Jacket."},"tableOfContents":{"@type":"Contents","#text":"Confronting smallpox -- Jenner's cowpox vaccine -- Engaging the periphery -- The Dutch connection: Batavia, Nagasaki, and Edo -- Constructing a network: the Ranpo physicians -- The vaccinators -- Engaging the center."},"note":[{"@type":"statement of responsibility","#text":"Ann Jannetta."},{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"a-ja---"}},{"@authority":"mesh","topic":"Social Change"},{"@authority":"mesh","topic":"Smallpox"},{"@authority":"mesh","topic":"Smallpox Vaccine"},{"@authority":"mesh","topic":["Social Change","history"]},{"@authority":"mesh","topic":["Smallpox","history"]},{"@authority":"mesh","topic":"History, 19th Century"},{"@authority":"mesh","topic":"Diffusion of Innovation"},{"@authority":"mesh","topic":["Smallpox Vaccine","history"]},{"@authority":"mesh","geographic":"Japan"},{"@authority":"lcsh","topic":["Smallpox","Vaccination","History"],"geographic":"Japan"},{"@authority":"lcsh","topic":["Smallpox vaccine","History"],"geographic":"Japan"},{"@authority":"lcsh","topic":["Smallpox","History"],"geographic":"Japan"},{"@authority":"mesh","geographic":"Japan"},{"@authority":"mesh","topic":["Smallpox Vaccine","history"],"geographic":"Japan"},{"@authority":"mesh","t