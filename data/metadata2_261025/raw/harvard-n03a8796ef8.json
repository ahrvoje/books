{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Sivers&limit=10&title=Anything You Want","limit":10,"start":0},"items":{"mods":{"titleInfo":{"title":"Anything you want","subTitle":"40 lessons for a new kind of entrepreneur"},"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":"Sivers, Derek","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author."}}]},"typeOfResource":"text","genre":{"@authority":"rdacontent","#text":"text"},"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nz"},{"@type":"text","@authority":"marccountry","#text":"New Zealand"}]},"dateIssued":{"@encoding":"marc","#text":"2021"},"copyrightDate":{"@encoding":"marc","#text":"2021"},"edition":"Third edition.","issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"[Wellington] :"}},"publisher":"[Derek Sivers],","dateIssued":"2021."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"86 pages ; 21 cm"},"abstract":{"@type":"Summary","#text":"You started a business. But why? Entrepreneurs often lose sight of what matters. Are you helping people? Are they happy? Are you happy? Are you profitable? Isn't that enough?Derek Sivers accidentally started a business by helping musicians sell their music. It became the largest online seller of independent music with over 150,000 musicians and $100M in sales. After ten years, he sold the company for $22 million and gave all the money to charity. In \"Anything You Want\" he shares 40 powerful lessons, in a book you can read in about an hour."},"note":{"@type":"statement of responsibility","#text":"