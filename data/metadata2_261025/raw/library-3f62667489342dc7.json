tomorrow.","pagenum":"","type":{"key":"/type/toc_item"}}],"isbn_10":["0801870372"],"subject_place":["United States"],"dewey_decimal_class":["142/.78/0973"],"covers":[567143],"lc_classifications":["B944.E94 C68 2003","B944.E94C68 2002"],"key":"/books/OL3939710M","authors":[{"key":"/authors/OL719661A","name":"George Cotkin"}],"publish_places":["Baltimore"],"subjects":["Existentialism -- United States -- History -- 20th century.","Philosophy, American -- 20th century."],"subject_time":["20th century."],"pagination":"x, 359 p. :","uri_descriptions":["Contributor biographical information","Table of contents","Publisher description"],"source_records":["marc:marc_openlibraries_phillipsacademy/PANO_FOR_IA_05072019.mrc:78579644:1708","ia:existentialameri0000cotk","bwb:9780801870378","marc:marc_loc_2016/BooksAll.2016.part28.utf8:193295991:1545","marc:marc_columbia/Columbia-extract-20221130-007.mrc:404351444:3868","marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:32952164:3153","marc:harvard_bibliographic_metadata/20220215_026.bib.mrc:118270693:3928"],"title":"Existential America","lccn":["2001007186"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. [285]-328) and index."},"number_of_pages":359,"languages":[{"key":"/languages/eng"}],"url":["http://www.loc.gov/catdir/bios/jhu051/2001007186.html","http://www.loc.gov/catdir/toc/jhu051/2001007186.html","http://www.loc.gov/catdir/description/jhu051/2001007186.html"],"local_id":["urn:phillips:31867001385660"],"publish_date":"2003","publish_country":"mdu","by_statement":"George Cotkin.","works":[{"key":"/works/OL3946408W"}],"type":{"key":"/type/edition"},"uris":["http://www.loc.gov/catdir/bios/jhu051/2001007186.html","http://www.loc.gov/catdir/toc/jhu051/2001007186.html","http://www.loc.gov/catdir/description/jhu051/2001007186.html"],"oclc_numbers":["48507579"],"description":{"type":"/type/text","value":"\"In Existential America, historian George Cotkin argues that the existential approach to life, marked by vexing despair and dauntless commitment in the face of uncertainty, has deep American roots and helps to define the United States in the twentieth century in ways that have never been fully realized or appreciated.\".\n\n\"As Cotkin shows, not only did Americans readily take to existentialism, but they were already heirs to a rich tradition of thinkers - from Jonathan Edwards and Herman Melville to Emily Dickinson and William James - who had wrestled with the problems of existence and the contingency of the world long before Sartre and his colleagues.\n\nAfter introducing the concept of an American existential tradition, Cotkin examines how formal existentialism first arrived in America in the 1930s through discussion of Kierkegaard and the early vogue among New York intellectuals for the works of Sartre, Beauvoir, and Camus.\n\nCotkin then traces the evolution of existentialism in America: its adoption by Richard Wright and Ralph Ellison to help articulate the African-American experience; its expression in the works of Norman Mailer and photographer Robert Frank; its incorporation into the tenets of the feminist and radical student movements of the 1960; and its lingering presence in contemporary American thought and popular culture, particularly in such films as Crimes and Misdemeanors, Fight Club, and American Beauty.\".\n\n\"The only full-length study of existentialism in America, this engaging and original work provides an invaluable guide to the history of American culture since the end of the Second World War.\"--BOOK JACKET."},"latest_revision":16,"revision":16,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-12-19T22:53:53.723876"}}},"OLID:OL26814407M":{"bib_key":"OLID:OL26814407M","info_url":"http://openlibrary.org/books/OL26814407M/Existential_America","preview":"noview","preview_url":"http://openlibrary.org/books/OL26814407M/Existential_America","thumbnail_url":"https://covers.openlibrary.org/b/id/8472597-S.jpg","details":{"publishers":["Johns Hopkins University Press"],"lc_classifications":["B819"],"source_records":["amazon:0801882001","bwb:9780801882005"],"title":"Existential America","number_of_pages":368,"last_modified":{"type":"/type/datetime","value":"2020-10-08T17:16:36.648026"},"covers":[8472597],"created":{"type":"/type/datetime","value":"2019-03-27T11:39:27.156444"},"isbn_13":["9780801882005"],"full_title":"Existential America","isbn_10":["0801882001"],"publish_date":"Apr 29, 2005","key":"/books/OL26814407M","authors":[{"key":"/authors/OL7488185A","name":"George Cotkin"}],"latest_revision":3,"works":[{"key":"/works/OL19358071W"}],"type":{"key":"/type/edition"},"revision":3}}}}