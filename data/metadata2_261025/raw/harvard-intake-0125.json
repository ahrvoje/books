"role":{"roleTerm":"publisher"}},"dateIssued":[2019]}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"ger"},{"@type":"text","@authority":"iso639-2b","#text":"German"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"770 pages : illustrations (some color), facsimiles, maps, plans, portraits ; 23 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Illustrative content","#text":"map"}},{"form":{"@type":"Illustrative content","#text":"facsimile"}},{"form":{"@type":"Illustrative content","#text":"plan"}},{"form":{"@type":"Illustrative content","#text":"portrait"}},{"form":{"@type":"Color content","#text":"polychrome"}}],"abstract":{"@type":"Summary","#text":"Unter der Fragestellung \"Absolutely Free\"? ist die Jubiläumsschrift für den Kunsthistoriker Jürgen Wiener aus interdisziplinärer Perspektive der Produktion, Rezeption, Gestaltung und Wahrnehmung von Kunst gewidmet. Die Spanne der Aufsätze reicht von der Einheit und Vielfalt in der karolingischen Kunst über Spitzwegs Bildformate bis zur Konstruktion von (Kunst-)Geschichte bei Damien Hirst, von mittelalterlichen Stickereien über Berninis Tierdarstellungen am Vierströmebrunnen bis zu einem Plädoyer für Polyrhythmik in der zeitgenössischen Geschichtsschreibung nach dem Vorbild Frank Zappas."},"note":[{"@type":"statement of responsibility","#text":"Christof Baier, Sarah Czirr, Astrid Lang, Gina Möller, Wiebke Windorf (Hg.)."},{"@type":"bibliography","#text":"Includes bibliographical references."}],"subject":[{"@authority":"lcsh","topic":["Art","History"]},{"@authority":"rvm","topic":["Art","Histoire"]},{"@authority":"aat","topic":"art history"},{"@authority":"fast","topic":"Art"}],"classification":[{"@authority":"lcc","#text":"N5300 .A27 2019"},{"@edition":"23/ger/20230216","@autho