9-177538-X"}},{"@type":"series","titleInfo":{"title":"Very short introductions"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99153583920503941/catalog"}}],"identifier":[{"@type":"isbn","#text":"1-4294-8713-5"},{"@type":"isbn","#text":"1-280-76257-8"},{"@type":"isbn","#text":"0-19-151652-X"},{"@type":"lccn","@invalid":"yes","#text":"2006000590"},{"@type":"oclc","#text":"609831064"},{"@type":"oclc","#text":"960199160"}],"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99153583920503941","processingDate":"2026-09-13T04:12Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":["aacr","rda pn"],"recordContentSource":{"@authority":"marcorg","#text":"MiAaPQ"},"recordCreationDate":{"@encoding":"marc","#text":"060117"},"recordChangeDate":{"@encoding":"iso8601","#text":"20200520"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99153583920503941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"@version":"3.8","titleInfo":[{"title":"Global interests ","subTitle":"Renaissance art between East and West "},{"@type":"alternative","title":"Renaissance art between East and West"}],"name":[{"@usage":"primary","@type":"personal","namePart":"Jardine, Lisa.","role":{"roleTerm":{"@type":"text","#text":"creator"}}},{"@type":"personal","namePart":"Brotton, Jerry."}],"typeOfResource":"text","genre":{"@authority":"marcgt","#text":"bibliography"},"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"Ithaca, N.Y"}}],"issuance":"monographic","agent":{"namePart":"Cornell University Press"},"dateIssued":"2000"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":{"@authority":"marcform","#text":"print"},"extent":"223 p. : ill. (some col.) ; 24 cm."},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Color content","#text":"polychrome"}}],"abstract":{"@type":"Review","#text":"\"Lisa Jardine and Jerry Brotton raise questions about the formation of cultural identity in Western Europe. Through an analysis of the circulation of art and luxury objects, the authors challenge the view that Renaissance culture defined itself in large part against an exotic, dangerous, always marginal East. Featuring more than seventy illustrations, including many in color and some published for the first time, their book provides fascinating insights into the works of Leonardo da Vinci, Durer, Holbein, Pisanello, and Titian.\"--Jacket."},"tableOfContents":{"@type":"Contents","#text":"Exchanging identity: Breaching the boundaries of Renaissance Europe -- Telling tapestries: Fabricating narratives of conquest -- Managing the infidel: Equestrian art on its mettle."},"note":[{"@type":"statement of responsibility","#text":"Lisa Jardine and Jerry Brotton."},"Originally published in Great Britain in 2000 by Reaktion Books, London.",{"@type":"bibliography","#text":"Includes bibliographical references (p. 215-218) and index."}],"subject":[{"geographicCode":[{"@authority":"marcgac","#text":"a-tu---"},{"@authority":"marcgac","#text":"e------"}]},{"@authority":"lcsh","topic":"Renaissance"},{"@authority":"lcsh","topic":"Art, Renaissance"},{"@authority":"lcsh","topic":"Art, Ottoman"},{"@authority":"lcsh","topic":"Material culture","geographic":"Europe"},{"@authority":"lcsh","geographic":"Europe","topic":["Civilization","Turkish influences"]},{"@authority":"lcsh","geographic":"Turkey","topic":["Civilization","European influences"]},{"@authority":"swd","temporal":"Geschichte 1420-1600"}],"classifica