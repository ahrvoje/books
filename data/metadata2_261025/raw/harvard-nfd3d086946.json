{"pagination":{"maxPageableSet":"10000","numFound":970,"query":"name=King&limit=10&title=On Writing","limit":10,"start":0},"items":{"mods":[{"titleInfo":{"title":"On writing","subTitle":"a memoir of the craft"},"name":{"@usage":"primary","@type":"personal","namePart":["King, Stephen",{"@type":"date","#text":"1947-"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"biography"},{"@authority":"fast","#text":"Biographies"}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"New York"}}],"publisher":"Scribner","dateIssued":["c2000",{"@encoding":"marc","#text":"2000"}],"issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"288 p. ; 23 cm."},"abstract":{"@type":"Summary","#text":"This volume \"really contains two books: a fondly sardonic autobiography and a tough-love lesson for aspiring novelists\", written by American author of contemporary horror, suspense, science fiction and fantasy, Stephen King (b. 1947). The first third of the book contains King's memoir, which includes heartfelt tidbits about his brother, mother and his long battles with alcohol and drug addiction. The second part of the book, \"On Writing,\" is where aspiring novelists might find inspiration. King describes the symbolism in many of his novels and offers writers common sense advice. He presents his taboos of writing: adverbs (especially those in dialog) and the passive voice. He describes his writer's toolbox, including examples of both good and bad writing, sometimes taken from his own work, sometimes taken from other writers. He also describes his approach to research. King concludes by including a list of nearly a hundred novels that he considers the best that he's read in the last three or four years."},"tableOfContents":"A list of books suggested to those who want to write by Stephen King.","note":[{"@type":"statement of responsibility","#text":"by Stephen King."},{"@type":"bibliography","#text":"Includes bibliographical references (pages 285-288)."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"n-us---"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["King, Stephen",{"@type":"date","#text":"1947-"}]}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["King, Stephen",{"@type":"date","#text":"1947-"}]},"topic":"Authorship"},{"@authority":"fast","temporal":"1900-1999"},{"@authority":"lcsh","topic":"Authors, American","temporal":"20th century","genre":"Biography"},{"@authority":"lcsh","topic":["Horror tales","Authorship"]},{"@authority":"lcsh","topic":"Authorship"},{"@authority":"mesh","topic":"Authorship"}],"classification":[{"@authority":"lcc","#text":"PS3561.I483 Z475 2000"},{"@authority":"nlm","#text":"813.54 K54o"},{"@edition":"21","@authority":"ddc","#text":"813/.54 B"}],"relatedItem":[{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":{"title":"On writing"},"name":{"namePart":"King, Stephen, 1947-"},"originInfo":{"publisher":"New York : Scribner, ©2000"},"identifier":{"@type":"local","#text":"(OCoLC)606484456"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990084378460203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0684853523"},{"@type":"lccn","#text":"^^^00030105^"},{"@type":"oclc","#text":"43903453"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000463633307","#text":"Lamont Library, Harvard University"},"shelfLocator":"PS3561.I483 Z475 2000"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"rep