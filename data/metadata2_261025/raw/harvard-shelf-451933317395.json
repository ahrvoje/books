{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Noonan&limit=10&title=Sid Meier's Memoir!","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":{"title":"Sid Meier's memoir! ","subTitle":"a life in computer games "},"name":[{"@usage":"primary","@type":"personal","namePart":"Meier, Sid","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},{"@type":"personal","namePart":"Noonan, Jennifer Lee","role":{"roleTerm":{"@type":"text","#text":"author"}}}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"biography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"Medical Subject Headings","#text":"Autobiography"},{"@authority":"fast","#text":"Autobiographies"},{"@authority":"fast","#text":"Biographies"},{"@authority":"fast","#text":"History"},{"@authority":"lcgft","#text":"Autobiographies"},{"@authority":"rvmgf","#text":"Autobiographies."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},"dateIssued":{"@encoding":"marc","#text":"2020"},"issuance":"monographic","edition":"First edition."},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"New York, NY :"}},"agent":{"namePart":"W. W. Norton & Company, Inc.,","role":{"roleTerm":"publisher"}},"dateIssued":[2020]}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"viii, 286 pages : illustrations ; 24 cm"},"abstract":{"@type":"Summary","#text":"\"The life and career of the legendary developer celebrated as the \"godfather of computer gaming,\" and creator of Civilization. Over his four-decade career, Sid Meier has produced some of the world's most popular video games, including Sid Meier's Civilization, which has sold more than 51 million units worldwide and accumulated more than one billion hours of play. Sid Meier's Memoir! is the story of an obsessive young computer enthusiast who helped launch a multibillion-dollar industry. Writing with warmth and ironic humor, Meier describes the genesis of his influential studio, MicroProse, founded in 1982 after a trip to a Las Vegas arcade, and recounts the development of landmark games, from vintage classics like Pirates! and Railroad Tycoon, to Civilization and beyond. Articulating his philosophy that a video game should be \"a series of interesting decisions,\" Meier also shares his perspective on the history of the industry, the psychology of gamers, and fascinating insights into the creative process, including his rules of good game design\"-- Provided by publisher."},"tableOfContents":{"@type":"Contents","#text":"1. What Happens In Vegas -- 2. Adaptation -- 3. Cruising Altitude -- 4. D-Day -- 5. Collective Effort -- 6. Ahoy! -- 7. And Then Bill Bought An Airplane -- 8. Overt Protraction -- 9. Hang On A Second -- 10. All Aboard -- 11. History Of Civilization, Part I -- 12. Turning Points -- 13. If It Ain't Baroque -- 14. Sequel-Ish -- 15. The Dispersing -- 16. Interesting Decisions -- 17. Back To The Future -- 18. Extinction -- 19. Artificial Turf -- 20. Into The Wind -- 21. Higher Education -- 22. Fuzzy Math -- 23. Social Mobility -- 24. Funny Business -- 25. Beyond."},"note":[{"@type":"statement of responsibility","#text":"Sid Meier ; written with Jennifer Lee Noonan."},"Includes index.","\"By the creator of Civilization!\""],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"n-us---"}},{"@authority":"lcsh","topic":"Video game designers","geographic":"United States","genre":"Biography"},{"@authority":"lcsh","topic":["Video games","History"]},{"@authority":"lcsh","topic":["Video games","Design"]},{"@authority":"lcsh","topic":["Video gamers","Psychology"]},{"@authority":"rvm","topic":"Développeurs de jeux vidéo","geographic":"États-Unis","genre":"Biographies"},{"@authority":"rvm","topic":["Jeux vidéo","Histoire"]},{"@authority":"rvm","topic":["Jeux vidéo","Conception"]},{"@authority":"rvm","topic":["Joueurs de jeux vidéo","Psychologie"]},{"@authority":"bisacsh","topic":"SPORTS & RECREATION / General"},{"@authority":"fast","@href":"(OCoLC)fst01982400","topic":"Video game designers"},{"@authority":"fast","@href":"(OCoLC)fst01166421","topic":"Video games"},{"@authority":"fast","@href":"(OCoLC)fst01166425","topic":["Video games","Design"]},{"@authority":"fast","@href":"(OCoLC)fst01204155","geographic":"United States"},{"@authority":"lcsh","name":{"@type":"personal","namePart":"Meier, Sid"}},{"@authority":"fast","name":{"@type":"personal","namePart":"Meier, Sid"}}],"classification":[{"@authority":"lcc","#text":"GV1469.3.M45 A3 2020"},{"@edition":"23","@authority":"ddc","#text":"794.8"}],"identifier":[{"@type":"isbn","#text":"9781324005872"},{"@type":"isbn","#text":"1324005874"},{"@type":"isbn","@invalid":"yes","#text":"9781324005889"},{"@type":"lccn","#text":"2020015913"},{"@type":"oclc","#text":"1152434035"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99155266168603941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"GV1469.3.M45 A3 2020"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99155266168603941","processingDate":"2026-04-06T04:15Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"