{"pagination":{"maxPageableSet":"10000","numFound":2,"query":"name=Simpson&limit=10&title=Touching the Void","limit":10,"start":0},"items":{"mods":[{"titleInfo":{"title":"Touching the void"},"name":{"@usage":"primary","@type":"personal","namePart":"Greig, David","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author."}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"drama"},{"@authority":"rdacontent","#text":"text"},{"@authority":"fast","#text":"Drama"},{"@authority":"lcgft","#text":"Drama"},{"@authority":"rvmgf","#text":"Théâtre."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},"dateIssued":{"@encoding":"marc","#text":"2018"},"copyrightDate":{"@encoding":"marc","#text":"2018"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"London :"}},"publisher":"Faber & Faber,","dateIssued":"2018."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"103 pages ; 20 cm"},"abstract":{"@type":"Summary","#text":"\"In 1928 a journalist asked George Mallory why he wanted to climb Everest. Mallory said, \"Because it's there\" Joe Simpson's memoir Touching the Void, international bestseller and BAFTA-winning film, charts his struggle for survival on the perilous Siula Grande mountain in the Peruvian Andes aged twenty-five. Adapted for the stage by David Greig, Joe's story explodes into a bold theatrical fantasia. We discover the counter-cultural world of Alpine climbing and the sensual joy of the mountains; we bear witness to the appalling moment when Joe's climbing partner Simon Yates, battered by freezing winds and tethered to the injured Simpson, makes the critical decision to cut the rope. Tense, funny and inquisitive, Touching the Void explores the mind's extraordinarily rich reservoirs of strength and imagination when teetering on the edge of death. David Greig's Touching the Void premiered at Bristol Old Vic, Bristol in September 2018\"--Amazon.com"},"note":{"@type":"statement of responsibility","#text":"David Greig ; stage adaptation based on the book by Joe Simpson."},"subject":[{"@authority":"lcsh","name":{"@type":"personal","namePart":["Simpson, Joe",{"@type":"date","#text":"1960-"}]},"genre":"Drama"},{"@authority":"fast","name":{"@type":"personal","namePart":["Simpson, Joe",{"@type":"date","#text":"1960-"}]}}],"classification":[{"@authority":"lcc","#text":"PR6057.R389 T67 2018"},{"@edition":"23","@authority":"ddc","#text":"822/.92"}],"relatedItem":[{"@type":"constituent","titleInfo":{"title":"Touching the void"},"name":{"@type":"personal","namePart":["Simpson, Joe,",{"@type":"date","#text":"1960-"}]}},{"@type":"otherFormat","@otherType":"Ebook version :","@displayLabel":"Ebook version :"},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99153839043803941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0571352243"},{"@type":"isbn","#text":"9780571352241"},{"@type":"isbn","@invalid":"yes","#text":"9780571352258"},{"@type":"oclc","#text":"1048288192"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"PR6057.R389 T67 2018"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99153839043803941","processingDate":"2023-02-24T09:13Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource"