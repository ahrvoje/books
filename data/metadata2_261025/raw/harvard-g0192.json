":"personal","namePart":["Welch, Jack,",{"@type":"date","#text":"1935-"}]}}],"classification":[{"@authority":"lcc","#text":"HD9697.A3 U585 1998"},{"@edition":"21","@authority":"ddc","#text":"338.7/62138/092 B"}],"identifier":[{"@type":"isbn","#text":"0471242721 (cloth)"},{"@type":"lccn","#text":"^^^97042942^"},{"@type":"oclc","#text":"37806196"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990077473560203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000123374118","#text":"Baker Library, Harvard Business School, Harvard University"},"shelfLocator":"HD9697.A3 U585 1997"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Baker Business"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990077473560203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"007747356"}},"processingDate":"2026-09-21T04:14Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"971007"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990077473560203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"titleInfo":{"nonSort":{"@space":"preserve","#text":"The  "},"title":"Jack Welch lexicon of leadership"},"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":"Krames, Jeffrey A.","role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":{"@authority":"marcgt","#text":"bibliography"},"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"New York"}}],"publisher":"McGraw-Hill","dateIssued":["c2002",{"@encoding":"marc","#text":"2002"}],"edition":"1st ed.","issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"xii, 210 p. ; 22 cm."},"abstract":[{"@type":"Review","#text":"\"Jack Welch is the most admired, copied, and studied CEO of the 20th century. His visionary initiatives and concepts - and adaptive management strategies - earned him the title of the most effective CEO in history. This alphabetically arranged, encyclopedic reference, The Jack Welch Lexicon of Leadership, provides an in-depth look at the methods that Welch used to turn GE into the world's most valuable corporation.\""},{"@type":"","#text":"\"By adding speed, simplifying the complex, and cutting straight to the heart of the matter, Jack Welch was able to find workable solutions for virtually every challenge. The Jack Welch Lexicon of Leadership follows Welch's example. It defines and organizes the terms and programs that Welch used to rewrite the language of leadership, then creates a roadmap you can use to create Welch magic of your own - regardless of your organization's industry or competitive position.\"--Jacket."}],"tableOfContents":"Part One. Evolution of a leadeer: the Welch years -- Part Two. The Jack Welch lexicon of leadership.","note":[{"@type":"statement of responsibility","#text":"Jeffrey A. Krames."},"\"Over 250 terms, concepts, strategies and initiatives of the legendary leader\"--jacket.",{"@type":"bibliography","#text":"Includes bibliographical references (p. 205-210)."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"n-us---"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":"Welch, Jack"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Welch, Jack",{"@type":"date","#text":"1935-2020"}]}},{"@authority":"mesh","name":{"@type":"personal","namePart":["Welch, Jack",{"@type":"date","#text":"1935-"}]}},{"@authority":"lcsh","topic":"Leadership"},{"@authority":"lcsh","topic":"Industrial management"},{"@authority":"lcsh","topic":"Competition"},{"@authority":"mesh","topic":"Leadership"},{"@authority":"mesh","topic":"Organizational Innovation"},{"@authority":"mesh","topic":"Competitive Behavior"},{"@authority":"mesh","topic":"Economic Competition"},{"@authority":"mesh","topic":["Industry","organization & administration"]},{"@authority":"mesh","geographic":"United States"}],"classification":[{"@authority":"lcc","#text":"HD57.7 .K726 2001"},{"@authority":"nlm","#text":"HD 57.7 K896j 2002"}],"identifier":[{"@type":"isbn","#text":"0071381406"},{"@type":"lccn","#text":"^^2001276684"},{"@type":"oclc","#text":"47941608"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990088600120203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000123374118","#text":"Baker Library, Harvard Business School, Harvard University"},"shelfLocator":"HD57.7 .K726 2002"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"HD57.7 .K726 2002"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":["Baker Business","Widener"]},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990088600120203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"008860012"}},"processingDate":"2024-09-01T05:13Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"PCX"},"recordCreationDate":{"@encoding":"marc","#text":"011001"},"recordChangeDate":{"@encoding":"iso8601","#text":"20160409"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990088600120203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}},{"@version":"3.8","titleInfo":{"title":"Jack ","subTitle":"straight from the gut "},"name":[{"@usage":"primary","@type":"personal","namePart":["Welch, Jack,",{"@type":"date","#text":"1935-2020"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},{"@type":"personal","namePart":"Byrne, John A."}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"biography"},{"@authority":"fast","#text":"Biographies"}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"New York "}}],"issuance":"monographic","agent":{"namePart":"Warner Books"},"dateIssued":"2003"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":{"@authority":"marcform","#text":"print"},"extent":"xvi, 480 p. : ill. ; 23 cm."},{"form":{"@type":"Illustrative content","#text":"illustration"}}],"abstract":{"@type":"Summary","#text":"Jack Welch was perhaps the greatest corporate leader of the 20th century. When he first became CEO of General Electric in 1981 the company was worth $12 billion. Twenty years later it is worth a total of $280 billion. But Welch was more than just the leader of the most successful business in the world. He revolutionized GE's entire corporate culture with his distinctive, highly personal management style: the individual appreciation of each of his 500 managers, the commitment to an informal but driven work style and the encouragement of candour were all part of the Welch approach."},"tableOfContents":{"@type":"Contents","#text":"1. Building self-confidence -- 2. Getting out of the pile -- 3. Blowing the roof off -- 4. Flying below the radar -- 5. Getting closer to the big leagues -- 6. Swimming in a bigger pond -- 7. Dealing with reality and \"superficial congeniality\" -- 8. The vision thing -- 9. The neutron years -- 10. The RCA deal -- 11. The people factory -- 12. Remaking Crotonville to remake GE -- 13. Boundaryless : taking ideas to the bottom line -- 14. Deep dives -- 15. Too full of myself -- 16. GE Capital : the growth engine -- 17. Mixing NBC with light bulbs -- 18. When to fight, when to fold -- 19. Globalization -- 20. Growing services -- 21. Six sigma and beyond -- 22. E-business -- 23. \"Go home, Mr. Welch\" -- 24. What this CEO thing is all about -- 25. A short reflection on golf -- 26. \"New guy.\""},"note":[{"@type":"statement of responsibility","#text":"Jack Welch ; with John A. Byrne."},"Includes index."],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"n-us---"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Welch, Jack,",{"@type":"date","#text":"1935-2020"}]}},{"@authority":"lcsh","topic":"Chief executive officers","geographic":"United States","genre":"Biography"},{"@authority":"lcsh","name":{"@type":"corporate","namePart":"General Electric Company"},"topic":"Management"},{"@authority":"lcsh","topic":["Electric industries","Management"],"geographic":"United States"},{"@authority":"lcsh","topic":"Industrial management","geographic":"United States"}],"classification":[{"@authority":"lcc","#text":"HD9697.A3 U584 2003"},{"@edition":"22","@authority":"ddc","#text":"338.762138092"}],"identifier":[{"@type":"isbn","#text":"0446690686 :"},{"@type":"isbn","#text":"9780446690683"},{"@type":"oclc","#text":"53121654"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990121793580203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000123374118","#text":"Baker Library