{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Mesquita&limit=10&title=Between Us","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":{"title":"Between us ","subTitle":"how cultures create emotions "},"name":{"@usage":"primary","@type":"personal","namePart":"Mesquita, Batja","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}},{"roleTerm":{"@type":"code","@authority":"marcrelator","#text":"aut"}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"fast","#text":"Instructional and educational works"},{"@authority":"fast","#text":"Cross-cultural studies"},{"@authority":"lcgft","#text":"Instructional and educational works"},{"@authority":"rvmgf","#text":"Matériel d'éducation et de formation."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},"dateIssued":{"@encoding":"marc","#text":"2022"},"copyrightDate":{"@encoding":"marc","#text":"2022"},"issuance":"monographic","edition":"First edition."},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"New York, NY :"}},"agent":{"namePart":"W.W. Norton & Company,","role":{"roleTerm":"publisher"}},"dateIssued":[2022]}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xii, 290 pages : illustrations ; 25 cm"},"abstract":{"@type":"Summary","#text":"\"A pioneer of cultural psychology argues that emotions are not innate, but made as we live our lives together. \"How are you feeling today?\" We may think of emotions as universal responses, felt inside. Using decades-long, cutting-edge research, acclaimed psychologist Batja Mesquita asks us to reconsider emotions through the lens of what they do in our relationships, both one-on-one and within larger social networks. From an outside-in perspective, readers will understand why pride in a Dutch context does not translate well to North Carolina, or why one's anger at a boss does not mean the same as your anger to a partner in a close relationship. By looking outward at relationships at work, school, and home, we can better judge how our emotions will be understood, how they might change a situation, and how they change us. Brilliantly synthesizing original psychological studies and stories from peoples across time and geography, Between Us skillfully argues that acknowledging differences in emotions allows us to find common ground, humanizing and humbling us all for the better\"-- Provided by publisher."},"tableOfContents":{"@type":"Contents","#text":"Lost in translation -- Emotions : MINE or OURS? -- To raise your child -- \"Right\" and \"wrong\" emotions -- Being connected and feeling good -- What's in a word? -- Learning the waltz -- Emotions in a multicultural world."},"note":[{"@type":"statement of responsibility","#text":"Batja Mesquita."},{"@type":"bibliography","#text":"Includes bibliographical references (pages [221]-280) and index."}],"subject":[{"@authority":"lcsh","topic":"Emotions","genre":"Cross-cultural studies"},{"@authority":"lcsh","topic":"Ethnopsychology"},{"@authority":"rvm","topic":"Ethnopsychologie"},{"@authority":"aat","topic":"ethnopsychology"},{"@authority":"bisacsh","topic":"PSYCHOLOGY / Emotions"},{"@authority":"bisacsh","topic":"SELF-HELP / Emotions"},{"@authority":"bisacsh","topic":"PSYCHOLOGY / Social Psychology"},{"@authority":"fast","topic":"Emotions"},{"@authority":"fast","topic":"Ethnopsychology"},{"@authority":"nli","topic":"Emotions","genre":"Cross-cultural studies"},{"@authority":"nli","topic":"Ethnopsychology"},{"@authority":"sears","topic":"Emotions","genre":"Cross-cultural studies"},{"@authority":"sears","topic":"Ethnopsychology"}],"classification":[{"@authority":"lcc","#text":"BF511 .M47 2022"},{"@edition":"23/eng/20220513","@authority":"ddc","#text":"155.8"},{"@authority":"bcl","#text":"77.46"}],"relatedItem":[{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":{"title":"Between us"},"originInfo":{"publisher":"New York, NY : W.W. Norton & Company, [2022]","edition":"First edition."},"identifier":[{"@type":"isbn","#text":"9781324002475"},{"@type":"local","#text":"(OCoLC)1335021910"}],"name":{"namePart":"Mesquita, Batja."}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99156403635303941/catalog"}}],"identifier":[{"@type":"isbn","#text":"9781324002444"},{"@type":"isbn","#text":"1324002441"},{"@type":"isbn","#text":"9781324074731"},{"@type":"isbn","#text":"1324074736"},{"@type":"isbn","@invalid":"yes","#text":"9781324002475"},"40031279328",{"@type":"lccn","#text":"2022008952"},{"@type":"oclc","#text":"1272856381"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"BF511 .M47 2022"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000463633307","#text":"Lamont Library, Harvard University"},"shelfLocator":"BF511 .M47 2022"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":["Lamont","Widener"]},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99156403635303941","processingDate":"2026-05-25T04:13Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"220504"},"recordChangeDate":{"@encodi