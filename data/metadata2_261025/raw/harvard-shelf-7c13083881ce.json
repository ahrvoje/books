cum"}],"dateIssued":"2005","edition":"1. Aufl."},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"ger"},{"@type":"text","@authority":"iso639-2b","#text":"German"}]},"physicalDescription":[{"form":{"@authority":"marcform","#text":"print"},"extent":"120 p. : ill., ports., facsims. ; 16 cm."},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Illustrative content","#text":"facsimile"}},{"form":{"@type":"Illustrative content","#text":"portrait"}}],"abstract":{"@type":"Scope and content","#text":"Albert Einstein gehört zu den bedeutendsten Wissenshaftlern der Geschichte und hat mit seinen Entdeckungen die moderne Physik massgeblich begründet. Einstein war aber nicht nur die Zentralfigur der Physik des 20. Jahrhunderts. Sein Eintreten für Menschenrechte, Demokratie und Frieden machten ihn überdies zu einer Symbolfigur des modernen, gesellschaftlich engagierten Wissenschaftlers unserer Zeit. Er war zudem ein engagierter Jude. All dies trug ihm Bewunderung und Verehrung, aber auch Missgunst und Angriffe auf Person und Werk ein, die nicht zuletzt auf Einstein als Juden und sein Engagement für die zionistische Idee zielten."},"note":[{"@type":"statement of responsibility","#text":"Dieter Hoffmann/Robert Schulmann."},"Biography.",{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"@authority":"lcsh","name":{"@type":"personal","namePart":["Einstein, Albert,",{"@type":"date","#text":"1879-1955"}]}},{"@authority":"swd","name":{"@type":"personal","namePart":"Einstein, Albert."}}],"classification":{"@authority":"lcc","#text":"QC16.E5 H644 2005"},"relatedItem":[{"titleInfo":{"title":"Jüdische Miniaturen ","partNumber":"Doppelbd. 25"}},{"@type":"series","titleInfo":{"title":"Jüdische Miniaturen (Hentrich & Hentrich)","partNumber":"Bd. 25"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990096987580203941/catalog"}}],"identifier":[{"@type":"