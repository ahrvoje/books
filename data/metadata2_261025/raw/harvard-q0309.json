ce and spirit of QED to the layperson."},"tableOfContents":{"@type":"Contents","#text":"Introduction to the 2006 edition / by A. Zee -- Foreword / by Leonard Mautner -- Preface / by Ralph Leighton -- Introduction -- Photons : particles of light -- Electrons and their interactions -- Loose ends."},"note":[{"@type":"statement of responsibility","#text":"Richard Feynman, with a new introduction by A. Zee."},"Includes index."],"subject":[{"@authority":"lcsh","topic":"Photons"},{"@authority":"lcsh","topic":"Electrons"},{"@authority":"lcsh","topic":"Quantum electrodynamics"},{"@authority":"mesh","topic":"Photons"},{"@authority":"mesh","topic":"Electrons"}],"classification":{"@authority":"lcc","#text":"QC793.5.P422 F48 2006"},"identifier":[{"@type":"isbn","#text":"0691127174"},{"@type":"isbn","#text":"0691125759 (pbk.)"},{"@type":"isbn","#text":"9780691127170"},{"@type":"isbn","#text":"9780691125756"},{"@type":"oclc","#text":"67234565"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990100706370203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","#text":"Harvard Plate Stacks, Harvard University"},"shelfLocator":"QC793.5.P422 F48 2006"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Plate Stacks"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990100706370203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"010070637"}},"processingDate":"2026-04-19T04:15Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"JJG"},"recordCreationDate":{"@encoding":"marc","#text":"060420"},"recordChangeDate":{"@encoding":"iso8601","#text":"20260205"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990100706370203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/