"lcc","#text":"BJ1012 .P37 2011"},{"@authority":"ddc","#text":"170"}],"relatedItem":[{"titleInfo":{"title":"On what matters ; v. 1"}},{"titleInfo":{"title":"The Berkeley Tanner lectures"}},null,{"@type":"series","titleInfo":{"title":"Berkeley Tanner lectures"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99153576986503941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0-19-161346-0"},{"@type":"isbn","#text":"0-19-180987-X"},{"@type":"oclc","#text":"735625246"},{"@type":"oclc","#text":"1024235030"}],"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99153576986503941","processingDate":"2024-11-13T06:12Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":["aacr","rda"],"recordContentSource":{"@authority":"marcorg","#text":"MiAaPQ"},"recordCreationDate":{"@encoding":"marc","#text":"110714"},"recordChangeDate":{"@encoding":"iso8601","#text":"20241028"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99153576986503941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"titleInfo":{"title":"Does anything really matter ?","subTitle":"essays on Parfit on objectivity"},"name":{"@type":"personal","namePart":["Singer, Peter",{"@type":"date","#text":"1946-"}],"role":{"roleTerm":{"@type":"text","#text":"editor."}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},"dateIssued":{"@encoding":"marc","#text":"2017"},"edition":"First edition.","issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Oxford ;"}},"publisher":"Oxford University Press,","dateIssued":"2017."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xii, 300 pages ; 24 cm"},"abstract":{"@type":"","#text":"'Does Anything Really Matter?' gives philosophers that were critized by Derek Parfit in his books 'On What Matters' an opportunity to respond to Parfit's criticisms. It includes essays on Parfit's views by Richard Chappell, Andrew Huddleston, Katarzyna de Lazari-Radek and Peter Singer, Bruce Russell, and Larry Temkin. A third volume of 'On What Matters', in which Parfit engages with his critics and breaks new ground in finding significant agreement between his own views and theirs, is appearing as a separate companion volume."},"tableOfContents":"Preface / by Peter Singer -- 1. Has Parfit's life been wasted? : some reflections on Part Six of 'On What Matters' / Larry S. Temkin -- 2. Two sides of the meta-ethical mountain? / Pater Railton -- 3. Parfit on normative concepts and disagreement / Allan Gibbard -- 4. All souls' night / Simon Blackburn -- 5. Parfit's mistaken meta-ethics / Michael Smith -- 6. Nothing \"really\" matters, but that's not what matters / Sharon Street -- 7. Knowing what matters / Richard Yetter Chappell -- 8. Nietzsche and the hope of normative convergence / Andrew Huddleston -- 9. In defence of reductionism in ethics / Frank Jackson -- 10. What matters about meta-ethics? / Mark Schroeder -- 11. A defense of moral intuitionism / Bruce Russell -- 12. Morality, blame, and internal reasons / Stephen Darwall -- 13. Parfit on objectivity and \"the profoundest problem in ethics\" / Katarzyna de Lazari-Radek and Peter Singer.","note":[{"@type":"statement of responsibility","#text":"edited by Peter Singer."},{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"@authority":"lcsh","name":{"@type":"personal","namePart":"Parfit, Derek"},"titleInfo":{"title":"On what matters"}},{"@authority":"lcsh","topic":"Ethics"},{"@authority":"lcsh","topic":"Objectivity"},{"@authority":"mesh","topic":"Ethics"}],"classification":[{"@authority":"lcc","#text":"B1649.P373 D64 2017"},{"@edition":"23","@authority":"ddc","#text":"170"}],"identifier":[{"@type":"isbn","#text":"9780199653836"},{"@type":"isbn","#text":"0199653836"},{"@type":"oclc","#text":"971969486"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990149074340203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"B1649.P373 D64 2017"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990149074340203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"014907434"}},"processingDate":"2024-04-16T05:18Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"ERASA"},"recordCreationDate":{"@encoding":"marc","#text":"151113"},"recordChangeDate":{"@encoding":"iso8601","#text":"20170216"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990149074340203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"titleInfo":[{"title":"On what matters"},{"@type":"uniform","title":"University press scholarship online"}],"name":[{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":"Parfit, Derek.","role":{"roleTerm":{"@type":"text","#text":"creator"}}},{"@type":"personal","namePart":["Scheffler, Samuel",{"@type":"date","#text":"1951-"}]},{"@type":"personal","namePart":["Scheffler, Samuel",{"@type":"date","#text":"1951-"}],"role":{"roleTerm":{"@type":"code","@authority":"marcrelator","#text":"aui"}}}],"typeOfResource":"text","genre":{"@authority":"marcgt","#text":"bibliography"},"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},{"placeTerm":{"@type":"text","#text":"Oxford"}},{"placeTerm":{"@type":"text","#text":"New York"}}],"publisher":"Oxford University Press","dateIssued":["2011-2017",{"@encoding":"marc","@point":"start","#text":"2011"},{"@encoding":"marc","@point":"end","#text":"2017"}],"issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"3 v. ; 24 cm."},"abstract":{"@type":"Summary","#text":"On What Matters is a major work in moral philosophy. It is the long-awaited follow-up to Derek Parfit's 1984 book Reasons and Persons, one of the landmarks of twentieth-century philosophy. Parfit now presents a powerful new treatment of reasons, rationality, and normativity, and a critical examination of three systematic moral theories - Kant's ethics, contractualism, and consequentialism - leading to his own ground-breaking synthetic conclusion. Along the way he discusses a wide range of moral issues, such as the significance of consent, treating people as a means rather than an end, and free will and responsibility. On What Matters is already the most-discussed work in moral philosophy: its publication is likely to establish it as a modern classic which everyone working on moral philosophy will have to read, and which many others will turn to for stimulation and illumination."},"tableOfContents":["V. 1. Part 1: Reasons. Normative concepts ; Objective theories ; Subjective theories ; Further arguments ; Rationality ; Morality ; Moral concepts -- Part 2: Principles. Possible consent ; Merely as a means ; Respect and value ; Free will and desert -- Part 3: Theories. Universal laws ; What if everyone did that? ; Impartiality ; Contractualism ; Consequentialism -- Conclusions -- Appendices. A. Stage-given reasons ; B. Rational irrationality and Gauthier's theory ; C. Deontic reasons -- v. 2. Part 4: Commentaries. Hiking the range / Susan Wolf ; Humanity as an end in itself / Allen Wood ; A mismatch of methods / Barbara Herman ; How I an not a Kantian / T.M. Scanlon -- Part 5: Responses. On hiking the range ; On humanity as an end in itself ; On a mismatch of methods ; How the numbers count ; Scanlonian contractualism ; The triple theory -- Part 6: Normativity. Analytical naturalism and subjectivism ; Non-analytical naturalism ; The triviality objection ; Naturalism and nihilism ; Non-cognitivism and quasi-realism ; Normativity and truth ; Normative truths ; Metaphysics ; Epistemology ; Rationalism ; Agreement ; Nietzsche -- Appendices. Why anything? Why this? ; The fair warning view ; Some of Kant's arguments for his formula of universal law ; Kant's claims about the good ; Autonomy and categorical imperatives ; Kant's motivational argument ; On what there is --","v. 3 Part 7: Irreducibly Normative Truths. ; How things Might Matter ; Non-Realist Cognitivism ; Normative and Natural Truths ; Gibard's offer to non-naturalists ; Railton's defence of soft naturalism ; Railton's resolution of our disagreements ; Jackson's non-empirical normative truths ; Schroeder's conservative reductive thesis -- Part 8: Expressivist truths ; Quasi-realist expressivism ; Gibbard's resolution of our disagreements ; Another triple theory -- Part 9: Normative and Psychological reasons ; Expressivist reasons ; Subjective reason ; Street's meta-ethical constructivism ; Morality, blame, and internal reasons l Nietzsche's mountain -- Part 10: Ethics ; What matters and universal reasons ; Conflicting reason ; The right and the good ; Deontological principles ; Act consequentialism and common sense morality ; Towards a unified theory."],"note":[{"@type":"statement of responsibility","#text":"Derek Parfit ; edited and introduced by Samuel Scheffler."},{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"@authority":"lcsh","topic":"Ethics"},{"@authority":"fast","topic":"Ethics"}],"classification":[{"@authority":"lcc","#text":"BJ1012 .P37 2011"},{"@edition":"22","@authority":"ddc","#text":"170"}],"relatedItem":[{"titleInfo":{"title":"Berkeley Tanner lectures"}},{"@type":"series","titleInfo":{"title":"Berkeley Tanner lectures"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990128173670203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"9780199572809 (vol. 1)"},{"@type":"isbn","#text":"0199572801 (vol. 1)"},{"@type":"isbn","#text":"9780199572816 (vol. 2)"},{"@type":"isbn","#text":"019957281X (vol. 2)"},{"@type":"isbn","#text":"9780198778608 (vol. 3)"},{"@type":"isbn","#text":"9780199265923 (set)"},{"@type":"isbn","#text":"0199265925 (set)"},{"@type":"lccn","#text":"^^2009029662"},{"@type":"oclc","#text":"428731337"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"BJ1012 .P37 2011"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000460372818","#text":"Robbins Library of Philosophy, Harvard University"},"shelfLocator":"BJ1012 .P37 2011"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":["Robbins Philosophy","Widener"]},"originalDocument":"https://s3.amazonaws.com/harvard.libraryc