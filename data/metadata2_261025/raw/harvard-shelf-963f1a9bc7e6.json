ition":"1st ed.","issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marccategory","#text":"electronic resource"},{"@authority":"marcsmd","#text":"remote"},{"@type":"media","@authority":"","#text":"computer"},{"@type":"carrier","@authority":"","#text":"online resource"}],"extent":"1 online resource (840 p.)"},"abstract":{"@type":"Summary","#text":"On What Matters is a major work in moral philosophy. It is the long-awaited follow-up to Derek Parfit's 1984 book Reasons and Persons, one of the landmarks of twentieth-century philosophy. Parfit now presents a powerful new treatment of reasons, rationality, and normativity, and a critical examination of three systematic moral theories - Kant's ethics, contractualism, and consequentialism - leading to his own ground-breaking synthetic conclusion. Along the way hediscusses a wide range of moral issues, such as the significance of consent, treating people as a means rather than an end, and free"},"tableOfContents":"pt. 4. Commentaries -- pt. 5. Responses -- pt. 6. Normativity.","note":[{"@type":"statement of responsibility","#text":"Derek Parfit ; edited and introduced by Samuel Scheffler."},"Description based upon print version of record.",{"@type":"bibliography","#text":"Includes bibliographical references and index."},{"@type":"language","#text":"English"}],"subject":{"@authority":"lcsh","topic":"Ethics"},"classification":[{"@authority":"lcc","#text":"BJ1012 .P37 2011"},{"@authority":"ddc","#text":"170"}],"relatedItem":[{"titleInfo":{"title":"On what matters ; v. 2"}},{"titleInfo":{"title":"The Berkeley Tanner lectures"}},null,null,{"@type":"series","titleInfo":{"title":"Berkeley Tanner lectures"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99153576996603941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0-19-161345-2"},{"@type":"isbn","#text":"0-19-180986-1"},{"@type":"isbn","#text":"1-283-16017-X"},{"@type":"isbn","#text":"9786613160171"},{"@type":"isbn","#text":"0-19-157671-9"},{"@type":"oclc","#text":"735625279"}],"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99153576996603941","processingDate":"2024-09-16T00:42Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":["aacr","rda"],"recordContentSource":{"@authority":"marcorg","#text":"MiAaPQ"},"recordCreationDate":{"@encoding":"marc","#text":"110713"},"recordChangeDate":{"@encoding":"iso8601","#text":"20240911"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99153576996603941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"titleInfo":{"title":"Reading Parfit","subTitle":"on what matters"},"name":{"@type":"personal","namePart":"Kirchin, Simon","role":{"roleTerm":{"@type":"text","#text":"editor."}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},"dateIssued":{"@encoding":"marc","#text":"2017"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Abingdon, Oxon ;"}},"publisher":"Routledge, an imprint of the Taylor & Francis Group,","dateIssued":"2017."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xi, 239 pages ; 24 cm"},"abstract":{"@type":"Summary","#text":"Derek Parfit was one of the world's leading philosophers. His On What Matters was the most eagerly awaited book in philosophy for many years. Reading Parfit: On What Matters is an essential overview and assessment of volumes 1 and 2 of Parfit's monumental work by a team of international contributors, and includes responses by Parfit himself. It discusses central features of Parfit's book, including the structure and nature of reasons; the ideas underlying moral principles; Parfit's discussions of consequentialism, contractualism and Kantian deontology; and his metaethical ideas and arguments. Reading Parfit will be central reading for students of ethics and anyone seeking a deeper understanding of one of the most important works of philosophy published in the last fifty years. Book jacket."},"tableOfContents":"1 Reflections from Wolf and Wood: incommensurability, guidance and the 'smoothing over' of ethical life / Simon Kirchin Kirchin, Simon 10 -- 2 Normative naturalism and normative nihilism: Parfit's dilemma for naturalism / David Copp Copp, David 28 -- 3 On what it is to matter / Julia Markovits Markovits, Julia 54 -- 4 The buck-passing account of value: assessing the negative thesis / Philip Stratton-Lake Stratton-Lake, Philip 82 -- 5 Normativity, reasons and wrongness: how to be a two-tier theorist / David McNaughton McNaughton, David, Piers Rawling Rawling, Piers 96 -- 6 Wrong-Making Reasons / Kieran Setiya Setiya, Kieran 123 -- 7 Parfit on reasons and rule consequentialism / Douglas W. Portmore Portmore, Douglas W. 135 -- 8 Advice for Non-Analytical Naturalists / J.L. Dowell Dowell, J.L., David Sobel Sobel, David 153 -- 9 Contingency and constructivism / Julia Driver Driver, Julia 172 -- 10 Responses / Derek Parfit Parfit, Derek 189.","note":[{"@type":"statement of responsibility","#text":"edited by Simon Kirchin."},{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"@authority":"lcsh","name":{"@type":"personal","namePart":"Parfit, Derek"},"titleInfo":{"title":"On what matters"}},{"@authority":"lcsh","topic":"Ethics"}],"classification":[{"@authority":"lcc","#text":"BJ1012.P373 R43 2017"},{"@edition":"23","@authority":"ddc","#text":"170"}],"identifier":[{"@type":"isbn","#text":"9780415529495"},{"@type":"isbn","#text":"0415529492"},{"@type":"isbn","#text":"9780415529501"},{"@type":"isbn","#text":"0415529506"},{"@type":"isbn","@invalid":"yes","#text":"9781315225531"},{"@type":"lccn","#text":"^^2016042085"},{"@type":"oclc","#text":"898926232"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990150070410203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"BJ1012.P373 R43 2017"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990150070410203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"015007041"}},"processingDate":"2024-08-03T06:19Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"161017"},"recordChangeDate":{"@encoding":"iso8601","#text":"20170508"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990150070410203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"titleInfo":{"title":"On what matters","partNumber":"Volume one"},"name":[{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":"Parfit, Derek.","role":{"roleTerm":{"@type":"t