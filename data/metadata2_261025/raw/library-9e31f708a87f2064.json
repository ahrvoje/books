/ic_marc.mrc:69966958:719","ia:characterofphysi00feyn"],"title":"The character of physical law","lccn":["67014527"],"notes":{"type":"/type/text","value":"6"},"number_of_pages":173,"subjects":["Physics -- Addresses, essays, lectures"],"by_statement":"Richard Feynman ; with an introduction by Paul Davies.","works":[{"key":"/works/OL271750W"}],"type":{"key":"/type/edition"},"lc_classifications":["QC28 .F4 1965","CB5 .C6 1964"],"oclc_numbers":["175060"],"languages":[{"key":"/languages/eng"}],"publishers":["M.I.T. Press"],"publish_date":"1965","latest_revision":12,"revision":12,"created":{"type":"/type/datetime","value":"2008-11-07T06:44:43.870876"},"last_modified":{"type":"/type/datetime","value":"2025-04-28T15:57:26.241073"}}},"OLID:OL23827421M":{"bib_key":"OLID:OL23827421M","info_url":"http://openlibrary.org/books/OL23827421M/The_character_of_physical_law","preview":"noview","preview_url":"http://openlibrary.org/books/OL23827421M/The_character_of_physical_law","details":{"notes":{"type":"/type/text","value":"The M.I.T. Press paperback series, 66."},"title":"The character of physical law","authors":[{"key":"/authors/OL35793A","name":"Richard Phillips Feynman"}],"publish_date":"1970","publishers":["M.I.T. Press"],"series":["The Messenger lectures"],"publish_places":["Cambridge"],"pagination":"173 p. :","subjects":["Physics"],"publish_country":"mau","by_statement":"Richard Feynman.","type":{"key":"/type/edition"},"key":"/books/OL23827421M","number_of_pages":173,"works":[{"key":"/works/OL271750W"}],"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2009-10-17T12:47:52.635786"},"last_modified":{"type":"/type/datetime","value":"2025-09-04T03:08:20.506641"}}},"OLID:OL25979640M":{"bib_key":"OLID:OL25979640M","info_url":"http://openlibrary.org/books/OL25979640M/The_Character_Of_Physical_Law","preview":"noview","preview_url":"http://openlibrary.org/books/OL25979640M/The_Character_Of_Physical_Law","thumbnail_url":"https://covers.openlibrary.org/b/id/7500429-S.jpg","details":{"publishers":["MIT Press (MA)"],"source_records":["marc:marc_openlibraries_phillipsacademy/PANO_FOR_IA_05072019.mrc:15065890:1029","ia:characterofphysi0000feyn_u5j3","marc:harvard_bibliographic_metadata/ab.bib.00.20150123.full.mrc:317551361:1835","marc:marc_columbia/Columbia-extract-20221130-006.mrc:169757096:1101","bwb:9780262560030","marc:harvard_bibliographic_metadata/20220215_044.bib.mrc:187958379:3699"],"title":"The Character Of Physical Law","identifiers":{"doi":["10.1604/9780262560030"]},"covers":[7500429],"isbn_13":["9780262560030"],"local_id":["urn:phillips:31867000074141"],"publish_date":"1967","key":"/books/OL25979640M","works":[{"key":"/works/OL17398794W"}],"type":{"key":"/type/edition"},"lccn":["67014527"],"lc_classifications":["QC28 .F4 1965"],"oclc_numbers":["175060","7768875"],"description":{"type":"/type/text","value":"Like any set of oral reflections, The Character of Physical Law has special value as a demonstration of the mind in action. The reader is particularly lucky in Richard Feynman. One of the most eminent and imaginative modern physicists, he was Professor of Theoretical Physics at the California Institute of Technology until his death in 1988. He is best known for his work on the quantum theory of the electromagnetic field, as well as for his later research in the field of low-temperature physics. In 1954 he received the Albert Einstein Award for his outstanding contribution to knowledge in mathematical and physical sciences; in 1965 he was appointed to Foreign Membership in the Royal Society and was awarded the Nobel Prize."},"number_of_pages":173,"languages":[{"key":"/languages/eng"}],"latest_revision":9,"revision":9,"created":{"type":"/type/datetime","value":"2016-10-14T03:38:13.672246"},"last_modified":{"type":"/type/datetime","value":"2026-08-02T16:06:00.149941"}}},"OLID:OL26934042M":{"bib_key":"OLID:OL26934042M","info_url":"http://openlibrary.org/books/OL26934042M/The_character_of_physical_law","preview":"noview","preview_url":"http://openlibrary.org/books/OL26934042M/The_character_of_physical_law","details":{"table_of_contents":[{"level":0,"label":"","title":"The law of gravitation, an example of physical law","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The relation of mathematics to physics","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The great conservation principles","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Symmetry in physical law","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The distinction of past and future","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Probability and uncertainty: the quantum mechanical view of nature","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Seeking new laws.","pagenum":"","type":{"key":"/type/toc_item"}}],"description":{"type":"/type/text","value":"\"Richard Feynman is one of, if not the, most famous physicists of the latter half of the 20th century. In 1964, at Cornell University, he delivered the famous Messenger Lectures. This book, The Character of Physical Law, sprung from these lectures. In this classic work, Feynman explores the relationship between math and physics, describes the great conservation principles, the puzzle of symmetry in physical law, how to reconcile physical problems that yield infinite results with their manifestations in the natural world, and quantum mechanical views of nature. Feynman's accessible speech and conversational style comes through well in each essay; his simple pencil and paper drawings communicate complex ideas as if one were viewing them on a chalk board. This reissue features a foreword by Nobel Laureate Frank Wilczek, which situates the work within modern scholarship and describes why the book is still relevant today. Although he mentions areas where Feynman's theories need \"updating,\" he points out that Feynman's unorthodox and brilliant way of thinking helped develop the general quantum electrodynamics theory, one of the most precise and accurate theories in physical science. Wilczek concludes with the assertion that this book represents Feynman at \"the height of his powers, and that this \"is the single best introduction to modern physics, altogether.\"\"--"},"isbn_10":["0262533413"],"local_id":["urn:sfpl:31223122325823","urn:sfpl:31223122325831"],"full_title":"The character of physical law","lc_classifications":["QC28 .F4 2017","QC28.F4 2017"],"key":"/books/OL26934042M","authors":[{"key":"/authors/OL35793A","name":"Richard Phillips Feynman"}],"contributions":["Wilczek, Frank, writer of foreword"],"isbn_13":["9780262533416"],"pagination":"173 pages","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run06.mrc:44872145:3679","bwb:9780262533416"],"title":"The character of physical law","dewey_decimal_class":["530"],"number_of_pages":173,"languages":[{"key":"/languages/eng"}],"lccn":["2016036636"],"subjects":["Physics"],"publish_date":"2017","publish_country":"mau","by_statement":"Richard Feynman with new foreword by Frank Wilczek","oclc_numbers":["957554696"],"works":[{"key":"/works/OL271750W"}],"type":{"key":"/type/edition"},"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2019-05-24T00:04:12.268542"},"last_modified":{"type":"/type/datetime","value":"2021-09-07T14:56:53.623269"}}},"OLID:OL29761687M":{"bib_key":"OLID:OL29761687M","info_url":"http://openlibrary.org/books/OL29761687M/Character_of_Physical_Law","preview":"noview","preview_url":"http://openlibrary.org/books/OL29761687M/Character_of_Physical_Law","details":{"publishers":["MIT Press"],"source_records":["bwb:9780262341738"],"title":"Character of Physical Law","number_of_pages":184,"isbn_13":["9780262341738"],"languages":[{"key":"/languages/eng"}],"full_title":"Character of Physical Law","lc_classifications":[""],"publish_date":"2017"