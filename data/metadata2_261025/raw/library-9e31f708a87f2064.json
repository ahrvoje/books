date":"1965-01-01","publishers":["M.I.T. Press"],"source_records":["promise:bwb_daily_pallets_2022-03-17"],"title":"The character of physical law","full_title":"The character of physical law","works":[{"key":"/works/OL31415901W"}],"key":"/books/OL43070889M","latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":"2022-12-07T06:24:54.465878"},"last_modified":{"type":"/type/datetime","value":"2023-01-25T18:18:27.606251"}}},"OLID:OL46545239M":{"bib_key":"OLID:OL46545239M","info_url":"http://openlibrary.org/books/OL46545239M/La_legge_fisica","preview":"noview","preview_url":"http://openlibrary.org/books/OL46545239M/La_legge_fisica","thumbnail_url":"https://covers.openlibrary.org/b/id/13316480-S.jpg","details":{"works":[{"key":"/works/OL271750W"}],"title":"La legge fisica","publishers":["Bollati Boringhieri"],"publish_date":"1993","key":"/books/OL46545239M","type":{"key":"/type/edition"},"identifiers":{},"covers":[13316480],"isbn_13":["9788833902616"],"classifications":{},"description":{"type":"/type/text","value":"In questo ciclo di conferenze, il premio Nobel Richard Feynman, parlando a braccio sulla scorta di poche note, racconta a studenti di varia provenienza, con scarse conoscenze matematiche, in che cosa consiste il lavoro del fisico teorico.\r\nIl suo intento non è però di divulgare i contenuti della fisica (ché, tanto, senza equazioni nessuno «potrà mai far capire la natura a “quelli dell’altra cultura”») ma di mostrare il modo in cui essa procede e di rendere in qualche misura consapevoli anche i profani del valore intellettuale dell’impresa. E lo fa col suo stile immediato e antiretorico, senza vaghe affermazioni qualitative, sulla base di esempi concreti tratti dalla fisica di ieri e di oggi, analizzati quanto basta per mettere in luce l’essenza del metodo. Al lettore più esperto non sfuggiranno le osservazioni sottili,\r\nle intuizioni profonde di cui questo libretto, come ogni scritto di Feynman, è ricco: dalla dimostrazione einsteiniana della località delle leggi di conservazione all’analisi del significato della termodinamica, alle considerazioni finali sul futuro della fisica."},"number_of_pages":208,"translated_from":[{"key":"/languages/eng"}],"languages":[{"key":"/languages/ita"}],"physical_format":"Paperback","publish_places":["Italy"],"translation_of":"The Character of Physical Law","latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2023-02-13T17:23:08.081287"},"last_modified":{"type":"/type/datetime","value":"2023-02-13T17:24:29.249090"}}},"OLID:OL61538386M":{"bib_key":"OLID:OL61538386M","info_url":"http://openlibrary.org/books/OL61538386M/Ο_Χαρακτήρας_του_Φυσικού_Νόμου","preview":"noview","preview_url":"http://openlibrary.org/books/OL61538386M/Ο_Χαρακτήρας_του_Φυσικού_Νόμου","thumbnail_url":"https://covers.openlibrary.org/b/id/15209958-S.jpg","details":{"works":[{"key":"/works/OL17398794W"}],"title":"Ο Χαρακτήρας του Φυσικού Νόμου","publishers":["Πανεπιστημιακές Εκδόσεις Κρήτης"],"publish_date":"1990","key":"/books/OL61538386M","type":{"key":"/type/edition"},"identifiers":{},"isbn_10":["960730912X"],"physical_dimensions":"23.5 x 15.7 x 0.7 centimeters","weight":"328 grams","table_of_contents":[{"level":2,"label":"Πρόλογος","title":"V","pagenum":"","type":{"key":"/type/toc_item"}},{"level":1,"label":"Διάλεξη 1: Ο νόμος της βαρύτητας, παράδειγμα φυσικού νόμου","title":"1","pagenum":"","type":{"key":"/type/toc_item"}},{"level":1,"label":"Διάλεξη 2: Η σχέση των Μαθηματικών με τη Φυσική","title":"25","pagenum":"","type":{"key":"/type/toc_item"}},{"level":1,"label":"Διάλεξη 3: Οι μεγαλειώδεις αρχές διατήρησης","title":"47","pagenum":"","type":{"key":"/type/toc_item"}},{"level":1,"label":"Διάλεξη 4: Η συμμετρία στο φυσικό νόμο","title":"71","pagenum":"","type":{"key":"/type/toc_item"}},{"level":1,"label":"Διάλεξη 5: Η διάκριση ανάμεσα στο παρελθόν και το μέλλον","title":"93","pagenum":"","type":{"key":"/type/toc_item"}},{"level":1,"label":"Διάλεξη 6: Πιθανότητα και αβεβαιότητα. Η κβαντομηχανική άποψη για τη φύση","title":"109","pagenum":"","type":{"key":"/type/toc_item"}},{"level":1,"label":"Διάλεξη 7: Αναζητώντας νέους νόμους","title":"129","pagenum":"","type":{"key":"/type/toc_item"}}],"publish_places":["Ηράκλειο Κρήτης, Ελλάδα"],"copyright_date":"1967","edition_name":"First edition","languages":[{"key":"/languages/gre"}],"translation_of":"The Character of Physical Law","translated_from":[{"key":"/languages/eng"}],"physical_format":"Paperback","number_of_pages":150,"covers":[15209958],"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2026-04-13T07:37:23.914056"},"last_modified":{"type":"/type/datetime","value":"2026-04-13T07:53:31.951861"}}}}}