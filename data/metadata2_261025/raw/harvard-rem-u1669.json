dentifier":"http://id.loc.gov/rwo/agents/n83130728."}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","@valueURI":"http://id.loc.gov/vocabulary/contentTypes/txt","#text":"text"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},"dateIssued":{"@encoding":"marc","#text":"2025"},"issuance":"monographic"},{"@eventType":"publication","place":[{"placeTerm":{"@type":"text","#text":"Abingdon, Oxon ;"}},{"placeTerm":{"@type":"text","#text":"New York, NY :"}}],"agent":[{"namePart":"Routledge,","role":{"roleTerm":"publisher"}},{"namePart":"Routledge,","role":{"roleTerm":"publisher"}}],"dateIssued":"2025.","issuance":"single unit"}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@authority":"marccategory","#text":"text"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"vi, 165 pages: illustrations; 24 cm"},{"form":{"@type":"Illustrative content","#text":"illustrations"}}],"abstract":{"@type":"Summary","#text":"\"This book critically analyses the conceptual understanding of financial investigation and financial intelligence among UK law enforcement authorities and their commentators. The work provides a critical review of financial investigation, including international standards, and how it is perceived and applied by law enforcement agencies. It adopts the position that financial investigation is an evidence-gathering process and not simply related to asset recovery. Here, the concept of \"following the money\" is superseded by the wider approach of \"following the financial footprint\" by generalist and specialist investigators and analysts. The book focuses on identifying the financial footprint as a skillset for routine investigation application inclusive of the emerging threat posed by the digital environment, including cryptocurrencies. It assesses the terminology, typologies and structures associated with the subject area at national and international level. It also examines the historical trajectory of financial investigation to understand current perceptions of it within law enforcement, among government ministers and policy makers. The book will be of interest to students, academics and policy-makers internationally working in the areas of Criminal Law, Criminology and Finance\"-- Provided by publisher."},"tableOfContents":{"@type":"Contents","#text":"Terminology and its effect upon perceptions of financial investigation -- Financial investigation and typologies associated with its application -- Historical trajectory, government reports, and financial investigation research -- International standards and independent commentators -- Financial intelligence and the National Intelligence Model -- The financial footprint and digital investigation."},"note":[{"@type":"statement of responsibility","#text":"Craig Hughes and David Hicks."},{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"e-uk---"}},{"@authority":"lcsh","topic":["Commercial crimes","Law and legislation"],"geographic":"Great Britain"},{"@authority":"lcsh","topic":["Financial institutions","Law and legislation"],"geographic":"Great Britain"},{"@authority":"lcsh","topic":["Financial institutions","Law and legislation","Criminal provisions"],"geographic":"Great Britain"},{"@authority":"lcsh","topic":["Finance","Law and legislation","Criminal provisions"],"geographic":"Great Britain"},{"@authority":"lcsh","topic":"Criminal law","geographic":"Great Britain"},{"@authority":"lcsh","topic":"Criminology","geographic":"Great Britain"},{"@authority":"rvm","topic":