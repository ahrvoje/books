ository","@valueURI":"http://isni.org/isni/0000000463633294","#text":"Fung Library, Harvard University"},"shelfLocator":"AS4.Z9 H8 1967"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Fung Library"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990069344210203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"006934421"}},"processingDate":"2025-05-16T05:14Z"}},{"sets":null}],"recordInfo":{"recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"700206"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990069344210203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}},{"@version":"3.8","titleInfo":{"nonSort":{"@space":"preserve","#text":"The  "},"title":"US government, citizen groups and the Cold War ","subTitle":"the state-private network "},"name":[{"@type":"personal","namePart":"Laville, Helen."},{"@type":"personal","namePart":["Wilford, Hugh,",{"@type":"date","#text":"1965-"}]}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"marcgt","#text":"conference publication"},{"@authority":"fast","#text":"Conference papers and proceedings"},{"@authority":"fast","#text":"History"}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},{"placeTerm":{"@type":"text","#text":"London "}},{"placeTerm":{"@type":"text","#text":"New York "}}],"issuance":"monographic","agent":{"namePart":"Routledge"},"dateIssued":"2006"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"xviii, 240 p. ; 24 cm."},"abstract":{"@type":"Summary","#text":"\"The US Government, Citizen Groups and the Cold War: The State-Private Network,\" edited by Helen Laville and Hugh Wilford, explores the intricate relationships between the U.S. government and various private organizations during the Cold War. This collection of case studies examines interactions with women's groups, religious bodies, labor unions, internationalist organizations, intellectuals, media, and students, highlighting how these collaborations served as both practical methods of communication and ideological constructs promoting American values of freedom and voluntarism. The volume offers a fresh perspective on propaganda and American foreign policy by moving beyond traditional state-dominated interpretations and analyzing the power dynamics between the state and private entities."},"tableOfContents":{"@type":"Contents","#text":"Introduction : negotiating freedom / Scott Lucas -- Conceptualising the state-private network in American foreign policy / Inderjeet Parmar -- Clark Eichelberger and the negotiation of internationalism / Andrew Johnston -- The importance of being (in)earnest : voluntary associations and the irony of the state-private network in the early Cold War / Helen Laville -- From cooperation to covert actions : the United States government and students, 1940-52 / Karen M. Paget -- Building a community around the Pax Americana : the US government and exchange programmes in the 1950s / Giles Scott-Smith --'The finest labour network in Europe' : American labour and the Cold War / Julia Angster -- In search of a clear and overarching American policy : the Reporter magazine (1949-1968) and the Cold War / Elke van Cassel -- Double vision, double analysis : the role of interpretation, negotiation, and compromise in the state-private network and British American studies / Ali Fisher -- Ambassadors of the screen : film and the state-private network in Cold War America / Tony Shaw -- Religious non-profit organizations, the Cold War, the state, and resurgent evangelicalism, 1945-90 / Axel R. Schafer -- 'The permanent revolution'? : the New York intellectuals, the CIA, and the cultural Cold War / Hugh Wilford -- Public diplomacy and the private sector : the United States Information Agency, it's predecessors, and the private sector / Nicholas J. Cull."},"note":[{"@type":"statement of responsibility","#text":"edited by Helen Laville and Hugh Wilford."},"\"Based on a conference on \"The American State-Private Network in the Cold War\" held in Birmingham, England in June 2003\"--T.p. verso.",{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"n-us---"}},{"@authority":"lcsh","geographic":"United States","topic":["Foreign relations","Citizen participation"],"temporal":"1945-1989","genre":"Congresses"},{"@authority":"lcsh","topic":["Public-private sector cooperation","History"],"geographic":"United States","temporal":"20th century","genre":"Congresses"},{"@authority":"lcsh","topic":["Citizens' associations","History"],"geographic":"United States","temporal":"20th century","genre":"Congresses"},{"@authority":"lcsh","topic":["Civil society","History"],"geographic":"United States","temporal":"20th century","genre":"Congresses"},{"@authority":"fast","temporal":"1900 - 1999"}],"classification":[{"@authority":"lcc","#text":"JZ1480 .U16 2006"},{"@edition":"22","@authority":"ddc","#text":"327.73/009/045"}],"relatedItem":[{"titleInfo":{"title":"Studies in intelligence series"}},{"@type":"series","titleInfo":{"title":"Cass series--studies in intelligence"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990099259260203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0415356083 (hardback)"},{"@type":"isbn","#text":"9780415356084"},{"@type":"lccn","#text":"^^2005005684"},{"@type":"oclc","#text":"58055367"}],"location":[{"physicalLocation":{"@displ