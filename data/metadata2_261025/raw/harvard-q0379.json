{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Fatland&limit=10&title=The Border","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":[{"nonSort":{"@space":"preserve","#text":"The  "},"title":"border ","subTitle":"a journey around Russia: through North Korea, China, Mongolia, Kazakhstan, Azerbaijan, Georgia, Ukraine, Belarus, Lithuania, Poland, Latvia, Estonia, Finland, Norway and the Northwest Passage "},{"@type":"uniform","@nameTitleGroup":"1","title":"Grensen. English"}],"name":[{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":["Fatland, Erika,",{"@type":"date","#text":"1983-"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}],"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJjxwQXpQ9bVYdG36yFYfq"},{"@type":"personal","namePart":"Dickson, Kari","role":{"roleTerm":{"@type":"text","#text":"translator"}}}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"rdacontent","#text":"still image"},{"@authority":"rdacontent","#text":"cartographic image"},{"@authority":"fast","#text":"Travel writing"},{"@authority":"lcgft","#text":"Travel writing"},{"@authority":"rvmgf","#text":"Récits de voyages."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},"dateIssued":{"@encoding":"marc","#text":"2020"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"London, UK :"}},"agent":{"namePart":"MacLehose Press,","role":{"roleTerm":"publisher"}},"dateIssued":"2020."}],"language":[{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},{"@objectPart":"translation","languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"nor"}}],"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@authority":"marccategory","#text":"text"},{"@authority":"marcsmd","#text":"regular print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"611 pages, 16 unnumbered pages of plates : color illustrations, maps ; 24 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Color content","#text":"polychrome"}},{"form":{"@type":"Illustrative content","#text":"map"}}],"abstract":{"@type":"Summary","#text":"Erika Fatland travels along the seemingly endless Russian border, from North Korea in the Far East through Russia's bordering states in Asia and the Caucasus, crossing the Caspian Ocean and the Black Sea along the way. The Border is a book about Russia and Russian history without its author ever entering Russia itself; a book about being the neighbour of that mighty, expanding empire throughout history. It is a chronicle of the colourful, exciting, tragic and often unbelievable histories of these bordering nations, their cultures, their people, their landscapes. Through her last three documentary books, one about terrorism in Beslan, one about the 2011 terror attacks in Norway and one about post-Soviet Central Asia, social anthropologist Erika Fatland has established herself as a sharp observer and an outstanding interviewer at the forefront of Nordic non-fiction."},"tableOfContents":{"@type":"Contents","#text":"The ocean -- Asia -- The Caucasus -- Europe."},"note":[{"@type":"statement of responsibility","#text":"Erika Fatland ; translated from the Norwegian by Kari Dickson."},{"@type":"bibliography","#text":"Includes bibliographical references and index."},{"@type":"language","#text":"Translated from the Norwegian."},"Stanford Travel Writing Awards : Shortlist, 2021","First published in the Norwegian language as Grensen by Kagge Forlag in 2017.","Translated from the Norwegian."],"subjec