#text":"Sir,"},{"@type":"date","#text":"1890-1971"}],"role":{"roleTerm":{"@type":"text","#text":"writer of foreword"}},"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJxmDjJ8RmvQypx6j9RdwC"},{"@type":"personal","namePart":"Nasar, Sylvia","role":{"roleTerm":{"@type":"text","#text":"writer of introduction"}},"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJwXby46GTKvYCvYfGRkDq"}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"biography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"Medical Subject Headings","#text":"Biography"},{"@authority":"fast","#text":"Biographies"},{"@authority":"fast","#text":"History"},{"@authority":"lcgft","#text":"Biographies."},{"@authority":"rvmgf","#text":"Biographies."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},"dateIssued":{"@encoding":"marc","#text":"2001"},"copyrightDate":{"@encoding":"marc","#text":"1996"},"issuance":"monographic","edition":"First Touchstone edition."},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"New York :"}},"agent":{"namePart":"Touchstone Book, published by Simon & Schuster,","role":{"roleTerm":"publisher"}},"dateIssued":"2001."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xx, 226 pages : illustrations, portraits ; 22 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Illustrative content","#text":"portrait"}}],"abstract":[{"@type":"Summary","#text":"\"By identifying the structure of DNA, the molecule of life, Francis Crick and James Watson revolutionized biochemistry and won themselves a Nobel Prize. At the time, Watson was only 24, a young scientist hungry to make his mark. His uncompromisingly honest account of the heady days of their thrilling sprint against other world-class researchers to solve one of science's greatest mysteries gives a dazzlingly clear picture of a world of brilliant scientists with great gifts, very human ambitions, and bitter rivalries. With humility unspoiled by false modesty, Watson relates his and Crick's desperate efforts to beat Linus Pauling to the Holy Grail of life sciences, the identification of the basic building block of life. Never has a scientist been so truthful in capturing in words the flavor of his work.\"--Back cover"},{"@type":"Summary","#text":"One of the two discoverers of DNA recalls the lively scientific quest that led to this breakthrough, from the long hours in the lab to the after-hours socializing and the financial struggles that almost sank their project."}],"tableOfContents":{"@type":"Contents","#text":"Foreword / Sir Lawrence Bragg -- Preface -- Introduction / Sylvia Nasar -- The double helix."},"note":{"@type":"statement of responsibility","#text":"James D. Watson."},"subject":[{"@authority":"lcsh","topic":["DNA","Research","History"]},{"@authority":"lcsh","topic":["Genetic code","Research","History"]},{"@authority":"lcsh","topic":["Molecular biology","Research","History"]},{"@authority":"lcsh","topic":"Molecular biologists","genre":"Biography"},{"@authority":"mesh","topic":["Biochemistry","history"]},{"@authority":"mesh","topic":"Biochemistry","genre":"personal narratives"},{"@authority":"rvm","topic":["ADN","Recherche","Histoire"]},{"@authority":"rvm","topic":["Code génétique","Recherche","Histoire"]},{"@authority":"rvm","topic":["Biologie moléculaire","Recherche","Histoire"]},{"@authority":"rvm","topic":"Biologistes moléculaires","genre":"Biographies"},{"@authority":"cct","topic":"DNA"},{"@authority":"cct","topic":["Biochemistry","History"],"geographic":"20th ce