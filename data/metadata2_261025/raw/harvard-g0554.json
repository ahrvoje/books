"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/000000046073724X","#text":"Cabot Science Library, Harvard University"},"shelfLocator":"QH506 .W399 2001"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Cabot Science"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990087583890203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"008758389"}},"processingDate":"2026-09-11T04:12Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"UKM"},"recordCreationDate":{"@encoding":"marc","#text":"011115"},"recordChangeDate":{"@encoding":"iso8601","#text":"20260907"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990087583890203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"@version":"3.8","titleInfo":{"nonSort":{"@space":"preserve","#text":"The  "},"title":"double helix ","subTitle":"a personal account of the discovery of the structure of DNA / by James D. Watson"},"name":{"@usage":"primary","@type":"personal","namePart":["Watson, James D.,",{"@type":"date","#text":"1928-2025"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"New York "}}],"dateIssued":[{"@encoding":"marc","#text":"1969"},"1969, c1968"],"copyrightDate":{"@encoding":"marc","#text":"1968"},"issuance":"monographic","agent":{"namePart":"New American Library"}},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authorit