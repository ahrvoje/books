i/0000000460377627","#text":"Ernst Mayr Library of the Museum of Comparative Zoology, Harvard University"},"shelfLocator":"QD341.A2 W315 1968"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":["Cabot Science","Harvard Forest","Gutman Education","Houghton","Kirkland","Lamont","Museum Comp Zoology","Countway Medicine","Widener"]},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990006732710203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"000673271"}},"processingDate":"2026-09-24T04:12Z"}},{"sets":null}],"recordInfo":{"recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"680301"},"recordChangeDate":{"@encoding":"iso8601","#text":"20210723"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990006732710203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"@version":"3.8","titleInfo":{"title":"Genes, girls, and Gamow "},"name":{"@usage":"primary","@type":"personal","namePart":["Watson, James D.,",{"@type":"date","#text":"1928-2025"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}},"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJmTk79KXq8kc3VDHrdRKd"},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"biography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"Medical Subject Headings","#text":"Personal Narrative"},{"@authority":"fast","#text":"Personal narratives"},{"@authority":"fast","#text":"Biographies"},{"@authority":"lcgft","#text":"Personal narratives"},{"@authority":"rbgenr","#text":"Biographies."},{"@authority":"rvmgf","#text":"Récits personnels."}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},{"placeTerm":{"@type":"text","#text":"Oxford "}},{"placeTerm":{"@type":"text","#text":"New York "}}],"dateIssued":[{"@encoding":"marc","#text":"2001"},"©2001"],"issuance":"monographic","agent":{"namePart":"Oxford University Press"}},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xxvii, 275 pages : illustrations, portraits ; 24 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Illustrative content","#text":"portrait"}}],"abstract":{"@type":"Review","#text":"\"How Jim Watson and Francis Crick deduced the double-helical structure of DNA first became known to the general public in 1968 through Watson's watershed The Double Helix.\" \"Genes, Girls and Gamow takes up the story of Watson's life from where The Double Helix finishes, the announcement of the double helix in the journal Nature in April 1953. The diary-like entries describe with freshness and immediacy Watson adjusting to new-found fame, carrying out tantalizing experiments on the role of RNA in biology, and falling in love. The book is enlivened by copies of hand-written letters from the larger-than-life, Russian-born theoretician George Gamow, who had made major contributions to physics but, in this period, was also intrigued by genes, RNA, and the elusive genetic code.\"--Jacket."},"note":[{"@type":"statement of responsibility","#text":"James D. Watson."},"Follows on from Double helix."],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"n-us---"}},{"@authority":"lcsh","topic":"Molecular biologists","geographic":"United States","genre":"Biography"},{"@authority":"mesh","topic":"Molecular Biology"},{"@authority":"rvm","topic":"Biologistes moléculaires","geographic":"États-Unis","genre":"Biographies"},{"@authority":"fast","topic":"Molecula