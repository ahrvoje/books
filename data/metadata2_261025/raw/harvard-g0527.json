":"author of introduction, etc"}}},{"@type":"personal","namePart":"Raynor, Michael E.","role":{"roleTerm":{"@type":"text","#text":"author"}}}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"rdacontent","#text":"still image"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"mau"},{"@type":"text","@authority":"marccountry","#text":"Massachusetts"}]},"dateIssued":{"@encoding":"marc","#text":"2024"},"copyrightDate":{"@encoding":"marc","#text":"2024"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Boston :"}},"agent":{"namePart":"Harvard Business Review Press,","role":{"roleTerm":"publisher"}},"dateIssued":[2024]}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xvi, 296 pages : illustrations, charts ; 25 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}}],"abstract":{"@type":"Summary","#text":"\"Christensen and Raynor give advice on the business decisions crucial to achieving truly disruptive growth and propose guidelines for developing your own disruptive growth engine. The authors identify the forces that cause managers to make bad decisions as they package and shape new ideas--and offer new frameworks to help create the right conditions, at the right time, for a disruption to succeed. This is a must-read for all senior managers and business leaders responsible for innovation and growth, as well as for members of their teams.\" -- publisher description."},"tableOfContents":{"@type":"Contents","#text":"The growth imperative -- How can we beat our most powerful compe