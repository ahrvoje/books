mazonaws.com/harvard.librarycloud.marc/990039547460203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"003954746"}},"processingDate":"2023-03-24T08:06Z"}},{"sets":null}],"recordInfo":{"recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"720225"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990039547460203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}},{"titleInfo":{"title":"Lombard street","subTitle":"a description of the money market"},"name":[{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":["Bagehot, Walter",{"@type":"date","#text":"1826-1877"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},{"@type":"corporate","namePart":"Scribner, Armstrong, and Company","role":{"roleTerm":{"@type":"text","#text":"publisher."}}}],"typeOfResource":"text","genre":{"@authority":"rbgenr","#text":"Advertisements-New York (State)-New York-19th century."},"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"New York"}}],"publisher":"Scribner, Armstrong & Co.","dateIssued":"1873","issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"viii, 359 p. ; 20 cm."},"tableOfContents":"A general view of Lombard Street -- How Lombard Street came to exist, and why it assumed its present form -- The position of the Chancellor of the Exchequer in the money market -- The mode in which the value of money is settled in Lombard Street -- Why Lombard Street is often very dull, and sometimes extremely excited -- A more exact account of the mode in which the Bank of England has discharged its duty of retaining a good bank reserve, and of administering it effectually -- The government of the Bank of England -- The joint stock banks -- The private banks -- The bill-brokers -- The principles which should regulate the amount of the banking reserve to be kept by the Bank of England -- Conclusion -- Appendix Note A. Liabilities and cash reserve of the chief banking systems -- Note B. Extract from evidence given by Mr. Alderman Salomons before the House of Commons Select Committee in 1858 -- Note C. Statement of circulation and deposits of the Bank of Dundee at intervals of ten years, between 1764 and 1864 -- Note D. Meeting of the proprietors of the Bank of England, September 13, 1866.","note":{"@type":"statement of responsibility","#text":"by Walter Bagehot."},"subject":[{"geographicCode":[{"@authority":"marcgac","#text":"e-uk---"},{"@authority":"marcgac","#text":"e-uk-en"}]},{"@authority":"lcsh","topic":"Money"},{"@authority":"lcsh","topic":"Banks and banking","geographic":["England","London"]}],"classification":{"@authority":"lcc","#text":"HG3000.L82 B3 1873"},"relatedItem":[{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":{"title":"Lombard street"},"name":{"namePart":"Bagehot, Walter, 1826-1877."},"originInfo":{"publisher":"New York, Scribner, Armstrong & Co., 1873"},"identifier":{"@type":"local","#text":"(OCoLC)663351262"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990049073770203941/catalog"}}],"identifier":[{"@type":"lccn","#text":"^^^06032303^"},{"@type":"oclc","#text":"3600613"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","#text":"Master Microforms, Harvard University"},"shelfLocator":"Film Mas 22004","holdingSimple":{"copyInformation":{"note":{"@type":"reproduction","#text":"Microfilm."}}}},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"HG3000.L82 B3 1873"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000123374118","#text":"Baker Library, Harvard Business School, Harvard University"},"shelfLocator":"KCB B144"},{"url":{"@access":"raw object","#text":"https://hdl.handle.net/2027/hvd.LI46SU"}}],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":["Baker Business","Master Microforms","Widener"]},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990049073770203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"004907377"}},"processingDate":"2023-11-07T06:14Z"}},{"sets":null}],"recordInfo":{"recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"780203"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990049073770203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}},{"titleInfo":{"title":"Lombard Street","subTitle":"a description of the money market"},"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":["Bagehot, Walter",{"@type":"date","#text":"1826-1877"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"New York"}}],"publisher":"Wiley","dateIssued":["c1999",{"@encoding":"marc","#text":"1999"}],"issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"xiv, 359 p. ; 23 cm."},"abstract":{"@type":"Review","#text":"\"The English precursor to Wall Street, London's Lombard Street is the original district of finance and the birthplace of the money market. Fast-paced and highly-charged, it is a hotbed of financial activity whose impact is felt not just nationally, but globally.\" \"The chef d'oeuvre of Walter Bagehot, Lombard Street began as a series of articles the esteemed essayist and financial advisor had written for the Economist during the 1850s. First published in book form in 1873, it is a vivid description of the money market that seamlessly brings together theoretical analyses, historical anecdotes, and incisive commentary on sociology, politics, and the Street's various personalities.\" \"Perhaps most importantly, Lombard Street features Bagehot's prescription for crisis management, which after nearly 150 years, remains the formula of choice for containing - and curtailing - financial crises.\"--Jacket."},"tableOfContents":"Introductory -- A General View of Lombard Street -- How Lombard Street Came to Exist, and Why it Assumed its Present Form -- The Position of the Chancellor of the Exchequer in the Money Market -- The Mode in Which the Value of Money is Settled in Lombard Street -- Why Lombard Street is Often Very Dull, and Sometimes Extremely Excited -- A More Exact Account of the Mode in Which the Bank of England has Discharged its Duty of Retaining a Good Bank Reserve, and of Administering it Effectually -- The Government of the Bank of England -- The Joint Stock Banks -- The Private Banks -- The Bill-Brokers -- The Principles Which Should Regulate the Amount of the Banking Reserve to be Kept by the Bank of England -- Liabilities and Cash Reserve of the Chief Banking Systems -- Extract From Evidence Given by Mr. Alderman Salomons Before the House of Commons Select Committee in 1858 -- Statement of Circulation and Deposits of the Bank of Dundee at Intervals of Ten Years, Between 1764 and 1864 -- Meeting of the Proprietors of the Bank of England, September 13, 1866.","note":[{"@type":"statement of responsibility","#text":"Walter Bagehot."},"Originally published: New York : Scribner, Armstrong, 1873. With new foreword."],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"e-uk---"}},{"temporal":"Geschichte 1764"},{"@authority":"lcsh","topic":"Banks and banking","geographic":["England","London"]},{"@authority":"lcsh","topic":"Banks and banking","geographic":"Great Britain"},{"@authority":"lcsh","topic":"Finance","geographic":["England","London"]},{"@authority":"lcsh","topic":"Finance","geographic":"Great Britain"}],"classification":[{"@authority":"lcc","#text":"HG3000.L82 B3 1999"},{"@edition":"21","@authority":"ddc","#text":"332/.09421"}],"relatedItem":[{"titleInfo":{"title":"Wiley investment classics"}},{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":{"title":"Lombard Street"},"name":{"namePart":"Bagehot, Walter, 1826-1877."},"originInfo":{"publisher":"New York : J. Wiley, ©1999"},"identifier":{"@type":"local","#text":"(OCoLC)651834095"}},{"@type":"series","titleInfo":{"title":"Wiley investment classics"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990080418140203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0471344990 (cloth : alk. paper)"},{"@type":"isbn","#text":"0471345369 (pbk. : alk. paper)"},{"@type":"lccn","#text":"^^^98051463^"},{"@type":"oclc","#text":"40354828"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000123374118","#text":"Baker Library, Harvard Business School, Harvard University"},"shelfLocator":"HG3000.L82 B3 1999"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"HG3000.L82 B3 1999"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":["Baker Business","Widener"]},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990080418140203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"008041814"}},"processingDate":"2025-02-16T06:17Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"990419"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990080418140203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}}]}}