om members of his kitchen crews to his writing, publishing, and television partners, to his daughter and his closest friends, to piece together a remarkably full, vivid, and nuanced vision of Tony's life and work."},"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2021-09-30T18:27:34.048481"},"last_modified":{"type":"/type/datetime","value":"2025-09-02T02:17:21.274452"}}},"OLID:OL34785610M":{"bib_key":"OLID:OL34785610M","info_url":"http://openlibrary.org/books/OL34785610M/Bourdain","preview":"noview","preview_url":"http://openlibrary.org/books/OL34785610M/Bourdain","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7979823A","name":"Laurie Woolever"}],"isbn_13":["9781526645166"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["PS3552.O8328"],"publish_date":"2021","publishers":["Bloomsbury Publishing Plc"],"source_records":["bwb:9781526645166"],"subjects":["American literature"],"title":"Bourdain","pagination":"464","subtitle":"In Stories","full_title":"Bourdain In Stories","works":[{"key":"/works/OL24488505W"}],"key":"/books/OL34785610M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-10-08T01:32:53.992508"},"last_modified":{"type":"/type/datetime","value":"2021-10-08T01:32:53.992508"}}},"OLID:OL36009149M":{"bib_key":"OLID:OL36009149M","info_url":"http://openlibrary.org/books/OL36009149M/Bourdain","preview":"noview","preview_url":"http://openlibrary.org/books/OL36009149M/Bourdain","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7979823A","name":"Laurie Woolever"}],"isbn_13":["9780062909121"],"languages":[{"key":"/languages/eng"}],"pagination":"464","publish_date":"2021","publishers":["HarperCollins Publishers"],"source_records":["bwb:9780062909121"],"subjects":["Cooks, biography","Television personalities"],"title":"Bourdain","subtitle":"The Definitive Oral Biography","full_title":"Bourdain The Definitive Oral Biography","works":[{"key":"/works/OL2