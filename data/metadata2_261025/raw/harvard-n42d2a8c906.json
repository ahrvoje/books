{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Kennedy&limit=10&title=The Secret History of the Rape Kit","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":[{"nonSort":{"@space":"preserve","#text":"The  "},"title":"secret history of the rape kit ","subTitle":"a true crime story "},{"@type":"alternative","title":"True crime story"}],"name":{"@usage":"primary","@type":"personal","namePart":["Kennedy, Pagan,",{"@type":"date","#text":"1962-"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}},{"roleTerm":{"@type":"code","@authority":"marcrelator","#text":"aut"}}],"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJckRd9R8yt778RJP9Vgrq"},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"marcgt","#text":"biography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"fast","#text":"History"},{"@authority":"fast","#text":"True crime stories"},{"@authority":"lcgft","#text":"True crime stories."},{"@authority":"rvmgf","#text":"Récits criminels."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},"dateIssued":{"@encoding":"marc","#text":"2025"},"copyrightDate":{"@encoding":"marc","#text":"2025"},"issuance":"monographic","edition":"Vintage Books original edition."},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"New York :"}},"agent":{"namePart":"Vintage Books, a division of Penguin Random House LLC,","role":{"roleTerm":"publisher"}},"dateIssued":"2025."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@authority":"marccategory","#text":"text"},{"@authority":"marcsmd","#text":"regular print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xi, 240 pages : illustrations ; 21 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}}],"abstract":{"@type":"Summary","#text":"\"In 1972, Martha 'Marty' Goddard volunteered at a crisis hotline, counseling girls who had been molested. By the end of the decade, she had launched a campaign pushing hospitals and police departments to collect evidence of sexual assault and treat survivors with dignity. She designed a new kind of forensics tool--the rape kit--and new practices of evidence collection that spread across the country. Yet even as Marty fought for women's rights, she allowed a man to take credit for her work and then vanished into obscurity. [This book] chronicles one journalist's mission to understand a crucial innovation and the problematic history of forensics in America. As Pagan Kennedy hunts for answers to the mystery of Marty Goddard, she reflects on her own experiences with sexual assault and her desire for justice\"--Back of cover."},"tableOfContents":{"@type":"Contents","#text":"Part 1: Evidence -- Part 2: Un-gaslighted."},"note":[{"@type":"statement of responsibility","#text":"Pagan Kennedy."},{"@type":"bibliography","#text":"Includes bibliographical references (pages 217-240)."}],"subject":[{"@authority":"lcsh","topic":["Rape","Investigation","History"]},{"@authority":"lcsh","topic":["Rape kits","History"]},{"@authority":"lcsh","topic":["Forensic sciences","History"]},{"@authority":"mesh","topic":["Forensic Medicine","history"]},{"@authority":"mesh","topic":["Sex Offenses","legislation & jurisprudence"]},{"@authority":"rvm","topic":["Criminalistique","Histoire"]},{"@authority":"rvm","topic":["Viol","Enquêtes","Histoire"]},{"@authority":"bisacsh","topic":"TRUE CRIME / Sexual Assault"},{"@authority":"bisacsh","topic":"SOCIAL SCIENCE / Women's Studies"},{"@authority":"bisacsh","topic":"BIOGRAPHY & AUTOBIOGRAPHY / Women"