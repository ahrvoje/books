tentSource":{"@authority":"marcorg","#text":"CSL"},"recordCreationDate":{"@encoding":"marc","#text":"840329"},"recordChangeDate":{"@encoding":"iso8601","#text":"20160408"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990015236570203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}},{"titleInfo":[{"title":"Convex polyhedra"},{"@type":"uniform","@nameTitleGroup":"1","title":"Vypuklye mnogogranniki. English"}],"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":["Aleksandrov, A. D. (Aleksandr Danilovich)",{"@type":"date","#text":"1912-1999"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},"text"],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"gw"},{"@type":"text","@authority":"marccountry","#text":"Germany"}]},{"placeTerm":{"@type":"text","#text":"Berlin"}},{"placeTerm":{"@type":"text","#text":"New York"}}],"publisher":"Springer","dateIssued":["c2005",{"@encoding":"marc","#text":"2005"}],"edition":"1st ed. 2005.","issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marccategory","#text":"electronic resource"},{"@authority":"marcsmd","#text":"remote"},{"@type":"media","@authority":"","#text":"computer"},{"@type":"carrier","@authority":"","#text":"online resource"}],"extent":"1 online resource (549 p.)"},"abstract":{"@type":"Summary","#text":"Convex Polyhedra is one of the classics in geometry. There simply is no other book with so many of the aspects of the theory of 3-dimensional convex polyhedra in a comparable way, and in anywhere near its detail and completeness. It is the definitive source of the classical field of convex polyhedra and contains the available answers to the question of the data uniquely determining a convex polyhedron. This question concerns all data pertinent to a polyhedron, e.g. the lengths of edges, areas of faces, etc. This vital and clearly written book includes the basics of convex polyhedra and collects the most general existence theorems for convex polyhedra that are proved by a new and unified method. It is a wonderful source of ideas for students. The English edition includes numerous comments as well as added material and a comprehensive bibliography by V.A. Zalgaller to bring the work up to date. Moreover, related papers by L.A.Shor and Yu.A.Volkov have been added as supplements to this book."},"tableOfContents":"Basic Concepts and Simplest Properties of Convex Polyhedra -- Methods and Results -- Uniqueness of Polyhedra with Prescribed Development -- Existence of Polyhedra with Prescribed Development -- Gluing and Flexing Polyhedra with Boundary -- Congruence Conditions for Polyhedra with Parallel Faces -- Existence Theorems for Polyhedra with Prescribed Face Directions -- Relationship Between the Congruence Condition for Polyhedra with Parallel Faces and Other Problems -- Polyhedra with Vertices on Prescribed Rays -- Infinitesimal Rigidity of Convex Polyhedra with Stationary Development -- Infinitesimal Rigidity Conditions for Polyhedra with Prescribed Face Directions -- Supplements.","note":[{"@type":"statement of responsibility","#text":"A.D. Alexandrov."},"Description based upon print version of record.",{"@type":"bibliography","#text":"Includes bibliographical references (p. [525]-536) and index."},{"@type":"language","#text":"English"}],"subject":[{"@authority":"lcsh","topic":"Polyhedra"},{"@authority":"lcsh","topic":"Convex surfaces"}],"classification":[{"@authority":"lcc","#text":"QA491 .A413 2005"},{"@authority":"ddc","#text":"516/.156"}],"relatedItem":[{"titleInfo":{"title":"Springer monographs in mathematics"}},{"@type":"series","titleInfo":{"title":"Springer Monographs in Mathematics"},"identifier":[{"@type":"issn","#text":"2196-9922"},{"@type":"local","#text":"(CKB)1000000000498741"}]},null,null,{"@type":"series","titleInfo":{"title":"Springer monographs in mathematics"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99153554659203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"1-280-33760-5"},{"@type":"isbn","#text":"9786610337606"},{"@type":"isbn","#text":"3-540-26340-3"},{"@type":"doi","#text":"10.1007/b137434"},{"@type":"oclc","#text":"262680671"}],"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99153554659203941","processingDate":"2024-08-07T06:58Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":["aacr","rda"],"recordContentSource":{"@authority":"marcorg","#text":"MiAaPQ"},"recordCreationDate":{"@encoding":"marc","#text":"041207"},"recordChangeDate":{"@encoding":"iso8601","#text":"20200520"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99153554659203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"titleInfo":[{"title":"First Siberian Winter School \"Algebra and Analysis\"","subTitle":"proceedings of the First Siberian School, Kemerovo State University, Kemerovo, 1988"},{"@type":"uniform","@nameTitleGroup":"1","title":"Algebra i analiz. English"}],"name":[{"@nameTitleGroup":"1","@type":"conference","namePart":"Siberian Winter School \"Algebra and Analysis\" (1st : 1987 : Kemerovo, R.S.F.S.R.)","role":{"roleTerm":{"@type":"text","#text":"creator"}}},{"@type":"personal","namePart":["Ershov, I͡Uriĭ Leonidovich",{"@type":"termsOfAddress","#text":"(Harvard local name)"}],"role":{"roleTerm":{"@type":"text","#text":"editor."}}},{"@type":"personal","namePart":["Aleksandrov, A. D. (Aleksandr Danilovich)",{"@type":"date","#text":"1912-1999"}],"