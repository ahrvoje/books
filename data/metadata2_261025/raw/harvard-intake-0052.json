{"@version":"3.8","titleInfo":{"title":"Julien Levy ","subTitle":"the man, his gallery, his legacy "},"name":[{"@usage":"primary","@type":"personal","namePart":"Warren, Beth Gates","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}},{"roleTerm":{"@type":"code","@authority":"marcrelator","#text":"aut"}}],"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PCjJTHM76cjC6VPxXc8tfWP"},{"@type":"personal","namePart":"Difilippantonio, Marie","role":[{"roleTerm":{"@type":"text","#text":"author"}},{"roleTerm":{"@type":"code","@authority":"marcrelator","#text":"aut"}}]}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"marcgt","#text":"biography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"rdacontent","#text":"still image"},{"@authority":"fast","#text":"Biographies"},{"@authority":"lcgft","#text":"Biographies."},{"@authority":"rvmgf","#text":"Biographies."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"ctu"},{"@type":"text","@authority":"marccountry","#text":"Connecticut"}]},"dateIssued":{"@encoding":"marc","#text":"2023"},"copyrightDate":{"@encoding":"marc","#text":"2023"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"[Newtown, Connecticut?] :"}},"agent":{"namePart":"Jean and Julien Levy Foundation for the Arts,","role":{"roleTerm":"publisher"}},"dateIssued":[2023]},{"@eventType":"distribution","place":{"placeTerm":{"@type":"text","#text":"New York, NY :"}},"agent":{"namePart":"ARTBOOK/D.A.P.,","role":{"roleTerm":"distributor"}},"dateOther":{"@type":"distribution","#text":[2023]}},{"@eventType":"manufacture","place":{"placeTerm":{"@type":"text","#text":"Seattle :"}},"agent":{"namePart":"Marquand Books,","role":{"roleTerm":"manufacturer"}},"dateOther":{"@type":"manufacture","#text":[2023]}}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"4 volumes : illustrations (some color), portraits ; 27 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Illustrative content","#text":"portrait"}},{"form":{"@type":"Color content","#text":"polychrome"}}],"abstract":{"@type":"Abstract","#text":"\"Julien Levy (1906-1981) is best remembered today as the art dealer who brought Surrealism to the United States. His eponymous New York City gallery (1931-1949) was generally regarded as the place to view cutting-edge contemporary work by such artists as Salvador Dalí, Max Ernst, Alberto Giacometti, Arshile Gorky, Frida Kahlo, René Magritte, Man Ray, and Pavel Tchelitchew. An in-depth study of Levy, the artists he represented, and the influence he wielded during the 1930s and 1940s is long overdue. Consequently, the Jean and Julien Levy Foundation charged the authors with the responsibility of giving readers an uncensored, insider's view of Levy and his art world activities. Volume 1 presents a biography of Levy, including a comprehensive exhibition chronology and the evolution of Levy's career during his eighteen years as an art dealer. Volumes 2, 3, and 4 contain in-depth chapters discussing each of the approximately 230 solo and group exhibitions held at the Julien Levy Gallery and highlighting the artists' careers prior to their exhibition(s) at the gallery, the critical response, and the artists' interactions with Levy. Due to the authors' unique and longstanding associations with the Levy Foundation, they have been able to incorporate important information previously unknown about the workings of the gallery and Levy's relationships with his artists, allowing them to clarify or correct statements made in Levy's 1977 Memoir of an Art Gallery and other publications\"-- Publisher's website."},"note":[{"@type":"statement of responsibility","#text":"Beth Gates Warren, Marie Difilippantonio."},{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"n-us---"}},{"@authority":"lcsh","topic":"Art dealers","geographic":"United States","genre":"Biography"},{"@authority":"lcsh","topic":"Art, Modern","temporal":"20th century"},{"@authority":"rvm","topic":"Marchands d'œuvres d'art","geographic":"États-Unis","genre":"Biographies"},{"@authority":"rvm","topic":"Art","temporal":"20e siècle"},{"@authority":"fast","topic":"Art dealers"},{"@authority":"fast","topic":"Art, Modern"},{"@authority":"fast","geographic":"United States"},{"@authority":"lcsh","name":{"@type":"corporate","namePart":"Julien Levy Gallery"}},{"@authority":"fast","name":{"@type":"corporate","namePart":"Julien Levy Gallery"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":"Levy, Julien"}},{"@authority":"fast","name":{"@type":"personal","namePart":"Levy, Julien","nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJpDHgQjRWGr7KTJhfw9jC"}},{"@authority":"fast","temporal":"1900-1999"}],"classification":[{"@authority":"lcc","#text":"N8660.L47 W37 2023"},{"@edition":"23","@authority":"ddc","#text":"709.2"}],"identifier":[{"@type":"isbn","#text":"9781646570324"},{"@type":"isbn","#text":"1646570324"},{"@type":"lccn","#text":"2022951697"},{"@type":"oclc","#text":"1392165799"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99157332778703941/catalog"}},"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99157332778703941","processingDate":"2026-09-01T18:26Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"YDX"},"recordCreationDate":{"@e