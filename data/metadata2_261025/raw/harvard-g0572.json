{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Christakis&limit=10&title=Apollo's Arrow","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":{"title":"Apollo's arrow ","subTitle":"the profound and enduring impact of coronavirus on the way we live "},"name":{"@usage":"primary","@type":"personal","namePart":"Christakis, Nicholas A.,","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},"dateIssued":{"@encoding":"marc","#text":"2020"},"issuance":"monographic"},{"@eventType":"publication","agent":{"namePart":"Hachette UK","role":{"roleTerm":"publisher"}},"dateIssued":"2020"}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marccategory","#text":"electronic resource"},{"@authority":"marcsmd","#text":"remote"},{"@type":"media","@authority":"rdamedia","#text":"computer"},{"@type":"carrier","@authority":"rdacarrier","#text":"online resource"}],"extent":"1 online resource (xvi, 368 pages) : illustrations, maps."},"abstract":{"@type":"Summary","#text":"\"Apollo's Arrow offers a riveting account of the impact of the coronavirus pandemic as it swept through American society in 2020, and of how the recovery will unfold in the coming years. Drawing on momentous (yet dimly remembered) historical epidemics, contemporary analyses, and cutting-edge research from a range of scientific disciplines, bestselling author, physician, sociologist, and public health expert Nicholas A. Christakis explores what it means to live in a time of plague, an experience that is paradoxically uncommon to the vast majority of humans who are alive, yet deeply fundamental to our species.\""},"tableOfContents":{"@type":"Contents","#text":"An infinitesimal thing -- An old enemy returns -- Pulling apart -- Grief, fear, and lies -- Us and them -- Banding together -- Things change -- How plagues end."},"note":[{"@type":"statement of responsibility","#text":"Nicholas Christakis."},{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"@authority":"fast","temporal":"Since 2020"},{"@authority":"lcsh","topic":["COVID-19 (Disease)","Social aspects"]},{"@authority":"lcsh","topic":["COVID-19 (Disease)","Psychological aspects"]},{"@authority":"fast","geographic":"United States"},{"@authority":"fast","geographic":"Great Britain"}],"classification":[{"@authority":"lcc","#text":"RA644.C67"},{"@edition":"23","@authority":"ddc","#text":"616"}],"relatedItem":[{"@type":"otherFormat","identifier":{"@type":"isbn","#text":"0-316-62821-2"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99155238489103941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0-316-62822-0"},{"@type":"lccn","#text":"2020942642"}],"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99155238489103941","processingDate":"2026-09-11T04:13Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"201020"},"recordChangeDate":{"@encoding":"iso8601","#text":"20230126"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99155238489103941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}}}}