},{"level":2,"label":"","title":"Index","pagenum":"","type":{"key":"/type/toc_item"}}],"source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run06.mrc:113931308:5048","amazon:1610398025","bwb:9781610398022","promise:bwb_daily_pallets_2022-03-17","marc:marc_nuls/NULS_PHC_180925.mrc:303072278:3154","marc:harvard_bibliographic_metadata/20220215_027.bib.mrc:194684010:5510"],"title":"Surveillance Valley","number_of_pages":369,"covers":[8143940],"local_id":["urn:sfpl:31223122736110","urn:sfpl:31223122736300","urn:sfpl:31223122736011","urn:sfpl:31223124377756","urn:sfpl:31223122736227","urn:sfpl:31223122736102","urn:sfpl:31223122736029","urn:sfpl:31223122736003","urn:bwbsku:W7-BLO-123"],"physical_format":"Hardcover","publish_date":"2018","key":"/books/OL26432571M","works":[{"key":"/works/OL17846590W"}],"type":{"key":"/type/edition"},"identifiers":{},"isbn_10":["9781610398022"],"lccn":["2017052227"],"oclc_numbers":["1015275129"],"ocaid":"surveillancevall0000levi","classifications":{},"lc_classifications":["TK7882.E2L48 2018","TK7882.E2 L48 2018"],"subtitle":"The Secret Military History of the Internet","languages":[{"key":"/languages/eng"}],"description":{"type":"/type/text","value":"\"Starting in the early 1960s, there was fear in America about the proliferation of computer database and networking technologies. People worried that these systems were going to be used by both corporations and governments for surveillance and control. Indeed, the dominant cultural view at the time was that computers were tools of repression, not liberation -- and that included the ARPANET, the military research network that would grow into the Internet we use today. Surveillance Valley starts in the past, but moves into the present, looking at the private surveillance business that powers much of Silicon Valley and the overlap between the Internet and the military-industrial complex. It also investigates and uncovers the close ties that exist between U.S. intelligence agencies and the anti-government privacy movement that has sprung up in the wake of Edward Snowden's leaks. The Internet was developed as a weapon, and remains a weapon today. American military interests continue to dominate all parts of the network, even those that supposedly stand in opposition.\"--Provided by publisher."},"latest_revision":12,"revision":12,"created":{"type":"/type/datetime","value":"2018-03-07T01:38:07.544434"},"last_modified":{"type":"/type/datetime","value":"2026-01-17T02:11:22.586587"}}},"OLID:OL28704913M":{"bib_key":"OLID:OL28704913M","info_url":"http://openlibrary.org/books/OL28704913M/Surveillance_Valley","preview":"noview","preview_url":"http://openlibrary.org/books/OL28704913M/Surveillance_Valley","details":{"publishers":["Icon Books, Limited"],"subtitle":"The Secret Military History of the Internet","last_modified":{"type":"/type/datetime","value":"2020-08-13T10:15:47.450870"},"source_records":["bwb:9781785784781"],"title":"Surveillance Valley","number_of_pages":384,"isbn_13":["9781785784781"],"created":{"type":"/type/datetime","value":"2020-08-13T10:15:47.450870"},"languages":[{"key":"/languages/eng"}],"lc_classifications":["UB251.U6L4 2019"],"publish_date":"2019","key":"/books/OL28704913M","authors":[{"key":"/authors/OL7424375A","name":"Yasha Levine"}],"latest_revision":1,"works":[{"key":"/works/OL17846590W"}],"type":{"key":"/type/edition"},"subjects":["Electronic surveillance","Internet, political aspects","Civil-military relations","Military research","Computer networks"],"revision":1}},"OLID:OL29418070M":{"bib_key":"OLID:OL29418070M","info_url":"http://openlibrary.org/books/OL29418070M/Surveillance_Valley","preview":"noview","preview_url":"http://openlibrary.org/books/OL29418070M/Surveillance_Valley","details":{"publishers":["Icon Books, Limited"],"subtitle":"The Secret Military History of the Internet","last_modified":{"type":"/type/datetime","value":"2020-08-25T15:59:32.451424"},"source_records":["bwb:9781785785054"],"t