{"pagination":{"maxPageableSet":"10000","numFound":2,"query":"name=Dyson&limit=10&title=Invention","limit":10,"start":0},"items":{"mods":[{"@version":"3.8","titleInfo":{"title":"Invention ","subTitle":"a life "},"name":{"@usage":"primary","@type":"personal","namePart":"Dyson, James","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"biography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"rdacontent","#text":"still image"},{"@authority":"aat","#text":"autobiographies (literary works)"},{"@authority":"fast","#text":"Autobiographies"},{"@authority":"fast","#text":"Biographies"},{"@authority":"lcgft","#text":"Autobiographies"},{"@authority":"rvmgf","#text":"Autobiographies."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},"dateIssued":{"@encoding":"marc","#text":"2021"},"copyrightDate":{"@encoding":"marc","#text":"2021"},"issuance":"monographic","edition":"First Simon & Schuster hardcover edition."},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"New York, NY :"}},"agent":{"namePart":"Simon & Schuster,","role":{"roleTerm":"publisher"}},"dateIssued":"2021."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"337 pages, 24 unnumbered pages of plates : illustrations ; 24 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}}],"abstract":{"@type":"Summary","#text":"Famously, over a four-year period, James Dyson made 5,127 prototypes of the cyclonic vacuum cleaner that would transform the way houses are cleaned around the world. In devoting all his resources to iteratively developing the technology, he risked it all, but out of many failures and setbacks came hard-fought success. In Invention: A Life, Dyson reveals how he came to set up his own company and led it to become one of the most inventive technology companies in the world. It is a compelling and dramatic tale, with many obstacles overcome."},"tableOfContents":{"@type":"Contents","#text":"Introduction -- Growing up -- Art school -- Sea truck -- The ballbarrow -- The Coach House -- DC01 -- Core technologies -- Going global -- The car -- Farming -- Education -- Making the future -- Postscript: Jake Dyson -- Postscript: Deirdre Dyson."},"note":[{"@type":"statement of responsibility","#text":"James Dyson."},"Includes index."],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"e-uk---"}},{"@authority":"lcsh","topic":"Inventors","geographic":"Great Britain","genre":"Biography"},{"@authority":"lcsh","topic":"Businessmen","geographic":"Great Britain","genre":"Biography"},{"@authority":"lcsh","topic":"Entrepreneurship","geographic":"Great Britain"},{"@authority":"rvm","topic":"Inventeurs","geographic":"Grande-Bretagne","genre":"Biographies"},{"@authority":"rvm","topic":"Hommes d'affaires","geographic":"Grande-Bretagne","genre":"Biographies"},{"@authority":"rvm","topic":"Entrepreneuriat","geographic":"Grande-Bretagne"},{"@authority":"bisacsh","topic":"BIOGRAPHY & AUTOBIOGRAPHY / Personal Memoirs"},{"@authority":"bisacsh","topic":"BIOGRAPHY & AUTOBIOGRAPHY / Business"},{"@authority":"bisacsh","topic":"BUSINESS & ECONOMICS / Leadership"},{"@authority":"fast","topic":"Businessmen"},{"@authority":"fast","topic":"Entrepreneurship"},{"@authority":"fast","topic":"Inventors"},{"@authority":"fast","geographic":"Great Britain"},{"@authority":"lcsh","name":{"@type":"corporate","namePart":"Dyson Appliances Limited"}},{"@authority":"fast","name":{"@type":"corporate","namePart":"Dyson Appliances Li