"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Color content","#text":"polychrome"}}],"abstract":{"@type":"Summary","#text":"The true story of Victorian artist Benjamin Waterhouse Hawkins, who built life-sized models of dinosaurs in the hope of educating the world about what these awe-inspiring ancient animals and what they were like."},"targetAudience":{"@authority":"marctarget","#text":"juvenile"},"note":[{"@type":"statement of responsibility","#text":"by Barbara Kerley ; with drawings by Brian Selznick ; many of which are based on the original sketches of Mr. Hawkins."},{"@type":"bibliography","#text":"Includes bibliographical references."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"e-uk---"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Hawkins, B. Waterhouse (Benjamin Waterhouse),",{"@type":"date","#text":"1807-1889"}]},"genre":"Juvenile literature"},{"@authority":"lcsh","topic":["Dinosaurs","Models","History"],"temporal":"19th century","genre":"Juvenile literature"},{"@authority":"lcsh","topic":"Modelmakers","geographic":"Great Britain","genre":["Biography","Juvenile literature"]},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Hawkins, B. Waterhouse (Benjamin Waterhouse),",{"@type":"date","#text":"1807-1894"}]},"genre":"Juvenile literature"},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Tweed, William Marcy,",{"@type":"date","#text":"1823-1878"}]},"genre":"Juvenile literature"},{"@authority":"lcsh","topic":"Natural history","genre":"Juvenile literature"},{"@authority":"lcsh","topic":"Education","genre":"Juvenile literature"},{"@authority":"lcsh","topic":"Museums","genre":"Juvenile literature"},{"@authority":"lcsh","topic":"Politicians","genre":"Juvenile literature"},{"@authority":"fast","temporal":"1800-1899"},{"hierarchicalGeographic":{"country":"United States","state":"New York (State)","city":"New York","citySection":"publication place"}}],"classification":[{"@authority":"lcc","#text":"QE861.5 .K47 2001"},{"@edition":"21","@authority":"ddc","#text":"567.9/022/8"}],"identifier":[{"@type":"isbn","#text":"0439114942"},{"@type":"lccn","#text":"^^^00058376^"},{"@type":"oclc","#text":"44933519"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990088590810203941/catalog"}},"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990088590810203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"008859081"}},"processingDate":"2026-08-19T04:19Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"000706"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990088590810203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"@version":"3.8","titleInfo":{"nonSort":{"@space":"preserve","#text":"The  "},"title":"dinosaur artist ","subTitle":"obsession, betrayal and the quest for Earth's ultimate trophy "},"name":{"@usage":"primary","@type":"personal","namePart":["Williams, Paige,",{"@type":"date","#text":"1966-"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"marcgt","#text":"biography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"fast","#text":"True crime stories"},{"@authority":"lcgft","#text":"True crime stories"},{"@authority":"rvmgf","#text":"Récits criminels."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},"dateIssued":{"@encoding":"marc","#text":"2018"},"copyrightDate":{"@encoding":"marc","#text":"2018"},"issuance":"monographic","edition":"First edition."},{"@eventType":"publication","place":[{"placeTerm":{"@type":"text","#text":"New York ;"}},{"placeTerm":{"@type":"text","#text":"Boston :"}}],"agent":[{"namePart":"Hachette Books,","role":{"roleTerm":"publisher"}},{"namePart":"Hachette Books,","role":{"roleTerm":"publisher"}}],"dateIssued":[2018]}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xxii, 410 pages ; 24 cm"},"abstract":{"@type":"Summary","#text":"\"In 2012, a New York auction catalogue made an unusual offering: \"a superb Tyrannosaurus skeleton.\" In fact, Lot 49135 consisted of a nearly complete T. bataar, a close cousin to T. rex, the most famous animal that ever lived. The fossils now on display in Manhattan had been unearthed in Mongolia, some 6,000 miles away. At 8 feet high and 24 feet long, the specimen was spectacular, and the final gavel signaled a winning bid of well over $1 million. Eric Prokopi, a thirty-eight-year-old Floridian, was the man who had brought this extraordinary skeleton to market. A onetime swimmer who spent his teenage years searching for shark teeth, Prokopi's singular obsession with fossils generated a thriving business hunting, preparing, and selling specimens, to clients ranging from natural history museums to avid private collectors like actor Leonardo DiCaprio. But there was a problem. This time, facing financial strain, had Prokopi gone too far? As the T. bataar went to auction, a network of paleontologists alerted the government of Mongolia to the eye-catching lot. As an international custody battle ensued, fueled by geopolitics, Prokopi watched as his own world unraveled. In the tradition of The Orchid Thief, The Dinosaur Artist is a stunning work of narrative journalism about humans' relationship with natural history and a seemingly intractable conflict between science and commerce. A story that stretches from Florida's Land O' Lakes to the Gobi Desert, The Dinosaur Artist illuminates the history of fossil collecting--a wildly popular, yet sometimes murky, risky business, populated by eccentrics and obsessives, where the lines between poacher and hunter, collector and smuggler, enthusiast and opportunist, can easily blur. In her first book ... writer Paige Williams has given readers an irresistible story that spans continents, cultures, and millennia as she examines the question of who, ultimately, owns the past\"--Jacket."},"tableOfContents":{"@type":"Contents","#text":"Introduction. Origins -- Part I: \"Superb Tyrannosaurus skeleton\" -- Land O' Lakes -- Garcia, king of the Ice Age -- Dive -- Deal -- Tucson -- Big game -- Middleman in Japan -- Hollywood headhunters -- Part II: The warrior and the explorer -- The Flaming cliffs -- Market conditions -- \"Go Gobi\" -- The ghost of Mary Anning -- The last dinosaur -- The President's predicament -- United States of America v. One Tyrannosaurus bataar skeleton -- Part III: Raid! -- Verdict -- Tarbomania -- Petersburg low -- The dinosaur bus -- Epilogue."},"note":[{"@type":"statement of responsibility","#text":"Paige Williams."},{"@type":"bibliography","#text":"Includes bibliographical references (pages 289-381) and index."}],"subject":[{"geographicCode":[{"@authority":"marcgac","#text":"a-mp---"},{"@authority":"marcgac","#text":"n-us-fl"}]},{"@authority":"lcsh","topic":["Fossils","Collection and preservation","Moral and ethical aspects"]},{"@authority":"lcsh","topic":["Fossils","Collection and preservation","Economic aspects"]},{"@authority":"lcsh","topic":["Fossils","Collection and preservation"],"geographic":"Mongolia"},{"@authority":"lcsh","topic":["Fossils","Collectors and collecting"],"geographic":"Florida"},{"@authority":"lcsh","topic":"Tyrannosaurus","geographic":"Mongolia"},{"@authority":"lcsh","topic":["Geopolitics","Moral and ethical aspects"]},{"@authority":"lcshac","topic":["Fossils","Collection and preservation"]},{"@authority":"lcshac","topic":["Fossils","Collection and preservation"],"geographic":"Mongolia"},{"@authority":"lcshac","topic":["Fossils","Collection and preservation","Moral and ethical aspects"]},{"@authority":"lcshac","topic":["Fossils","Collection and preservation","Economic aspects"]},{"@authority":"lcshac","topic":["Fossils","Collection and preservation"],"geographic":"Florida"},{"@authority":"rvm","topic":["Fossiles","Collectionneurs et collections"],"geographic":"Floride"},{"@authority":"rvm","topic":"Tyrannosaurus","geographic":"Mongolie"},{"@authority":"rvm","topic":["Géopolitique","Aspect moral"]},{"@authority":"bisacsh","topic":["HISTORY","Expeditions & Discoveries"]},{"@authority":"bisacsh","topic":["SCIENCE","Paleontology"]},{"@authority":"bisacsh","topic":["TRUE CRIME","Con Artists, Hoaxes & Deceptions"]},{"@authority":"fast","@href":"(OCoLC)fst00933168","topic":["Fossils","Collection and preservation"]},{"@authority":"fast","@href":"(OCoLC)fst01160096","topic":"Tyrannosaurus"},{"@authority":"gnd","topic":"Fossiliensammeln"},{"@authority":"gnd","topic":"Tyrannosaurus"},{"geographic":"Mongolia"},{"@authority":"fast","@href":"(OCoLC)fst01205150","geographic":"Florida"},{"@authority":"fast","@href":"(OCoLC)fst01208752","geographic":"Mongolia"},{"@authority":"gnd","geographic":"Mongolei"},{"@authority":"gnd","geographic":"Florida"},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Prokopi, Eric,",{"@type":"date","#text":"1974-"}]}}],"classification":[{"@authority":"lcc","#text":"QE862.S3 W533 2018"},{"@edition":"23","@authority":"ddc","#text":"560.75"}],"identifier":[{"@type":"isbn","#text":"9780316382533"},{"@type":"isbn","#text":"0316382531"},{"@type":"isbn","@invalid":"yes","#t