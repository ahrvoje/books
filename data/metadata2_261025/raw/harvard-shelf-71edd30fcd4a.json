0203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}},{"@version":"3.8","titleInfo":{"nonSort":{"@space":"preserve","#text":"An  "},"title":"Essay on the psychology of invention in the mathematical field"},"name":{"@usage":"primary","@type":"personal","namePart":["Hadamard, Jacques,",{"@type":"date","#text":"1865-1963"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nmu"},{"@type":"text","@authority":"marccountry","#text":"New Mexico"}]},{"placeTerm":{"@type":"text","#text":"Santa Fe, NM "}}],"issuance":"monographic","agent":{"namePart":"William Gannon"}},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"}},"identifier":{"@type":"isbn","#text":"0883071215"},"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990004128940203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000460342846","#text":"Monroe C. Gutman Library, Graduate School of Education, Harvard University"}},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Gutman Education"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990004128940203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"000412894"}},"processingDate":"2026-07-12T04:29Z"}},{"sets":null}],"recordInfo":{"recordCreationDate":{"@encoding":"marc","#text":"851101"},"recordChangeDate":{"@encoding":"iso8601","#text":"20260709"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990004128940203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"@version":"3.8","titleInfo":[{"nonSort":{"@space":"preserve","#text":"The  "},"title":"mathematician's mind ","subTitle":"the psychology of invention in the mathematical field "},{"@type":"alternative","title":"Psychology of invention in the mathematical field"},{"@type":"uniform","@nameTitleGroup":"1","title":"Essay on the psychology of invention in the mathematical field"}],"name":[{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":["Hadamard, Jacques,",{"@type":"date","#text":"1865-1963"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},{"@type":"personal","namePart":["Johnson-Laird, P. N. (Philip Nicholas),",{"@type":"date","#text":"1936-"}],"role":{"roleTerm":{"@type":"text","#text":"writer of preface"}},"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJymFTQFB4G8CqVcpJwV4q"},{"@type":"personal","namePart":["Einstein, Albert,",{"@type":"date","#text":"1879-1955"}],"role":{"roleTerm":{"@type":"text","#text":"writer of appendix"}},"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJkhFRgHDtmhvmC6JdfXh3"}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"lcgft","#text":"Informational works"}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nju"},{"@type":"text","@authority":"marccountry","#text":"New Jersey"}]},{"placeTerm":{"@type":"text","#text":"Princeton, N.J"}}],"issuance":"monographic","agent":{"namePart":"Princeton University Press"},"dateIssued":"1996"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"xix, 143 p. ; 21 cm."},"abstract":{"@type":"Summary","#text":"Fifty years ago when Jacques Hadamard set out to explore how mathematicians invent new ideas, he considered the creative experiences of some of the greatest thinkers of his generation, such as George Polya, Claude Levi-Strauss, and Albert Einstein. It appeared that inspiration could strike anytime, particularly after an individual had worked hard on a problem for days and then turned attention to another activity. In exploring this phenomenon, Hadamard produced one of the most famous and cogent cases for the existence of unconscious mental processes in mathematical invention and other forms of creativity."},"tableOfContents":{"@type":"Contents","#text":"General views and inquiries -- Discussions on unconsciousness -- The unconscious and discovery -- The preparation stage. Logic and chance -- The later conscious work -- Discovery as a synthesis. The help of signs -- Different kinds of mathematical minds -- Paradoxical cases of intuition -- The general direction of research."},"note":[{"@type":"statement of responsibility","#text":"Jacques Hadamard."},"Originally published: An essay on the psychology of invention in the mathematical field. Princeton : Princeton University Press, 1945.",{"@type":"bibliography","#text":"Includes bibliographical references."}],"subject":[{"@authority":"lcsh","topic":["Mathematics","Philosophy"]},{"@authority":"lcsh","topic":["Mathematicians","Psychology"]}],"classification":[{"@authority":"lcc","#text":"QA8.4 .H3 1996"},{"@edition":"20","@authority":"ddc","#text":"510/.1/9"}],"identifier":[{"@type":"isbn","#text":"0691029318 (pbk. : alk. paper)"},{"@type":"lccn","#text":"^^^96027544^"},{"@type":"oclc","#text":"35209279"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990069368630203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/000000046073724X","#text":"Cabot Science Library, Harvard University"},"shelfLocator":"QA8.4 .H3 1996"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI"