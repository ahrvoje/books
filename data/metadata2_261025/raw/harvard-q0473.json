{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Fatland&limit=10&title=Sovietistan","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":[{"title":"Sovietistan ","subTitle":"travels in Turkmenistan, Kazakhstan, Tajikistan, Kyrgyzstan and Uzbekistan "},{"@type":"uniform","@nameTitleGroup":"1","title":"Sovjetistan. English"}],"name":[{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":["Fatland, Erika,",{"@type":"date","#text":"1983-"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}],"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJjxwQXpQ9bVYdG36yFYfq"},{"@type":"personal","namePart":"Dickson, Kari","role":{"roleTerm":{"@type":"text","#text":"translator"}},"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJhX7w9F64tmD7R38MXGHC"}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"marcgt","#text":"biography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"rdacontent","#text":"still image"},{"@authority":"fast","#text":"Travel writing"},{"@authority":"lcgft","#text":"Travel writing"},{"@authority":"rvmgf","#text":"Récits de voyages."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},"dateIssued":{"@encoding":"marc","#text":"2019"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"London :"}},"agent":{"namePart":"Maclehose Press/Quercus,","role":{"roleTerm":"publisher"}},"dateIssued":"2019."}],"language":[{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},{"@objectPart":"translation","languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"nor"}}],"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"477 pages, 8 unnumbered pages of plates : color illustrations, maps, color portraits ; 24 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Illustrative content","#text":"map"}},{"form":{"@type":"Illustrative content","#text":"portrait"}},{"form":{"@type":"Color content","#text":"polychrome"}}],"abstract":{"@type":"Summary","#text":"Erika Fatland takes the reader on a journey that is unknown to even the most seasoned globetrotter. The five former Soviet Republics' Kazakhstan, Kyrgyzstan, Tajikistan, Turkmenistan and Uzbekistan all became independent when the Soviet Union fell apart in 1991. How have these countries developed since then? In the Kyrgyzstani villages Erika Fatland meets victims of the widely known tradition of bride snatching; she visits the huge and desolate Polygon in Kazakhstan where the Soviet Union tested explosions of nuclear bombs; she meets Chinese shrimp gatherers on the banks of the dried out Aral Sea and she witnesses the fall of a dictator. She travels incognito through Turkmenistan, a country that is closed to journalists. She meets exhausted human rights activists in Kazakhstan, survivors from the massacre in Osh in 2010, German Menonites that found paradise on the Kyrgyzstani plains 200 years ago. During her travels, she observes how ancient customs clash with gas production and she witnesses the underlying conflicts between ethnic Russians and the majority in a country that is slowly building its future in Nationalist colours. In these countries, that used to be the furthest border of the Soviet Union, life follows another pace of time. Amidst the treasures of Samarkand and the bleakness of Soviet architecture, Erika Fatland moves with her openness towards the people and the landscapes around her."},"tableOfContents":{"@type":"Contents","#text":"Turkmenistan -- Kazakhstan -- Tajikistan -- Kyrgyzstan -- Uzbekistan."},"note":[{"@type":"statement of responsibility","#text":"Erika Fatland ; translated from the Norwegian by Kari Dickson."},{"@type":"bibliography","#text":"Includes bibliographical references (pages 475-477)."},{"@type":"language","#text":"Translated from the Norwegian."},"Winner of the Norwegian Prize for Non-fiction.","First published in the Norwegian language as \"Sovjetistan\" by Kagge Forlag, Oslo, in 2014--Title page verso"],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"ac-----"}},{"@authority":"bicssc","topic":"Travel writing"},{"@authority":"eflch","topic":"Travel and Tourism"},{"@authority":"fast","topic":"Travel"},{"@authority":"ukslc","topic":"Travel and Tourism"},{"@authority":"lcsh","geographic":"Asia, Central","topic":"Description and travel"},{"@authority":"rvm","geographic":"Asie centrale","topic":"Descriptions et voyages"},{"@authority":"fast","geographic":"Central Asia"},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Fatland, Erika,",{"@type":"date","#text":"1983-"}]},"topic":"Travel","geographic":"Asia, Central"}],"classification":[{"@authority":"lcc","#text":"DK854 .F37513 2019"},{"@edition":"23","@authority":"ddc","#text":"915.8"}],"relatedItem":[{"@type":"otherFormat","@otherType":"Ebook version :","@displayLabel":"Ebook version :","identifier":{"@type":"isbn","#text":"9780857057754"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99153833513303941/catalog"}}],"identifier":[{"@type":"isbn","#text":"9780857057761"},{"@type":"isbn","#text":"0857057766"},{"@type":"isbn","#text":"9780857057778"},{"@type":"isbn","#text":"0857057774"},{"@type":"isbn","@invalid":"yes","#text":"9780857057754"},{"@type":"isbn","#text":"085705774X"},{"@type":"isbn","#text":"9780857057747"},"60002343170",{"@type":"lccn","#text":"2019458797"},{"@type":"oclc","#text":"1117767397"},{"@type":"stock number","#text":"HachetteUK640775 Ingram Content Group"}],"location":[{"physicalLoc