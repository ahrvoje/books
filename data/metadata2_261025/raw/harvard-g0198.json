tatement of responsibility","#text":"Virginia Law Review, Volume 23, No. 6, April, 1937."},"identifier":{"@type":"oclc","#text":"26793018"},"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990069624850203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"Econ 4899.09.37"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990069624850203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"006962485"}},"processingDate":"2024-03-26T05:13Z"}},{"sets":null}],"recordInfo":{"recordContentSource":{"@authority":"marcorg","#text":"VA@"},"recordCreationDate":{"@encoding":"marc","#text":"921015"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990069624850203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}},{"titleInfo":[{"title":"Powerful","subTitle":"building a culture of freedom and responsibility"},{"@type":"alternative","title":"Building a culture of freedom and responsibility"}],"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":"McCord, Patty","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author."}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"xxu"},{"@type":"text","@authority":"marccountry","#text":"United States"}]},"dateIssued":{"@encoding":"marc","#text":"2017"},"copyrightDate":{"@encoding":"marc","#text":"2017"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"[United States] :"}},"publisher":"Silicon Guild,","dateIssued":[2017]}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xx, 152 pages ; 22 cm"},"abstract":[{"@type":"Summary","#text":"\"When it comes to recruiting, motivating, and creating great teams, Patty McCord says most companies have it all wrong. McCord helped create the unique and high-performing culture at Netflix, where she was chief talent officer. In her new book, Powerful: Building a Culture of Freedom and Responsibility, she shares what she learned there and elsewhere in Silicon Valley. McCord advocates practicing radical honesty in the workplace, saying good-bye to employees who don't fit the company's emerging needs, and motivating with challenging work, not promises, perks, and bonus plans. She argues that the old standbys of corporate HR--annual performance reviews, retention plans, employee empowerment and engagement programs--often end up being a colossal waste of time and resources. Her road-tested advice, offered with humor and irreverence, provides readers a different path for creating a culture of high performance and profitability. Powerful will change how you think about work and the way a business should be run\"--Dust jacket flap."},{"@type":"Summary","#text":"When it comes to recruiting, motivating, and creating great teams, McCord says most companies have it all wrong. She helped create the high-performing culture at Netflix, and now she shares what she learned. McCord advocates practicing radical honesty in the workplace, saying good-bye to employees who don't fit the company's emerging needs, and motivating with challenging work, not promises, perks, and bonus plans."}],"tableOfContents":"Introduction. A new way of working : foster freedom and responsibility -- The greatest motivation is contributing to success : treat people like adults -- Every single employee should understand the business : communicate constantly about the challenge -- Humans hate being lied to and being spun : practice radical honesty -- Debate vigorously : cultivate strong opinions and argue about them only on the facts -- Build the company now that you want to be then : relentlessly focus on the future -- Someone really smart in every job : have the right person in every single position -- Pay people what they're worth to you : compensation is a judgment call -- The art of good good-byes : make needed changes fast, and be a great place to be from.","note":[{"@type":"statement of responsibility","#text":"Patty McCord."},"\"From the Co-Creator of NETFLIX Culture Deck.\"",{"@type":"bibliography","#text":"Includes bibliographical references (pages 149-150)."}],"subject":[{"@authority":"sears","name":{"@type":"corporate","namePart":"Netflix (Firm)."}},{"@authority":"lcsh","topic":"Corporate culture"},{"@authority":"lcsh","topic":"Industrial management"},{"@authority":"lcsh","topic":"Employee motivation"},{"@authority":"lcsh","topic":["Organizational change","Management"]},{"@authority":"lcsh","topic":"Teams in the workplace"},{"@authority":"lcsh","topic":"Personnel management"},{"@authority":"lcsh","topic":"Organizational change"},{"@authority":"mesh","topic":"Organizational Culture"},{"@authority":"mesh","topic":"Personnel Management"},{"@authority":"mesh","topic":"Organizational Innovation"},{"@authority":"rvm","topic":"Culture organisationnelle"},{"@authority":"rvm","topic":"Gestion d'entreprise"},{"@authority":"rvm","topic":["Personnel","Motivation"]},{"@authority":"rvm","topic":"Changement organisationnel"},{"@authority":"rvm","topic":"Équipes de travail"},{"@authority":"rvm","topic":["Personnel","Direction"]},{"@authority":"bisacsh","topic":["BUSINESS & ECONOMICS","Management"]},{"@authority":"bisacsh","topic":["BUSINESS & ECONOMICS","Workplace Culture"]},{"@authority":"cct","topic":"Corporate culture"},{"@authority":"cct","topic":"Industrial management"},{"@authority":"cct","topic":"Employee motivation"},{"@authority":"cct","topic":["Organizational change","Management"]},{"@authority":"cct","topic":"Teams in the workplace"},{"@authority":"cct","topic":"Personnel management"},{"@authority":"fast","topic":"Organizational change"},{"@authority":"fast","topic":"Corporate culture"},{"@authority":"fast","topic":"Employee motivation"},{"@authority":"fast","topic":"Industrial management"},{"@authority":"fast","topic":["Organizational change","Management"]},{"@authority":"fast","topic":"Personnel management"},{"@authority":"fast","topic":"Teams in the workplace"},{"@authority":"gnd","topic":"Betriebsklima"},{"@authority":"gnd","topic":"Organisationskultur"},{"@authority":"gnd","topic":"Teamwork"},{"@authority":"sears","topic":"Personnel management"}],"classification":[{"@authority":"lcc","#text":"HD58.7 .M3875 2017"},{"@edition":"23","@authority":"ddc","#text":"658.3"},{"@authority":"clc","#text":"F272-05"}],"identifier":[{"@type":"isbn","#text":"1939714095"},{"@type":"isbn","#text":"9781939714091"},{"@type":"isbn","#text":"9781939714138"},{"@type":"isbn","#text":"1939714133"},{"@type":"isbn","#text":"9781939714206"},{"@type":"isbn","#text":"1939714206"},{"@type":"isbn","@invalid":"yes","#text":"9781939714114"},{"@type":"lccn","#text":"2017913094"},{"@type":"oclc","#text":"994372028"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99153701594703941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000123374118","#text":"Baker Library, Harvard Business School, Harvard University"},"shelfLocator":"HD58.7 .M3875 2017"},null,