ifier":{"@type":"local","#text":"(OCoLC)647249467"},"name":{"namePart":"Smil, Vaclav."}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990015253240203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0873324234"},{"@type":"lccn","#text":"^^^87012922^"},{"@type":"oclc","#text":"15792770"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"HD9502.C62 S644 1988"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000463633294","#text":"Fung Library, Harvard University"},"shelfLocator":"HD9502.C62 S644 1988"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000121790804","#text":"Harvard-Yenching Library, Harvard University"},"shelfLocator":"HD9502.C62 S644 1988"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":["Fung Library","Harvard-Yenching","Widener"]},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990015253240203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"001525324"}},"processingDate":"2026-08-07T04:15Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"870514"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990015253240203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"@version":"3.8","titleInfo":{"title":"Energy in world history "},"name":{"@usage":"primary","@type":"personal","namePart":"Smil, Vaclav","role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"fast","#text":"History"},{"@authority":"fast","#text":"History."}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"cou"},{"@type":"text","@authority":"marccountry","#text":"Colorado"}]},{"placeTerm":{"@type":"text","#text":"Boulder "}}],"issuance":"monographic","agent":{"namePart":"Westview Press"},"dateIssued":"1994"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":{"@authority":"marcform","#text":"print"},"extent":"xviii, 300 p. : ill. ; 25 cm."},{"form":{"@type":"Illustrative content","#text":"illustration"}}],"abstract":{"@type":"Summary","#text":"\"Every human activity entails the conversion of energy. Changes in the fundamental sources of energy, and in the use of energy sources, are a basic dimension of the evolution of society. Our appreciation of the significance of these processes is essential to a fuller understanding of world history. Vaclav Smil offers a comprehensive look at the role of energy in world history, ranging from human muscle-power in foraging societies and animal-power in traditional farming to preindustrial hydraulic techniques and modern fossil-fueled civilization. The book combines a vast historical sweep with cross-cultural comparisons and is enhanced by illustrations and accessible quantitative material. Students and general readers alike will gain an understanding of energy's fundamental role in human progress. Smil illuminates the role played by various means of harnessing energy in different societies and provides new insights by explaining the impact and limitations of these fundamental physical inputs - whether it is in the cultivation of crops, smelting of metals, waging of war, or the mass production of goods. While examining the energetic foundations of historical changes, Energy in World History avoids simplistic, deterministic views of energy needs and recognizes the complex interplay of physical and social realities.\"--Publisher description."},"tableOfContents":{"@type":"Incomplete contents","#text":"1. Energy and Society --- 2. Energy in Prehistory --- 3. Traditional Agriculture --- 4. Preindustrial Prime Movers and Fuels --- 5. Fossil-Fueled Civilization --- 6. Energy in World History."},"note":[{"@type":"statement of responsibility","#text":"Vaclav Smil."},{"@type":"bibliography","#text":"Includes bibliographical references (p. 272-291) and index."}],"subject":{"@authority":"lcsh","topic":["Power resources","History"]},"classification":[{"@authority":"lcc","#text":"TJ163.5 .S623 1994"},{"@edition":"20","@authority":"ddc","#text":"333.79/09"}],"relatedItem":[{"titleInfo":{"title":"Essays in world history"}},{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":{"title":"Energy in world history"},"originInfo":{"publisher":"Boulder : Westview Press, 1994"},"identifier":{"@type":"local","#text":"(OCoLC)624457054"},"name":{"namePart":"Smil, Vaclav."}},{"@type":"series","titleInfo":{"title":"Essays in world history"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990050515630203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0813319013 (alk. paper)"},{"@type":"isbn","#text":"0813319021 (pbk.)"},{"@type":"lccn","#text":"^^^94016485^"},{"@type":"oclc","#text":"30398523"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"TJ163.5 .S623 1994"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990050515630203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"005051563"}},"processingDate":"2026-10-16T04:13Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"940421"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990050515630203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"@version":"3.8","titleInfo":{"title":"Energy transitions ","subTitle":"history, requirements, prospects "},"name":{"@usage":"primary","@type":"personal","namePart":"Smil, Vaclav","role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":{"@authority":"marcgt","#text":"bibliography"},"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"cau"},{"@type":"text","@authority":"marccountry","#text":"California"}]},{"placeTerm":{"@type":"text","#text":"Santa Barbara, Calif"}}],"dateIssued":[{"@encoding":"marc","#text":"2010"},"c2010"],"issuance":"monographic","agent":{"namePart":"Praeger"}},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":{"@authority":"marcform","#text":"print"},"extent":"ix, 178 p. : ill. ; 25 cm."},{"form":{"@type":"Illustrative content","#text":"illustration"}}],"abstract":{"@type":"Summary","#text":"Describes the history of modern society's dependence on fossil fuels and the prospects for the transition to a nonfossil world. Vaclav Smil makes it clear that this transition will not be accomplished easily, and that it cannot be accomplished within the timetables established by the Obama administration. --from publisher description"},"tableOfContents":{"@type":"Contents","#text":"Energy systems : their basic properties -- Global transitions : universal patterns -- National transitions