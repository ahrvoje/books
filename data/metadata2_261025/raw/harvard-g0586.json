marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},{"placeTerm":{"@type":"text","#text":"Oxford [Eng.] "}},{"placeTerm":{"@type":"text","#text":"New York "}}],"issuance":"monographic","agent":{"namePart":"Oxford University Press"},"dateIssued":"1980"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":{"@authority":"marcform","#text":"print"},"extent":"viii, 386 p. : ill. ; 24 cm."},{"form":{"@type":"Illustrative content","#text":"illustration"}}],"abstract":{"@type":"Abstract","#text":"Monograph of essays on energy sources in the developing contries, and perspectives for increasing its availability - examines linkages between energy, its uses and economic growth in general, presents detailed case studies of China, India and Brazil, and reviews issues affecting solar energy, wood fuel, thermal energy, atomic energy, biogas, rural electrification, hydroelectric power, etcetera"},"tableOfContents":[{"@type":"Contents","#text":"Energy in the developing world / Vaclav Smil and Wlliam E. Knowland -- Energy in the rule third world / Arjum Makhijani -- Energy and the economic prospect for developing counries / Workshop on Alternative Energy Strategies -- Direct and indirect uses of solar energy / United States National Academy of Science -- The other energy crisis: firewood / Eric P. Eckholm -- Woodfuel -- a time for reassessment / Keith Openshaw -- Tropical forest plantations / Norman E. Johnson -- Geothermal energy / United States National Academy of Sciences -- Nuclear energy for the Third World / Klaus Gottstein"},{"@type":"Contents","#text":"China's energetics: a system analysis /Vaclav Smil -- China's electric power industry / William Clarke -- Energy resources, consumption, and supply in India / P.D. Henderson -- Energy use in rural India / Roger Revelle -- Biogas plants in India / Chama Kashkari -- Rural electrification in India: biogas versus large-scale power / Wallace E. Tyner and John Adams -- Brazil: energy options and current outlook / Jose Goldemberg -- Energy profile of Brazil / Eric J. Jeffs -- Itaipu: the world's largest power station / Jerry Mazzone -- Alternative energy technologies in Brazil / J.M. Miccolis -- Alcohol: a Brazilian answer to the energy crisis / Allen L. Hammond"},{"@type":"Contents","#text":"Nigeria's oil industry / Martin Quinlan -- Hydro power plants in Nigeria / G.V. Eckenfelder -- Energy resources and demands in Zambia and Africa south of the equator / Enar Eskilsson -- Energy in Zaire / Kenneth L. Adelman -- Solar energy for Tanzania / Norman L. Brown and James W. Howe -- Conventional energy resources in Indonesia / A. Arismunandar -- Energy resources in Bangladesh -- problems and prospects / M. Azizur Rahman and A.M.Z. Huq -- Energy resources in Turkey / Muammer Cetelincelik -- Energy in Mexico / J. Eibenschutz, A. Ascofet, and G. Bazan -- Energy and economic growth in Central America / Alan M. Strout."}],"note":[{"@type":"statement of responsibility","#text":"edited by Vaclav Smil and William E. Knowland."},{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"d------"}},{"@authority":"lcsh","topic":"Power resources","geographic":"Developing countries"},{"@authority":"lcsh","geographic":"Developing countries","topic":"Power resources"}],"classification":[{"@authority":"lcc","#text":"HD9502.A2"},{"@authority":"lcc","#text":"TJ163.2 .E479"}],"relatedItem":[{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":{"title":"Energy in the developing world"},"originInfo":{"publisher":"Oxford [Eng.] ; New York : Oxford University Press, 1980"},"identifier":{"@type":"local","#text":"(OCoLC)565971468"}},{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":{"