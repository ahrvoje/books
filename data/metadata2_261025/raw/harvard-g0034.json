 ein engagierter Jude. All dies trug ihm Bewunderung und Verehrung, aber auch Missgunst und Angriffe auf Person und Werk ein, die nicht zuletzt auf Einstein als Juden und sein Engagement für die zionistische Idee zielten."},"note":[{"@type":"statement of responsibility","#text":"Dieter Hoffmann/Robert Schulmann."},"Biography.",{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"@authority":"lcsh","name":{"@type":"personal","namePart":["Einstein, Albert,",{"@type":"date","#text":"1879-1955"}]}},{"@authority":"swd","name":{"@type":"personal","namePart":"Einstein, Albert."}}],"classification":{"@authority":"lcc","#text":"QC16.E5 H644 2005"},"relatedItem":[{"titleInfo":{"title":"Jüdische Miniaturen ","partNumber":"Doppelbd. 25"}},{"@type":"series","titleInfo":{"title":"Jüdische Miniaturen (Hentrich & Hentrich)","partNumber":"Bd. 25"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990096987580203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"3933471834 (pbk.)"},{"@type":"isbn","#text":"9783933471833 (pbk.)"},{"@type":"oclc","#text":"60561744"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"QC16.E5 H644 2005"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990096987580203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"009698758"}},"processingDate":"2026-09-20T04:29Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"OHX"},"recordCreationDate":{"@encoding":"marc","#text":"050603"},"recordChangeDate":{"@encoding":"iso8601","#text":"20070313"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990096987580203941"},"recordOr