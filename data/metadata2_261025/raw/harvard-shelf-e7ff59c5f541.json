{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Coulombe&limit=10&title=Becoming Trader Joe","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":{"title":"Becoming Trader Joe ","subTitle":"how I did business my way and still beat the big guys "},"name":[{"@usage":"primary","@type":"personal","namePart":["Coulombe, Joe,",{"@type":"date","#text":"1930-2020"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}],"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJghrTXh9bPcDFH9P3bTpP"},{"@type":"personal","namePart":"Civalleri, Patty","role":{"roleTerm":{"@type":"text","#text":"author"}},"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PCjwr6Jc89RTyRXHRRcDbbd"}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"biography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"rdacontent","#text":"still image"},{"@authority":"Medical Subject Headings","#text":"Autobiography"},{"@authority":"aat","#text":"autobiographies (literary works)"},{"@authority":"fast","#text":"Autobiographies"},{"@authority":"fast","#text":"History"},{"@authority":"lcgft","#text":"Autobiographies"},{"@authority":"rvmgf","#text":"Autobiographies."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"tnu"},{"@type":"text","@authority":"marccountry","#text":"Tennessee"}]},"dateIssued":{"@encoding":"marc","#text":"2021"},"copyrightDate":{"@encoding":"marc","#text":"2021"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Nashville :"}},"agent":{"namePart":"HarperCollins Leadership,","role":{"roleTerm":"publisher"}},"dateIssued":"2021"}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xxiv, 264 pages, 8 unnumbered pages of plates : illustrations (chiefly color) ; 22 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Color content","#text":"polychrome"}}],"abstract":[{"@type":"Summary","#text":"Build an iconic shopping experience that your customers love--and a work environment that your employees love being a part of--using this blueprint from Trader Joe's visionary founder, Joe Coulombe."},{"@type":"Summary","#text":"Coulombe founded what would become Trader Joe's in the late 1960s and helped shape it into the quirky food chain it is today. Realizing early on that he could not compete and win by playing the same game his bigger competitors were playing, he decided to build a store for educated people of somewhat modest means. Buying unusual products from around the world, he provided customers with background on how they were sourced and their nutritional value. Here he shares the lessons he learned by challenging the status quo and rethinking the way a business operates. -- adapted from back cover and Amazon info."}],"tableOfContents":{"@type":"Contents","#text":"Foreword / Leroy D. Watson -- Preface. What's in a name? -- A trader Joe's sampler -- How we got there. The milk train doesn't stop here anymore ; The god of fair beginnings ; The guns of August, the wages of success ; On the road to Trader Joe's ; How I Love Lucy homogenized America ; Good time Charley ; Uncorked! ; Whole Earth Harry ; Promise, large promise ; Hairballs -- Mac the Knife. Mac the Knife ; Intensive buying ; Virtual distribution ; Private label products ; From discrete to indiscretions ; Too, too solid stores ; Skunks in the office ; Double entry retailing ; Demand side retailing ; Supply side retailing ; The last five year plans -- First I sell, then I leave. Employee ownership ; The sale of Trader Joe's ; Goodbye to all that -- Addendum. Post de-partum."},"note":[{"@type":"statement of responsibility","#text":"Joe Coulombe with Patty Civalleri."},{"@type":"bibliography","#text":"Includes bibliographical references and index."},"Includes index."],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"n-us---"}},{"@authority":"lcsh","topic":["Grocery trade","History"],"geographic":"United States"},{"@authority":"lcsh","topic":["Supermarkets","History"],"geographic":"United States"},{"@authority":"lcsh","topic":["Chain stores","History"],"geographic":"United States"},{"@authority":"lcsh","topic":["Specialty stores","History"],"geographic":"United States"},{"@authority":"lcsh","topic":"Success in business"},{"@authority":"lcsh","topic":["Retail trade","Management"]},{"@authority":"lcsh","topic":"Entrepreneurship"},{"@authority":"mesh","topic":"Entrepreneurship"},{"@authority":"rvm","topic":["Magasins à succursales multiples","Histoire"],"geographic":"États-Unis"},{"@authority":"rvm","topic":"Succès dans les affaires"},{"@authority":"rvm","topic":"Entrepreneuriat"},{"@authority":"aat","topic":"entrepreneurs"},{"@authority":"fast","topic":"Chain stores"},{"@authority":"fast","topic":"Entrepreneurship"},{"@authority":"fast","topic":"Grocery trade"},{"@authority":"fast","topic":["Retail trade","Management"]},{"@authority":"fast","topic":"Specialty stores"},{"@authority":"fast","topic":"Success in business"},{"@authority":"fast","topic":"Supermarkets"},{"@authority":"fast","geographic":"United States"},{"@authority":"lcsh","name":{"@type":"corporate","namePart":"Trader Joe's (Firm)"},"topic":"History"},{"@authority":"fast","name":{"@type":"corporate","namePart":"Trader Joe's (Firm)"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Coulombe, Joe,",{"@type":"date","#text":"1930-2020"}]}}],"classification":[{"@authority":"lcc","#text":"HD9321.9.T73 C68 2021"},{"@edition":"23","@authority":"ddc","#text":"658.40092"}],"relatedItem":[{"@type":"otherFormat","@otherType":"Online version:","@di