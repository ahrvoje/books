g/isni/000000011940971X","#text":"Harvard Law School Library, Harvard University"},"shelfLocator":"HC 107.N73 P63214 1988"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Law School"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990016771860203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"001677186"}},"processingDate":"2025-05-04T05:12Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"900925"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990016771860203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}},{"@version":"3.8","titleInfo":[{"title":"Beyond good and evil ","subTitle":"On the genealogy of morality "},{"@type":"alternative","title":"On the genealogy of morality"}],"name":[{"@usage":"primary","@type":"personal","namePart":["Nietzsche, Friedrich Wilhelm,",{"@type":"date","#text":"1844-1900"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},{"@type":"personal","namePart":["Del Caro, Adrian,",{"@type":"date","#text":"1952-"}],"role":{"roleTerm":{"@type":"text","#text":"translator"}}}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"cau"},{"@type":"text","@authority":"marccountry","#text":"California"}]},"dateIssued":{"@encoding":"marc","#text":"2014"},"copyrightDate":{"@encoding":"marc","#text":"2014"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Stanford, California :"}},"agent":{"namePart":"Stanford University Press,","role":{"roleTerm":"publisher"}},"dateIssued":[2014]}],"language":[{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},{"@objectPart":"translation","languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"ger"}}],"physicalDescription":{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"x, 525 pages ; 19 cm."},"abstract":{"@type":"Summary","#text":"Beyond Good and Evil inscribes itself boldly into the history of philosophy, challenging ancient and modern notions of philosophy's achievements and insisting on a new task for \"new philosophers.\" This is a watershed book for Nietzsche and for philosophy in the modern era. On the Genealogy of Morality applies Nietzsche's celebrated genealogical method, honed in the earlier aphoristic writings, to the problem of morality's influence on the human species. In three treatises that strikingly anticipate insights appearing much later in Freud's Civilization and Its Discontents (1930), Nietzsche provides an anthropological psychograph of our species, revealing the origins of the concepts of good and evil, the roles played by guilt and bad conscience, and the persistence of ascetic ideals. Manifesting a hopeful yet unsentimental assessment of the human condition, these books resonated throughout the 20th century and continue to exert broad appeal."},"tableOfContents":{"@type":"Contents","#text":"Beyond good and evil -- On the genealogy of morality."},"note":[{"@type":"statement of responsibility","#text":"Friedrich Nietzsche ; translated, with an afterword, by Adrian Del Caro."},"\"Translated from Friedrich Nietzsche, Sämtliche Werke: Kritische Studienausgabe, ed. Giorgio Colli and Mazzino Montinari, in 15 vols. This book corresponds to Vol. 5.\"--Title page verso.","Translation of: Jenseits von Gut und Böse ; Zur Genealogie der Moral. München : Deutscher Taschenbuch Verlag ; Berlin ; New York : De Gruyter, 1980.",{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"@authority":"lcsh","topic":"Ethics"},{"@authority":"fast","topic":"Ethics"},{"@authority":"mesh","topic":"Ethics"}],"classification":[{"@authority":"lcc","#text":"B3313.J42 E5 2014"},{"@edition":"23","@authority":"ddc","#text":"193"}],"relatedItem":[{"titleInfo":{"title":"The complete works of Friedrich Nietzsche ","partNumber":"volume 8"}},{"@type":"constituent","titleInfo":{"title":"Jenseits von Gut und Böse. English"},"name":{"@type":"personal","namePart":["Nietzsche, Friedrich Wilhelm,",{"@type":"date","#text":"1844-1900"}]}},{"@type":"constituent","titleInfo":{"title":"Zur Genealogie der Moral. English"},"name":{"@type":"personal","namePart":["Nietzsche, Friedrich Wilhelm,",{"@type":"date","#text":"1844-1900"}]}},{"@type":"constituent","titleInfo":{"title":"On the genealogy of morality"}},{"@type":"host","titleInfo":{"title":"The complete works of Friedrich Nietzsche "},"identifier":{"@type":"local","#text":"9958390211601381"}},{"@type":"series","titleInfo":{"title":"Works. English. 1995","partNumber":"v. 8"},"name":{"@type":"personal","namePart":["Nietzsche, Friedrich Wilhelm,",{"@type":"date","#text":"1844-1900"}]}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990140989190203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"9780804728805 (cloth : alk. paper)"},{"@type":"isbn","#text":"0804728801 (cloth : alk. paper)"},{"@type":"isbn","#text":"9780804788984 (pbk. : alk. paper)"},{"@type":"isbn","#text":"0804788987 (pbk. : alk. paper)"},{"@type":"lccn","#text":"^^2013046593"},{"@type":"oclc","#text":"843858352"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000121705139","#text":"Harvard Divinity School Library, Harvard University"},"shelfLocator":"