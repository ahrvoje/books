ype":"statement of responsibility","#text":"Adrian Del Caro."},{"@type":"bibliography","#text":"Bibliography of works by and about Nietzche: p. 151-157."}],"subject":[{"@authority":"lcsh","name":{"@type":"personal","namePart":["Nietzsche, Friedrich Wilhelm,",{"@type":"date","#text":"1844-1900"}]},"topic":"Aesthetics"},{"@authority":"lcsh","topic":"Aesthetics, Modern","temporal":"19th century"},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Nietzsche, Friedrich Wilhelm,",{"@type":"date","#text":"1844-1900"}]},"titleInfo":{"title":"Geburt der Tragödie"}}],"classification":{"@authority":"lcc","#text":"B3318.A4 D44 1981"},"relatedItem":[{"titleInfo":{"title":"European university studies. Series XX, Philosophy ; Europäische Hochschulschriften. Series XX, Philosophie ","partNumber":"v. 69 = Bd. 69"}},{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":{"title":"Dionysian aesthetics"},"originInfo":{"publisher":"Frankfurt am Main : Lang, ©1981"},"identifier":{"@type":"local","#text":"(OCoLC)647097868"},"name":{"namePart":"Del Caro, Adrian, 1952-"}},{"@type":"series","titleInfo":{"title":"Europäische Hochschulschriften","partNumber":["Reihe XX","Bd. 69"],"partName":"Philosophie "}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990006963500203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"3820468196 (pbk.) :"},{"@type":"lccn","#text":"^^^81191463^"},{"@type":"oclc","#text":"7374665"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"B3318.A4 D44 1981"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990006963500203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"000696350"}},"processingDate":"2026-09-08T04:15Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"821005"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990006963500203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"@version":"3.8","titleInfo":{"title":"Growing (Un)equal :","subTitle":"Fiscal Policy and Income Inequality in China and BRIC+ "},"name":[{"@usage":"primary","@type":"personal","namePart":"Cevik, Serhan.","role":{"roleTerm":{"@type":"text","#text":"creator"}}},{"@type":"personal","namePart":"Correa-Caro, Carolina."}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"government publication"},{"@authority":"rdacontent","#text":"text"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"dcu"},{"@type":"text","@authority":"marccountry","#text":"District of Columbia"}]},"dateIssued":{"@encoding":"marc","#text":"2015"},"issuance":"monographic","edition":"1st ed."},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Washington, D.C. :"}},"agent":{"namePart":"International Monetary Fund,","role":{"roleTerm":"publisher"}},"dateIssued":"2015."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marccategory","#text":"electronic resource"},{"@authority":"marcsmd","#text":"remote"},{"@type":"media","@authority":"rdamedia","#text":"computer"},{"@type":"carrier","@authority":"rdacarrier","#text":"online resource"}],"extent":"1 online resource (53 p.)"},"abstract":{"@type":"Abstract","#text":"This paper investigates the empirical characteristics of income inequality in China and a panel  of BRIC+ countries over the period 1980–2013, with a focus on the redistributive contribution  of fiscal policy. Using instrumental variable techniques to deal with potential endogeneity, we  find evidence supporting the hypothesis of the existence of a Kuznets curve—an inverted Ushaped  relationship between income inequality and economic development—in China and the  panel of BRIC+ countries. In the case of China, the empirical results indicate that government  spending and taxation have opposing effects on income inequality. While government  spending appears to have a worsening impact, taxation improves income distribution. Even  though the redistributive effect of fiscal policy in China appears to be stronger than what we  identify in the BRIC+ panel, it is not large enough to compensate for the adverse impact of  other influential factors."},"tableOfContents":[{"@type":"Contents","#text":"Cover Page; Title Page; Copyright Page; Contents; Figures; Tables; I. Introduction; Figure 1. Income Inequality and Fiscal Redistribution in China; II. China's Experience in the Global Context; Figure 2. China and the Rest of the World; III. An Overview of the Literature; IV. A Synopsis of China's Fiscal Policy; Figure 3. Evolution of Fiscal Policy in China; V. Data Description; Figure 4. Confidence Intervals of Gini Coefficients in China; Table 1. Descriptive Statistics: China; Table 2. Descriptive Statistics: BRIC+ Countries; VI. Empirical Strategy and Results"},"A. Instrumental Variable Models-ChinaTable 3. China: IV Estimation; B. Instrumental-Variable Panel Data Analysis-BRIC+; Table 4. BRIC+ Panel: IV-GMM Estimation; VII. Concluding Remarks and Policy Issues; References; Footnotes"],"note":[{"@type":"statement of responsibility","#text":"Serhan Cevik, Carolina Correa-Caro."},"Description based upon print version of record.","Description based on publisher supplied metadata and other sources."],"subject":[{"@authority":"imf","topic":"Macroeconomics"},{"@authority":"imf","topic":"Public Finance"},{"@authority":"imf","topic":"Economic Development, Innovation, Technological Change, and Growth"},{"@authority":"imf","topic":"Aggregate Factor Income Distribution"},{"@authority":"imf","topic":"Fiscal Policy"},{"@authority":"imf","topic":"National Government Expenditures and Related Policies: General"},{"@authority":"imf","topic":"Personal Income, Wealth, and Their Distributions"},{"@authority":"imf","topic":"Public finance & taxation"},{"@authority":"imf","topic":"Income inequality"},{"@authority":"imf","topic":"Income distribution"},{"@authority":"imf","topic":"Fiscal policy"},{"@authority":"imf","topic":"Expenditure"},{"@authority":"imf","topic":"Personal income"},{"@authority":"imf","topic":"National accounts"},{"@authority":"imf","topic":"Expenditures, Public"},{"@authority":"imf","topic":"Income"},{"@authority":"imf","geographic":"China, People's Republic of"}],"classification":[{"@authority":"lcc","#text":"HG3881.5.I58"},{"@authority":"ddc","#text":"332.15199999999999"}],"relatedItem":[{"titleInfo":{"title":"IMF Working Papers"}},{"@type":"otherFormat","identifier":{"@type":"isbn","#text":"9781475519976"}},{"@type":"otherFormat","identifier":{"@type":"isbn","#text":"1475519974"}},{"@type":"series","titleInfo":{"title":"IMF Working Papers; Working Paper ","partNumber":"No. 2015/068"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99153644330803941/catalog"}}],"identifier":[{"@type":"isbn","#text":"9781475551402"},{"@type":"isbn","#text":"1475551401"},{"@type":"isbn","#text":"9781484300602"},{"@type":"isbn","#text":"1484300602"},{"@type":"oclc","#text":"908074473"}],"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99153644330803941","processingDate":"2026-07-05T04:17Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"DcWaIMF"},"recordCreationDate":{"@encoding":"marc","#text":"020129"},"recordChangeDate":{"@encoding":"iso8601","#text":"20250426"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99153644330803941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"@version":"3.8","titleInfo":{"title":"Fiscal Reforms, Long-term Growth and Income Inequality "},"name":[{"@usage":"primary","@type":"personal","namePart":"Acosta Ormaechea, Santiago.","role":{"roleTerm":{"@type":"text","#text":"creator"}}},{"@type":"personal","namePart":"Correa-Caro, Carolina."},{"@type":"personal","namePart":"Komatsuzaki, Takuji."}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"government publication"},{"@authority":"rdacontent","#text":"text"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"dcu"},{"@type":"text","@authority":"marccountry","#text":"District of Columbia"}]},"dateIssued":{"@encoding":"marc","#text":"2017"},"issuance":"monographic","edition":"1st ed."},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Washington, D.C. :"}},"agent":{"namePart":"International Monetary Fund,","role":{"roleTerm":"publisher"}},"dateIssued":"2017."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marccategory","#text":"electronic resource"},{"@authority":"marcsmd","#text":"remote"},{"@type":"media","@authority":"rdamedia","#text":"computer"},{"@type":"carrier","@authority":"rdacarrier","#text":"online resource"}],"extent":"1 online resource (47 pages)"},"abstract":{"@type":"Abstract","#text":"We estimate the effects on growth of nine fiscal reform episodes in seven high-income countries  using the Synthetic Control Method. These episodes are selected using an indicator-based approach  applied to the evaluation of growth-friendly fiscal reforms during 1975-2010. We find that in reform  countries the annual growth rate of real GDP was on average about 1 percentage point above their  synthetic units 10 years after each respective reform. Moreover, countries which were initially less  developed seemed to experience a larger growth impact after their reforms. Results are broadly  robust to controlling for structural reforms on business regulation, financial market, labor market, and  legal and product markets, which may also affect growth. Our findings also suggest that inequality is  not affected by the growth-friendly fiscal reforms analyzed in this paper."},"tableOfContents":{"@type":"Contents","#text":"Cover -- Contents -- ABSTRACT -- I. INTRODUCTION -- II. COUNTRY SELECTION AND THE SYNTHETIC CONTROL METHOD -- A. Selection of Reform Countries -- B. Selection of Comparator Countries -- C. Synthetic Control Method -- III. BASELINE RESULTS -- IV. NON-FISCAL STRUCTURAL REFORMS AND LINKS WITH INEQUALITY -- A. Non-Fiscal Structural Reforms -- B. Inequality -- V. CONCLUDING REMARKS -- REFERENCES -- TABLES -- 1. Country-Case Selection Indicators -- 2. Countries that Satisfy the Quantitative Criteria -- 3. Summary Comparison of Non-Fiscal Structural Reforms -- 4. Growth Effect and \"Non-Fiscal Structural Reform Gap -- FIGURES -- 1. Growth Effects of Fiscal Structural Reforms: Baseline -- 2. Pre-Reform GDP Per Capita Relative to the US and After-Reform Growth Effect -- 3. Growth Effects: Baseline and Controlling for Non-Fiscal Structural Reforms -- 4. Changes in Market and Net Gini Coefficients in Reform Episodes -- 5. Changes in Market Gini Coefficients and Fiscal Redistribution, Treated vs Synthetic -- APPENDICES -- 1. Country Selection -- 2. Comparator Countries -- 3. Year-By-Year Charts of the SCM Baseline Results -- 4. Summary of Fiscal Reforms by Country -- 5. Placebo Experiments -- 6. Structural Reforms."},"note":[{"@type":"statement of responsibility","#text":"Santiago Acosta Ormaechea, Takuji Komatsuzaki, Carolina Correa-Caro."},"Description based on publisher supplied metadata and other sources."],"subject":[{"@authority":"imf","topic":"Macroeconomics"},{"@authority":"imf","topic":"Public Finance"},{"@authority":"imf","topic":"Fiscal Policy"},{"@authority":"imf","topic":"Economic Growth and Aggregate Productivity: General"},{"@authority":"imf","topic":"Comparative Studies of Countries"},{"@authority":"imf","topic":"Institutions and the Macroeconomy"},{"@authority":"imf","topic":"Aggregate Factor Income Distribution"},{"@authority":"imf","topic":"Personal Income, Wealth, and Their Distributions"},{"@authority":"imf","topic":"Fiscal policy"},{"@authority":"imf","topic":"Structural reforms"},{"@authority":"imf","topic":"Personal income"},{"@authority":"imf","topic":"Income inequality"},{"@authority":"imf","topic":"Income distribution"},{"@authority":"imf","topic":"Macrostructural analysis"},{"@authority":"imf","topic":"National accounts"},{"@authority":"imf","topic":"Income"},{"@authority":"imf","geographic":"Chile"}],"relatedItem":[{"titleInfo":{"title":"IMF Working Papers"}},{"@type":"otherFormat","identifier":{"@type":"isbn","#text":"9781484303689"}},{"@type":"otherFormat","identifier":{"@type":"isbn","#text":"1484303687"}},{"@type":"series","titleInfo":{"title":"IMF Working Papers; Working Paper ","partNumber":"No. 2017/145"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99153998585703941/catalog"}}],"identifier":[{"@type":"isbn","#text":"9781484306987"},{"@type":"isbn","#text":"1484306988"},{"@type":"isbn","#text":"9781484307014"},{"@type":"isbn","#text":"1484307011"},{"@type":"oclc","#text":"994775153"}],"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99153998585703941","processingDate":"2026-07-05T04:34Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"DcWaIMF"},"recordCreationDate":{"@encoding":"marc","#text":"020129"},"recordChangeDate":{"@encoding":"iso8601","#text":"20250426"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99153998585703941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"@version":"3.8","titleInfo":{"title":"Fiscal Stimulus Impact on Firms' Profitability During the Global Financial Crisis "},"name":[{"@usage":"primary","@type":"personal","namePart":"Correa-Caro, Carolina.","role":{"roleTerm":{"@type":"text","#text":"creator"}}},{"@type":"personal","namePart":"Medina, Leandro."},{"@type":"personal","namePart":"Poplawski Ribeiro, Marcos."},{"@type":"personal","namePart":"Sutton, Bennett."},{"@type":"corporate","namePart":"International Monetary Fund,","role":{"roleTerm":{"@type":"text","#text":"issuing body"}}}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"government publication"},{"@authority":"rdacontent","#text":"text"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"dcu"},{"@type":"text","@authority":"marccountry","#text":"District of Columbia"}]},"dateIssued":{"@encoding":"marc","#text":"2018"},"issuance":"monographic","edition":"1st ed."},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Washington, D.C. :"}},"agent":{"namePart":"International Monetary Fund,","role":{"roleTerm":"publisher"}},"dateIssued":"2018."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marccategory","#text":"electronic resource"},{"@authority":"marcsmd","#text":"remote"},{"@type":"media","@authority":"rdamedia","#text":"computer"},{"@type":"carrier","@authority":"rdacarrier","#text":"online resource"}],"extent":"1 online resource (39 pages)"},"abstract":{"@type":"Abstract","#text":"Using financial statement data from the Thomson Reuter’s Worldscope database for 22,333 non-financial firms in 52 advanced and emerging economies, this paper examines how fiscal stimulus (i.e., changes in structural deficit) interacted with sectoral business cycle sensitivity affected corporate profitability during the recovery period of the global financial crisis (GFC). Using cross-sectional analyses, our findings indicate that corporate profitability improved significantly after the GFC fiscal stimulus, especially in manufacturing, utilities and retail sectors. Firm size and leverage are also found to be significant in explaining changes in corporate profitability."},"tableOfContents":{"@type":"Contents","#text":"Cover -- Contents -- Abstract -- I. Introduction -- II. Literature Review -- III. Methodology -- A. Estimation Strategy -- B. Measures of Business Cycle Sensitivity and External Financial Dependency -- C. Corporate and Macroeconomic Data -- D. Descriptive Statistics -- IV. Results -- A. Baseline Estimation -- B. Testing Asymmetric Effects of the Fiscal Stimulus -- C. Industry/Sectoral Analysis -- D. Expenditure vs Revenue Composition of Stimulus -- V. Robustness Tests -- A. ILO's Alternative Measure of Discretionary Fiscal Stimulus -- B. Measuring Fiscal Stimulus through Government Expenditure Forecast Errors -- VI. Concluding Remarks -- References -- Tables -- 1. Summary Statistics, Full Sample -- 2. Summary Statistics, Advanced Economies -- 3. Summary Statistics, Emerging Market Economies -- 4. Results for All Countries for Profits -- 5. Asymmetric effects of Fiscal Stimulus on Firms' Profitability -- 6a. Horse Race Results Per Sector for Profits -- 6b. Horse Race Results Per Sector for Profits -- 7. Expenditure-Based Fiscal Stimulus -- Figures -- 1. Box-Whisker Plots: Profit (EBITDA) to Asset Ratios -- 2. Box-Whisker Plots: Growth Rate of Total Assets -- 3. Fiscal Impulse, 2009."},"note":[{"@type":"statement of responsibility","#text":"Carolina Correa-Caro, Leandro Medina, Marcos Poplawski Ribeiro, Bennett Sutton."},{"@type":"bibliography","#text":"Includes bibliographical references."},"Description based on publisher supplied metadata and other sources.","Description based on print version record."],"subject":[{"@authority":"lcsh","topic":"Global Financial Crisis, 2008-2009."},{"@authority":"lcsh","topic":"Economic development"},{"@authority":"lcsh","topic":"Financial risk management"},{"@authority":"imf","topic":"Banking"},{"@authority":"imf","topic":"Banks and Banking"},{"@authority":"imf","topic":"Business cycles"},{"@authority":"imf","topic":"Business Fluctuations"},{"@authority":"imf","topic":"Central bank policy rate"},{"@authority":"imf","topic":"Cycles"},{"@authority":"imf","topic":"Economic growth"},{"@authority":"imf","topic":"Expenditure"},{"@authority":"imf","topic":"Expenditures, Public"},{"@authority":"imf","topic":"Financial services"},{"@authority":"imf","topic":"Fiscal Policy"},{"@authority":"imf","topic":"Fiscal policy"},{"@authority":"imf","topic":"Fiscal stimulus"},{"@authority":"imf","topic":"Interest rates"},{"@authority":"imf","topic":"Interest Rates: Determination, Term Structure, and Effects"},{"@authority":"imf","topic":"Macroeconomics"},{"@authority":"imf","topic":"Multiple or Simultaneous Equation Models: Models with Panel Data"},{"@authority":"imf","topic":"National Deficit Surplus"},{"@authority":"imf","topic":"National Government Expenditures and Related Policies: General"},{"@authority":"imf","topic":"Prices, Business Fluctuations, and Cycles: General (includes Measurement and Data)"},{"@authority":"imf","topic":"Public finance & taxation"},{"@authority":"imf","topic":"Public Finance"},{"@authority":"imf","geographic":"United States"}],"classification":{"@authority":"lcc","#text":"HB3722 .C677 2018"},"relatedItem":[{"titleInfo":{"title":"IMF Wo