{"pagination":{"maxPageableSet":"10000","numFound":2,"query":"name=Levi&limit=10&title=The Periodic Table","limit":10,"start":0},"items":{"mods":[{"@version":"3.8","titleInfo":[{"nonSort":{"@space":"preserve","#text":"The  "},"title":"periodic table "},{"@type":"uniform","@nameTitleGroup":"1","title":"Sistema periodico. English"}],"name":[{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":["Levi, Primo,",{"@type":"date","#text":"1919-1987"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},{"@type":"personal","namePart":"Rosenthal, Raymond."},{"@type":"personal","namePart":"Ascherson, Neal","role":{"roleTerm":{"@type":"text","#text":"author of introduction"}}}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"Library of Congress Subject Headings","#text":"Autobiographical fiction, Italian."},{"@authority":"fast","#text":"Biographies"}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"New York "}}],"issuance":"monographic","agent":{"namePart":"Alfred A. Knopf"},"dateIssued":"1996"},"language":[{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},{"@objectPart":"translation","languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"ita"}}],"physicalDescription":[{"form":{"@authority":"marcform","#text":"print"},"extent":"xxv, 241 p. : ill. ; 21 cm."},{"form":{"@type":"Illustrative content","#text":"illustration"}}],"abstract":{"@type":"Summary","#text":"Largely a memoir of the years before and after Primo Levi's transportation from his native Italy to Auschwitz as an anti-Fascist partisan and a Jew, this book recounts, in clear, beautiful prose, the story of the Piemontese Jewish community from which Levi came, of his years as a student and young chemist at the inception of the Second World War, and of his investigations into the nature of the material world. It provides crucial links and backgrounds, both personal and intellectual, in the tremendous project of remembrance that is Levi's gift to posterity. But far from being a prologue to his experience of the Holocaust, Levi's masterpiece represents his most impassioned response to the events that engulfed him. It celebrates the pleasures of love and friendship and the search for meaning, and stands as a monument to those things in us that are capable of resisting and enduring in the face of tyranny.--From publisher description."},"tableOfContents":{"@type":"Contents","#text":"Argon -- Hydrogen -- Zinc -- Iron -- Potassium -- Nickel -- Lead -- Mercury -- Phosphorous -- Gold -- Cerium -- Chromium -- Sulfur -- Titanium -- Arsenic -- Nitrogen -- Tin -- Uranium -- Silver -- Vanadium -- Carbon."},"note":[{"@type":"statement of responsibility","#text":"Primo Levi ; translated from the Italian by Raymond Rosenthal ; with an introduction by Neal Ascherson."},{"@type":"bibliography","#text":"Includes bibliographical references (p. xvii)."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"e------"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Levi, Primo,",{"@type":"date","#text":"1919-1987"}]}},{"@authority":"lcsh","topic":"Jews","geographic":"Europe","genre":"Biography"}],"classification":[{"@authority":"lcc","#text":"PQ4872.E8 S513 1996"},{"@edition":"20","@authority":"ddc","#text":"858/.91403"}],"relatedItem":[{"@type":"series","titleInfo":{"title":"Everyman's library ","partNumber":"218"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990084952280203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0679444637 (alk. paper)"},{"@type":"lccn","#text":"^^^96008920^"},{"@type":"oclc","#text":"34745902"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI