/OL8631565M/The_Great_Disruption","preview":"noview","preview_url":"http://openlibrary.org/books/OL8631565M/The_Great_Disruption","thumbnail_url":"https://covers.openlibrary.org/b/id/917659-S.jpg","details":{"publishers":["Profile Books Ltd"],"number_of_pages":368,"title":"The Great Disruption","physical_format":"Paperback","identifiers":{"goodreads":["1884374"],"librarything":["5404267"]},"isbn_13":["9781861972170"],"covers":[917659],"edition_name":"New Ed edition","isbn_10":["1861972172"],"publish_date":"April 20, 2000","key":"/books/OL8631565M","authors":[{"key":"/authors/OL389579A","name":"Francis Fukuyama"}],"works":[{"key":"/works/OL2670541W"}],"type":{"key":"/type/edition"},"subjects":["Sociology, Social Studies","Sociology"],"source_records":["bwb:9781861972170"],"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2008-04-30T08:14:56.482104"},"last_modified":{"type":"/type/datetime","value":"2024-04-17T01:01:40.918276"}}},"OLID:OL21254415M":{"bib_key":"OLID:OL21254415M","info_url":"http://openlibrary.org/books/OL21254415M/The_great_disruption","preview":"noview","preview_url":"http://openlibrary.org/books/OL21254415M/The_great_disruption","details":{"publishers":["Profile Books"],"number_of_pages":354,"subtitle":"human nature and the reconstitution of social order","key":"/books/OL21254415M","authors":[{"key":"/authors/OL389579A","name":"Francis Fukuyama"}],"publish_places":["London"],"subjects":["Information society.","Social change -- History -- 20th century.","Social history -- 1945-","Social norms -- History -- 20th century.","Social integration."],"pagination":"xii, 354 p. :","title":"The great disruption","notes":{"type":"/type/text","value":"Includes bibliographical references and index."},"identifiers":{"goodreads":["2218856"],"librarything":["5404267"]},"languages":[{"key":"/languages/eng"}],"isbn_10":["1861970994"],"publish_date":"1999","publish_country":"enk","by_statement":"Francis Fukuyama.","works":[{"key":"/works/OL2670541W"}],"type":{"key":"/type/edition"},"source_records":["bwb:9781861970992"],"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2008-11-01T13:15:27.851370"},"last_modified":{"type":"/type/datetime","value":"2024-04-17T01:12:27.973165"}}},"OLID:OL24229331M":{"bib_key":"OLID:OL24229331M","info_url":"http://openlibrary.org/books/OL24229331M/The_great_disruption","preview":"restricted","preview_url":"https://archive.org/details/greatdisruptionh00fuku","thumbnail_url":"https://covers.openlibrary.org/b/id/6508363-S.jpg","details":{"publishers":["Free Press"],"subtitle":"human nature and the reconstitution of social order","ia_box_id":["IA117503"],"isbn_10":["068484530X"],"covers":[6508363],"local_id":["urn:sfpl:31223052166338","urn:nuls:31786101181078"],"lc_classifications":["HM851 .F85 1999","HM851.F85 1999"],"key":"/books/OL24229331M","authors":[{"key":"/authors/OL389579A","name":"Francis Fukuyama"}],"ocaid":"greatdisruptionh00fuku","publish_places":["New York"],"pagination":"xii, 354 p. ;","source_records":["ia:greatdisruptionh00fuku","marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run02.mrc:189554860:1538","marc:marc_loc_2016/BooksAll.2016.part27.utf8:231221761:842","marc:marc_nuls/NULS_PHC_180925.mrc:37786620:1094","bwb:9780684845302","marc:marc_columbia/Columbia-extract-20221130-005.mrc:378310244:3262","marc:harvard_bibliographic_metadata/20220215_040.bib.mrc:165749036:4684"],"title":"The great disruption","dewey_decimal_class":["303.4"],"number_of_pages":354,"lccn":["99022527"],"subjects":["Information society.","Social change -- History -- 20th century.","Social history -- 1945-","Social norms -- History -- 20th century.","Social integration."],"publish_date":"1999","publish_country":"nyu","by_statement":"Francis Fukuyama.","works":[{"key":"/works/OL16455602W"}],"type":{"key":"/type/edition"},"oclc_numbers":["99022527","40901223"],"description":{"type":"/type/text","value":"The Great Disruption begins by observing that over the past thirty years, the United States and other developed countries have undergone a profound transformation from industrial to information societies; knowledge has replaced mass production as the basis of wealth, power, and social interaction. At the same time, Western societies have endured increasing levels of crime, massive changes in fertility and family structure, decreasing levels of trust, and the triumph of individualism over community.\n\nJust as the Industrial Revolution brought about momentous changes in society's moral values, a similar Great Disruption in our own time has caused profound changes in our social structure.\n\nDrawing on the latest sociological data and new theoretical models from fields as diverse as economics and biology, Fukuyama reveals that even though the old order has broken apart, a new social order is already taking shape. Indeed, he suggests, the Great Disruption of the 1960s and 1970s may be giving way to a Great Reconstruction, as Western society weaves a new fabric of social and moral values appropriate to the changed realities of the postindustrial world."},"languages":[{"key":"/languages/eng"}],"latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2010-05-13T19:46:23.117869"},"last_modified":{"type":"/type/datetime","value":"2026-05-20T09:43:32.223798"}}}}}