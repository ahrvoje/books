.edu/alma/99155769402703941/catalog"}}],"identifier":[{"@type":"isbn","#text":"9780593084694"},{"@type":"isbn","#text":"0593084691"},{"@type":"oclc","#text":"1237358449"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/000000046073724X","#text":"Cabot Science Library, Harvard University"},"shelfLocator":"QA93 .P37275 2021"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","#text":"Science and Engineering Complex Library, Harvard University"},"shelfLocator":"QA93 .P37275 2021"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":["Cabot Science","Science and Engineering Complex Library"]},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99155769402703941","processingDate":"2024-03-21T05:16Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"LJW"},"recordCreationDate":{"@encoding":"marc","#text":"210212"},"recordChangeDate":{"@encoding":"iso8601","#text":"20240128"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99155769402703941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"@version":"3.8","titleInfo":[{"title":"Humble Pi ","subTitle":"a comedy of maths errors "},{"@type":"alternative","title":"Comedy of maths errors"}],"name":{"@usage":"primary","@type":"personal","namePart":["Parker, Matt",{"@type":"termsOfAddress","#text":"(Mathematician)"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}],"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJjmMWjkMRyPvr4VP7y68C"},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"rdacontent","#text":"still image"},{"@authority":"aat","#text":"miscellanies."},{"@authority":"aat","#text":"humor."},{"@authority":"fast","#text":"Trivia and miscellanea"},{"@authority":"fast","#text":"Humor"},{"@authority":"lcgft","#text":"Trivia and miscellanea"},{"@authority":"lcgft","#text":"Humor"},{"@authority":"rvmgf","#text":"Miscellanées."},{"@authority":"rvmgf","#text":"Humour."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},"dateIssued":{"@encoding":"marc","#text":"2019"},"copyrightDate":{"@encoding":"marc","#text":"2019"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"[London] UK :"}},"agent":{"namePart":"Allen Lane, an imprint of Penguin Books,","role":{"roleTerm":"publisher"}},"dateIssued":"2019."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"314 pages : illustrations ; 24 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}}],"abstract":{"@type":"Summary","#text":"What makes a bridge wobble when it's not meant to? Billions of dollars mysteriously vanish into thin air? A building rock when its resonant frequency matches a gym class leaping to Snap's 1990 hit \"The Power\"? The answer is maths. Or, to be precise, what happens when maths goes wrong in the real world. As Matt Parker shows us, our modern lives are built on maths: computer programes, finance, engineering. And most of the time this maths works quietly behind the scenes, until...it doesn't. Exploring and explaining a litany of glitches, near-misses and mishaps involving the internet, big data, elections, street signs, lotteries, the Roman empire and a hapless Olympic shooting team, Matt Parker shows us the bizarre ways maths trips us up, and what this reveals about its essential place in our world. Mathematics doesn't have good 'people skills', but we would all be better off, he argues, if we saw it as a practical ally. This book shows how, by making maths our friend, we cal learn from its pitfalls. It also contains puzzles, challenges, geometric socks, jokes about binary code and three deliberate mistakes. Getting it wrong has never been more fun--Publisher's description."},"tableOfContents":{"@type":"Contents","#text":"Losing track of time -- Engineering mistakes -- Little data -- Out of shape -- You can't count on it -- Does not compute -- Probably wrong -- Put your money where your mistakes are -- A round-about way -- Too small to notice -- Units, conventions, and why can't we all just get along? -- Stats and why I like it -- Tltloay rodanm -- Does not compute -- So, what have we learned from our mistakes?."},"targetAudience":{"@authority":"marctarget","#text":"adult"},"note":[{"@type":"statement of responsibility","#text":"Matt Parker."},{"@type":"bibliography","#text":"Includes bibliographical references and index."},"Pages numbered in reverse."],"subject":[{"@authority":"lcsh","topic":"Mathematics","genre":"Miscellanea"},{"@authority":"lcsh","topic":"Mathematics","genre":"Humor"},{"@authority":"lcsh","topic":"Errors"},{"@authority":"rvm","topic":"Mathématiques","genre":"Miscellanées"},{"@authority":"rvm","topic":"Mathématiques","genre":"Humour"},{"@authority":"rvm","topic":"Erreurs"},{"@authority":"eflch","topic":"Mathematics"},{"@authority":"fast","topic":"Errors"},{"@authority":"fast","topic":"Mathematics"},{"@authority":"ukslc","topic":"Popular Science and Mathematics"}],"classification":[{"@authority":"lcc","#text":"QA99 .P37 2019"},{"@edition":"23","@authority":"ddc","#text":"510"}],"relatedItem":[{"@type":"otherFormat","@otherType":"Ebook version :",