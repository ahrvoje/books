{"pagination":{"maxPageableSet":"10000","numFound":82,"query":"name=Keynes&limit=10&title=The General Theory of Employment, Interest, and Money","limit":10,"start":0},"items":{"mods":[{"titleInfo":{"title":"Keynes's The general theory of employment, interest, and money","subTitle":"a concordance"},"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":"Glahe, Fred R.","role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"index"},{"@authority":"fast","#text":"Concordances"},{"@authority":"fast","#text":"Concordances."}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"mdu"},{"@type":"text","@authority":"marccountry","#text":"Maryland"}]},{"placeTerm":{"@type":"text","#text":"Savage, Md"}}],"publisher":"Rowman & Littlefield","dateIssued":["c1991",{"@encoding":"marc","#text":"1991"}],"issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"xii, 280 p. ; 24 cm."},"abstract":{"@type":"Summary","#text":"\"This concordance ... is based on his 1936 first edition, published in the United States by Harcourt Brace Jovanovich\"--Pref."},"note":[{"@type":"statement of responsibility","#text":"edited by Fred R. Glahe ; with an introduction by Kenneth E. Boulding."},"\"This concordance ... is based on the 1936 first edition, as published in the United States by Harcourt Brace Jovanovich\"--Editor's pref."],"subject":{"@authority":"lcsh","name":{"@type":"personal","namePart":["Keynes, John Maynard",{"@type":"date","#text":"1883-1946"}]},"titleInfo":{"title":"General theory of employment, interest and money"},"topic":"Concordances"},"classification":[{"@authority":"lcc","#text":"HB99.K38 G53 1991"},{"@edition":"20","@authority":"ddc","#text":"330.15/6"}],"relatedItem":[{"titleInfo":{"title":"General theory of employment, interest, and money"},"name":{"@type":"personal","namePart":["Keynes, John Maynard,",{"@type":"date","#text":"1883-1946"}]}},{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":{"title":"Keynes's The general theory of employment, interest, and money"},"name":{"namePart":"Glahe, Fred R."},"originInfo":{"publisher":"Savage, Md. : Rowman & Littlefield, ©1991"},"identifier":{"@type":"local","#text":"(OCoLC)646273425"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990023387970203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0847676781 (cloth : alk. paper)"},{"@type":"lccn","#text":"^^^91023359^"},{"@type":"oclc","#text":"24066890"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"HB99.K38 G53 1991"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990023387970203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"002338797"}},"processingDate":"2024-04-11T05:10Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"910617"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990023387970203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}},{"@version":"3.8","titleInfo":{"nonSort":{"@space":"preserve","#text":"L' "},"title":"actualité des textes fondateurs ","subTitle":"Adam Smith, Karl Marx et John Maynard Keynes "},"name":{"@usage":"primary","@type":"personal","namePart":"Gilles, Philippe,","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"fast","#text":"Sources"},{"@authority":"fast","#text":"History"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"fr"},{"@type":"text","@authority":"marccountry","#text":"France"}]},"dateIssued":{"@encoding":"marc","#text":"2018"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Paris :"}},"agent":{"namePart":"Classiques Garnier,","role":{"roleTerm":"publisher"}},"dateIssued":"2018."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"fre"},{"@type":"text","@authority":"iso639-2b","#text":"French"}]},"physicalDescription":{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"210 pages ; 22 cm."},"abstract":{"@type":"Summary","#text":"L'étude de La Richesse des nations, du Capital et de la Théorie générale révèle les idées, toujours actuelles, respectivement de la nécessité de l'État ; de la capacité du capitalisme à surmonter ses contradictions ; de l'importance de la psychologie dans le comportement des hommes en société. -- Provided by publisher."},"tableOfContents":{"@type":"Contents","#text":"Pt. 1. Adam Smith et ses recherches sur la nature et les causes de la richesse des nations -- De la manufacture d'épingles à la division du travail comme naissance du sujet économique -- Condition à l'opulence des Nations -- La division du travail comme incarnation historique de la \"valeur travail\" -- L'avantage à l'échange et la volonté d'enrichissement illimité comme conditions à l'opulence des Nations -- Des conditions de l'opulence des particuliers â celle des nations -- Le Marché et la \"main invisible\" -- Le Marché : de la pratique de l'échange à la manifestation providentielle de la \"main invisible\" -- Le \"libre échange\" : du principe aux réalités -- De la spontanéité au \"système de la liberté naturelle\" -- L'État comme \"surintendant de l'industrie des particuliers chargé de la diriger vers les emplois les mieux assortis à l'intérêt général de la société\" -- La conception libérale de l'État. Les fonctions régaliennes et l'Éducation comme réponses aux défaillances de l'intérêt privé et des vertus civiques -- L'action économique de l'État. Des travaux et services publics aux impôts et à la régulation bancaire -- Pt. 2. Karl Marx et le capital. Critique de l'économie politique -- De la théorie de la valeur à la transformation de la \"plus-value\" en \"profit\" et de la \"valeur\" en \"prix de production\" -- Du fétichisme de la marchandise à la \"formule générale du capital\" -- L'exploitation de la force de travail comme condition à l'extraction de la plus-value et du profit -- Accumulation du \"capital individuel\" et accumulation du \"capital social\" -- Conditions et mécanismes de la \"reproduction simple\" et de la \"reproduction élargie\" -- Les fondements micro-économiques de l'accumulation du capital. La reproduction du \"capital individuel\" -- L'analyse macro-économique de l'accumulation du capital. Les schémas de reproduction -- Les explications des cycles économiques dans le capital -- Le schéma des trois temporalités -- La cyclicité de \"l'armée industrielle de réserve\". Une temporalité conjoncturelle -- La cyclicité des taux de profit et du taux d'intérêt. Une temporalité financière -- Les cycles de rotation du capital. Une temporalité technologique -- Pt. 3. John Maynard Keynes et la théorie générale de l'emploi, de l'intérêt et de la monnaie -- La théorie générale comme fondement de la macroéconomie moderne -- De la démonstration du sous-emploi aux propositions de politique économique de retour au plein emploi -- Des critiques des \"postulats classiques\" au pragmatisme keynésien -- Le modèle de Keynes -- Entreprise, spéculation, convention et nature humaine ou l'instabilité économique comme conséquence de l'état de la prévision à long terme -- Les décisions d'investissement et \"l'état de la prévision à long terme\" -- Les \"marchés financiers organisés\" et la nécessité des conventions."},"note":[{"@type":"statement of responsibility","#text":"Philippe Gilles."},{"@type":"bibliography","#text":"Includes bibliographical references (pages 195-199) and indexes."}],"subject":[{"@authority":"lcsh","topic":["Economics","History","Sources"]},{"@authority":"rvm","topic":["Économie politique","Histoire","Sources"]},{"@authority":"fast","@href":"(OCoLC)fst00902116","topic":"Economics"},{"@authority":"fast","@href":"(OCoLC)fst00972484","topic":"Influence (Literary, artistic, etc.)"},{"@authority":"gnd","topic":"Volkswirtschaft"},{"@authority":"fast","@href":"(OCoLC)fst01356847","titleInfo":{"title":"General theory of employment, interest and money (Keynes, John Maynard)"}},{"@authority":"fast","@href":"(OCoLC)fst01356351","titleInfo":{"title":"Inquiry into the nature and causes of the wealth of nations (Smith, Adam)"}},{"@authority":"fast","@href":"(OCoLC)fst01356163","titleInfo":{"title":"Kapital (Marx, Karl)"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Smith, Adam,",{"@type":"date","#text":"1723-1790"}]},"titleInfo":{"title":"Inquiry into the nature and causes of the wealth of nations"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Marx, Karl,",{"@type":"date","#text":"1818-1883"}]},"titleInfo":{"title":"Kapital"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Keynes, John Maynard,",{"@type":"date","#text":"1883-1946"}]},"titleInfo":{"title":"General theory of employment, interest and money"}},{"@authority":"fast","name":{"@type":"personal","namePart":["Keynes, John Maynard,",{"@type":"date","#text":"1883-1946"}]}},{"@authority":"fast","name":{"@type":"personal","namePart":["Marx, Karl,",{"@type":"date","#text":"1818-1883"}]}},{"@authority":"fast","name":{"@type":"personal","namePart":["Smith, Adam,",{"@type":"date","#text":"1723-1790"}]}},{"@authority":"gnd","name":{"@type":"personal","namePart":["Smith, Adam",{"@type":"date","#text":"1723-1790"}]},"titleInfo":{"title":"An inquiry into the nature and causes of the wealth of nations"}},{"@authority":"gnd","name":{"@type":"personal","namePart":["Marx, Karl",{"@type":"date","#text":"1818-1883"}]},"titleInfo":{"title":"Das Kapital"}},{"@authority":"gnd","name":{"@type":"personal","namePart":["Keynes, John Maynard",{"@type":"date","#text":"1883-1946"}]},"titleInfo":{"title":"General theory of employment, interest and money"}}],"classification":[{"@authority":"lcc","#text":"HB75 .G518 2018"},{"@authority":"ddc","#text":"330"}],"relatedItem":[{"titleInfo":{"title":"Bibliothèque de l'économiste","partNumber":"Vol. 18"}},{"@type":"series","titleInfo":{"title":"Bibliothèque de l'économiste","partNumber":"18"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99153696983503941/catalog"}}],"identifier":[{"@type":"isbn","#text":"9782406072287"},{"@type":"isbn","#text":"2406072282"},{"@type":"isbn","#text":"2406072290"},{"@type":"isbn","#text":"9782406072294"},{"@type":"lccn","#text":"2018415962"},{"@type":"oclc","#text":"1046623236"}],"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99153696983503941","processingDate":"2025-08-03T05:17Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"180727"},"recordChangeDate":{"@encoding":"iso8601","#text":"20250728"},"recordIdentifier":{"@source":"MH:ALMA","