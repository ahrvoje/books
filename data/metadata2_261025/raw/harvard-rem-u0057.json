{"pagination":{"maxPageableSet":"10000","numFound":2,"query":"name=Mehta&limit=10&title=Swipe to Unlock","limit":10,"start":0},"items":{"mods":[{"@version":"3.8","titleInfo":{"title":"Swipe to unlock ","subTitle":"the primer on technology and business strategy "},"name":[{"@usage":"primary","@type":"personal","namePart":"Mehta, Neel","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},{"@type":"personal","namePart":"Detroja, Parth","role":{"roleTerm":{"@type":"text","#text":"author"}}},{"@type":"personal","namePart":"Agashe, Aditya","role":{"roleTerm":{"@type":"text","#text":"author"}}}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"fast","#text":"Popular works"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},"dateIssued":{"@encoding":"marc","#text":"2023"},"issuance":"monographic","edition":"3rd edition, 7th revision (July 2023)."},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"[Ithaca, New York] :"}},"agent":{"namePart":"Belle Applications, Inc,","role":{"roleTerm":"publisher"}},"dateIssued":"2023"}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"333 pages : illustrations, maps ; 22 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Illustrative content","#text":"map"}}],"abstract":{"@type":"Summary","#text":"\"How does Spotify decide which songs to recommend? Why would Amazon offer free shipping if it loses them money? How did a single typo take down 20% of the internet? You don't have to be a tech industry veteran to answer questions like these. Authored by three product managers at Google, Facebook, and Microsoft, Swipe to Unlock analyzes real-world cases to break down the core concepts of technology and business strategy. Learn the ins and outs of the tech industry and how to think like a seasoned technology executive even if you are just starting out in your tech career. Accessible, in-depth, and refreshingly clear, Swipe to Unlock is the key to landing your dream job in tech, launching the next great startup, or becoming a better-informed digital citizen\""},"tableOfContents":{"@type":"Contents","#text":"Software development -- Operating systems -- App economics -- The internet -- Cloud computing -- Big data -- Hacking & security -- Hardware & robots -- Business motives -- Emerging markets -- Technology policy -- Trends going forward"},"note":[{"@type":"statement of responsibility","#text":"Neel Mehta, Parth Detroja,  Aditya Agashe"},{"@type":"bibliography","#text":"Includes bibliographical references and index"}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"n-us---"}},{"@authority":"lcsh","topic":"Computer science","genre":"Popular works"},{"@authority":"lcsh","topic":"Technology","genre":"Popular works"},{"@authority":"lcsh","topic":"High technology industries","geographic":"United States"},{"@authority":"lcsh","topic":["Information technology","Economic aspects"],"genre":"Popular works"},{"@authority":"lcsh","topic":["Business","Technological innovations"],"genre":"Popular works"},{"@authority":"rvm","topic":"Informatique","genre":"Ouvrages de vulgarisation"},{"@authority":"rvm","topic":"Technologie","genre":"Ouvrages de vulgarisation"},{"@authority":"rvm","topic":"Industries de pointe","geographic":"États-Unis"},{"@authority":"rvm","topic":["Technologie de l'information","Aspect économique"],"genre":"Ouvrages de vulgarisation"},{"@authority":"rvm","topic":["Affaires",