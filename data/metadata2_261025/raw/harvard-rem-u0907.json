{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Eagle&limit=10&title=Trillion Dollar Coach","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":{"title":"Trillion dollar coach ","subTitle":"the leadership playbook of Silicon Valley's Bill Campbell "},"name":[{"@usage":"primary","@type":"personal","namePart":["Schmidt, Eric,",{"@type":"date","#text":"1955 April 27-"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},{"@type":"personal","namePart":["Rosenberg, Jonathan,",{"@type":"date","#text":"1961-"}],"role":{"roleTerm":{"@type":"text","#text":"author"}},"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJxMkmdHwr9WTPyGkKtMyd"},{"@type":"personal","namePart":"Eagle, Alan","role":{"roleTerm":{"@type":"text","#text":"author"}},"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PCjHkp9Fr4TWpX4mR93d38K"}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"marcgt","#text":"biography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"aat","#text":"collective biographies."},{"@authority":"fast","#text":"Biographies"},{"@authority":"fast","#text":"Anecdotes"},{"@authority":"lcgft","#text":"Biographies"},{"@authority":"lcgft","#text":"Anecdotes"},{"@authority":"rvmgf","#text":"Biographies."},{"@authority":"rvmgf","#text":"Anecdotes."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},"dateIssued":{"@encoding":"marc","#text":"2019"},"issuance":"monographic","edition":"First edition."},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"New York, NY :"}},"agent":{"namePart":"HarperCollins Publishers,","role":{"roleTerm":"publisher"}},"dateIssued":[2019]}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xvi, 218 pages : illustrations ; 24 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}}],"abstract":[{"@type":"Summary","#text":"\"Eric Schmidt, Jonathan Rosenberg and Alan Eagle, the team behind How Google Works, return with the story of Bill Campbell, the greatest executive business coach the world has ever seen, responsible for creating more value than just about anybody else on the planet\"-- Provided by publisher."},{"@type":"Summary","#text":"Bill Campbell's mentoring of some of our most successful modern entrepreneurs has helped create well over a trillion dollars in market value. Here Schmidt, Rosenberg and Eagle examine how the man fondly known as Coach Bill built trusting relationships, fostered personal growth, inspired courage, and identified and resolved simmering tensions that inevitably arise in fast-moving environments. The result is a blueprint for forward-thinking business leaders and managers that will help them create higher performing and faster moving cultures, teams, and companies. -- adapted from jacket"}],"tableOfContents":{"@type":"Contents","#text":"Foreword / by Adam Grant -- The caddie and the CEO -- Your title makes you a manager. Your people make you a leader -- Build an envelope of trust -- Team first -- The power of love -- The yardstick."},"note":[{"@type":"statement of responsibility","#text":"Eric Schmidt, Jonathan Rosenberg and Alan Eagle."},{"@type":"bibliography","#text":"Includes bibliographical references (pages 201-207) and index."}],"subject":[{"geographicCode":[{"@authority":"marcgac","#text":"n-us---"},{"@authority":"marcgac","#text":"n-us-ca"}]},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Campbell, Bill,",{"@type":"date","#text":"1940-2016"}]},"genre":"Anecdotes"