{"pagination":{"maxPageableSet":"10000","numFound":108,"query":"name=Pirsig&limit=10&title=Zen and the Art of Motorcycle Maintenance","limit":10,"start":0},"items":{"mods":[{"@version":"3.8","titleInfo":{"title":"Guidebook to Zen and the art of motorcycle maintenance "},"name":[{"@usage":"primary","@type":"personal","namePart":"DiSanto, Ronald L.","role":{"roleTerm":{"@type":"text","#text":"creator"}}},{"@type":"personal","namePart":"Steele, Thomas J."}],"typeOfResource":"text","genre":{"@authority":"marcgt","#text":"biography"},"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"New York "}}],"issuance":"monographic","agent":{"namePart":"W. Morrow"},"dateIssued":"1990","edition":"1st ed."},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":{"@authority":"marcform","#text":"print"},"extent":"407 p. : ill., map ; 25 cm."},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Illustrative content","#text":"map"}}],"abstract":{"@type":"Summary","#text":"When Robert Pirsig's Zen and the Art of Motorcycle Maintenance was first published in 1974, it caused a literary sensation. An entire generation was profoundly affected by the story of the narrator, his son, Chris, and their month-long motorcycle odyssey from Minnesota to California. A combination of philosophical speculation and psychological tension, the book is a complex story of relationships, values, madness, and, eventually, enlightenment. Ronald DiSanto and Thomas Steele have spent years investigating the background and underlying symbolism of Pirsig's work. Together, and with the approval of Robert Pirsig, they have written a fascinating reference/companion to the original. This guidebook serves as a metaphorical backpack of supplies for the reader's journey through the original work. With the background material, insights, and perspectives the authors provide, it has become required reading for new fans of the book as well as those who have returned to it over the years."},"note":[{"@type":"statement of responsibility","#text":"Ronald L. DiSanto and Thomas J. Steele."},{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"n-us---"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":"Pirsig, Robert M."},"titleInfo":{"title":"Zen and the art of motorcycle maintenance"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":"Pirsig, Robert M."}},{"@authority":"lcsh","name":{"@type":"personal","namePart":"Pirsig, Robert M."},"topic":"Travel","geographic":"United States"},{"@authority":"lcsh","topic":"Fathers and sons","geographic":"United States"},{"@authority":"lcsh","topic":"Philosophy and civilization"},{"@authority":"lcsh","topic":"Zen Buddhism and science"},{"@authority":"lcsh","topic":"Essentialism (Philosophy)"},{"@authority":"lcsh","topic":"Values"},{"@authority":"lcsh","topic":"Conduct of life"},{"@authority":"lcsh","topic":"Self"}],"classification":[{"@authority":"lcc","#text":"CT275.P6483 D57 1990"},{"@edition":"20","@authority":"ddc","#text":"917.304/92"}],"relatedItem":[{"titleInfo":{"title":"Zen and the art of motorcycle maintenance"},"name":{"@type":"personal","namePart":"Pirsig, Robert M."}},{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":{"title":"Guidebook to Zen and the art of motorcycle maintenance"},"originInfo":{"publisher":"New York : W. Morrow, ©1990","edition":"1st ed."},"identifier":{"@type":"local","#text":"(OCoLC)802298850"},"name":{"namePart":"DiSanto, Ronald L."}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990019991980203941/catalog"}}],"identifier":[{