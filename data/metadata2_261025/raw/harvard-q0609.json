de fiction."},{"@authority":"rvmgf","#text":"Romans graphiques."},{"@authority":"rvmgf","#text":"Récits personnels."},{"@authority":"tgfbne","#text":"Relatos personales"},{"@authority":"tgfbne","#text":"Cómics autobiográficos"},{"@authority":"tgfbne","#text":"Cómics sociales"},{"@authority":"tgfbne","#text":"Cómics de no ficción"},{"@authority":"tgfbne","#text":"Cómics"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"quc"},{"@type":"text","@authority":"marccountry","#text":"Québec (Province)"}]},"dateIssued":{"@encoding":"marc","#text":"2022"},"copyrightDate":{"@encoding":"marc","#text":"2022"},"issuance":"monographic","edition":"First edition."},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"[Montréal, Québec] :"}},"agent":{"namePart":"Drawn & Quarterly,","role":{"roleTerm":"publisher"}},"dateIssued":"2022."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@authority":"marccategory","#text":"text"},{"@authority":"marcsmd","#text":"regular print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"430 pages, 4 unnumbered pages : chiefly illustrations, maps ; 24 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Illustrative content","#text":"map"}}],"abstract":{"@type":"Summary","@href":"https://drawnandquarterly.com/books/ducks/","#text":"\"Before there was Kate Beaton, New York Times bestselling cartoonist of Hark! A Vagrant, there was Katie Beaton of the Cape Breton Beatons, specifically Mabou, a tight-knit seaside community where the lobster is as abundant as beaches, fiddles, and Gaelic folk songs. With the singular goal of paying off her student loans, Katie heads out west to take advantage of Alberta's oil rush--part of the long tradition of East Coasters who seek gainful employment elsewhere when they can't find it in the homeland they love so much. Katie encounters the harsh reality of life in the oil sands, where trauma is an everyday occurrence yet is never discussed. Beaton's natural cartooning prowess is on full display as she draws colossal machinery and mammoth vehicles set against a sublime Albertan backdrop of wildlife, northern lights, and boreal forest. Her first full length graphic narrative, Ducks: Two Years in the Oil Sands is an untold story of Canada: a country that prides itself on its egalitarian ethos and natural beauty while simultaneously exploiting both the riches of its land and the humanity of its people.\" -- description from publisher's website."},"note":[{"@type":"statement of responsibility","#text":"Kate Beaton."},"Ignatz award winner, 2023"],"subject":[{"geographicCode":[{"@authority":"marcgac","#text":"n-cn---"},{"@authority":"marcgac","#text":"n-cn-ab"}]},{"@authority":"lcsh","topic":"Petroleum workers","geographic":"Canada","genre":["Biography","Comic books, strips, etc"]},{"@authority":"lcsh","topic":"Women employees","geographic":"Canada","genre":["Biography","Comic books, strips, etc"]},{"@authority":"lcsh","topic":"Cartoonists","geographic":"Canada","genre":["Biography","Comic books, strips, etc"]},{"@authority":"lcsh","topic":["Petroleum industry and trade","Social aspects"],"geographic":"Canada","genre":"Comic books, strips, etc"},{"@authority":"lcsh","topic":"Psychic trauma","genre":"Comic books, strips, etc"},{"@authority":"lcsh","topic":"Sexual harassment","genre":"Comic books, strips, etc"},{"@authority":"lcsh","topic":"Oil sands","geographic":"Alberta","genre":"Comic books, strips, etc"},{"@authority":"lcsh","topic":"Gas wells"},{"@authority":"lcshac","@href":"(DLC)sj2021052987","topic":"Cartoonists","genre":"Comic books, strips, etc"},{"@authority":"mesh","topic":"Oil and Gas Fields"},{"@authority":"mesh"