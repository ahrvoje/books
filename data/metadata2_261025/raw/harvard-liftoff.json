{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Berger&limit=10&title=Liftoff","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":[{"title":"Liftoff ","subTitle":"Elon Musk and the desperate early days that launched SpaceX "},{"@type":"alternative","title":"Lift off"},{"@type":"alternative","title":"Elon Musk and the desperate early days that launched SpaceX"}],"name":{"@usage":"primary","@type":"personal","namePart":["Berger, Eric",{"@type":"termsOfAddress","#text":"(Science writer)"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"biography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"rdacontent","#text":"still image"},{"@authority":"fast","#text":"History"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},"dateIssued":{"@encoding":"marc","#text":"2021"},"copyrightDate":{"@encoding":"marc","#text":"2021"},"issuance":"monographic","edition":"First edition."},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"New York, NY :"}},"agent":{"namePart":"William Morrow, an imprint of HarperCollinsPublishers,","role":{"roleTerm":"publisher"}},"dateIssued":[2021]}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"280 pages, 16 unnumbered pages of plates : illustrations (chiefly color) ; 24 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Color content","#text":"polychrome"}}],"abstract":{"@type":"Summary","#text":"Less than 20 years after its founding, SpaceX boasts the largest constellation of commercial satellites in orbit, has pioneered reusable rockets, and in 2020 became the first private company to launch human beings into orbit. Berger takes readers inside the wild early days that made SpaceX. Focusing on the company's first four launches of the Falcon 1 rocket, he charts the bumpy journey from scrappy underdog to aerospace pioneer. He draws upon interviews with dozens of former and current engineers, designers, mechanics, and executives, including Elon Musk. -- Adapted from jacket."},"tableOfContents":{"@type":"Contents","#text":"Prologue -- Early years -- Merlin -- Kwaj -- Flight one -- Selling rockets -- Flight two -- Texas -- Flight three -- Eight weeks -- Flight four -- Always go to eleven -- Epilogue -- Key SpaceX employees from 2002 to 2008 -- Timeline -- Bulent Altan's Turkish goulash."},"targetAudience":{"@authority":"marctarget","#text":"adult"},"note":[{"@type":"statement of responsibility","#text":"Eric Berger."},"Includes index."],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"n-us---"}},{"@authority":"lcsh","topic":["Space flight","History"],"temporal":"21st century"},{"@authority":"lcsh","topic":["Space launch industry","History"],"geographic":"United States","temporal":"21st century"},{"@authority":"lcsh","topic":["Launch vehicles (Astronautics)","History"],"geographic":"United States","temporal":"21st century"},{"@authority":"mesh","topic":["Space Flight","history"]},{"@authority":"rvm","topic":["Vol spatial","Histoire"],"temporal":"21e siècle"},{"@authority":"rvm","topic":["Véhicules spatiaux","Lancement","Industrie","Histoire"],"geographic":"États-Unis","temporal":"21e siècle"},{"@authority":"rvm","topic":["Lanceurs (Astronautique)","Histoire"],"geographic":"États-Unis","temporal":"21e siècle"},{"@authority":"bisacsh","topic":["TECHNOLOGY & ENGINEERING","Aeronautics & Astronautics"]},{"@authority":"bisacsh","topic":["SCIENCE","Space Scien