periment of Einstein, Podolsky and Rosen. A Letter from Albert Einstein, 1935."},"note":[{"@type":"statement of responsibility","#text":"Karl R. Popper."},"Translation of Logik der Forschung.",{"@type":"bibliography","#text":"Includes bibliographical references and indexes."}],"subject":[{"@authority":"lcsh","topic":["Science","Methodology"]},{"@authority":"mesh","topic":"Science"},{"@authority":"mesh","topic":"Logic"}],"classification":[{"@authority":"lcc","#text":"Q175 .P863 1974"},{"@authority":"nlm","#text":"Q 175 P831L 1968"},{"@authority":"ddc","#text":"501/.8"}],"relatedItem":[{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":[{"title":"Logic of scientific discovery"},{"@type":"uniform","title":"Logik der Forschung. English"}],"originInfo":{"publisher":"London : Hutchinson, 1972","edition":"6th impression rev."},"identifier":{"@type":"local","#text":"(OCoLC)988950748"},"name":{"namePart":"Popper, Karl R. (Karl Raimund), 1902-1994."}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990109239170203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0091117208 : 0091117216"},{"@type":"lccn","#text":"^^^75301851^"},{"@type":"oclc","#text":"1918420"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000460340699","#text":"Biblioteca Berenson, I Tatti - The Harvard University Center for Italian Renaissance Studies"},"shelfLocator":"Q175 .P863 1974"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Biblioteca Berenson"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990109239170203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"010923917"}},"processingDate":"2026-09-11T04:19Z"}},{"sets":null}],"recordInfo":{"recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"940