cordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"001049744"}},"processingDate":"2024-08-13T05:14Z"}},{"sets":null}],"recordInfo":{"recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"810406"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990010497440203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}},{"@version":"3.8","titleInfo":{"title":"Quantum theory and the schism in physics "},"name":{"@usage":"primary","@type":"personal","namePart":["Popper, Karl R. (Karl Raimund),",{"@type":"date","#text":"1902-1994"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"lcgft","#text":"Informational works"}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},{"placeTerm":{"@type":"text","#text":"London "}},{"placeTerm":{"@type":"text","#text":"New York "}}],"dateIssued":[{"@encoding":"marc","@point":"start","#text":"1992"},{"@encoding":"marc","@point":"end","#text":"1982"},"1992, c1982"],"issuance":"monographic","agent":{"namePart":"Routledge"}},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":{"@authority":"marcform","#text":"print"},"extent":"xviii, 230 p. ; 24 cm."},{"form":{"@type":"Illustrative content","#text":"illustration"}}],"abstract":[{"@type":"Summary","#text":"The basic theme of Popper's philosophy--that something can come from nothing--is related to the present situation in physical theory. Popper carries his investigation right to the center of current debate in quantum physics. He proposes an interpretation of physics--and indeed an entire cosmology--which is realist, conjectural, deductivist and objectivist, anti-positivist, and anti-instrumentalist. He stresses understanding, reminding us that our ignorance grows faster than our conjectural knowledge."},{"@type":"Summary","#text":"Popper addresses the deep division in modern physics caused by the transition from classical, deterministic realism to subjectivist and instrumentalist interpretations of quantum mechanics."}],"tableOfContents":{"@type":"Contents","#text":"Preface 1982: On a Realistic and Commonsense Interpretation of Quantum Theory -- Introduction: Quantum mechanics without 'the observer' -- Understanding Quantum Theory and its Interpretation -- The Objectivity of Quantum Theory -- Towards a Resolution of the Paradoxes of Quantum Theory -- A Metaphysical Epilogue -- Bibliographical Addendum, 1989."},"note":[{"@type":"statement of responsibility","#text":"Karl R. Popper."},{"@type":"bibliography","#text":"Includes bibliographical references and indexes."}],"subject":[{"@authority":"lcsh","topic":"Quantum theory"},{"@authority":"lcsh","topic":["Physics","Philosophy"]},{"@authority":"mesh","topic":"Quantum Theory"}],"classification":[{"@authority":"lcc","#text":"QC174.13 .P67 1992"},{"@edition":"20","@authority":"ddc","#text":"530.1/2"}],"relatedItem":[{"titleInfo":{"title":"The Postscript to The logic of scientific discovery"}},{"@type":"series","titleInfo":{"title":"Postscript to The logic of scientific discovery (London, England)"},"name":{"@type":"personal","namePart":["Popper, Karl R. (Karl Raimund),",{"@type":"date","#text":"1902-1994"}]}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990026230940203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0415091128 (pbk.)"},{"@type":"lccn","#text":"^^^92023685^"},{"@type":"oclc","#text":"26159482"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agen