{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Krauss&limit=10&title=Fear of Physics","limit":10,"start":0},"items":{"mods":{"titleInfo":{"title":"Fear of physics","subTitle":"a guide for the perplexed"},"name":{"@usage":"primary","@type":"personal","namePart":["Krauss, Lawrence M.",{"@type":"date","#text":"1954-"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"fast","#text":"Popular works"}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"New York, NY"}}],"publisher":"BasicBooks","dateIssued":["c1993",{"@encoding":"marc","#text":"1993"}],"issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"xv, 206 p. ; 22 cm."},"abstract":{"@type":"Summary","#text":"\"Assume the cow is a sphere.\" So begins this lively, irreverent, and informative look at everything from the physics of boiling water to cutting-edge research at the observable limits of the universe. Rich with anecdotes and accessible examples (like the cow as sphere, which illustrates the principle of simplifying the world in order to explain it), Fear of Physics nimbly ranges over the tools and thought behind the world of modern physics, taking the mystery out of what is essentially a very human intellectual endeavor."},"tableOfContents":"Looking Where the Light Is -- The Art of Numbers -- Creative Plagiarism -- Hidden Realities -- The Search for Symmetry-- It Ain't Over Till It's Over.","note":[{"@type":"statement of responsibility","#text":"Lawrence M. Krauss."},{"@type":"bibliography","#text":"Includes bibliographical references (p. [200]) and index."}],"subject":[{"@authority":"lcsh","topic":"Physics"},{"@authority":"lcsh","topic":"Physics","genre":"Popular works"},{"@authority":"mesh","topic":"Physics"}],"classification":[{"@authority":"lcc","#text":"QC21.2 .K73 1993"},{"@authority":"nlm","#text":"QC 21.2 K91f 1993"},{"@edition":"20","@authority":"ddc","#text":"530/.01"}],"relatedItem":[{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":{"title":"Fear of physics"},"name":{"namePart":"Krauss, Lawrence Maxwell."},"originInfo":{"publisher":"New York, NY : BasicBooks, ©1993"},"identifier":{"@type":"local","#text":"(OCoLC)623178107"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990034497150203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0465057454"},{"@type":"lccn","#text":"^^^92054523^"},{"@type":"oclc","#text":"28063017"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000463633307","#text":"Lamont Library, Harvard University"},"shelfLocator":"QC21.2 .K73 1993"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/000000046073724X","#text":"Cabot Science Library, Harvard University"},"shelfLocator":"QC21.2 .K73 1993"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":["Cabot Science","Lamont"]},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990034497150203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"003449715"}},"processingDate":"2024-08-03T08:36Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"920813"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990034497150203941"},"recordOrigin":"Converted f