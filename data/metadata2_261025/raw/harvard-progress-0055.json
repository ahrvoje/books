{"pagination":{"maxPageableSet":"10000","numFound":2,"query":"name=Rasmussen&limit=10&title=How Glass Changed the World","limit":10,"start":0},"items":{"mods":[{"titleInfo":{"title":"How Glass Changed the World","subTitle":"The History and Chemistry of Glass from Antiquity to the 13th Century"},"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":"Rasmussen, Seth C.","role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":{"@authority":"marcgt","#text":"government publication"},"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"gw"},{"@type":"text","@authority":"marccountry","#text":"Germany"}]},{"placeTerm":{"@type":"text","#text":"Berlin, Heidelberg"}}],"publisher":"Springer Berlin Heidelberg","dateIssued":"2012","issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"electronic"},"extent":"digital."},"note":{"@type":"statement of responsibility","#text":"by Seth C. Rasmussen."},"subject":[{"@authority":"lcsh","topic":"Chemistry, Physical and theoretical"},{"@authority":"lcsh","topic":"Materials science"},{"@authority":"lcsh","topic":"Physical organic chemistry"},{"@authority":"lcsh","topic":["Science","History"]},{"topic":"Ceramics, Glass, Composites, Natural Methods"},{"topic":"History of Science"}],"classification":[{"@authority":"lcc","#text":"TP807-823"},{"@authority":"lcc","#text":"TA418.9.C6"},{"@edition":"23","@authority":"ddc","#text":"620.14"}],"relatedItem":[{"titleInfo":{"title":"SpringerBriefs in Molecular Science"}},{"@type":"otherFormat","@otherType":"Printed edition:","@displayLabel":"Printed edition:"},{"@type":"series","titleInfo":{"title":"SpringerBriefs in molecular science"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990133157170203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"9783642281839"},{"@type":"isbn","#text":"9783642281839"},{"@type":"doi","#text":"10.1007/978-3-642-28183-9"}],"location":{"url":"https://nrs.harvard.edu/urn-3:hul.ebookbatch.SPRGR_batch:9783642281839","holdingSimple":{"copyInformation":{"note":{"@type":"reproduction","#text":"Electronic reproduction. Available via World Wide Web."}}}},"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990133157170203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"013315717"}},"processingDate":"2021-11-06T05:12Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"Springer"},"recordCreationDate":{"@encoding":"marc","#text":"120222"},"recordChangeDate":{"@encoding":"iso8601","#text":"20120803"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990133157170203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}},{"titleInfo":{"title":"How glass changed the world","subTitle":"the history and chemistry of glass from antiquity to the 13th century"},"name":{"@usage":"primary","@type":"personal","namePart":"Rasmussen, Seth C.","role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},"text"],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"New York"}}],"publisher":"Springer","dateIssued":"2012","edition":"1st ed. 2012.","issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marccategory","#text":"electronic resource"},{"@authority":"marcsmd","#text":"remote"},{"@type":"media","@authority":"","#text":"computer"},{"@type":"carrier","@authority":"","#text":"online resource"}],"extent":"1 online resource (88 p.)"},"abstract":{"@type":"Summary","#text":"Glass production is thought to date to ~2500 BC and had found numerous uses by the height of the Roman Empire. The modern view of glass-based chemical apparatus (beakers, flasks, stills, etc.) was quite limited, however, due to a lack of glass durability under rapid temperature changes and chemical attack. In the mid 1200s, this began to change as the glassmakers of Venice and Murano began blending previous Roman methods with raw materials from the Levant, as well as developing pretreatment and purification methods of the raw materials used. The combination of these practices resulted in a new glass with a strength and high melting point suitable for use in chemical apparatus. The ability to produce vessels from glass allowed much greater freedom and versatility in the design of chemical apparatus. In addition, the resulting improved glass technology lead to the invention of eyeglasses and a vast improvement in still design, which in turn allowed the isolation of important materials such as alcohol and the mineral acids. This text will give an overview of the history and chemistry of glass technology from its origins in antiquity to its dramatic expansion in the 13th century, concluding with its impact on society in general, particularly its affect on chemical practices."},"tableOfContents":"Origins of glass: Myth and known history -- Development and growth of glass through the Roman period -- Reinventing an old material: Venice and the new glass -- Applications to chemical apparatus -- Impact on society and its effect on chemical progress.","note":[{"@type":"statement of responsibility","#text":"Seth C. Rasmussen."},"Description based upon print version of record.",{"@type":"bibliography","#text":"Includes bibliographical references."},{"@type":"language","#text":"English"}],"subject":[{"@authority":"lcsh","topic":["Glass","History"]},{"@authority":"lcsh","topic":["Glass manufacture","Chemistry"]}],"classification":[{"@authority":"lcc","#text":"QD139.G5 R37 2012"},{"@authority":"ddc","#text":"621.36"}],"relatedItem":[{"titleInfo":{"title":"History of chemistry"}},{"@type":"series","titleInfo":{"title":"SpringerBriefs in Molecular Science"},"identifier":[{"@type":"issn","#text":"2191-5415"},{"@type":"local","#text":"(CKB)3400000000023826"}]},null,{"@type":"series","titleInfo":{"title":"SpringerBriefs in molecular science","partName":"History of chemistry"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99153586238103941/catalog"}}],"identifier":[{"@type":"isbn","#text":"1-280-79240-X"},{"@type":"isbn","#text":"9786613702791"},{"@type":"isbn","#text":"3-642-28183-4"},{"@type":"doi","#text":"10.1007/978-3-642-28183-9"},{"@type":"oclc","#text":"778874667"}],"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99153586238103941","processingDate":"2024-08-06T06:59Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":["aacr","rda"],"recordContentSource":{"@authority":"marcorg","#text":"MiAaPQ"},"recordCreationDate":{"@encoding":"marc","#text":"120123"},"recordChangeDate":{"@encoding":"iso8601","#text":"20200520"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99153586238103941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}}]}}