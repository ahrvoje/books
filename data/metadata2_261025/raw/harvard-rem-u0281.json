arket","Law and legislation"]},{"@authority":"bisacsh","topic":"LAW / Administrative Law & Regulatory Practice"}],"classification":[{"@authority":"lcc","#text":"K1114 .P57 2019"},{"@edition":"23","@authority":"ddc","#text":"346./092"}],"relatedItem":[{"@type":"otherFormat","identifier":{"@type":"local","#text":"(OCoLC)1059253097"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99153846872303941/catalog"}}],"identifier":[{"@type":"isbn","#text":"9780691189437"},{"@type":"isbn","#text":"0691189439"},{"@type":"isbn","@invalid":"yes","#text":"9780691178974"},{"@type":"isbn","@invalid":"yes","#text":"0691178976"},{"@type":"oclc","#text":"1090539986"},{"@type":"oclc","#text":"on1090539986"}],"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99153846872303941","processingDate":"2021-01-23T17:03Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"N$T"},"recordCreationDate":{"@encoding":"marc","#text":"190325"},"recordChangeDate":{"@encoding":"iso8601","#text":"20190508"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99153846872303941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"titleInfo":[{"nonSort":{"@space":"preserve","#text":"The  "},"title":"code of capital","subTitle":"how the law creates wealth and inequality"},{"@type":"alternative","title":"How the law creates wealth and inequality"}],"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":"Pistor, Katharina","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author."}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nju"},{"@type":"text","@authority":"marccountry","#text":"New Jersey"}]},"dateIssued":{"@encoding":"marc","#text":"2019"},"copyrightDate":{"@encoding":"marc","#text":"2019"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Princeton :"}},"publisher":"Princeton University Press,","dateIssued":[2019]}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xiii, 297 pages ; 25 cm"},"abstract":{"@type":"Summary","#text":"\"Capital is the defining feature of modern economies, yet most people have no idea where it actually comes from. What is it, exactly, that transforms mere wealth into an asset that automatically creates more wealth? The Code of Capital explains how capital is created behind closed doors in the offices of private attorneys, and why this little-known fact is one of the biggest reasons for the widening wealth gap between the holders of capital and everybody else. In this ... book, Katharina Pistor argues that the law selectively \"codes\" certain assets, endowing them with the capacity to protect and produce private wealth. With the right legal coding, any object, claim, or idea can be turned into capital - and lawyers are the keepers of the code. Pistor describes how they pick and choose among different legal systems and legal devices for the ones that best serve their clients' needs, and how techniques that were first perfected centuries ago to code landholdings as capital are being used today to code stocks, bonds, ideas, and even expectations--assets that exist only in law\"--Provided by publisher."},"tableOfContents":"Empire of law -- Coding land -- Cloning legal persons -- Minting debt -- Enclosing nature's code -- A code for the globe -- The masters of the code -- A new code? -- Capital rules by law.","note":[{"@type":"statement of responsibility","#text":"Katharina Pistor."},{"@type":"bibliography","#text":"Includes bibliographical references (pages 235-277) and index."}],"subject":[{"@authority":"lcsh","topic":"Capital"},{"@authority":"lcsh","topic":"Profit"},{"@authority":"lcsh","topic":"Income distribution"},{"@authority":"lcsh","topic":["Law","Economic aspects"]},{"@authority":"lcsh","topic":"Lawyers"},{"@authority":"lcsh","topic":"Law and globalization"},{"@authority":"rvm","topic":"Profit"},{"@authority":"rvm","topic":["Revenu","Répartition"]},{"@authority":"rvm","topic":["Droit","Aspect économique"]},{"@authority":"rvm","topic":"Droit et mondialisation"},{"@authority":"fast","topic":"Capital"},{"@authority":"fast","topic":"Income distribution"},{"@authority":"fast","topic":"Law and globalization"},{"@authority":"fast","topic":["Law","Economic aspects"]},{"@authority":"fast","topic":"Lawyers"},{"@authority":"fast","topic":"Profit"},{"@authority":"lemac","topic":"Dret i economia"}],"classification":[{"@authority":"lcc","#text":"HB501 .P49 2019"},{"@edition":"23","@authority":"ddc","#text":"332/.041"},{"@authority":"bcl","#text":"83.30"}],"identifier":[{"@type":"isbn","#text":"9780691178974"},{"@type":"isbn","#text":"0691178976"},{"@type":"isbn","#text":"9780691208602"},{"@type":"isbn","#text":"0691208603"},{"@type":"lccn","#text":"2018965763"},{"@type":"oclc","#text":"1059253097"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99153781319903941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/000000011940971X","#text":"Harvard Law School Library, Harvard University"},"shelfLocator":"HB501 .P48 2019"},{"physicalLocation":{"@displayLabel":"H