":{"@type":"text","#text":"Cambridge, Mass"}}],"dateIssued":[{"@encoding":"marc","#text":"1970"},"[1970, c1956]"],"issuance":"monographic","agent":{"namePart":"M.I.T. Press"}},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"380 p. 22 cm."},"subject":{"@authority":"lcsh","name":{"@type":"personal","namePart":["Wiener, Norbert,",{"@type":"date","#text":"1894-1964"}]}},"classification":[{"@authority":"lcc","#text":"QA29.W497 A35"},{"@authority":"ddc","#text":"925.1"}],"identifier":{"@type":"oclc","#text":"538628"},"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990046894000203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000123374118","#text":"Baker Library, Harvard Business School, Harvard University"},"shelfLocator":"GW W647a"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Baker Business"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990046894000203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"004689400"}},"processingDate":"2026-07-20T04:12Z"}},{"sets":null}],"recordInfo":{"recordContentSource":{"@authority":"marcorg","#text":"DAY"},"recordCreationDate":{"@encoding":"marc","#text":"730116"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990046894000203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"@version":"3.8","titleInfo":{"title":"Norbert Wiener, 1894-1964 "},"name":{"@usage":"primary","@type":"personal","namePart":"Masani, Pesi Rustom","role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"marcgt","#text":"biography"},{"@authority":"Medical Subject Headings","#text":"Biography"},{"@authority":"fast","#text":"Biographies"},{"@authority":"lcgft","#text":"Biographies"},{"@authority":"rvmgf","#text":"Biographies."}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"sz"},{"@type":"text","@authority":"marccountry","#text":"Switzerland"}]},{"placeTerm":{"@type":"text","#text":"Basel "}},{"placeTerm":{"@type":"text","#text":"Boston "}}],"dateIssued":[{"@encoding":"marc","#text":"1989"},"1990"],"issuance":"monographic","agent":{"namePart":"Birkhäuser"}},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":{"@authority":"marcform","#text":"print"},"extent":"416 p. : ill. 23 cm."},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Illustrative content","#text":"photograph"}},{"form":{"@type":"Color content","#text":"monochrome"}}],"abstract":{"@type":"Summary","#text":"Norbert Wiener was an American mathematician and philosopher. He was a professor of mathematics at the Massachusetts Institute of Technology (MIT). A child prodigy, Wiener later became an early researcher in stochastic and mathematical noise processes, contributing work relevant to electronic engineering, electronic communication, and control systems. Wiener is considered the originator of cybernetics, a formalization of the notion of feedback, with implications for engineering, systems control, computer science, biology, neuroscience, philosophy, and the organization of society. Wiener thought on a grand scale and stressed the adaptation of technical concepts from pure mathematics and electrical engineering outside their technical contexts. Masani's interesting and thoughtful book analyses both Wiener's mathematical and his nonmathematical ideas in sympathetic and sensitive detail. Readers will find much to appreciate in this book, in addition to the discussion of Wiener's technical research."},"tableOfContents":{"@type":"Contents","#text":"Prologue -- Count Tolstoy and Wiener's father -- New England and Wiener's early training, 1901-1905 -- Harvard and Wiener's university training, 1906-1913 -- Bertrand Russell and Wiener's postdoctoral years, 1914-1917 -- World War I and Wiener's military yearnings -- From postulate systems to the Brownian motion and potential theory -- The allotment of national income, marriage, and Wiener's academic career -- From communications engineering to generalized harmonic analysis and Tauberian theory -- Max Born and Wiener's thoughts on quantum mechanics and unified field theory -- The collaboration with E. Hopf and R.E.A.C. Paley -- Birkhoff's theorem and consolidation of Wiener's ideas on statistical physics -- Lee, Bush, and Wiener's thoughts on networks and computers -- Bigelow and anti-aircraft fire control, 1940-1945 -- Arturo Rosenblueth and Wiener's work in physiology -- McCulloch, Pitts and the evolution of Wiener's neurophysiological ideas -- The cybernetical movement and von Neumann's letter, 1946 -- Cybernetics -- The second industrial revolution and its educational, economic and social challenges -- Wiener on global policy and military science; von Neumann's position; science and human welfare -- Wiener's excursion into the religious domain -- Wiener's literary predilections and initiatives; his concept of art -- Wiener, the man and the teacher : authenticity and prejudice in his attitudes and writings -- Epilogue."},"note":[{"@type":"statement of responsibility","#text":"by Pesi R. Masani."},"Includes index.",{"@type":"bibliography","#text":"Bibliography: p.392-399."},{"@type":"bibliography","#text":"\"Bibliography of Norbert Wiener\": p. 377-390."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"n-us---"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Wiener, Norbert,",{"@type":"date","#text":"1894-1964"}]}},{"@authority":"lcsh","topic":"Mathematicians","geographic":"United States","genre":"Biography"}],"classification":[{"@authority":"lcc","#text":"QA29.W497 M37 1989"},{"@edition":"19","@authority":"ddc","#text":"510/.92/4 B"}],"relatedItem":[{"titleInfo":{"title":"Vita mathematica ","partNumber":"v. 5"}},{"@type":"series","titleInfo":{"title":"Vita mathematica","partNumber":"v. 5"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990018398300203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0817622462"},{"@type":"lccn","#text":"^^^89000906^"},{"@type":"oclc","#text":"19389460"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/000000046073724X","#text":"Cabot Science Library, Harvard University"},"shelfLocator":"QA29.W497 M37 1990"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/000000046073724X","#text":"Cabot Science Library, Harvard University"},"shelfLocator":"QA29.W497 M37 1990"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"QA29.W497 M37 1990x"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":["Cabot Science","Widener"]},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990018398300203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"001839830"}},"processingDate":"2026-09-24T04:13Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"890227"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990018398300203941"},"recordOrigin":"Conv