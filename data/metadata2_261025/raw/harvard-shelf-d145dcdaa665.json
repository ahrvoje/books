{"pagination":{"maxPageableSet":"10000","numFound":2,"query":"name=Hessler&limit=10&title=Other Rivers","limit":10,"start":0},"items":{"mods":[{"@version":"3.8","titleInfo":{"title":"Other rivers ","subTitle":"a Chinese education "},"name":{"@usage":"primary","@type":"personal","namePart":["Hessler, Peter,",{"@type":"date","#text":"1969-"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}],"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJjxrDphJmmJGyfB7Tdfbd"},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"marcgt","#text":"biography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"fast","#text":"Biographies"},{"@authority":"fast","#text":"History"},{"@authority":"fast","#text":"Travel writing"},{"@authority":"lcgft","#text":"Biographies"},{"@authority":"lcgft","#text":"Travel writing"},{"@authority":"rvmgf","#text":"Biographies."},{"@authority":"rvmgf","#text":"Récits de voyages."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},"dateIssued":{"@encoding":"marc","#text":"2024"},"copyrightDate":{"@encoding":"marc","#text":"2024"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"New York :"}},"agent":{"namePart":"Penguin Press,","role":{"roleTerm":"publisher"}},"dateIssued":"2024."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"449 pages : maps ; 25 cm"},{"form":{"@type":"Illustrative content","#text":"map"}}],"abstract":{"@type":"Summary","#text":"\"More than two decades after teaching English during the early part of China's economic boom, an experience chronicled in his book River Town, Peter Hessler returned to Sichuan province to instruct students from the next generation. At the same time, Hessler and his wife enrolled their twin daughters in a local state-run elementary school, where they were the only Westerners. Over the years, Hessler had kept in close contact with many of the people he had taught in the 1990s. By reconnecting with these individuals-members of China's \"Reform generation,\" now in their forties-while teaching current undergrads, Hessler gained a unique perspective on China's incredible transformation. In Peter Hessler's hands, China's education system is the perfect vehicle for examining the country's past, present, and future, and what we can learn from it, for good and ill\"-- Provided by publisher."},"tableOfContents":{"@type":"Contents","#text":"Part 1. Rejection -- The old campus -- The new campus -- Chengdu experimental -- Earthquake -- Part 2. The city suspended -- Children of the Corona -- The sealed city -- Involution -- Common sense -- Generation Xi -- Epilogue: The Uncompahgre River."},"targetAudience":{"@authority":"marctarget","#text":"adult"},"note":[{"@type":"statement of responsibility","#text":"Peter Hessler."},{"@type":"bibliography","#text":"Includes bibliographical references (pages 425-442) and index."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"a-cc---"}},{"@authority":"lcsh","topic":["College students","Interviews"],"geographic":"China"},{"@authority":"lcsh","topic":["Education, Higher","History"],"geographic":"China","temporal":"20th century"},{"@authority":"rvm","topic":["Enseignement supérieur","Histoire"],"geographic":"Chine","temporal":"20e siècle"},{"@authority":"fast","topic":"Education, Higher"},{"@authority":"fast","topic":"Intellectual life"},{"@authority":"fast","topic":"Travel"},{"@authority":"sears","topic":"College students","genre":"Interviews"},{