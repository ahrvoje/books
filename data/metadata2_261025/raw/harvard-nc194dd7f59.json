m","#text":"print"},"extent":"xi, 336 p. ; 21 cm."},"note":[{"@type":"statement of responsibility","#text":"Robert X. Cringely."},"Includes index."],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"n-us-ca"}},{"@authority":"lcsh","topic":"Computer industry","geographic":["California","Santa Clara Valley (Santa Clara County)"]}],"classification":[{"@authority":"lcc","#text":"HD9696.C63 U51586 1993"},{"@edition":"20","@authority":"ddc","#text":"338.4/7004/0979473"}],"identifier":[{"@type":"isbn","#text":"0060975350 :"},{"@type":"isbn","#text":"9780060975357"},{"@type":"lccn","#text":"^^^92053427^"},{"@type":"oclc","#text":"27034962"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990115599190203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000123374118","#text":"Baker Library, Harvard Business School, Harvard University"},"shelfLocator":"HD9696.C63 U51586 1993"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Baker Business"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990115599190203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"011559919"}},"processingDate":"2024-04-06T05:17Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"920612"},"recordChangeDate":{"@encoding":"iso8601","#text":"20080908"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990115599190203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}},{"titleInfo":{"title":"Accidental empires","subTitle":"how the boys of Silicon Valley make their millions, battle foreign competition, and still can't get a date"},"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":"Cringely, Robert X.","role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"mau"},{"@type":"text","@authority":"marccountry","#text":"Massachusetts"}]},{"placeTerm":{"@type":"text","#text":"Reading, Mass"}}],"publisher":"Addison-Wesley","dateIssued":["c1992",{"@encoding":"marc","#text":"1992"}],"issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"xi, 324 p. ; 24 cm."},"abstract":{"@type":"Summary","#text":"\"Computer manufacturing is--after cars, energy production and illegal drugs--the largest industry in the world, and it's one of the last great success stories in American business. Accidental Empires is the trenchant, vastly readable history of that industry, focusing as much on the astoundingly odd personalities at its core--Steve Jobs, Bill Gates, Mitch Kapor, etc. and the hacker culture they spawned as it does on the remarkable technology they created. Cringely reveals the manias and foibles of these men (they are always men) with deadpan hilarity and cogently demonstrates how their neuroses have shaped the computer business. But Cringely gives us much more than high-tech voyeurism and insider gossip. From the birth of the transistor to the mid-life crisis of the computer industry, he spins a sweeping, uniquely American saga of creativity and ego that is at once uproarious, shocking and inspiring.\"--Amazon.com viewed August 14, 2020"},"tableOfContents":"The demo-god -- The tyrannry of the normal distribution -- Why they don't call it computer valley -- Amateur hour -- Role models -- Chairman Bill leads the happy workers in song -- All IBM stories are true -- Software envy -- Clones -- The prophet -- Font wars -- On the beach -- Economics of scale -- Counter-reformation -- Future computing.","note":[{"@type":"statement of responsibility","#text":"Robert X. Cringely."},"Includes index.","\"A William Patrick book.\""],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"n-us-ca"}},{"@authority":"lcsh","topic":"Computer industry","geographic":["California","Santa Clara County"]},{"@authority":"lcsh","topic":"Computer industry","geographic":["California","Santa Clara Valley (Santa Clara County)"]}],"classification":[{"@authority":"lcc","#text":"HD9696.C63 U51586 1991"},{"@edition":"20","@authority":"ddc","#text":"338.4/7004/0979473"}],"identifier":[{"@type":"isbn","#text":"0201570327"},{"@type":"lccn","#text":"^^^91027089^"},{"@type":"oclc","#text":"24141993"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990024760920203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000123374118","#text":"Baker Library, Harvard Business School, Harvard University"},"shelfLocator":"HD9696.C63 U51586 1992"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"HD9696.C63 U51586 1991"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":["Baker Business","Widener"]},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990024760920203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"002476092"}},"processingDate":"2024-04-11T05:14Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"910710"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990024760920203941"},"reco