:"MH:ALMA","#text":"990012758790203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}},{"titleInfo":[{"nonSort":{"@space":"preserve","#text":"The  "},"title":"precarious balance","subTitle":"the politics of power in Europe, 1494-1945"},{"@type":"uniform","@nameTitleGroup":"1","title":"Gleichgewicht oder Hegemonie. English"}],"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":["Dehio, Ludwig",{"@type":"date","#text":"1888-1963"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},{"placeTerm":{"@type":"text","#text":"London"}}],"publisher":"Chatto & Windus","dateIssued":"1963","issuance":"monographic"},"language":[{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"ger"}}],"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"x, 295, viii p. ; 23 cm."},"abstract":{"@type":"Summary","#text":"\"In this book, Professor Dehio surveys the four and a half centuries that lie between Charles VIII's invasion of Italy and the end of the Second World War, and contrasts the drive for hegemony by successive aggressors (Spanish, French, German) with the opposing principle of balance which repeatedly called coalitions into being to save the continent from becoming subjected to a single political will. This pattern in Europe's history has become obsolete because as Professor Dehio shows, the states of Europe found it more and more difficult to thwart the ambitions of a Kaiser or a Hitler without calling upon outside help, so that by now power in Europe has passed from its own people to the greater peripheral empires.\"--From book jacket."},"tableOfContents":"1. The system of states up to the collapse of the Spanish bid for supremacy under Philip II -- 2. The system of states up to the collapse of the French bid for supremacy under Louis XIV -- 3. The system of states up to the collapse of Napoleon's bid for supremacy -- 4. The system of states up to the collapse of the German bid for supremacy under Hitler","note":[{"@type":"statement of responsibility","#text":"by Ludwig Dehio ; [Translated by Charles Fullman]"},"Includes index."],"subject":[{"@authority":"lcsh","topic":"Balance of power"},{"@authority":"lcsh","topic":"Imperialism"},{"@authority":"lcsh","topic":"World politics"}],"classification":[{"@authority":"lcc","#text":"JX1318 .D42"},{"@edition":"18","@authority":"ddc","#text":"940.2"}],"relatedItem":[{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":[{"title":"Precarious balance"},{"@type":"uniform","title":"Gleichgewicht oder Hegemonie. English"}],"name":{"namePart":"Dehio, Ludwig, 1888-1963."},"originInfo":{"publisher":"London : Chatto & Windus, 1963"},"identifier":{"@type":"local","#text":"(OCoLC)988110456"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990077578710203941/catalog"}}],"identifier":{"@type":"oclc","#text":"259329"},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","#text":"Kirkland House Library, Harvard University"},"shelfLocator":"JX1318 .D42 1963x"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"JX1318 .D42 1963x"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":["Kirkland","Widener"]},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990077578710203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":