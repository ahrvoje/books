{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Jarvis&limit=10&title=Mapping the Airways","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":{"title":"Mapping the airways "},"name":[{"@usage":"primary","@type":"personal","namePart":["Jarvis, Paul,",{"@type":"date","#text":"1946-"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}],"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PCjwgg78Pbm9wy8GhM9t8vd"},{"@type":"corporate","namePart":"British Airways","nameIdentifier":"https://id.oclc.org/worldcat/entity/E39QH7JmqRqk4gkgDyYyYRdFhR"}],"typeOfResource":"text","genre":[{"@authority":"rdacontent","#text":"text"},{"@authority":"rdacontent","#text":"still image"},{"@authority":"fast","#text":"History"},{"@authority":"fast","#text":"Maps"},{"@authority":"fast","#text":"Illustrated works"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},"dateIssued":{"@encoding":"marc","#text":"2016"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Stroud :"}},"agent":{"namePart":"Amberley Publishing,","role":{"roleTerm":"publisher"}},"dateIssued":"2016."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"160 pages : illustrations, maps ; 17 x 25 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Illustrative content","#text":"map"}}],"abstract":{"@type":"Summary","#text":"Maps have long held a fascination for travellers and would-be travellers alike. Drawing on fascinating and unique material from the BA archive, curator Paul Jarvis focusses on the beautiful map artworks used over nearly 100 years of history to promote the airline's services - from early adverts to twenty-first-century on-board moving maps - and the vital maps and charts used by pilots and navigators. The progression of artistic styles used through the decades and the use of maps, actual or stylised, to present factual information or to encourage the use of air services is presented in striking full colour. Authorised by British Airways and with a foreword by Keith Williams, the Executive Chairman of British Airways, this book shows how we have charted our voyages through the skies and the enduring power of maps to spark our imagination."},"tableOfContents":{"@type":"Contents","#text":"Brussels-Congo in 41/2 days -- Geography or art? -- From landmarks to way markers -- One hundred years of showing the way -- Twenty-first-century air travel."},"note":[{"@type":"statement of responsibility","#text":"Paul Jarvis."},"\"In association with British Airways.\"","Foreword by Executive Chairman, British Airways, Keith Williams."],"subject":[{"@authority":"lcsh","topic":["Advertising","Airlines"]},{"@authority":"lcsh","topic":["Airlines","History"],"genre":"Pictorial works"},{"@authority":"rvm","topic":["Compagnies de transport aérien","Publicité"]},{"@authority":"rvm","topic":["Compagnies de transport aérien","Histoire"],"genre":"Ouvrages illustrés"},{"@authority":"fast","topic":["Advertising","Airlines"]},{"@authority":"fast","topic":"Airlines"},{"@authority":"gnd","topic":"Karte"},{"@authority":"gnd","topic":"Kartografie"},{"@authority":"gnd","topic":"Luftverkehr"},{"@authority":"lcsh","name":{"@type":"corporate","namePart":"British Airways"},"genre":"Maps"},{"@authority":"lcsh","name":{"@type":"corporate","namePart":"British Airways"},"topic":"History"},{"@authority":"fast","name":{"@type":"corporate","namePart":"British Airways"}}],"classification":[{"@authority":"lcc","#text":"G3201.P6