etime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-02-04T07:33:04.081452"}}},"OLID:OL3701402M":{"bib_key":"OLID:OL3701402M","info_url":"http://openlibrary.org/books/OL3701402M/Heidegger","preview":"noview","preview_url":"http://openlibrary.org/books/OL3701402M/Heidegger","thumbnail_url":"https://covers.openlibrary.org/b/id/119921-S.jpg","details":{"publishers":["Oxford University Press"],"number_of_pages":150,"subtitle":"A Very Short Introduction","series":["Very short introductions ;"],"covers":[119921],"local_id":["urn:sfpl:31223101729276","urn:sfpl:31223101729268","urn:bwbsku:O8-BQR-039"],"key":"/books/OL3701402M","authors":[{"key":"/authors/OL382596A","name":"Michael Inwood"}],"publish_places":["Oxford","New York"],"subjects":["Heidegger, Martin, 1889-1976.","Heidegger, Martin, 1889-1976."],"pagination":"150 p. :","source_records":["ia:heidegger00inwo_113","marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run04.mrc:274499789:3542","bwb:9780192854100","marc:marc_loc_2016/BooksAll.2016.part30.utf8:220550984:974","promise:bwb_daily_pallets_2022-09-14","ia:heideggerverysho0000inwo","marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:86551167:2052"],"title":"Heidegger","notes":"Includes bibliographical references (p. [vii-ix]) and index.","identifiers":{"librarything":["57801"],"goodreads":["314932"]},"languages":[{"key":"/languages/eng"}],"publish_date":"2000","publish_country":"enk","works":[{"key":"/works/OL2626024W"}],"type":{"key":"/type/edition"},"description":"From the Publisher: Martin Heidegger (1889-1976) is probably the most divisive philosopher of the twentieth century: viewed by some as a charlatan and by others as a leader and central figure of modern philosophy. Michael Inwood's lucid introduction to Heidegger's thought focuses on his most important work, \"Being and Time,\" and its major themes of existence in the world, inauthenticity, guilt, destiny, truth, and the nature of time. These themes are then reassessed in the light of Heidegger's later work, together with the extent of his philosophical importance and influence. This is an invaluable guide to the complex and voluminous thought of a major twentieth-century existentialist philosopher.","isbn_10":["0192854100"],"lccn":["2003267665"],"oclc_numbers":["44184324"],"dewey_decimal_class":["193"],"lc_classifications":["B3279.H49 I594 2000"],"latest_revision":16,"revision":16,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-03-28T16:57:34.016266"}}},"OLID:OL7384553M":{"bib_key":"OLID:OL7384553M","info_url":"http://openlibrary.org/books/OL7384553M/Heidegger","preview":"noview","preview_url":"http://openlibrary.org/books/OL7384553M/Heidegger","thumbnail_url":"https://covers.openlibrary.org/b/id/119920-S.jpg","details":{"publishers":["Oxford University Press, USA"],"number_of_pages":160,"subtitle":"A Very Short Introduction","covers":[119920],"key":"/books/OL7384553M","authors":[{"key":"/authors/OL382596A","name":"Michael Inwood"}],"source_records":["ia:heidegger00inwo_113"],"title":"Heidegger","identifiers":{"goodreads":["314932"],"librarything":["57801"]},"languages":[{"key":"/languages/eng"}],"publish_date":"April 30, 2002","works":[{"key":"/works/OL2626024W"}],"type":{"key":"/type/edition"},"isbn_10":["0192854100"],"isbn_13":["9780192854100"],"latest_revision":12,"revision":12,"created":{"type":"/type/datetime","value":"2008-04-29T13:35:46.876380"},"last_modified":{"type":"/type/datetime","value":"2025-03-28T16:57:34.016266"}}},"OLID:OL27398427M":{"bib_key":"OLID:OL27398427M","info_url":"http://openlibrary.org/books/OL27398427M/Heidegger","preview":"noview","preview_url":"http://openlibrary.org/books/OL27398427M/Heidegger","thumbnail_url":"https://covers.openlibrary.org/b/id/14841137-S.jpg","details":{"publishers":["Oxford University Press"],"source_records":["bwb:9780198828662","marc:marc_columbia/Columbia-extract-20221130-029.mrc:72582185:2264"],"title":"Heidegger","identifiers":{},"covers":[14841137],"publish_date":"24 March 2019","key":"/books/OL27398427M","works":[{"key":"/works/OL2626024W"}],"type":{"key":"/type/edition"},"subtitle":"A Very Short Introduction","publish_places":["Oxford, UK"],"copyright_date":"2019","edition_name":"Second edition","languages":[{"key":"/languages/eng"}],"physical_format":"Paperback","description":"Martin Heidegger, considered by some to be the greatest charlatan ever to claim the title of \"philosopher,\" by some as an apologist for Nazism, and by others as an acknowledged leader in continental philosophy, is probably the most divisive thinker of the twentieth century.\r\n\r\nIn the second edition of this <i>Very Short Introduction</i>, Michael Inwood focuses on Heidegger's most important work, <i>Being and Time</i>, to explore its major themes of existence in the world, inauthenticity, guilt, destiny, truth, and the nature of time. These themes are then reassessed in the light of Heidegger's multifaceted later thought, and how, despite its diversity, it hangs together as a single, coherent project. Finally, Inwood turns to Heidegger's Nazism and anti-Semitism, to reveal its deep connection with his personality and overall view of philosophy. This is an invaluable guide to the complex and voluminous thought of one of the twentieth century's greatest yet most enigmatic philosophers.","isbn_13":["9780198828662"],"oclc_numbers":["1079203121"],"lc_classifications":["B3279.H49","B3279.H49 I59 2019"],"physical_dimensions":"6.9 x 4.4 x  inches","table_of_contents":[{"level":1,"label":"1","title":"Heidegger's life","pagenum":"","type":{"key":"/type/toc_item"}},{"level":1,"label":"2","title":"Heidegger's philosophy","pagenum":"","type":{"key":"/type/toc_item"}},{"level":1,"label":"3","title":"Being","pagenum":"","type":{"key":"/type/toc_item"}},{"level":1,"label":"4","title":"Dasein","pagenum":"","type":{"key":"/type/toc_item"}},{"l