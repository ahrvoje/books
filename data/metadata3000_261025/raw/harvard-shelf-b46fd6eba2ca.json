i.org/isni/0000000463633307","#text":"Lamont Library, Harvard University"},"shelfLocator":"DS208 .T48x 1964"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Lamont"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990011040960203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"001104096"}},"processingDate":"2026-09-10T04:18Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"MNF"},"recordCreationDate":{"@encoding":"marc","#text":"790207"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990011040960203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"titleInfo":{"title":"Arabian sands"},"name":[{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":["Thesiger, Wilfred",{"@type":"date","#text":"1910-"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},{"@type":"personal","namePart":"Stewart, Rory"}],"typeOfResource":"text","originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},{"placeTerm":{"@type":"text","#text":"London"}},{"placeTerm":{"@type":"text","#text":"New York"}}],"publisher":"Penguin","dateIssued":"2007","edition":"New ed. /","issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"xvii, 347 p., [16] p. of plates : ill., maps ; 20 cm."},"abstract":{"@type":"Review","#text":"\"Born in Addis Ababa in 1910 and educated in England, from 1945 Wilfred Thesiger spent five years exploring in and around the vast, waterless desert, the 'Empty Quarter' of Arabia. Travelling amongst the Bedu people, he experienced their everyday challenges of hunger and thirst, the trials of long marches beneath the relentless sun, the bitterly cold nights and the constant danger of death if it was discovered he was a Christian 'infidel'. He was the first European to visit most of the region, and just before he left the area the process that would change it forever had begun - the discovery of oil. Thesiger saw Arabian Sands as 'a memorial to a vanished past, a tribute to a once magnificent people'.\" \"This edition includes an introduction by Rory Stewart discussing the dangers of Thesiger's travels, his unconventional personality and his insights into Bedu life.\"--Jacket."},"tableOfContents":"Introduction / Rory Stewart -- List of maps -- Preface -- Preface to the 1991 reprint -- Foreword -- Prologue -- 1. Abyssinia and the Sudan -- 2. Prelude in Dhaufar -- 3. The sands of Ghanim -- 4. Secret preparations at Salala -- 5. The approach to the empty quarter -- 6. On the edge of the empty quarter -- 7. The first crossing of the empty quarter -- 8. Return to Salala -- 9. From Salala to Mukalla -- 10. Preparations for a second crossing -- 11. The second crossing of the empty quarter -- 12. From Sulaiyil to Abu Dhabi -- 13. The Trucial coast -- 14. A holiday in Buraimi -- 15. The quicksands of Umm al Samim -- 16. The Wahiba sands -- 17. The closing door -- Arabic and botanical names of plants mentioned in the book -- A list of the chief characters on the various journeys -- Index.","note":[{"@type":"statement of responsibility","#text":"Wilfred Thesiger."},"Includes index."],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"ar-----"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Thesiger, Wilfred",{"@type":"date","#text":"1910-"}]},"topic":"Homes and haunts","geographic":"Arabian Peninsula"},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Thesiger, Wilfred",{"@type":"date","#text":"1910-200