{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Kaku&limit=10&title=The God Equation","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":{"nonSort":{"@space":"preserve","#text":"The  "},"title":"God equation ","subTitle":"the quest for a theory of everything "},"name":{"@usage":"primary","@type":"personal","namePart":"Kaku, Michio","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"fast","#text":"Informational works"},{"@authority":"lcgft","#text":"Informational works"},{"@authority":"rvmgf","#text":"Documents d'information."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},"dateIssued":{"@encoding":"marc","#text":"2021"},"copyrightDate":{"@encoding":"marc","#text":"2021"},"issuance":"monographic","edition":"First edition."},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"New York :"}},"agent":{"namePart":"Doubleday,","role":{"roleTerm":"publisher"}},"dateIssued":[2021]}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"ix, 225 pages : illustrations ; 20 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}}],"abstract":{"@type":"Summary","#text":"\"Michio Kaku, renowned theoretical physicist and author of Hyperspace and The Future of Humanity, tells the story of the greatest quest in science. When Newton discovered the laws of motion and gravity, he unified the rules of heaven and earth. From then on, physicists have been discovering new forces and incorporating them into ever-greater theories. But the major breakthroughs of the 20th century--relativity and quantum mechanics--are incompatible, and so since then, physicists have been endeavoring to combine these two theories. This would ultimately tie all the forces in the universe together into one beautiful equation that can unlock the deepest mysteries of space and time. That epic journey is the story of this book\"-- Provided by publisher."},"tableOfContents":{"@type":"Contents","#text":"Introduction to the final theory -- Unification, the ancient dream -- Einstein's quest for unification -- Rise of the quantum -- Theory of almost everything -- The dark universe -- Rise of string theory : promise and problems -- Finding meaning in the universe."},"note":[{"@type":"statement of responsibility","#text":"Dr. Michio Kaku, professor of theoretical physics City University of New York."},{"@type":"bibliography","#text":"Includes bibliographical references (pages 203-210) and index."}],"subject":[{"@authority":"lcsh","topic":"Cosmology"},{"@authority":"lcsh","topic":"Big bang theory"},{"@authority":"lcsh","topic":"Quantum theory"},{"@authority":"lcsh","topic":["Physics","Philosophy"]},{"@authority":"mesh","topic":"Quantum Theory"},{"@authority":"rvm","topic":"Cosmologie"},{"@authority":"rvm","topic":"Big bang"},{"@authority":"rvm","topic":"Théorie quantique"},{"@authority":"rvm","topic":["Physique","Philosophie"]},{"@authority":"aat","topic":"cosmology"},{"@authority":"bisacsh","topic":"SCIENCE / Astronomy"},{"@authority":"fast","topic":"Quantum theory"},{"@authority":"fast","topic":["Physics","Philosophy"]},{"@authority":"fast","topic":"Big bang theory"},{"@authority":"fast","topic":"Cosmology"},{"@authority":"sears","topic":"Cosmology"},{"@authority":"sears","topic":"Big bang theory"}],"classification":[{"@authority":"lcc","#text":"QB981 .K133 2021"},{"@edition":"23","@authority":"ddc","#text"