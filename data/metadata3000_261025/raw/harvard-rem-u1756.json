1891)] -- Anima candida [Riemann (1826-1866)] -- Arithmetic the second [Kummer (1810-1893)] -- The last universalist [Poincare (1854-1912)] -- Paradise lost? [Cantor (1845-1918)]."},"note":{"@type":"statement of responsibility","#text":"by E.T. Bell."},"subject":[{"@authority":"lcsh","topic":"Mathematicians"},{"@authority":"lcsh","topic":["Mathematics","History"]},{"@authority":"mesh","topic":["Mathematics","history"]}],"classification":[{"@authority":"lcc","#text":"QA28 .B4"},{"@authority":"nlm","#text":"QA 28 B433m 1937"},{"@authority":"ddc","#text":"925.1"}],"identifier":[{"@type":"lccn","#text":"^^^37027177^"},{"@type":"oclc","#text":"514181"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990006833480203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000460341683","#text":"Birkhoff Library, Harvard University"},"shelfLocator":"QA28 .B4 1937"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/000000046073724X","#text":"Cabot Science Library, Harvard University"},"shelfLocator":"TA15 32"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","#text":"Kirkland House Library, Harvard University"},"shelfLocator":"QA28 .B4"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/000000046073724X","#text":"Cabot Science Library, Harvard University"},"shelfLocator":"QA28 .B4 1937b"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/n91089739","#text":"Collection of Historical Scientific Instruments, Harvard University"},"shelfLocator":"QA28 .B4"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000464428911","#text":"History of Science Library, Ha