graphical references and indexes."}],"subject":[{"@authority":"lcsh","topic":"Liberty"},{"@authority":"lcsh","topic":"Democracy"},{"@authority":"lcsh","topic":"Rule of law"},{"@authority":"lcsh","topic":"Economic policy"},{"@authority":"mesh","topic":"Freedom"},{"@authority":"mesh","topic":"Democracy"}],"classification":{"@authority":"lcc","#text":"JC585 .H294 1979"},"relatedItem":[{"titleInfo":{"title":"His Law, legislation, and liberty ","partNumber":"v. 3"}},{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":{"title":"Political order of a free people"},"originInfo":{"publisher":"Chicago : University of Chicago Press, 1979"},"identifier":{"@type":"local","#text":"(OCoLC)702594340"},"name":{"namePart":"Hayek, Friedrich A. von (Friedrich August), 1899-1992."}},{"@type":"series","titleInfo":{"title":"Law, legislation, and liberty","partNumber":"v. 3"},"name":{"@type":"personal","namePart":["Hayek, Friedrich A. von (Friedrich August),",{"@type":"date","#text":"1899-1992"}]}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990008118250203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0226320871"},{"@type":"lccn","#text":"^^^78025905^"},{"@type":"oclc","#text":"4492759"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000463633307","#text":"Lamont Library, Harvard University"},"shelfLocator":"JC585 .H294x v.3"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"Gov 518.96.5 vol.3"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":["Lamont","Widener"]},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990008118250203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"000811825"}},"processingDate":"2026-10-14T04:11Z"}},{"sets":null}],"recordInfo":{"recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"781103"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990008118250203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"titleInfo":{"title":"Law, legislation, and liberty","subTitle":"a new statement of the liberal principles of justice and political economy"},"name":[{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":["Hayek, Friedrich A. von (Friedrich August)",{"@type":"date","#text":"1899-1992"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author."}}]},{"@type":"personal","namePart":["Shearmur, Jeremy",{"@type":"date","#text":"1948-"}],"role":{"roleTerm":{"@type":"text","#text":"editor."}}}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"ilu"},{"@type":"text","@authority":"marccountry","#text":"Illinois"}]},"dateIssued":{"@encoding":"marc","#text":"2021"},"copyrightDate":{"@encoding":"marc","#text":"2021"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Chicago ;"}},"publisher":"The University of Chicago Press,","dateIssued":"2021."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xlvii, 563 pages ; 24 cm."},"abstract":{"@type":"Summary","#text":"\"In this essential entry in The Collected Works of F. A. Hayek series, political philosopher Jeremy Shearmur collates Hayek's three-volume opus Law, Legislation and Liberty in a single, critical volume. His synthesis is a feat of more than just format: Shearmur has produced a critical translation of the myriad contradictions and shortcomings of the original volumes, supplementing it with footnotes and translations from the original German that bring the text to new life and relevance. These three volumes constitute a scaling-up of the framework offered in Hayek's famed The Road to Serfdom: Volume 1, Rules and Order, espouses the virtues of classical liberalism; Volume 2, The Mirage of Social Justice, examines the societal forces that undermine liberalism and its capacity to induce \"spontaneous order\"; Volume 3, The Political Order of a Free People, proposes alternatives and interventions against the emerging anti-liberal movements, including a rule of law that resides in stasis with personal freedom\"--"},"tableOfContents":["Volume 1. Rules and order -- Volume 2. The mirage of social justice -- Volume 3. The political order of a free people.","Consolidated Preface Introduction -- Volume I Rules and Order  1.Reason and Evolution  2. Cosmos and Taxis  3. Principles and Expediency  4. The Changing Concept of Law  5. Nomos: The Law of Liberty  6. Thesis: The Law of Legislation  Notes  Volume 2 The Mirage of Social Justice  7. General Welfare and Particular Purposes  8. The Quest for Justice  9.  'Social’ or Distributive Justice  10. The Market Order or Catallaxy  11. The Discipline of Abstract Rules and the Emotions of the Tribal Society  Notes  Volume 3 The Political Order of a Free People  12. Majority Opinion and Contemporary Democracy  13. The Division of Democratic Powers  14. The Public Sector and the Private Sector  15. Government Policy and the Market  16. The Miscarriage of the Democratic Ideal: A Recapitualation  17. A Model Constitution  18. The Containmen