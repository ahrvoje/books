{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Cribb&limit=10&title=Food or War","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":{"title":"Food or war "},"name":{"@usage":"primary","@type":"personal","namePart":"Cribb, Julian","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"fast","#text":"Informational works"},{"@authority":"lcgft","#text":"Informational works"},{"@authority":"rvmgf","#text":"Documents d'information."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},"dateIssued":{"@encoding":"marc","#text":"2019"},"copyrightDate":{"@encoding":"marc","#text":"2019"},"issuance":"monographic"},{"@eventType":"publication","place":[{"placeTerm":{"@type":"text","#text":"Cambridge, United Kingdom ;"}},{"placeTerm":{"@type":"text","#text":"New York, NY :"}}],"agent":[{"namePart":"Cambridge University Press,","role":{"roleTerm":"publisher"}},{"namePart":"Cambridge University Press,","role":{"roleTerm":"publisher"}}],"dateIssued":"2019."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xiii, 336 pages : illustrations, maps ; 22 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Illustrative content","#text":"map"}}],"abstract":{"@type":"Summary","#text":"\"Food or War Ours is the Age of Food. Food is a central obsession in all cultures, nations, the media, and society. Our future supply of food is filled with risk, and history tells us that lack of food leads to war. But it also presents us with spectacular opportunities for fresh human creativity and technological prowess. Julian Cribb describes a new food system capable of meeting all humans' needs on our hot, overcrowded planet. The book is for anyone concerned about the health, safety, affordability, diversity, and sustainability of their food - and the peace of our planet. This book is not just timely - its message is of the greatest urgency. Audiences include consumers, 'foodies', policymakers, researchers, cooks, chefs and farmers. Indeed, anyone who cares about their food, where it comes from and what it means for them, their children and grandchildren\"-- Provided by publisher."},"tableOfContents":{"@type":"Contents","#text":"Food and conflict: premonitions -- War and hunger -- The strategic importance of food, land and water -- Is 'agriculture' sustainable? -- Hotspots for food conflict in the twentyfirst century -- Food as an existential risk -- Food for peace -- Urban dreams and nightmares -- The future of food -- Conclusion: Key recommendations of this book."},"note":[{"@type":"statement of responsibility","#text":"Julian Cribb."},{"@type":"bibliography","#text":"Includes bibliographical references (pages 281-318) and index."}],"subject":[{"@authority":"lcsh","topic":"Food security"},{"@authority":"lcsh","topic":["Food supply","Political aspects"]},{"@authority":"lcsh","topic":"Sustainable agriculture"},{"@authority":"rvm","topic":"Sécurité alimentaire"},{"@authority":"rvm","topic":"Agriculture durable"},{"@authority":"fast","@href":"(OCoLC)fst01748879","topic":"Food security"},{"@authority":"fast","@href":"(OCoLC)fst00931219","topic":["Food supply","Political aspects"]},{"@authority":"fast","@href":"(OCoLC)fst01139712","topic":"Sustainable agriculture"},{"@authority":"gnd","topic":"Agrarökonomie"},{"@authority":"gnd","topic":"Agrarpolitik"},{"@authority":"gnd","topic":"Lebensmittelversorgun