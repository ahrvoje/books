{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Krasnostein&limit=10&title=The Trauma Cleaner","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":{"nonSort":{"@space":"preserve","#text":"The  "},"title":"trauma cleaner ","subTitle":"one woman's extraordinary life in death, decay & disaster "},"name":{"@usage":"primary","@type":"personal","namePart":"Krasnostein, Sarah","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"marcgt","#text":"biography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"rdacontent","#text":"still image"},{"@authority":"lcgft","#text":"Autobiographies"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"vra"},{"@type":"text","@authority":"marccountry","#text":"Victoria"}]},"dateIssued":{"@encoding":"marc","#text":"2017"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Melbourne, Vic. :"}},"agent":{"namePart":"Text Publishing,","role":{"roleTerm":"publisher"}},"dateIssued":"2017."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"261 pages, 8 unnumbered pages of plates : portraits (chiefly colour) ; 24 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Illustrative content","#text":"portrait"}},{"form":{"@type":"Color content","#text":"polychrome"}}],"abstract":{"@type":"Summary","#text":"It's not the police, firefighters, or EMTs that clean up a crime scene--that's the job of a trauma cleaner, specifically Sandra Pankhurst. Before she was a trauma cleaner, Sandra Pankhurst was many things: husband and father, drag queen, gender reassignment patient, sex worker, small businesswoman, trophy wife ... But as a little boy, raised in violence and excluded from the family home, she just wanted to belong. Now she believes her clients deserve no less. A woman who sleeps among garbage she has not put out for forty years. A man who bled quietly to death in his loungeroom. A woman who lives with rats, random debris and terrified delusion. The still life of a home vacated by accidental overdose. Sarah Krasnostein has watched the extraordinary Sandra Pankhurst bring order and care to these, the living and the dead--and the book she has written is equally extraordinary. Not just the compelling story of a fascinating life among lives of desperation, but an affirmation that, as isolated as we may feel, we are all in this together."},"targetAudience":{"@authority":"marctarget","#text":"adult"},"note":[{"@type":"statement of responsibility","#text":"by Sarah Krasnostein."},{"@type":"bibliography","#text":"Includes bibliographical references."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"u-at---"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":"Pankhurst, Sandra"}},{"@authority":"lcsh","topic":"Cleaning personnel","genre":"Biography"},{"@authority":"lcsh","topic":["Accidents","Cleaning"]},{"@authority":"lcsh","topic":["Violent deaths","Cleaning"]},{"topic":"Australian"},{"@authority":"lcsh","geographic":"Australia"}],"classification":[{"@authority":"lcc","#text":"HD8039.C442 A84 2017"},{"@edition":"23","@authority":"ddc","#text":"648.5"}],"identifier":[{"@type":"isbn","#text":"9781925498523"},{"@type":"isbn","#text":"1925498522"},{"@type":"oclc","#text":"992709750"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990152157430203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repo