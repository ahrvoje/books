Lamont","Widener"]},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990014070030203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"001407003"}},"processingDate":"2026-09-20T04:23Z"}},{"sets":null}],"recordInfo":{"recordContentSource":{"@authority":"marcorg"},"recordCreationDate":{"@encoding":"marc","#text":"720303"},"recordChangeDate":{"@encoding":"iso8601","#text":"20080324"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990014070030203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"titleInfo":[{"nonSort":{"@space":"preserve","#text":"The  "},"title":"opium of the intellectuals"},{"@type":"uniform","@nameTitleGroup":"1","title":"Opium des intellectuels. English"}],"name":[{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":["Aron, Raymond",{"@type":"date","#text":"1905-1983"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},{"@type":"personal","namePart":"Kilmartin, Terence","role":{"roleTerm":{"@type":"text","#text":"translator."}}}],"typeOfResource":"text","originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},{"placeTerm":{"@type":"text","#text":"London"}}],"publisher":"Secker & Warburg","dateIssued":["1957 [c1955]",{"@encoding":"marc","@point":"start","#text":"1957"},{"@encoding":"marc","@point":"end","#text":"1955"}],"issuance":"monographic"},"language":[{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"fre"}}],"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"324 p. 23 cm."},"abstract":{"@type":"Summary","#text":"Raymond Aron's 1955 masterpiece The Opium of the Intellectuals, is one of the great works of twentieth- century political reflection. Aron shows how noble ideas can slide into the tyranny of \"secular religion\" and emphasizes how political thought has the profound responsibility of telling the truth about social and political reality-in all its mundane imperfections and tragic complexities. Aron explodes the three \"myths\" of radical thought: the Left, the Revolution, and the Proletariat. Each of these ideas, Aron shows, are ideological, mystifying rather than illuminating. He also provides a fascinating sociology of intellectual life and a powerful critique of historical determinism in the classically restrained prose for which he is justly famous"},"note":[{"@type":"statement of responsibility","#text":"Translated by Terence Kilmartin."},"Translation of the French L'opium des intellectuels."],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"e-fr---"}},{"@authority":"lcsh","topic":"Intellectuals"},{"@authority":"lcsh","geographic":"France","topic":"Intellectual life"}],"classification":[{"@authority":"lcc","#text":"HM213 .A713"},{"@edition":"18","@authority":"ddc","#text":"316"}],"identifier":[{"@type":"lccn","#text":"^^^57003365^"},{"@type":"oclc","#text":"4693198"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990039045250203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"Soc 592.5.5"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990039045250203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"003904525"}},"processingDate":"2025-07-06T05:16Z"}},{"sets":null}],"recordInfo":{"recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#t