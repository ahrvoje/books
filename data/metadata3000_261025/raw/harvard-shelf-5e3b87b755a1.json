{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Godin&limit=10&title=Tribes","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":{"title":"Tribes ","subTitle":"we need you to lead us "},"name":{"@usage":"primary","@type":"personal","namePart":"Godin, Seth","role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":[{"@authority":"Medical Subject Headings","#text":"Popular Work"},{"@authority":"Medical Subject Headings","#text":"Popular Work"}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"New York "}}],"issuance":"monographic","agent":{"namePart":"Portfolio"},"dateIssued":"2008"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"151 p. ; 19 cm."},"abstract":{"@type":"Summary","#text":"According to Godin, Tribes are groups of people aligned around an idea, connected to a leader and to each other. Tribes make our world work, and always have. The new opportunity is that it's easier than ever to find, organize, and lead a tribe. The Web has enabled an explosion of all kinds of tribes--and created shortage of people to lead them. This is the growth industry of our time. Tribes (the book) will help you understand exactly what's at stake, and why you can and should lead a tribe of your own."},"note":{"@type":"statement of responsibility","#text":"Seth Godin."},"subject":[{"@authority":"mesh","topic":"Group Processes"},{"@authority":"lcsh","topic":"Leadership"},{"@authority":"mesh","topic":"Leadership"},{"@authority":"mesh","topic":"Leadership"}],"classification":[{"@authority":"lcc","#text":"HD57.7 .G6546 2008"},{"@authority":"nlm","#text":"HD 57.7 G585t 2008"},{"@edition":"22",