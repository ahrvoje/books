{"pagination":{"maxPageableSet":"10000","numFound":2,"query":"name=Buford&limit=10&title=Heat","limit":10,"start":0},"items":{"mods":[{"titleInfo":{"title":"Heat","subTitle":"an amateur's adventures as kitchen slave, line cook, pasta maker, and apprentice to a butcher in Tuscany"},"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":"Buford, Bill","role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":{"@authority":"fast","#text":"Biographies."},"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},{"placeTerm":{"@type":"text","#text":"New York"}}],"publisher":"Vintage Books","dateIssued":"2007","edition":"1st. Vintage Books ed.","issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"extent":"318 p. ; 20 cm."},"abstract":{"@type":"Summary","#text":"Writer Buford's memoir of his headlong plunge into the life of a professional cook. Expanding on his award-winning New Yorker article, Buford gives us a chronicle of his experience as \"slave\" to Mario Batali in the kitchen of Batali's three-star New York restaurant, Babbo. He describes three frenetic years of trials and errors, disappointments and triumphs, as he worked his way up the Babbo ladder from \"kitchen bitch\" to line cook, his relationship with the larger-than-life Batali, whose story he learns as their friendship grows through (and sometimes despite) kitchen encounters and after-work all-nighters, and his immersion in the arts of butchery in Northern Italy, of preparing game in London, and making handmade pasta at an Italian hillside trattoria.--From publisher description."},"targetAudience":{"@authority":"marctarget","#text":"adult"},"note":{"@type":"statement of responsibility","#text":"Bill Buford."},"subj