{"@authority":"lcc","#text":"D764 .A5323 2001"},{"@edition":"21","@authority":"ddc","#text":"940.54/21"}],"relatedItem":[{"titleInfo":{"title":"The campaigns of World War II"}},{"@type":"series","titleInfo":{"title":"Campaigns of World War II"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990088567470203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"076030923X (hc. : alk. paper)"},{"@type":"lccn","#text":"^^2001030186"},{"@type":"oclc","#text":"46240388"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"D764 .A5323 2001 F"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990088567470203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"008856747"}},"processingDate":"2026-08-19T04:14Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"020307"},"recordChangeDate":{"@encoding":"iso8601","#text":"20041216"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990088567470203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"@version":"3.8","titleInfo":{"title":"Kursk ","subTitle":"the greatest battle : Eastern Front 1943 "},"name":{"@usage":"primary","@type":"personal","namePart":["Clark, Lloyd,",{"@type":"date","#text":"1967-"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":{"@authority":"marcgt","#text":"bibliography"},"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},{"placeTerm":{"@type":"text","#text":"London "}}],"issuance":"monographic","agent":{"namePart":"Headline Review"},"dateIssued":"2011"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":{"@authority":"marcform","#text":"print"},"extent":"xxvi, 468 p., [16] p. of plates : ill., maps ; 24 cm."},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Illustrative content","#text":"map"}}],"abstract":{"@type":"Subject","#text":"On July 5, 1943, the greatest land battle in history began when Nazi and Red Army forces clashed near the town of Kursk, on the western border of the Soviet Union. Code named \"Operation Citadel,\" the German offensive would cut through the bulge in the eastern front that had been created following Germany's retreat at the battle of Stalingrad. But the Soviets, well-informed about Germany's plans through their network of spies, had months to prepare. Two million men supported by 6,000 tanks, 35,000 guns, and 5,000 aircraft convened in Kursk for an epic confrontation that was one of the most important military engagements in history, the epitome of \"total war.\" It was also one of the most bloody, and despite suffering seven times more casualties, the Soviets won a decisive victory that became a turning point in the war. With unprecedented access to the journals and testimonials of the officers, soldiers, political leaders, and citizens who lived through it, \"The Battle of the Tanks\" is the definitive account of an epic showdown that changed the course of history."},"note":[{"@type":"statement of responsibility","#text":"Lloyd Clark."},{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"@authority":"lcsh","topic":"Kursk, Battle of, Russia, 1943"},{"@authority":"lcsh","topic":["World War, 1939-1945","Tank warfare"]},{"@authority":"fast","temporal":"1939-1945"}],"classification":[{"@authority":"lcc","#text":"D764.3.K8 C53 2011"},{"@edition":"23","@authority":"ddc","#text":"940.5421735"}],"identifier":[{"@type":"isbn","#text":"9780755336388"},{"@type":"isbn","#text":"0755336380"},{"@type":"oclc","#text":"751829624"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990128808320203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"D764.3.K8 C53 2011x"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990128808320203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"012880832"}},"processingDate":"2026-08-06T04:32Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"UKMGB"},"recordCreationDate":{"@encoding":"marc","#text":"110415"},"recordChangeDate":{"@encoding":"iso8601","#text":"20110926"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990128808320203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}}]}}