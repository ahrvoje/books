{"pagination":{"maxPageableSet":"10000","numFound":4,"query":"name=Marx&limit=10&title=Capital, Volume I","limit":10,"start":0},"items":{"mods":[{"titleInfo":[{"title":"Everything and other performance texts from Germany. Karl Marx : Capital, volume I"},{"@type":"alternative","title":"Capital, volume 1"}],"name":[{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":"Haug, Helgard","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author."}}]},{"@type":"personal","namePart":"Wetzel, Daniel","role":{"roleTerm":{"@type":"text","#text":"author."}}},{"@type":"corporate","namePart":"Rimini Protokoll (Theater group)"}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"drama"},{"@authority":"rdacontent","#text":"text"},{"@authority":"lcgft","#text":"Drama."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},"dateIssued":{"@encoding":"marc","#text":"2018"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"[London, England] :"}},"publisher":"Seagull Books London,","dateIssued":"2018."}],"language":[{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},{"@objectPart":"translation","languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"ger"}}],"physicalDescription":{"reformattingQuality":"access","form":[{"@authority":"marccategory","#text":"electronic resource"},{"@authority":"marcsmd","#text":"remote"},{"@type":"media","@authority":"rdamedia","#text":"computer"},{"@type":"carrier","@authority":"rdacarrier","#text":"online resource"}],"extent":"1 online resource (pages 138-184)"},"abstract":{"@type":"Summary","#text":"There are 751 pages between the first and the last sentence – between: \"The wealth of those societies in which the capitalist mode of production prevails, presents itself as 'an immense accumulation of commodities,' its unit being a single commodity.\" - and: \"The only thing that interests us is the secret discovered in the new world by the Political Economy of the old world, and proclaimed on the housetops: that the capitalist mode of production and accumulation, and therefore capitalist private property, have for their fundamental condition the annihilation of self-earned private property; in other words, the expropriation of the labourer.\" Marx's Capital performs a \"critique of political economy.\" Helgard Haug and Daniel Wetzel believe it is also a dramatic text whose secrets can only be uncovered by the people who have lived with, through, in, alongside, and for and against the work."},"note":[{"@type":"statement of responsibility","#text":"Helgard Haug and Daniel Wetzel (Rimini Protokoll) ; translated by Jack Davis."},"Title from title page (viewed August 27, 2021).",{"@type":"language","#text":"In English."},{"@type":"language","#text":"Original language in German."}],"subject":[{"@authority":"lcsh","name":{"@type":"personal","namePart":["Marx, Karl",{"@type":"date","#text":"1818-1883"}]},"titleInfo":{"title":"Kapital"},"genre":"Adaptations"},{"@authority":"lcsh","topic":"Economics","genre":"Drama"}],"relatedItem":[{"@otherType":"Based on (work):","titleInfo":{"title":"Kapital"},"name":{"@type":"personal","namePart":["Marx, Karl,",{"@type":"date","#text":"1818-1883"}]}},{"@type":"host","titleInfo":{"title":"Everything and other performance texts from Germany"},"originInfo":{"publisher":"London, England : Seagull Books London, 2018."},"part":{"text":"Pages 136-184"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99155236968103941/catalog"}}],"identifier":["ASP4690371/codr",{"@type":"oclc","#text":"1268148731"}],"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99155236968103941","processingDate":"2023-08-16T05:12Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"VaAlASP"},"recordCreationDate":{"@encoding":"marc","#text":"210827"},"recordChangeDate":{"@encoding":"iso8601","#text":"20230814"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99155236968103941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"@version":"3.8","titleInfo":{"nonSort":{"@space":"preserve","#text":"The  "},"title":"constitution of capital ","subTitle":"essays on volume I of Marx's Capital "},"name":[{"@type":"personal","namePart":["Bellofiore, Riccardo,",{"@type":"date","#text":"1953-"}]},{"@type":"personal","namePart":["Taylor, Nicola,",{"@type":"date","#text":"1961-"}]},{"@type":"conference","namePart":"International Symposium on Marxian Theory (12th : 2002 : Università di Bergamo)"}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"marcgt","#text":"conference publication"},{"@authority":"fast","#text":"Conference papers and proceedings"}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},{"placeTerm":{"@type":"text","#text":"Basingstoke, Hampshire [England] "}},{"placeTerm":{"@type":"text","#text":"New York "}}],"issuance":"monographic","agent":{"namePart":"Palgrave Macmillan"},"dateIssued":"2004"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"ix, 315 p. : ill. ; 23 cm."},"abstract":{"@type":"Summary","#text":"The essays in this collection address specific themes in Volume I of Marx's \"Capital.\" Although the essays can be read independently, they present complimentary perspectives on issues at the cutting edge of recent scholarship on Marx's work. Although all Parts of\" Capital I \"are discussed, the book is not intended to be a textbook. It will be read by specialists in the field as well as graduate students in the history of economic thought, political economy and philosophy."},"tableOfContents":{"@type":"Contents","#text":"Marx's Capital I, the constitution of capital : general introduction / Nicola Taylor and Riccardo Bellofiore -- Money and the form of value / Christopher J. Arthur -- The objectivity of value versus the idea of habitual action / Martha Campbell -- Reconstructing Marx on money and the measurement of value / Nicola Taylor -- Productive force and the degree of intensity of labour : Marx's concepts and formalizations in the middle part of Capital I / Geert Reuten -- Money and totality : Marx's logic in volume I of Capital / Fred Moseley -- Marx and the macro-monetary foundation of microeconomics / Riccardo Bellofiore. Reply to Bellofiore / Fred Moseley ; Rejoinder to Moseley / Riccardo Bellofiore -- Technology and history in capitalism : Marxian and neo-Schumpeterian perspectives / Tony Smith -- The social and material transformation of production by capital : formal and real subsumption in Capital, volume I / Patrick Murray -- The inner mechanism of the accumulation of capital : the acceleration triple : a methodological appraisal of part seven of Marx's Capital I / Geert Reuten."},"note":[{"@type":"statement of responsibility","#text":"edited by Riccardo Bellofiore and Nicola Taylor."},"Revised versions of contributions first presented at the 12th International Symposium on Marxian Theory (ISMT) held at the University of Bergamo in July 2002.","\"Intended as a companion to: The circulation of capital: essays on volume II of Marx's 'Capital', edited by Christopher Arthur & Geert Reuten, Macmillan 1998, and The culmination of capital: essays on volume III of Marx's 'Capital', edited by Martha Campbell & Geert Reuten, Palgrave-Macmillan 2002\"--Pref.",{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"@authority":"lcsh","name":{"@type":"personal","namePart":["Marx, Karl,",{"@type":"date","#text":"1818-1883"}]},"titleInfo":{"title":"Kapital"},"genre":"Congresses"},{"@authority":"lcsh","topic":"Capital","genre":"Congresses"},{"@authority":"lcsh","topic":"Marxian economics","genre":"Congresses"}],"classification":[{"@authority":"lcc","#text":"HB501.M37 C66 2004"},{"@edition":"21","@authority":"ddc","#text":"335.4/1"}],"identifier":[{"@type":"isbn","#text":"1403907986"},{"@type":"lccn","#text":"^^2003053614"},{"@type":"oclc","#text":"52347785"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990093770300203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"HB501.M37 C66 2004x"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990093770300203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"009377030"}},"processingDate":"2025-12-09T06:52Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"030527"},"recordChangeDate":{"@encoding":"iso8601","#text":"20050603"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990093770300203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"titleInfo":{"title":"Understanding Capital","subTitle":"a guide to volume I"},"name":[{"@nameTitleGroup":"1","@usage":"primary"