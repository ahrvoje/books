{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Fenichell&limit=10&title=Plastic","limit":10,"start":0},"items":{"mods":{"titleInfo":{"title":"Plastic","subTitle":"the making of a synthetic century"},"name":{"@usage":"primary","@type":"personal","namePart":"Fenichell, Stephen","role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":{"@authority":"fast","#text":"History"},"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"New York"}}],"publisher":"HarperBusiness","dateIssued":["c1996",{"@encoding":"marc","#text":"1996"}],"issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"356 p. : ill. ; 24 cm."},"abstract":{"@type":"Summary","#text":"In Plastic: The Making of a Synthetic Century, Stephen Fenichell takes a fresh, irreverent look at the substance we all love to hate. The book moves from the early astonishment at such inventions as celluloid film and waterproof clothing; to the nylon-stocking riots after World War II; to the revolutionary, yet practical, proliferation of Tupperware in the '50s. Fenichell's sweeping assessment of the social and economic revolutions brought on by plastic extends from the sublime to the absurd, the beautiful to the mundane, demonstrating how scientists, artists, politicians, and the buying public have all molded, and also been molded by, plastic."},"tableOfContents":"1. Plasticland -- 2. Protoplastic -- 3. Celluloid Heroes -- 4. The Bakelite Brigade -- 5. Cellophane -- 6. Nylon -- 7. The Vinyl Solution -- 8. Plast-O-Rama -- 9. Pop Plastic -- 10. The Seat of the Plague -- 11. Sympathy for the Devil.","note":[{"@type":"statement of responsibility","#text":"Stephen Fenichell."},"Includes index.",{"@type":"bibliography","#text":"Includes index."}],"subject":{"@authority":"lcsh","topic":["Plastics","History"]},"classification":[{"@authority":"lcc","#text":"TP1116 .F46 1996"},{"@authority":"nlm","#text":"668.4 F333p"},{"@edition":"20","@authority":"ddc","#text":"668.4"}],"relatedItem":[{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":{"title":"Plastic"},"name":{"namePart":"Fenichell, Stephen."},"originInfo":{"publisher":"New York : HarperBusiness, ©1996"},"identifier":{"@type":"local","#text":"(OCoLC)603775349"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990069247240203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0887307329 (cloth)"},{"@type":"lccn","#text":"^^^96000364^"},{"@type":"oclc","#text":"34193959"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000463633307","#text":"Lamont Library, Harvard University"},"shelfLocator":"TP1116 .F46 1996"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000123374118","#text":"Baker Library, Harvard Business School, Harvard University"},"shelfLocator":"TP1116 .F46 1996"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"TP1116 .F46 1996"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":["Baker Business","Lamont","Widener"]},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990069247240203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"006924724"}},"processingDate":"2024-11-10T06:15Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#te