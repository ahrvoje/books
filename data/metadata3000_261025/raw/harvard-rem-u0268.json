ource":"MH:ALMA","#text":"990017465750203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}},{"@version":"3.8","titleInfo":[{"title":"Josef ","subTitle":"Wandlung der Bilder - Bilder der Wandlung : Tiefenpsychologische Näherungen an die Josefsgeschichte der Bibel und des Koran "},{"@type":"alternative","title":"Wandlung der Bilder - Bilder der Wandlung ","subTitle":"Tiefenpsychologische Näherungen an die Josefsgeschichte der Bibel und des Koran"},{"@type":"alternative","title":"Tiefenpsychologische Näherungen an die Josefsgeschichte der Bibel und des Koran"}],"name":{"@usage":"primary","@type":"personal","namePart":["Schmidt, Nora,",{"@type":"date","#text":"1985-"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}],"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PCjqJXVpfbqgDWW8bjjj4hd"},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"gw"},{"@type":"text","@authority":"marccountry","#text":"Germany"}]},"dateIssued":{"@encoding":"marc","#text":"2021"},"copyrightDate":{"@encoding":"marc","#text":"2021"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Göttingen, Germany :"}},"agent":{"namePart":"Vandenhoeck & Ruprecht GmbH,","role":{"roleTerm":"publisher"}},"dateIssued":[2021]},{"@eventType":"manufacture","place":{"placeTerm":{"@type":"text","#text":"Birkach, Germany :"}},"agent":{"namePart":"CPI buchbücher.de","role":{"roleTerm":"manufacturer"}}}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"ger"},{"@type":"text","@authority":"iso639-2b","#text":"German"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"155 pages : illustration ; 21 cm."},{"form":{"@type":"Illustrative content","#text":"illustration"}}],"abstract":"\"Die Josefsgeschichte gehört zu den bekanntesten Erzählungen der hebräischen Bibel. Bereits in der Antike und Spätantike wurde sie von zahlreichen Kommentatoren nicht nur ausgelegt, sondern auch fortgeschrieben und erzählerisch ergänzt. Hierzu gehört auch die Josefsgeschichte des Koran. In dem vorliegenden Buch wird die Geschichte Josefs in ihren Entwicklungsstadien nachvollzogen und erstmals tiefenpsychologisch gedeutet. Mithilfe der hermeneutischen Prinzipien der Tiefenpsychologie zeigt sich die Josefsgeschichte als der Individuationsprozess eines traumatisierten Kindes, das nach Phasen der Einsamkeit und Demütigung in der Fremde zu sich selbst findet und schliesslich rettend auf die Ursprungsfamilie zugehen kann. Die Bilder der Wandlung, die sich mit der Figur Josefs auch für heutige Leser verbinden, geht auch eine Wandlung der Bilder einher: So werden die verschiedenen Akzente und psychologischen Dynamiken der Josefsgeschichte in ihren jüdischen, christlichen und islamischen Varianten beschrieben.\" --Provided by publisher","note":[{"@type":"statement of responsibility","#text":"Nora Schmidt"},{"@type":"bibliography","#text":"Includes bibliographical references (pages 147-152) and index."}],"subject":[{"@authority":"fast","topic":"Joseph (Son of Jacob) in the Qurʼan"},{"@authority":"nli","titleInfo":{"title":"Bible","partNumber":"XXXVII-L","partName":"Genesis"},"topic":"Criticism, interpretation, etc"},{"@authority":"nli","titleInfo":{"title":"Bible","partName":"Genesis"},"topic":"Psychology"},{"@authority":"nli","titleInfo":{"title":"Qurʼan"},"topic":"Relation to the Bible"},{"@authority":"lcsh","name":{"@type":"personal","namePart":[{"@type":"termsOfAddress","#text":"(Son of Jacob)"},"Joseph"]}},{"@authority":"lcsh","name":{"@type":"personal","namePart":[{"@