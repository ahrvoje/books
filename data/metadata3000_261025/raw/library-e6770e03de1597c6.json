":{},"languages":[{"key":"/languages/eng"}],"local_id":["urn:phillips:31867003056483","urn:sfpl:31223096402913","urn:sfpl:31223096402160","urn:sfpl:31223096402517","urn:sfpl:31223096344396","urn:sfpl:31223096339883","urn:sfpl:31223096402269","urn:sfpl:31223096339875","urn:sfpl:31223099433469","urn:sfpl:31223096344545","urn:sfpl:31223096307781","urn:sfpl:31223099433519","urn:sfpl:31223096339834","urn:sfpl:31223096344420","urn:sfpl:31223096403549","urn:sfpl:31223096339792","urn:sfpl:31223099433451","urn:sfpl:31223096344438","urn:sfpl:31223096339818","urn:sfpl:31223096344446","urn:sfpl:31223096402418","urn:sfpl:31223096339867","urn:sfpl:31223096403077","urn:sfpl:31223096344487","urn:sfpl:31223096339826","urn:sfpl:31223096339925","urn:sfpl:31223096344511","urn:sfpl:31223096344529","urn:sfpl:31223096402756","urn:sfpl:31223099433444","urn:sfpl:31223096339909","urn:nuls:31786102854319"],"publish_date":"2011","works":[{"key":"/works/OL16084255W"}],"type":{"key":"/type/edition"},"physical_dimensions":"25 x  x  centimeters","oclc_numbers":["682893439"],"number_of_pages":535,"description":{"type":"/type/text","value":"\"From the author of 1491--the best-selling study of the pre-Columbian Americas--a deeply engaging new history that explores the most momentous biological event since the death of the dinosaurs. More than 200 million years ago, geological forces split apart the continents. Isolated from each other, the two halves of the world developed totally different suites of plants and animals. Columbus's voyages brought them back together--and marked the beginning of an extraordinary exchange of flora and fauna between Eurasia and the Americas. As Charles Mann shows, this global ecological tumult--the \"Columbian Exchange\"--underlies much of subsequent human history. Presenting the latest generation of research by scientists, Mann shows how the creation of this worldwide network of exchange fostered the rise of Europe, devastated imperial China, convulsed Africa, and for two centuries made Manila and Mexico City-- where Asia, Europe, and the new frontier of the Americas dynamically interacted--the center of the world. In 1493, Charles Mann gives us an eye-opening scientific interpretation of our past, unequaled in its authority and fascination\"--"},"latest_revision":18,"revision":18,"created":{"type":"/type/datetime","value":"2011-08-26T13:41:16.471594"},"last_modified":{"type":"/type/datetime","value":"2026-04-13T09:45:26.920936"}}},"OLID:OL25405923M":{"bib_key":"OLID:OL25405923M","info_url":"http://openlibrary.org/books/OL25405923M/1493","preview":"restricted","preview_url":"https://archive.org/details/1493uncoveringne00mann_0","thumbnail_url":"https://covers.openlibrary.org/b/id/14582128-S.jpg","details":{"other_titles":["Fourteen ninety-three","Fourteen hundred ninety-three"],"publishers":["Vintage Books"],"subtitle":"uncovering the new world Columbus created","description":"\"From the author of 1491--the best-selling study of the pre-Columbian Americas--a deeply engaging new history that explores the most momentous biological event since the death of the dinosaurs.  More than 200 million years ago, geological forces split apart the continents. Isolated from each other, the two halves of the world developed totally different suites of plants and animals. Columbus's voyages brought them back together--and marked the beginning of an extraordinary exchange of flora and fauna between Eurasia and the Americas. As Charles Mann shows, this global ecological tumult--the \"Columbian Exchange\"--underlies much of subsequent human history. Presenting the latest generation of research by scientists, Mann shows how the creation of this worldwide network of exchange fostered the rise of Europe, devastated imperial China, convulsed Africa, and for two centuries made Manila and Mexico City-- where Asia, Europe, and the new frontier of the Americas dynamically interacted--the center of the world.  In 1493, Charles Mann gives us an eye-opening scientific interpretation of our past, unequaled in its authority and fascination\"--","covers":[14582128,7960612],"full_title":"1493 uncovering the new world Columbus created","key":"/books/OL25405923M","authors":[{"key":"/authors/OL583603A","name":"Charles C. Mann"}],"publish_places":["New York"],"languages":[{"key":"/languages/eng"}],"pagination":"xxx, 690 p. :","source_records":["marc:marc_loc_updates/v40.i32.records.utf8:11312525:2362","ia:1493uncoveringne00mann_0","marc:marc_loc_2016/BooksAll.2016.part39.utf8:302300971:2362","bwb:9780307278241"],"title":"1493","notes":"Includes bibliographical references and index.","number_of_pages":690,"edition_name":"1st Vintage Books ed.","subject_places":["America"],"subjects":["Commerce","History","Ecology","Slave trade","Agriculture","Environmental aspects","Modern History","Influence","Industrial revolution","Economic history","Economic aspects","Discovery and exploration"],"subject_people":["Christopher Columbus"],"publish_country":"nyu","publish_date":"2012","by_statement":"Charles C. Mann","works":[{"key":"/works/OL16084255W"}],"type":{"key":"/type/edition"},"identifiers":{},"ocaid":"1493uncoveringne00mann_0","isbn_13":["9780307278241"],"lccn":["2012372262"],"classifications":{},"lc_classifications":["D228 .M36 2012","D228.M36 2012"],"latest_revision":9,"revision":9,"created":{"type":"/type/datetime","value":"2012-08-08T07:58:56.055209"},"last_modified":{"type":"/type/datetime","value":"2024-02-16T05:48:42.908677"}}},"OLID:OL26853860M":{"bib_key":"OLID:OL26853860M","info_url":"http://openlibrary.org/books/OL26853860M/1493_wu_zhong_da_jiao_huan_kai_chuang_de_shi_jie_shi","preview":"restricted","preview_url":"https://archive.org/details/1493wuzhongdajia1493char","thumbnail_url":"https://covers.openlibrary.org/b/id/8541111-S.jpg","details":{"other_titles":["1493: uncovering the new world Columbus created"],"publishers":["Zhong xin chu ban ji tuan gu fen you xian gong si"],"subtitle":"1493: uncovering the new world Columb