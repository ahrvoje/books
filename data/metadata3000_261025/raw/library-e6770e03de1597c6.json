,"identifiers":{"amazon":["0307913767"]},"title":"1493","subtitle":"Uncovering the New World Columbus Created","authors":[{"key":"/authors/OL583603A","name":"Charles C. Mann"}],"publish_date":"Aug 09, 2011","publishers":["Random House Audio"],"covers":[9096755],"physical_format":"audio cd","full_title":"1493 Uncovering the New World Columbus Created","source_records":["amazon:0307913767"],"isbn_13":["9780307913760"],"isbn_10":["0307913767"],"type":{"key":"/type/edition"},"languages":[{"key":"/languages/eng"}],"key":"/books/OL27652310M","number_of_pages":14,"works":[{"key":"/works/OL16084255W"}],"latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":"2019-11-08T19:28:17.824230"},"last_modified":{"type":"/type/datetime","value":"2024-01-12T22:27:57.239596"}}},"OLID:OL28565424M":{"bib_key":"OLID:OL28565424M","info_url":"http://openlibrary.org/books/OL28565424M/1493_for_Young_People","preview":"noview","preview_url":"http://openlibrary.org/books/OL28565424M/1493_for_Young_People","details":{"publishers":["Seven Stories Press"],"subtitle":"From Columbus's Voyage to Globalization","source_records":["bwb:9781609806637"],"title":"1493 for Young People","number_of_pages":416,"languages":[{"key":"/languages/eng"}],"publish_date":"2015","key":"/books/OL28565424M","authors":[{"key":"/authors/OL7219902A","name":"Charles Mann"},{"key":"/authors/OL5392626A","name":"Rebecca Stefoff"}],"works":[{"key":"/works/OL16084255W"}],"type":{"key":"/type/edition"},"subjects":["Columbus, christopher, 1451-1506","Columbus, christopher, 1451-1506, juvenile literature","History, modern","History, modern, juvenile literature","Economic history","Commerce","Commerce, juvenile literature","Agriculture","Agriculture, juvenile literature"],"identifiers":{},"isbn_13":["9781609806637"],"lc_classifications":["D228.M35 2014"],"contributors":[{"role":"Adaptation of original work by","name":"Rebecca Stefoff"}],"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2020-08-04T15:36:38.013618"},"last_modified":{"type":"/type/datetime","value":"2026-03-12T18:45:57.704671"}}},"OLID:OL31061853M":{"bib_key":"OLID:OL31061853M","info_url":"http://openlibrary.org/books/OL31061853M/1493_for_young_people","preview":"borrow","preview_url":"https://archive.org/details/1493foryoungpeop0000mann","thumbnail_url":"https://covers.openlibrary.org/b/id/12875643-S.jpg","details":{"description":"\"1493 for Young People by Charles C. Mann tells the gripping story of globalization through travel, trade, colonization, and migration from its beginnings in the fifteenth century to the present. How did the lowly potato plant feed the poor across Europe and then cause the deaths of millions? How did the rubber plant enable industrialization? What is the connection between malaria, slavery, and the outcome of the American Revolution? How did the fabled silver mountain of sixteenth-century Bolivia fund economic development in the flood-prone plains of rural China and the wars of the Spanish Empire? Here is the story of how sometimes the greatest leaps also posed the greatest threats to human advancement.  Mann's language is as plainspoken and clear as it is provocative, his research and erudition vast, his conclusions ones that will stimulate the critical thinking of young people. 1493 for Young People provides tools for wrestling with the most pressing issues of today, and will empower young people as they struggle with a changing world\"--","title":"1493 for young people","subtitle":"from Columbus's voyage to globalization","authors":[{"key":"/authors/OL583603A","name":"Charles C. Mann"}],"publish_date":"2015","other_titles":["Fourteen ninety-three for young people","Fourteen hundred ninety-three for young people"],"publishers":["Triangle Square"],"series":["For young people series"],"full_title":"1493 for young people from Columbus's voyage to globalization","publish_places":["New York"],"contributions":["Stefoff, Rebecca, 1951-"],"source_records":["mar