s":["marc:OpenLibraries-Trent-MARCs/multi1.mrc:626281:1041","marc:marc_openlibraries_phillipsacademy/PANO_FOR_IA_05072019.mrc:71314286:1165","marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run01.mrc:146491070:3322","marc:marc_loc_2016/BooksAll.2016.part13.utf8:100599505:769","bwb:9780226561578","marc:marc_columbia/Columbia-extract-20221130-001.mrc:173273674:1445","marc:harvard_bibliographic_metadata/ab.bib.01.20150123.full.mrc:50538347:2698","marc:harvard_bibliographic_metadata/20220215_021.bib.mrc:358639223:5069"],"title":"The pursuit of power","lccn":["81024095"],"notes":{"type":"/type/text","value":"Includes bibliographical references and index.\n\n6"},"identifiers":{"librarything":["22379"],"goodreads":["2831602"]},"local_id":["urn:trent:0116300674102","urn:trent:0199900068503","urn:phillips:31867000042536","urn:sfpl:31223007442388"],"by_statement":"William H. McNeill.","works":[{"key":"/works/OL469160W"}],"type":{"key":"/type/edition"},"oclc_numbers":["8132100"],"description":{"type":"/type/text","value":"\"In this magnificent synthesis of military, technological, and social history, William H. McNeill explores a whole millennium of human upheaval and traces the path by which we have arrived at the frightening dilemmas that now confront us. McNeill moves with equal mastery from the crossbow -- banned by the Church in 1139 as too lethal for Christians to use against one another -- to the nuclear missile, from the sociological consequences of drill in the seventeenth century to the emergence of the military-industrial complex in the twentieth. His central argument is that a commercial transformation of world society in the eleventh century caused military activity to respond increasingly to market forces as well as to the commands of rulers. Only in our own time, suggests McNeill, are command economies replacing the market control of large-scale human effort. The Pursuit of Power does not solve the problems of the present, but its discoveries, hypotheses, and sheer breadth of learning do offer a perspective on our current fears and, as McNeill hopes, 'a ground for wiser action'.\"--Publisher description."},"publishers":["University of Chicago Press"],"publish_date":"1982","languages":[{"key":"/languages/eng"}],"latest_revision":12,"revision":12,"created":{"type":"/type/datetime","value":"2008-11-02T14:42:45.468615"},"last_modified":{"type":"/type/datetime","value":"2025-11-18T10:41:27.131706"}}},"OLID:OL27083821M":{"bib_key":"OLID:OL27083821M","info_url":"http://openlibrary.org/books/OL27083821M/The_pursuit_of_power","preview":"noview","preview_url":"http://openlibrary.org/books/OL27083821M/The_pursuit_of_power","thumbnail_url":"https://covers.openlibrary.org/b/id/8711961-S.jpg","details":{"publishers":["Acls History E-Book Proje"],"subtitle":"technology, armed force, and society since a.d. 1000","covers":[8711961],"full_title":"The pursuit of power technology, armed force, and society since a.d. 1000","key":"/books/OL27083821M","authors":[{"key":"/authors/OL27393A","name":"William Hardy McNeill"}],"publish_places":["[S.l.]"],"languages":[{"key":"/languages/eng"}],"pagination":"p.","source_records":["ia:pursuitpowertech1000mcne"],"title":"The pursuit of power","isbn_13":["9781597402903"],"isbn_10":["1597402907"],"publish_date":"2009","publish_country":"xx","oclc_numbers":["671870647"],"works":[{"key":"/works/OL469160W"}],"type":{"key":"/type/edition"},"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2019-07-06T17:27:16.988829"},"last_modified":{"type":"/type/datetime","value":"2026-03-24T19:57:23.840562"}}},"OLID:OL39825306M":{"bib_key":"OLID:OL39825306M","info_url":"http://openlibrary.org/books/OL39825306M/Jing_zhu_fu_qiang","preview":"borrow","preview_url":"https://archive.org/details/jingzhufuqianggo0000mcne","thumbnail_url":"https://covers.openlibrary.org/b/id/12950228-S.jpg","details":{"notes":{"type":"/type/text","value":"Includes bibliographical references."},"title"