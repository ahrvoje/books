.5.J63 G73 2018"},{"@authority":"nlm","#text":"HF 5549.5 .J63 .G73 2018"},{"@edition":"23","@authority":"ddc","#text":"306.361"},{"@authority":"bisacsh","#text":"BUS012000 BUS107000 SOC002010"}],"relatedItem":[{"@type":"otherFormat","@otherType":"Print version:","@displayLabel":"Print version:","titleInfo":{"title":"Bullshit jobs"},"name":{"namePart":"Graeber, David."},"originInfo":{"publisher":"New York : Simon & Schuster, 2018","edition":"First Simon & Schuster hardcover edition."},"identifier":{"@type":"local","#text":"(OCoLC)1030241785"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99158486360403941/catalog"}}],"identifier":[{"@type":"isbn","#text":"9781501143342"},{"@type":"isbn","#text":"1501143344"},{"@type":"isbn","@invalid":"yes","#text":"9781501143311"},{"@type":"isbn","@invalid":"yes","#text":"150114331X"},{"@type":"isbn","@invalid":"yes","#text":"1501143336"},{"@type":"isbn","@invalid":"yes","#text":"9781501143335"},{"@type":"issue number","#text":"EB00717471 Recorded Books"},{"@type":"oclc","#text":"1035847195"},{"@type":"oclc","#text":"1035847195"},{"@type":"stock number","#text":"BBDE6316-9EF2-4A8D-87AA-E7722916ED01 OverDrive, Inc."}],"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99158486360403941","processingDate":"2025-05-16T05:13Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"TEFOD"},"recordCreationDate":{"@encoding":"marc","#text":"180517"},"recordChangeDate":{"@encoding":"iso8601","#text":"20250326"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99158486360403941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"@version":"3.8","titleInfo":[{"title":"Bullshit jobs "},{"@type":"alternative","@displayLabel":"Title on dust jacket:","title":"Bull shit jobs ","subTitle":"a theory"}],"name":[{"@usage":"primary","@type":"personal","namePart":"Graeber, David","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}],"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJp6cxKF7V9pDpBRxmvPwC"},{"@type":"corporate","namePart":"Simon and Schuster, Inc.","role":{"roleTerm":{"@type":"text","#text":"publisher"}}}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},"dateIssued":{"@encoding":"marc","#text":"2018"},"copyrightDate":{"@encoding":"marc","#text":"2018"},"issuance":"monographic","edition":"First Simon & Schuster hardcover edition."},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"New York :"}},"agent":{"namePart":"Simon & Schuster,","role":{"roleTerm":"publisher"}},"dateIssued":"2018."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xxvii, 333 pages : black and white illustrations ; 24 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Color content","#text":"monochrome"}}],"abstract":{"@type":"Summary","#text":"\"'Does your job make a meaningful contribution to the world?' David Graeber asked this question in a playful, provocative online essay titled On the Phenomenon of Bullshit Jobs. He defined a bullshit job as 'a form of paid employment that is so completely pointless, unnecessary, or pernicious that even the employee cannot justify its existence, even though as part of the conditions of employment, the employee feels obliged to pretend that this is not the case.' After a million views in seventeen different languages, people all over the world are still debating the answer. ... Graeber, in his singularly searing and illuminating style, identifies the five types of bullshit jobs and argues that when 1 percent of the population controls most of a society's wealth, they control what jobs are 'useful' and 'important.' ... Graeber illustrates how nurses, bus drivers, musicians, and landscape gardeners provide true value, and what it says about us as a society when we look down upon them. Using arguments from some of the most revered political thinkers, philosophers, and scientists of our time, Graeber articulates the societal and political consequences of these bullshit jobs. Depression, anxiety, and a warped sense of our values are all dire concerns. He provides a blueprint to undergo a shift in values, placing creative and caring work at the center of our culture, providing the meaning and satisfaction we all crave.\"--Jacket."},"tableOfContents":{"@type":"Contents","#text":"Preface: On the phenomenon of bullshit jobs -- What is a bullshit job? -- What sorts of bullshit jobs are there? -- Why do those in bullshit jobs regularly report themselves unhappy? -- What is it like to have a bullshit job? -- Why are bullshit jobs proliferating? -- Why do we as a society not object to the growth of pointless employment? -- What are the political effects of bullshit jobs, and is there anything that can be done about this situation?"},"note":[{"@type":"statement of responsibility","#text":"David Graeber."},{"@type":"bibliography","#text":"Includes bibliographical references (pages 327-333)."}],"subject":[{"@authority":"lcsh","topic":["Job satisfaction","Social aspects"]},{"@authority":"lcsh","topic":"Organizational effectiveness"},{"@authority":"lcsh","topic":["Bureaucracy","Social aspects"]},{"@authority":"lcsh","topic":"Social structure"},{"@authority":"lcsh","topic":["Work","Social aspects"]},{"@authority":"lcsh","topic":["Work","Psychological aspects"]},{"@authority":"lcshac","topic":["Job satisfaction","Social aspects"]},{"@authority":"lcshac","topic":["Work","Social aspects"]},{"@authority":"lcshac","topic":["Work","Psychological aspects"]},{"@authority":"rvm","topic":["Satisfaction au travail","Aspect social"]},{"@authority":"rvm","topic":"Efficacité organisationnelle"},{"@authority":"rvm","topic":["Bureaucratie","Aspect social"]},{"@authority":"rvm","topic":"Structure sociale"},{"@authority":"rvm","topic":["Travail","Aspect social"]},{"@authority":"rvm","topic":["Travail","Aspect psychologique"]},{"@authority":"aat","topic":"social structure"},{"@authority":"bisacsh","topic":["BUSINESS & ECONOMICS","Personal Success"]},{"@authority":"bisacsh","topic":["BUSINESS & ECONOMICS","Workplace Culture"]},{"@authority":"bisacsh","topic":["SOCIAL SCIENCE","Anthropology","Cultural & Social"]},{"@authority":"fast","topic":["Bureaucracy","Social aspects"]},{"@authority":"fast","topic":"Organizational effectiveness"},{"@authority":"fast","topic":"Social structure"},{"@authority":"fast","topic":["Work","Psychological aspects"]},{"@authority":"fast","topic":["Work","Social aspects"]},{"@authority":"gnd","topic":"Arbeitszufriedenheit"},{"@authority":"gnd","topic":"Sinn"},{"@authority":"gnd","topic":"Bürokratisierung"},{"@authority":"gnd","topic":"Arbeitskultur"},{"@authority":"gnd","topic":"Arbeitssoziologie"},{"@authority":"stw","@href":"(DE-STW)11309-1","topic":"Arbeitswelt"},{"@authority":"stw","@href":"(DE-STW)15837-5","topic":"Arbeitszufriedenheit"},{"@authority":"stw","@href":"(DE-STW)11154-4","topic":"Bürokratie"},{"@authority":"stw","@href":"(DE-STW)16597-1","topic":"Sozialstruktur"},{"@authority":"stw","@href":"(DE-STW)16692-0","topic":"Industriesoziologie"},{"@authority":"stw","@href":"(DE-STW)12617-6","topic":"Arbeitspsychologi