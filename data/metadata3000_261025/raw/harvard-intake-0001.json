meIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJc3MgKfJkXRcGFdpVMHG3"}},{"@authority":"lcsh","name":{"@type":"corporate","namePart":"Endurance (Ship)"}},{"@authority":"lcsh","name":{"@type":"corporate","namePart":"Aurora (Cruiser)"}},{"@authority":"fast","name":{"@type":"corporate","namePart":"Aurora (Cruiser)"}},{"@authority":"fast","name":{"@type":"corporate","namePart":"Endurance (Ship)"}}],"classification":[{"@authority":"lcc","#text":"G850 1914 .S5"},{"@authority":"ddc","#text":"919.9"}],"relatedItem":[{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":{"title":"South"},"originInfo":{"publisher":"London : William Heinemann, 1919 (1920 printing)"},"identifier":{"@type":"local","#text":"(OCoLC)609442682"},"name":{"namePart":"Shackleton, Ernest Henry, Sir, 1874-1922."}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990065806720203941/catalog"}}],"identifier":[{"@type":"lccn","#text":"^^^20001603^"},{"@type":"oclc","#text":"13627467"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"https://isni.org/isni/0000000463448398","#text":"Botany Libraries, Harvard University"},"shelfLocator":"G850 1914 .S524 1919x"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"Geog 6009.14"},{"url":{"@access":"raw object","#text":"https://hdl.handle.net/2027/hvd.32044021213533"}}],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":["Botany","Widener"]},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990065806720203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"006580672"}},"processingDate":"2026-09-07T04:18Z"}},{"sets":null}],"recordInfo":{"recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"960223"},"recordChangeDate":{"@encoding":"iso8601","#text":"20191017"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990065806720203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"@version":"3.8","titleInfo":[{"title":"South by south ","subTitle":"New Zealand and the heroic age of Antarctic exploration "},{"@type":"alternative","title":"New Zealand and the heroic age of Antarctic exploration"}],"name":{"@usage":"primary","@type":"personal","namePart":"Ferrall, Charles","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author person"}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdaco","#text":"text"},{"@authority":"fast","#text":"History"},{"@authority":"fast","#text":"Personal correspondence"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nz"},{"@type":"text","@authority":"marccountry","#text":"New Zealand"}]},"dateIssued":{"@encoding":"marc","#text":"2025"},"copyrightDate":{"@encoding":"marc","#text":"2025"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Wellington :"}},"agent":{"namePart":"Te Herenga Waka University Press,","role":{"roleTerm":"publisher"}},"dateIssued":"2025.","issuance":"single unit"}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamt","#text":"unmediated"},{"@type":"carrier","@authority":"rdact","#text":"volume"}],"extent":"320 pages : illustrations ; 24 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}}],"abstract":{"@type":"Summary","#text":"\"Joseph Kinsey is not a name many of us know - or not as well as we know the name Robert Falcon Scott. But from his base in Christchurch, Kinsey - book and art collector, philanthropist, science enthusiast, businessman - forged deep connections with the Antarctic expeditions and the explorers themselves through his tireless work as the agent for various expeditions. Two other New Zealanders also formed close friendships: Charles Bowen, a former politician, and Wellington lawyer Leonard Tripp, to whom Shackleton declared: 'I love you as David and Jonathan loved. 'South by South tells the story of New Zealand's role in 'the Heroic Age', that wave of exploration beginning at the end of the nineteenth century in which men set out to traverse the continent of Antarctica and, if they survived, to bring home their findings. The members of this New Zealander triumvirate were all believers in the British Empire, but the southern voyages were to an uninhabited land. South by South brings to light many letters, newspaper articles, and pieces of official correspondence, much of which has not been published before, during the five expeditions of 1901-1916: the Discovery, Nimrod, Terra Nova, Aurora, and Endurance. In particular, Scott's letters to Kinsey and Shackleton's to Tripp tell of their hope, despair, exhaustion, and deep gratitude for their friendship. What they and the explorers wrote was influenced by nineteenth-century adventure stories which conveyed the Imperialist ideals of the time. If the impending conflict of 1914-18 was a very 'literary war', this was very literary exploration\"--Back cover."},"note":[{"@type":"statement of responsibility","#text":"Charles Ferrall."},{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"geographicCode":[{"@authority":"marcgac","#text":"t------"},{"@authority":"marcgac","#text":"u-nz---"},{"@authority":"marcgac","#text":"e-uk---"}]},{"@authority":"lcsh","topic":"Explorers","geographic":"Antarctica","genre":"Correspondence"},{"@authority":"lcsh","topic":[