{"pagination":{"maxPageableSet":"10000","numFound":4,"query":"name=Kaye&limit=10&title=Philosophy","limit":10,"start":0},"items":{"mods":[{"@version":"3.8","titleInfo":{"nonSort":{"@space":"preserve","#text":"The  "},"title":"Onion and philosophy ","subTitle":"fake news story true, alleges indignant area professor "},"name":{"@type":"personal","namePart":"Kaye, Sharon M."},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"fast","#text":"Criticism, interpretation, etc."}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"ilu"},{"@type":"text","@authority":"marccountry","#text":"Illinois"}]},{"placeTerm":{"@type":"text","#text":"Chicago "}}],"dateIssued":[{"@encoding":"marc","#text":"2010"},"c2010"],"issuance":"monographic","agent":{"namePart":"Open Court"}},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":{"@authority":"marcform","#text":"print"},"extent":"x, 286 p. : ill. ; 23 cm."},{"form":{"@type":"Illustrative content","#text":"illustration"}}],"abstract":{"@type":"Summary","#text":"The Onion, with its unique brand of deadpan satirical humor, has become a familiar part of the American scene. The newspaper has a readership of over a million, and it reaches millions more with its spin-off books and The Onion News Network. The Onion has shown us that standard ways of thinking about the news have their grotesque and silly side, and this invites philosophical examination. Twenty-one philosophers were commissioned to figure out just what makes the Onion so truthful and insightful. Are the Onion writers truly cynical, or just cynically faking it? Does the Onion really have a serious point of view on religion? On sex? On politics? Who cares what Area Man thinks? If everyone's so dumb, how come so many Onion readers keep on laughing at how dumb they are? -- Product Description."},"tableOfContents":{"@type":"Contents","#text":"Science and technology -- Opinion -- Politics -- World -- Business -- Local -- News archive -- Entertainment."},"note":[{"@type":"statement of responsibility","#text":"edited by Sharon M. Kaye."},{"@type":"bibliography","#text":"Includes bibliographical references and indexes."}],"subject":[{"@authority":"lcsh","titleInfo":{"title":"Onion (Madison, Wis.)"}},{"@authority":"lcsh","topic":["Satire","Philosophy"]},{"@authority":"lcsh","topic":["American wit and humor","History and criticism"]}],"classification":[{"@authority":"lcc","#text":"PN4899.M322 O55 2010"},{"@edition":"22","@authority":"ddc","#text":"051"}],"relatedItem":[{"titleInfo":{"title":"Popular culture and philosophy ","partNumber":"v. 54"}},{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":{"title":"Onion and philosophy"},"originInfo":{"publisher":"Chicago : Open Court, ©2010"},"identifier":[{"@type":"isbn","#text":"9780812696875"},{"@type":"local","#text":"(OCoLC)696084180"}]},{"@type":"series","titleInfo":{"title":"Popular culture and philosophy ","partNumber":"v. 54"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990127685010203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"9780812696875 (trade paper : alk. paper)"},{"@type":"isbn","#text":"0812696875 (trade paper : alk. paper)"},{"@type":"lccn","#text":"^^2010035359"},{"@type":"oclc","#text":"555629386"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"PN4899.M322 O55 2010"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990127685010203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"012768501"}}