cument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99156317961703941","processingDate":"2024-09-18T05:20Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"220123"},"recordChangeDate":{"@encoding":"iso8601","#text":"20220713"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99156317961703941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"titleInfo":{"title":"From the great transformation to the great financialization","subTitle":"on Karl Polanyi and other essays"},"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":"Levitt, Kari","role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"mbc"},{"@type":"text","@authority":"marccountry","#text":"Manitoba"}]},{"placeTerm":{"@type":"text","#text":"Black Point, N. S"}}],"publisher":"Fernwood Pub.","dateIssued":["c2013",{"@encoding":"marc","#text":"2013"}],"issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"viii, 286 p. ; 23 cm."},"tableOfContents":"Part 1- Polanyi on capitalism, socialism and democracy. On transformations: Past, present and future? -- Hayek from Vienna to Chicago: Architect of the neoliberal creed -- The roots of Polanyi's socialist vision -- Back to the future: The world economic crisis of the 1930s -- Keynes and Polanyi: The 1920s and the 1990s -- Leading concepts in the work of Karl Polanyi and their contemporary relevance -- Culture and economy -- Social dividend as a citizen right -- Part 2- The global south from conquest and exploitation to self-reliant development. Structural continuity and economic dependence in the capitalist world system -- From mercantilism to neoliberalism and the financial crisis of 2008 -- The great financialization of 2008 -- Development economics in perspective -- Reclaiming policy space for equitable economic development -- Intellectual independence and transformative change in the south -- Part 3- Conclusion. Globalization and development: Decline of the west and rise of the rest.","note":[{"@type":"statement of responsibility","#text":"Kari Polanyi Levitt."},{"@type":"bibliography","#text":"Includes bibliographical references (p. 271-279) and index."}],"subject":[{"@authority":"lcsh","name":{"@type":"personal","namePart":["Polanyi, Karl",{"@type":"date","#text":"1886-1964"}]}},{"@authority":"lcsh","topic":"Capitalism"}],"classification":[{"@authority":"lcc","#text":"HB501 .L48 2013"},{"@edition":"23","@authority":"ddc","#text":"330.12/2"}],"identifier":[{"@type":"isbn","#text":"9781552665459"},{"@type":"isbn","#text":"1552665453"},{"@type":"oclc","#text":"821261828"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990137217750203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"HB501 .L48 2013"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990137217750203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"013721775"}},"processingDate":"2024-02-10T06:19Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"NLC"},"recordCreationDate":{"@encoding":"marc","#text":"121206"},"