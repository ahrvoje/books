{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Thornton&limit=10&title=Tits Up","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":[{"title":"Tits up ","subTitle":"what sex workers, milk bankers, plastic surgeons, bra designers, and witches tell us about breasts "},{"@type":"alternative","title":"What sex workers, milk bankers, plastic surgeons, bra designers, and witches tell us about breasts"}],"name":{"@usage":"primary","@type":"personal","namePart":"Thornton, Sarah (Sarah L.)","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}},{"roleTerm":{"@type":"code","@authority":"marcrelator","#text":"aut"}},{"roleTerm":{"@type":"code","@authority":"marcrelator","#text":"http://id.loc.gov/vocabulary/relators/aut"}}],"nameIdentifier":["https://id.oclc.org/worldcat/entity/E39PBJq6RyJYRFgyKCRhqc9qwC","http://id.loc.gov/rwo/agents/n2014040444"]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","@valueURI":"http://id.loc.gov/vocabulary/contentTypes/txt","#text":"text"},{"@authority":"rdacontent","@valueURI":"http://id.loc.gov/vocabulary/contentTypes/sti","#text":"still image"},{"@authority":"fast","#text":"Popular works"},{"@authority":"lcgft","#text":"Informational works"},{"@authority":"rvmgf","#text":"Documents d'information."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},"dateIssued":{"@encoding":"marc","#text":"2024"},"copyrightDate":{"@encoding":"marc","#text":"2024"},"issuance":"monographic","edition":"First edition."},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"New York :"}},"agent":{"namePart":"W. W. Norton & Company,","role":{"roleTerm":"publisher"}},"dateIssued":[2024],"issuance":"single unit"}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@authority":"marccategory","#text":"text"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"321 pages illustrations 24 cm"},{"form":{"@type":"Illustrative content","#text":"illustrations"}}],"abstract":{"@type":"Summary","#text":"Author Sarah Thornton ventures behind the scenes to uncover the social and cultural significance of breasts. She excavates the diverse truths of mammary glands from the strip club to the operating room, from the nation's oldest human milk bank to the fit rooms of bra designers. Thornton draws insights from plastic surgeons, lactation consultants, body-positive witches, lingerie models, and 'free the nipple' activists to explore the status of breasts as emblems of femininity. She examines how women's chests have become a billion-dollar business, as well as a stage for debates about race, class, gender, and desire. Everywhere she turns, Thornton encounters chauvinistic myths about this elemental body part that quietly justify deficits in women's bodily autonomy and endorse shortfalls in their political status. Blending sociology, reportage, and personal narrative, Thornton has one overriding ambition--to liberate breasts from centuries of patriarchal prejudice. -- From publisher's description."},"tableOfContents":{"@type":"Contents","#text":"Introduction: Reclaiming a part of womanhood -- Hardworking tits -- Lifesaving jugs -- Treasured chests -- Active apexes -- Holy mammaries -- Conclusion: Toward a liberated rack."},"note":[{"@type":"statement of responsibility","#text":"Sarah Thornton."},{"@type":"bibliography","#text":"Includes bibliographical references (pages 259-302) and index."}],"subject":[{"@authority":"lcsh","topic":["Breast","Social aspects"]},{"@authority":"lcsh","topic":"Breast"},{"@authority":"lcsh"