dified":{"type":"/type/datetime","value":"2026-05-20T09:03:03.764223"}}},"OLID:OL21593347M":{"bib_key":"OLID:OL21593347M","info_url":"http://openlibrary.org/books/OL21593347M/Fate_Is_the_Hunter","preview":"noview","preview_url":"http://openlibrary.org/books/OL21593347M/Fate_Is_the_Hunter","details":{"notes":{"type":"/type/text","value":"Originally published 1961."},"identifiers":{"amazon.co.uk_asin":["0671504002"],"goodreads":["5729831"],"librarything":["90538"]},"title":"Fate Is the Hunter","authors":[{"key":"/authors/OL2725285A","name":"Ernest K. Gann"}],"publish_date":"1984","publishers":["Simon and Schuster"],"isbn_10":["0671504002"],"lc_classifications":["PS3513.A56"],"publish_places":["New York, USA"],"isbn_13":["9780671504007"],"lccn":["83020273"],"languages":[{"key":"/languages/eng"}],"dewey_decimal_class":["813","B/.54"],"subjects":["Gann, Ernest K.","Novelists, American -- 20th century -- Biography.","Air pilots -- United States -- Biography."],"publish_country":"xxu","by_statement":"Ernest K. Gann.","oclc_numbers":["10161670"],"type":{"key":"/type/edition"},"source_records":["marc:talis_openlibrary_contribution/talis-openlibrary-contribution.mrc:648713496:729"],"key":"/books/OL21593347M","works":[{"key":"/works/OL4416196W"}],"latest_revision":8,"revision":8,"created":{"type":"/type/datetime","value":"2008-11-03T06:44:22.235135"},"last_modified":{"type":"/type/datetime","value":"2025-12-18T04:35:13.836495"}}},"OLID:OL22780359M":{"bib_key":"OLID:OL22780359M","info_url":"http://openlibrary.org/books/OL22780359M/Fate_Is_the_Hunter","preview":"noview","preview_url":"http://openlibrary.org/books/OL22780359M/Fate_Is_the_Hunter","details":{"publishers":["New English Library"],"identifiers":{"british_national_bibliography":["GB6917829"],"amazon.de_asin":["0450003507"],"librarything":["90538"]},"isbn_10":["0450003507"],"lc_classifications":["TL540.G/"],"key":"/books/OL22780359M","authors":[{"key":"/authors/OL2725285A","name":"Ernest K. Gann"}],"publish_places":["London, England"],"isbn_13":["9780450003509"],"pagination":"315p. ;","title":"Fate Is the Hunter","dewey_decimal_class":["629.130924"],"notes":{"type":"/type/text","value":"Originally published, New York: Simon & Schuster: (B61-4143), London: Hodder & Stoughton, 1961."},"number_of_pages":315,"languages":[{"key":"/languages/eng"}],"subjects":["Gann, Ernest K. -- 1910-  -- Biography."],"publish_date":"1969","publish_country":"xxk","by_statement":"by Ernest K. Gann.","oclc_numbers":["30299952","877160541"],"works":[{"key":"/works/OL4416196W"}],"type":{"key":"/type/edition"},"source_records":["bwb:9780450003509"],"latest_revision":8,"revision":8,"created":{"type":"/type/datetime","value":"2008-12-30T03:06:32.866331"},"last_modified":{"type":"/type/datetime","value":"2024-08-17T06:34:05.473653"}}},"OLID:OL23764874M":{"bib_key":"OLID:OL23764874M","info_url":"http://openlibrary.org/books/OL23764874M/Fate_is_the_hunter","preview":"noview","preview_url":"http://openlibrary.org/books/OL23764874M/Fate_is_the_hunter","details":{"title":"Fate is the hunter","authors":[{"key":"/authors/OL2725285A","name":"Ernest K. Gann"}],"publish_date":"1961","publishers":["Simon and Schuster"],"pagination":"390 p. ;","subjects":["Air pilots -- Correspondence, reminiscences, etc"],"publish_country":"nyu","by_statement":"by Ernest Kellogg Gann.","publish_places":["New York"],"type":{"key":"/type/edition"},"key":"/books/OL23764874M","number_of_pages":390,"works":[{"key":"/works/OL4416196W"}],"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2009-10-09T23:11:48.752252"},"last_modified":{"type":"/type/datetime","value":"2025-09-03T07:42:56.692028"}}},"OLID:OL23850862M":{"bib_key":"OLID:OL23850862M","info_url":"http://openlibrary.org/books/OL23850862M/Los_jest_myśliwym","preview":"noview","preview_url":"http://openlibrary.org/books/OL23850862M/Los_jest_myśliwym","thumbnail_url":"https://covers.openlibrary.org/b/id/6678986-S.jpg","details":{"publishers":["ISKRY"],"table_of_contents":[{"level":0,"label":"","title":"PROLOG","pagenum":"2","type":{"key":"/type/toc_item"}}],"description":{"type":"/type/text","value":"„Strach znaliśmy dotąd jedynie z widzenia. Teraz przyszedł czas na zawarcie bliższej znajomości. Oba silniki zaczynają nagle przerywać. Najpierw jeden, potem drugi. Na jedna straszliwa chwile oba milkną zupełnie. Potem następuje cisza, która w istocie nie jest ciszą, ale mrożącym krew w żyłach zaniknięciem wszelkich odgłosów. \r\n\r\nTak się umiera.\r\nTrzy minuty po drugiej nad ranem. \r\n\r\nI nagle silniki wracają do życia. Czujemy, jak się zrywają d, ale straciliśmy bezcenne 500 stóp! Jesteśmy na mniejszej wysokości aniżeli szczyt, który gdzieś tu musi być w pobliżu. Coś trzeba zrobić z silnikami. Reszta jest nieważna. Hughen szarpnięciem przestawia gaźniki na bogata mieszankę. Zabiera się ponownie do głównego zbiornika paliwa i pompuje. Przez cały czas stara się utrzymać samolot w czymś na podobieństwo równego lotu. \r\n\r\nSilniki znowu słabną. Dotknęła je jakaś tajemnicza choroba. Możemy spierać się z naszym zmysłem latania, ale nie ze wskaźnikiem ciśnienia ładowania. Oba przyrządy wskazują powolny, ale stały, spadek mocy. To nie może być wina lodu na gaźniku. Tego jesteśmy pewni, ponieważ inne przyrządy mówią że ogrzewanie działa. Tracimy jeszcze dwieście stóp, Hughen nerwowo szarpie dzwignie gazu. Sprawdza iskrowniki. Zdumienie jego jest większe od strachu a ja nie wiem jak mu pomóc. \r\n\r\nJesteśmy o wiele za nisko...\""},"weight":"65 ","covers":[6678986],"last_modified":{"type":"/type/datetime","value":"2020-02-19T15:29:15.602871"},"latest_revision":5,"key":"/books/OL23850862M","authors":[{"key":"/authors/OL2725285A","name":"Ernest K. Gann"}],"publish_places":["Warszawa"],"contributions":["30 000 +280"],"first_sentence":{"type":"/type/text","value":"Jest to zbeletryzowana biografia amerykańskiego pilota pasażerskiego, obejmująca trudny okres powstawania i formowania sie lotnictwa pasażerskiego. \r\n\r\n„Los jest myśliwym\" (Fate is the hunter) to zbeletryzowana autobiografia amerykańskiego pilota pasażerskiego rozmiłowanego w swoim zawodzie, obejmująca trudny okres powstawanie i formowania się lotnictwa pasażerskiego, które w dwudziestoleciu międzywojennym i w czasie II wojny światowej z niezbyt pewnego i popularnego środka komunikacji przekształciło się w potęgę, jaką jest obecnie. \r\n\r\nErnest Kellogg Gann urodził się w 1910 w Lincoln, w stanie Nebraska. Po ukończeniu akademii wojskowej dwa lata studiuje w Yale. Swoją lotniczą karierę trwającą siedemnaście lat zaczyna jako amator. Pod koniec lat trzydziestych zgłasza się na kurs pilotów transportowych, zorganizowany przez jedną z firm lotniczych, a następnie pracuje przez pewien czas na liniach krajowych. W 1941 roku Gann jest w pierwszej grupie lotników tworzących zalążek słynnego Air Transport Command, jedynej w swoim rodzaju formacji cywilnej na usługach wojska."},"title":"Los jest myśliwym","number_of_pages":235,"created":{"type":"/type/datetime","value":"2009-11-04T19:41:59.149689"},"edition_name":"I","publish_date":"1965","works":[{"key":"/works/OL4416196W"}],"type":{"key":"/type/edition"},"physical_dimensions":"82x104","revision":5}},"OLID:OL24548001M":{"bib_key":"OLID:OL24548001M","info_url":"http://openlibrary.org/books/OL24548001M/Fate_Is_the_Hunter","preview":"borrow","preview_url":"https://archive.org/details/fateishunter00gann","thumbnail_url":"https://covers.openlibrary.org/b/id/8273550-S.jpg","details":{"publishers":["Crest / Fawcett"],"number_of_pages":352,"ia_box_id":["IA127804"],"covers":[8273550],"physical_format":"Mass Market Paperback","lc_classifications":["PS3513.A56 F3"],"latest_revision":10,"key":"/books/OL24548001M","authors":[{"key":"/authors/OL2725285A","name":"Ernest K. Gann"}],"ocaid":"fateishunter00gann","publish_places":["Greenwich, CT, USA"],"description":{"type":"/type/text","value":"The story of one pilots journey from corn field flying to the early days of commercial aviation, through the second world war and post war flying. Well written, full of grit, drama, some humor, and some luck."},"languages":[{"key":"/languages/eng"}],"pagination":"352 p. ;","source_records":["ia:fateishunter00gann"],"title":"Fate Is the Hunter","dewey_decimal_class":["818.54"],"notes":{"type":"/type/text","value":"Crest Book R502\r\nA Crest Reprint\r\nSecond Crest printing"},"identifiers":{"goodreads":["34632001"]},"created":{"type":"/type/datetime","value":"2010-12-17T16:03:35.814276"},"edition_name":"2nd Crest printing","last_modified":{"type":"/type/datetime","value":"2020-02-19T15:23:35.773849"},"publish_date":"1962-03","publish_country":"ctu","copyright_date":"1961","by_statement":"by Ernest K. Gann","oclc_numbers":["6595271"],"works":[{"key":"/works/OL4416196W"}],"type":{"key":"/type/edition"},"revision":10}},"OLID:OL25118809M":{"bib_key":"OLID:OL25118809M","info_url":"http://openlibrary.org/books/OL25118809M/Los_jest_myśliwym","preview":"noview","preview_url":"http://openlibrary.org/books/OL25118809M/Los_jest_myśliwym","thumbnail_url":"https://covers.openlibrary.org/b/id/6997013-S.jpg","details":{"publishers":["Lotnicza Oficyna Wydawnicza LOW PASS"],"covers":[6997013],"last_modified":{"type":"/type/datetime","value":"2020-02-19T15:29:15.602871"},"latest_revision":3,"key":"/books/OL25118809M","created":{"type":"/type/datetime","value":"2011-12-05T10:34:54.729372"},"title":"Los jest myśliwym","publish_date":"2011","works":[{"key":"/works/OL4416196W"}],"type":{"key":"/type/edition"},"revision":3}},"OLID:OL25118811M":{"bib_key":"OLID:OL25118811M","info_url":"http://openlibrary.org/books/OL25118811M/Los_jest_myśliwym","preview":"noview","preview_url":"http://openlibrary.org/books/OL25118811M/Los_jest_myśliwym","thumbnail_url":"https://covers.openlibrary.org/b/id/6975748-S.jpg","details":{"publishers":["Lotnicza Oficyna Wydawnicza LOW PASS"],"table_of_contents":[{"level":0,"label":"","title":"Jedna z najlepszych powieści o tematyce lotniczej, jaka kiedykolwiek została wydana.","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Ponownie dostępna w języku polskim po 46 latach od pierwszego wydania.","pagenum":"","type":{"key":"/type/toc_item"}}],"title":"Los jest myśliwym","created":{"type":"/type/datetime","value":"2011-12-05T10:50:54.978701"},"covers":[6975748],"languages":[{"key":"/languages/pol"}],"last_modified":{"type":"/type/datetime","value":"2020-02-19T15:29:15.602871"},"publish_date":"2011","key":"/books/OL25118811M","subtitle":"Tłumaczenie na język polski - Henryk Krzeczkowski","publish_places":["Warszawa, Poland"],"works":[{"key":"/works/OL4416196W"}],"type":{"key":"/type/edition"},"latest_revision":4,"revision":4}},"OLID:OL25129854M":{"bib_key":"OLID:OL25129854M","info_url":"http://openlibrary.org/books/OL25129854M/Los_jest_myśliwym","preview":"noview","preview_url":"http://openlibrary.org/books/OL25129854M/Los_jest_myśliwym","thumbnail_url":"https://covers.openlibrary.org/b/id/6997015-S.jpg","details":{"publishers":["Lotnicza Oficyna Wydawnicza LOW PASS"],"weight":"496 grams","title":"Los jest myśliwym","number_of_pages":494,"covers":[6997015],"created":{"type":"/type/datetime","value":"2011-12-25T18:55:52.758483"},"physical_format":"Paperback","isbn_10":["9788393424702"],"publish_date":"2011","key":"/books/OL25129854M","last_modified":{"type":"/type/datetime","value":"2020-08-22T04:22:18.920453"},"latest_revision":6,"publish_places":["Warszawa, Poland"],"works":[{"key":"/works/OL4416196W"}],"type":{"key":"/type/edition"},"physical_dimensions":"5 x 14,5 x 20,5 centimeters","revision":6}},"OLID:OL27911846M":{"bib_key":"OLID:OL27911846M","info_url":"http://openlibrary.org/books/OL27911846M/Fate_Is_the_Hunter","preview":"noview","preview_url":"http://openlibrary.org/books/OL27911846M/Fate_Is_the_Hunter","thumbnail_url":"https://covers.openlibrary.org/b/id/9269325-S.jpg","details":{"publishers":["Weidenfeld & Nicholson","Phoenix"],"physical_format":"Paperback","title":"Fate Is the Hunter","covers":[