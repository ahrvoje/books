ry":"ctu","by_statement":"by Thomas C. Schelling.","works":[{"key":"/works/OL2259854W"}],"type":{"key":"/type/edition"},"oclc_numbers":["2425457"],"latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-05-31T05:53:03.455451"}}},"OLID:OL5985894M":{"bib_key":"OLID:OL5985894M","info_url":"http://openlibrary.org/books/OL5985894M/Arms_and_influence","preview":"noview","preview_url":"http://openlibrary.org/books/OL5985894M/Arms_and_influence","details":{"publishers":["Yale University Press"],"identifiers":{"librarything":["226219"]},"ia_box_id":["IA147609"],"local_id":["urn:phillips:31867000043278","urn:sfpl:31223001307363","urn:sfpl:31223001307371"],"ia_loaded_id":["armsinfluence00sche"],"lc_classifications":["U104 .S33"],"key":"/books/OL5985894M","authors":[{"key":"/authors/OL294006A","name":"Thomas C. Schelling"}],"publish_places":["New Haven"],"contributions":["Harvard University. Center for International Affairs."],"pagination":"viii, 293 p.","source_records":["marc:marc_records_scriblio_net/part05.dat:149637833:803","marc:marc_ithaca_college/ic_marc.mrc:72261954:885","ia:armsinfluence00sche","marc:marc_openlibraries_phillipsacademy/PANO_FOR_IA_05072019.mrc:98611381:1193","marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run01.mrc:188944416:1741","marc:marc_loc_2016/BooksAll.2016.part06.utf8:53745261:803","marc:harvard_bibliographic_metadata/ab.bib.00.20150123.full.mrc:546193190:1952","marc:marc_columbia/Columbia-extract-20221130-004.mrc:487415529:1248"],"title":"Arms and influence","dewey_decimal_class":["355.0335"],"notes":{"type":"/type/text","value":"Bibliographical footnotes.\n\"Written under the auspices of the Center for International Affairs, Harvard University.\"\n\"Delivered in part as the Henry L. Stimson lectures, Yale University.\""},"number_of_pages":293,"languages":[{"key":"/languages/eng"}],"lccn":["66015744"],"subjects":["Military policy","World politics"],"publish_date":"1966","publish_country":"ctu","by_statement":"by Thomas C. Schelling.","works":[{"key":"/works/OL2259854W"}],"type":{"key":"/type/edition"},"oclc_numbers":["567721"],"description":{"type":"/type/text","value":"Traditionally, Americans have viewed war as an alternative to diplomacy, and military strategy as the science of victory. Today, however, in our world of nuclear weapons, military power is not so much exercised as threatened. It is, Mr. Schelling says, bargaining power, and the exploitation of this power, for good or evil, to preserve peace or to threaten war, is diplomacy - the diplomacy of violence. The author concentrates in this book on the way in which military capabilites - real or imagined - are used, skillfully or clumsily, as bargaining power. He sees the steps taken by the US during the Berlin and Cuban crises as not merely preparations for engagement, but as signals to an enemy, with reports from the adversary's own military intelligence as our most important diplomatic communications."},"latest_revision":12,"revision":12,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2024-08-03T16:35:54.271660"}}},"OLID:OL8207354M":{"bib_key":"OLID:OL8207354M","info_url":"http://openlibrary.org/books/OL8207354M/Arms_and_Influence.","preview":"noview","preview_url":"http://openlibrary.org/books/OL8207354M/Arms_and_Influence.","thumbnail_url":"https://covers.openlibrary.org/b/id/637121-S.jpg","details":{"identifiers":{"goodreads":["1035614"],"librarything":["226219"]},"title":"Arms and Influence.:","authors":[{"key":"/authors/OL294006A","name":"Thomas C. Schelling"}],"publish_date":"February 18, 1977","publishers":["Greenwood Press Reprint"],"covers":[637121],"physical_format":"Hardcover","subjects":["Military Science","Technology & Industrial Arts"],"edition_name":"New Ed edition","isbn_13":["9780837189802"],"languages":[{"key":"/languages/eng"}],"isbn_10":["0837189802"],"type":{"key":"/type/edition"},"first_sentence":{"type":"/type/text","value":"The usual distinction between diplomacy and force is not merely in the instruments, words or bullets, but in the relation between adversaries\u001ain the interplay of motives and the role of communication, understandings, compromise, and restraint."},"source_records":["amazon:0837189802"],"key":"/books/OL8207354M","number_of_pages":293,"works":[{"key":"/works/OL2259854W"}],"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2008-04-29T15:03:11.581851"},"last_modified":{"type":"/type/datetime","value":"2025-12-20T00:23:09.662756"}}},"OLID:OL9431185M":{"bib_key":"OLID:OL9431185M","info_url":"http://openlibrary.org/books/OL9431185M/Arms_and_Influence_(The_Henry_L._Stimson_Lectures_Series)","preview":"noview","preview_url":"https://archive.org/details/armsinfluencethe00sche","thumbnail_url":"https://covers.openlibrary.org/b/id/159271-S.jpg","details":{"publishers":["Yale University Press"],"number_of_pages":303,"weight":"10.4 ounces","covers":[159271],"physical_format":"Paperback","key":"/books/OL9431185M","authors":[{"key":"/authors/OL294006A","name":"Thomas C. Schelling"}],"ocaid":"armsinfluencethe00sche","subjects":["POLITICS & GOVERNMENT","Warfare & Defence","General","Political Science / General","Politics / Current Events","Military policy","World politics"],"edition_name":"New Ed edition","languages":[{"key":"/languages/eng"}],"first_sentence":{"type":"/type/text","value":"The usual distinction between diplomacy and force is not merely in the instruments, words or bullets, but in the relation between adversaries\u001ain the interplay of motives and the role of communication, understandings, compromise, and restraint."},"source_records":["bwb:9780300002218","idb:9780300002218"],"title":"Arms and Influence (The Henry L. Stimson Lectures Series)","identifiers":{"goodreads":["113730"],"librarything":["226219"]},"isbn_13":["9780300002218