"primary","@type":"personal","namePart":["Illich, Ivan,",{"@type":"date","#text":"1926-2002"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},{"placeTerm":{"@type":"text","#text":"London "}},{"placeTerm":{"@type":"text","#text":"New York "}}],"dateIssued":[{"@encoding":"marc","#text":"2002"},"2002, ©1970"],"issuance":"monographic","agent":{"namePart":"Marion Boyars"}},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"viii, 116 pages ; 21 cm"},"abstract":{"@type":"Summary","#text":"Schools have failed our individual needs, supporting false and misleading notions of 'progress' and development fostered by the belief that ever-increasing production, consumption and profit are proper yardsticks for measuring the quality of human life. Our universities have become recruiting centers for the personnel of the consumer society, certifying citizens for service, while at the same time disposing of those judged unfit for the competitive rat race. In this bold and provocative book, Illich suggest some radical and exciting reforms for the education system."},"tableOfContents":{"@type":"Contents","#text":"Why we must disestablish school -- Phenomenology of school -- Ritualization of progress -- Institutional spectrum -- Irrational consistencies -- Learning webs -- Rebirth of epimethean man."},"note":[{"@type":"statement of responsibility","#text":"Ivan Illich."},"\"First published in Great Britain in 1971 by Calder and Boyars Ltd.\"--Title page verso.",{"@type":"bibliography","#text":"Includes bibliographical references."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"n-us---"}},{"@authority":"lcsh","topic":"Education","geographic":"United States"},{"@authority":"lcsh","topic":"Educational sociology","geographic":"United States"},{"@authority":"fast","topic":"Education"},{"@authority":"fast","topic":"Educational sociology"},{"@authority":"fast","geographic":"United States"},{"@authority":"gtt","topic":"Informeel onderwijs"}],"classification":[{"@authority":"lcc","#text":"LA210 .I4 2002"},{"@authority":"ddc","#text":"370.1"},{"@authority":"bcl","#text":"81.90"}],"identifier":[{"@type":"isbn","#text":"0714508799"},{"@type":"isbn","#text":"9780714508795"},{"@type":"oclc","#text":"53067211"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990148866710203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000460342846","#text":"Monroe C. Gutman Library, Graduate School of Education, Harvard University"},"shelfLocator":"LA210 .I4 2002"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Gutman Education"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990148866710203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"014886671"}},"processingDate":"2026-06-05T04:11Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"GZD"},"recordCreationDate":{"@encoding":"marc","#text":"030923"},"recordChangeDate":{"@encoding":"iso8601","#text":"20170123"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990148866710203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)","languageOfCataloging":{"l