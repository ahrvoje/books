{"pagination":{"maxPageableSet":"10000","numFound":2,"query":"name=Hitchens&limit=10&title=Thomas Paine's Rights of Man","limit":10,"start":0},"items":{"mods":[{"titleInfo":{"title":"Thomas Paine's Rights of man","subTitle":"a biography"},"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":"Hitchens, Christopher","role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"fast","#text":"Criticism, interpretation, etc."},{"@authority":"fast","#text":"Early works"}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"New York"}}],"publisher":["Atlantic Monthly Press","Distributed by Publishers Group West"],"dateIssued":["c2006",{"@encoding":"marc","#text":"2006"}],"edition":"1st. American ed.","issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"158 p. ; 21 cm."},"abstract":{"@type":"Summary","#text":"Thomas Paine was one of the greatest advocates of freedom in history, and his Declaration of the Rights of Man, first published in 1791, is the key to his reputation. Inspired by his outrage at Edmund Burke's attack on the French Revolution, Paine's text is a passionate defense of man's inalienable rights. Since its publication, Rights of Man has been celebrated, criticized, maligned, suppressed, and co-opted. But here, polemicist and commentator Christopher Hitchens marvels at its forethought and revels in its contentiousness. Hitchens, a political descendant of the great pamphleteer, demonstrates how Paine's book forms the philosophical cornerstone of the United States, and how, \"in a time when both rights and reason are under attack,\" Thomas Paine's life and writing \"will always be part of the arsenal on which we shall need to depend.\" (New Statesman)--From publisher description."},"tableOfContents":"Paine in America -- Paine in Europe -- Rights of man, part one -- Rights of man, part two -- The age of reason -- Conclusion : Paine's legacy.","note":[{"@type":"statement of responsibility","#text":"Christopher Hitchens."},"Originally published: London : Atlantic Books, 2006.",{"@type":"bibliography","#text":"Includes bibliographical references (p. [143]-146) and index."}],"subject":{"@authority":"lcsh","name":{"@type":"personal","namePart":["Paine, Thomas",{"@type":"date","#text":"1737-1809"}]},"titleInfo":{"title":"Rights of man"}},"classification":[{"@authority":"lcc","#text":"JC177.H5 H58 2006"},{"@edition":"22","@authority":"ddc","#text":"323.5"}],"relatedItem":[{"titleInfo":{"title":"Books that changed the world"}},{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":{"title":"Thomas Paine's Rights of man"},"name":{"namePart":"Hitchens, Christopher."},"originInfo":{"publisher":"New York : Atlantic Monthly Press ; [Berkeley, Calif.] : Distributed by Publishers Group West, ©2006","edition":"1st American ed."},"identifier":{"@type":"local","#text":"(OCoLC)607848804"}},{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":{"title":"Thomas Paine's Rights of man"},"name":{"namePart":"Hitchens, Christopher."},"originInfo":{"publisher":"New York : Atlantic Monthly Press ; [Berkeley, Calif.] : Distributed by Publishers Group West, ©2006","edition":"1st American ed."},"identifier":{"@type":"local","#text":"(OCoLC)608552417"}},{"@type":"series","titleInfo":{"title":"Books that changed the world (New York, N.Y.)"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990109106420203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0871139553 (hbk