repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"BR 2253.31.277"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":["Kirkland","Lamont","Widener"]},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990001227170203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"000122717"}},"processingDate":"2026-09-20T04:31Z"}},{"sets":null}],"recordInfo":{"recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"731030"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020917"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990001227170203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"titleInfo":{"title":"Winston Churchill, the wilderness years"},"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":["Gilbert, Martin",{"@type":"date","#text":"1936-2015"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"marcgt","#text":"biography"},{"@authority":"fast","#text":"Biographies"}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},{"placeTerm":{"@type":"text","#text":"London"}}],"publisher":"Macmillan London","dateIssued":"1981","issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"279 p. : ill. ; 24 cm."},"abstract":{"@type":"Summary","#text":"In 1928, Winston Churchill seemed to be at the very height of his career. He was Chancellor of the Exchequer and when he spoke in the House of Commons, MPs of every party flocked to hear his oratory. The leadership of the all-powerful Conservative party seemed within his grasp. A year later, however, all had changed. The Conservatives themselves were defeated, and out of office, Churchill found himself at odds with the leadership, especially over the future of India. When the National Government was formed in 1931, Churchill was not asked to join it. Thereafter, though out on his own, Churchill's acute political sense, foresight and courage were undiminished. Fed with secret inside information by a small, brave band of men - some of them risking their careers to help him - Churchill consistently warned of the Nazi danger, even before the rise of Hitler. And once Hitler came to power, he stepped up his attacks on Britain's failure to rearm. His message was belittled by the Government, which fought him at every turn, even refusing him the right to broadcast. But Churchill never gave up. Despite all the Government's efforts, and as a result of Churchill's courage and perseverance, the British public came to realize the truth of his warnings; the bond was formed that was to be so vital in the years that followed, when Britain and Churchill stood together, but alone. -- Amazon"},"tableOfContents":"Prelude: The pinnacle of success -- 1. Political strife -- 2. 'These anxious and dubious times' -- 3. 'If we lose faith in ourselves...' -- 4. 'Stoats and weasels' -- 5. 'Leaderless confusion' -- 6. Appeasement: 'This long retreat' -- 7. Munich: 'The sacrifice of honor' -- 8. The coming of war","note":[{"@type":"statement of responsibility","#text":"Martin Gilbert."},"Includes index.",{"@type":"bibliography","#text":"Bibliography: p. 269-271."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"e-uk---"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Churchill, Winston",{"@type":"date","#text":"1874-1965"}]}},{"@authority":"fast","temporal":"1910-1945"}