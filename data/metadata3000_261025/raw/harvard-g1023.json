o":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},"dateIssued":{"@encoding":"marc","#text":"2014"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"London :"}},"agent":{"namePart":"Tate Publishing,","role":{"roleTerm":"publisher"}},"dateIssued":"2014."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"160 pages : illustrations (chiefly color), ports. ; 27 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Illustrative content","#text":"portrait"}},{"form":{"@type":"Color content","#text":"polychrome"}}],"abstract":{"@type":"Summary","#text":"Art historian, collector, museum director and broadcaster, Kenneth Clark was one of the leading cultural figures in Britain in the midtwentieth century. Accompanying a major exhibition, this book considers all aspects of his life and work, including his television career that climaxed in the landmark series 'Civilisation'. Particular emphasis is placed on Clark's support of, and influence upon, the art of his time. As director of the National Gallery he oversaw the relocation of the collection during the Second World War. He chaired the pioneering War Artists Advisory Committee, and persauded the government not to conscript artists - Henry Moore was one such artist who greatly benefited from Clark's support. After the war he resigned his directorship to concentrate on writing, in 1954 was co-founder of the broadcasting company that was to become ITV, and chaired the Arts Council from 1955 to 1960. A passionate advocate of art being made accessible to all, in 1969 Clark wrote and presented 'Civilisation' for the BBC, distilling the history of Western philosophy, culture and art into thirteen groundbreaking episodes. After a period of neglect, there is now considerable interest in Clark among academics, publishers and broadcasters. As well as providing new research and information on Clark, the book is a significant intervention into histories of modern British art."},"tableOfContents":{"@type":"Contents","#text":"Director's foreword / Penelope Curtis -- Introduction / Chris Stephens and John-Paul Stonard -- 1. Looking for civilisation / John-Paul Stonard -- 2. Selected works from the collection of Kenneth Clark / Chris Stephens and John-Paul Stonard -- 3. Patron and collector / Chris Stephens -- 4. Second World War / David Alan Mellor -- 5. Saltwood / Peter T.J. Rumley -- 6. Television / John Wyver."},"note":[{"@type":"statement of responsibility","#text":"[edited by] Chris Stephens and John-Paul Stonard ; with David Alan Mellor, Peter T.J. Rumley and John Wyver."},"Published to accompany an exhibition held at Tate Britain, London, 19 May-10 August 2014.",{"@type":"bibliography","#text":"Includes bibliographical references (pages 138-140) and index."},{"@type":"bibliography","#text":"Includes filmography (pages 141-143)."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"e-uk-en"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Clark, Kenneth,",{"@type":"date","#text":"1903-1983"}]},"genre":"Exhibitions"},{"@authority":"lcsh","topic":["Art criticism","History"],"geographic":"England","temporal":"20th century","genre":"Exhibitions"},{"@authority":"lcsh","topic":"Art historians","geographic":"England","genre":"Biography"},{"@authority":"lcsh","topic":"Museum directors","geographic":"England","genre":"Biography"},{"name":{"@type":"personal","namePart":[{"@type":"termsOfAddress","#text":"Baron Clark"},"Clark, Kenneth McKenzie,",{"@type":"date","#text":"1903-1983"}]}},{"@authority"