hority":"marcorg","#text":"TEFOD"},"recordCreationDate":{"@encoding":"marc","#text":"140611"},"recordChangeDate":{"@encoding":"iso8601","#text":"20201021"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99155839466403941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"@version":"3.8","titleInfo":{"title":"Napoleon ","subTitle":"a concise biography "},"name":{"@usage":"primary","@type":"personal","namePart":"Bell, David A. (David Avrom)","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"marcgt","#text":"biography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"fast","#text":"Biographies"},{"@authority":"fast","#text":"History"},{"@authority":"fast","#text":"Biographies"},{"@authority":"fast","#text":"History."},{"@authority":"gsafd","#text":"Biographies."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},"dateIssued":{"@encoding":"marc","#text":"2015"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"New York, NY :"}},"agent":{"namePart":"Oxford University Press,","role":{"roleTerm":"publisher"}},"dateIssued":[2015]}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"x, 139 pages ; 22 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Illustrative content","#text":"map"}}],"abstract":{"@type":"Summary","#text":"Napoleon Bonaparte's astounding life and military genius have captured imaginations for two centuries. Now award-winning historian David A. Bell provides a succinct and elegant portrait, offering an original and lively account of Napoleon's dazzling career and firmly situating him in the historical context of revolutionary France. Bell emphasizes the astonishing sense of human possibility - for both good and ill - that Napoleon represented. By his late twenties, he was already one of the greatest generals in European history. At thirty, he had become absolute master of Europe's most powerful country. In his early forties, he ruled a European empire mightier than any since Rome, fighting wars that changed the shape of the continent. But his fall was epic as well, leading him to spend his last years in miserable exile in the South Atlantic."},"tableOfContents":{"@type":"Contents","#text":"The Corsican, 1769-1796 -- The general, 1796-1799 -- The First Consul, 1799-1804 -- The emperor, 1804-1812 -- Downfall, 1812-1815 -- Epilogue: 1815-2015."},"note":[{"@type":"statement of responsibility","#text":"David A. Bell."},{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"e-fr---"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":[{"@type":"termsOfAddress","#text":"I"},{"@type":"termsOfAddress","#text":"Emperor of the French"},"Napoleon",{"@type":"date","#text":"1769-1821"}]}},{"@authority":"lcsh","topic":"Emperors","geographic":"France","genre":"Biography"},{"@authority":"lcsh","geographic":"France","topic":"History","temporal":"1789-1815"},{"@authority":"fast","name":{"@type":"personal","namePart":[{"@type":"termsOfAddress","#text":"I"},{"@type":"termsOfAddress","#text":"Emperor of the French"},"Napoleon",{"@type":"date","#text":"1769-1821"}]}},{"@authority":"fast","@href":"(OCoLC)fst00908898","topic":"Emperors"},{"@authority":"fast","@href":"(OCoLC)fst01204289","geographic":"France"},{"@authority":"fast","temporal":"1789 - 1815"}],"classification":[{"@authority":"lcc","#text":"DC203 .B44 2015"},{"@edition":"23","@authority":"ddc","#text":"944.05092 B"}],"identifier":[{"@type":"isbn","#text":"9780190262716"},{"@type":"isbn","#text":"0190262710"},{"@type":"lccn","#text":"^^2015010173"},{"@type":"oclc","#text":"905600286"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990145446470203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"DC203 .B44 2015"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990145446470203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"014544647"}},"processingDate":"2026-08-06T04:26Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"150323"},"recordChangeDate":{"@encoding":"iso8601","#text":"20151201"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990145446470203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"titleInfo":[{"nonSort":{"@space":"preserve","#text":"The  "},"title":"Man Who Thought He Was Napoleon","subTitle":"Toward a Political History of Madness"},{"@type":"uniform","@nameTitleGroup":"1","title":"Homme qui se prenait pour Napoléon. English"}],"name":[{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":"Murat, Laure","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author."}},{"roleTerm":{"@type":"code","@authority":"marcrelator","#text":"aut"}},{"roleTerm":{"@type":"code","@authority":"marcrelator","#text":"http://id.loc.gov/vocabulary/relators/aut"}}]},{"@type":"personal","namePart":"Bell, David A."},{"@type":"personal","namePart":"Dusinberre, Deke"}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"dictionary"},{"@authority":"marcgt","#text":"government publication"},"text"],"originInfo":[{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"ilu"},{"@type":"text","@authority":"marccountry","#text":"Illinois"}]},{"placeTerm":{"@type":"code","@authority":"iso3166","#text":"US-IL"}}],"dateIssued":{"@encoding":"marc","#text":"2014"},"copyrightDate":{"@encoding":"marc","#text":"2014"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Chicago :"}},"publisher":"University of Chicago Press,","dateIssued":[2014]}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marccategory","#text":"electronic resource"},{"@authority":"marcsmd","#text":"remote"},{"@type":"media","@authority":"","#text":"computer"},{"@type":"carrier","@authority":"","#text":"online resource"}],"extent":"1 online resource (305 p.)"},"abstract":{"@type":"Summary","#text":"The Man Who Thought He Was Napoleon is built around a bizarre historical event and an off-hand challenge. The event? In December 1840, nearly twenty years after his death, the remains of Napoleon were returned to Paris for burial-and the next day, the director of a Paris hospital for the insane admitted fourteen men who claimed to be Napoleon. The challenge, meanwhile, is the claim by great French psychiatrist Jean-Étienne-Dominique Esquirol (1772-1840) that he could recount the history of France through asylum registries. From those two components, Laure Murat embarks on an exploration of the surprising relationship between history and madness. She uncovers countless stories of patients whose delusions seem to be rooted in the historical or political traumas of their time, like the watchmaker who believed he lived with a new head, his original having been removed at the guillotine. In the troubled wake of the Revolution, meanwhile, French physicians diagnosed a number of mental illnesses tied to current events, from \"revolutionary neuroses\" and \"democratic disease\" to the \"ambitious monomania\" of the Restoration. How, Murat asks, do history and psychiatry, the nation and the individual psyche, interface? A fascinating history of psychiatry-but of a wholly new sort-The Man Who Thought He Was Napoleon offers the first sustained analysis of the intertwined discourses of madness, psychiatry, history, and political theory."},"tableOfContents":"Frontmatter -- Contents -- Foreword -- Translator's Preface -- Preamble -- One. Revolutionary Terror, or Losing Head and Mind -- Two. Asylum or Political Prison? -- Three. The Man Who Thought He Was Napoleon -- Four. Morbus Democraticus -- Five. Reason in Revolt -- Postamble -- Acknowledgments -- Notes -- Selected Bibliography -- Index","targetAudience":{"@authority":"marctarget","#text":"specialized"},"note":[{"@type":"statement of responsibility","#text":"Laure Murat."},"Description based upon print version of record.",{"@type":"bibliography","#text":"Includes bibliographical references and index."},{"@type":"language","#text":"English"}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"e-fr---"}},{"@authority":"lcsh","topic":["Projective identification","History"],"geographic":"France"},{"@authority":"lcsh","topic":["Mentally ill","History"],"geographic":"France"},{"@authority":"lcsh","topic":["Mental illness","History"],"geographic":"France"}],"classification":[{"@authority":"lcc","#text":"RC455.4.P76 M8713 2014eb"},{"@edition":"23","@authority":"ddc","#text":"616.8900944"}],"relatedItem":[null,null,null,null,{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99153638437303941/catalog"}}],"identifier":[{"@type":"isbn","#text":"9780226025872"},{"@type":"isbn","#text":"022602587X"},{"@type":"doi","#text":"10.7208/9780226025872"},{"@type":"oclc","#text":"887802558"}],"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99153638437303941","processingDate":"2025-04-15T05:14Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"DE-B1597"},"recordCreationDate":{"@encoding":"marc","#text":"200424"},"recordChangeDate":{"@encoding":"iso8601","#text":"20240221"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99153638437303941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"@version":"3.8","titleInfo":[{"nonSort":{"@space":"preserve","#text":"The  "},"title":"man who thought he was Napoleon ","subTitle":"toward a political history of madness "},{"@type":"uniform","@nameTitleGroup":"1","title":"Homme qui se prenait pour Napoléon. English"},{"@type":"uniform","title":"University press scholarship online"}],"name":[{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":"Murat, Laure","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},{"@type":"personal","namePart":"Dusinberre, Deke","role":{"roleTerm":{"@type":"text","#text":"translator"}}},{"@type":"personal","namePart":"Bell, David A. (David Avrom)","role":{"roleTerm":{"@type":"text","#text":"writer of preface"}}}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"fast","#text":"History"},{"@authority":"fast","#text":"History."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"ilu"},{"@type":"text","@authority":"marccountry","#text":"Illinois"}]},"dateIssued":{"@encoding":"marc","#text":"2014"},"copyrightDate":{"@encoding":"marc","#text":"2014"},"issuance":"monographic"},{"@eventType":"publication","place":[{"placeTerm":{"@type":"text","#text":"Chicago ;"}},{"placeTerm":{"@type":"text","#text":"London :"}}],"agent":[{"namePart":"University of Chicago Press,","role":{"roleTerm":"publisher"}},{"namePart":"University of Chicago Press,","role":{"roleTerm":"publisher"}}],"dateIssued":"2014."}],"language":[{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},{"@objectPart":"translation","languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"fre"}}],"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xiii, 288 pages : illustrations ; 24 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Illustrative content","#text":"portrait"}}],"abstract":{"@type":"Summary","#text":"\"The Man Who Thought He Was Napoleon is built around a bizarre historical event and an off-hand challenge. The event? In December 1840, nearly twenty years after his death, the remains of Napoleon were returned to Paris for burial--and the next day, the director of a Paris hospital for the insane admitted fourteen men who claimed to be Napoleon. The challenge, meanwhile, is the claim by great French psychiatrist Jean-Étienne-Dominique Esquirol (1772-1840) that he could recount the history of France through asylum registries. From those two components, Laure Murat embarks on an exploration of the surprising relationship between history and madness. She uncovers countless stories of patients whose delusions seem to be rooted in the historical or political traumas of their time, like the watchmaker who believed he lived with a new head, his original having been removed at the guillotine. In the troubled wake of the Revolution, meanwhile, French physicians diagnosed a number of mental illnesses tied to current events, from \"revolutionary neuroses\" and \"democratic disease\" to the \"ambitious monomania\" of the Restoration. How, Murat asks, do history and psychiatry, the nation and the individual psyche, interface?\" -- Publisher's description."},"tableOfContents":{"@type":"Contents","#text":"Revolutionary terror, or losing head and mind -- Asylum or political prison? -- The man who thought he was Napoleon -- Morbus democraticus -- Reason in revolt."},"note":[{"@type":"statement of responsibility","#text":"Laure Murat ; translated by Deke Dusinberre ; with a foreword by David A. Bell."},"\"Originally published as L'homme que se prenait pour Napoléon : pour une histoire politique de la folie. © Copyright Éditions Gallimard, 2011\"--Title page verso.",{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"e-fr---"}},{"@authority":"mesh","topic":["Mentally Ill Persons","history"]},{"@authority":"mesh","topic":"Identification, Psychological"},{"@authority":"mesh","topic":"Projection"},{"@authority":"mesh","topic":["Mental Disorders","history"]},{"@authority":"mesh","geographic":"France"},{"@authority":"mesh","topic":"Mentally Ill Persons"},{"@authority":"mesh","topic":"Mental Disorders"},{"@authority":"mesh","topic":"Identification, Psychological"},{"@authority":"lcsh","topic":["Mental illness","History"],"geographic":"France"},{"@authority":"lcsh","topic":["Mentally ill","History"],"geographic":"France"},{"@authority":"lcsh","topic":["Projective identification","History"],"geographic":"France"},{"@authority":"lcsh","geographic":"France"},{"@authority":"fast","@href":"(OCoLC)fst01016547","topic":"Mental illness"},{"@authority":"fast","@href":"(OCoLC)fst01016699","topic":"Mentally ill"},{"@authority":"fast","@href":"(OCoLC)fst01078838","topic":"Projective identification"},{"@authority":"fast","@href":"(OCoLC)fst01204289","geographic":"France"},{"@authority":"mesh","topic":"Projection"},{"@authority":"mesh","geographic":"France"}],"classification":[{"@authority":"lcc","#text":"RC455.4.P76 M8713 2014"},{"@authority":"nlm","#text":"WM 11.GF7 M972m 2014"},{"@edition":"23","@authority":"ddc","#text":"616.8900944"}],"relatedItem":[{"@type":"otherFormat","@otherType":"Ebook version","@displayLabel":"Ebook version","identifier":{"@type":"isbn","#text":"9780226025872"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990142121810203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"9780226025735 (cloth : alkaline paper)"},{"@type":"isbn","#text":"022602573X (cloth : alkaline paper)"},{"@type":"isbn","@invalid":"yes","#text":"9780226025872 (e-book)"},{"@type":"lccn","#text":"^^2014006514"},{"@type":"oclc","#text":"869589032"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"RC455.4.P76 M8713 2014"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990142121810203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"014212181"}},"processingDate":"2026-08-29T04:19Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"ICU/DLC"},"recordCreationDate":{"@encoding":"marc","#text":"140219"},"recordChangeDate":{"@encoding":"iso8601","#text":"20160629"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990142121810203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"@version":"3.8","titleInfo":{"title":"Napoleon","subTitle":"A Very Short Introduction"},"name":{"@usage":"primary","@type":"personal","namePart":"Bell, D. A. (David A.),","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}},{"roleTerm":{"@type":"code","@authority":"marcrelator","#text":"aut"}}]},"typeOfResource":"text","genre":{"@authority":"marcgt","#text":"government publication"},"originInfo":[{"place":{"placeTerm":{"@type":"code","@authority":"marccountry","#text":"uuu"}},"dateIssued":[{"@encoding":"marc","@point":"start","#text":"2018"},{"@encoding":"marc","@point":"end","#text":"uuuu"}],"issuance":"monographic"},{"@eventType":"publication","agent":{"namePart":"Oxford University Press","role":{"roleTerm":"publisher"}},"dateIssued":"2018"}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marccategory","#text":"electronic resource"},{"@authority":"marcsmd","#text":"remote"}],"extent":"1 online resource (148 pages)"},"abstract":{"@type":"Summary","#text":"This Very Short Introduction might prove disappointing to those expecting an introduction to a very short man. Dispelling the myth of Napoleon Bonaparte's short stature, as well as the other rumors and legends, David A. Bell provides a concise, accurate, and lively portrait of Napoleon Bonaparte's character and career, situating him firmly in historical context. This book emphasizes the astonishing sense of human possibility--for both good and ill--that Napoleon represented. By his late twenties, Napoleon was already one of the greatest generals in European history. At thirty, he had become absolute master of Europe's most powerful country. In his early forties, he ruled a European empire more powerful than any since Rome, fighting wars that changed the shape of the continent and brought death to millions. Then everything collapsed, leading him to spend his last years in miserable exile in the South Atlantic. Bell underscores the importance of the French Revolution in understanding Napoleon's career. The revolution made possible the unprecedented concentration of political authority that Napoleon accrued, and his success in mobilizing human and material resources for war. Without the political changes brought about by the revolution, Napoleon could not have fought his wars. Without the wars, he could not have seized and held onto power. Though his virtual dictatorship betrayed the ideals of liberty and equality, his life and career were revolutionary."},"tableOfContents":{"@type":"Contents","#text":"Halftitle page Series page List of illustrations Introduction Chapter 1: The Corsican, 1769-1796 Chapter 2: The general, 1796-1799 Chapter 3: The First Consul, 1799-1804 Chapter 4: The emperor, 1804-1812 Chapter 5: Downfall, 1812-1815 Epilogue: 1815-the present Further reading"},"note":{"@type":"statement of responsibility","#text":"David A. Bell."},"subject":[{"@authority":"lcsh","name":{"@type":"personal","namePart":[{"@type":"termsOfAddress","#text":"I"},{"@type":"termsOfAddress","#text":"Emperor of the French"},"Napoleon",{"@type":"date","#text":"1769-1821"}]}},{"@authority":"lcsh","topic":"Emperors","geographic":"France","genre":"Biography"},{"@authority":"bisacsh","topic":"HISTORY / General"},{"@authority":"bisacsh","topic":"HISTORY / Europe / France"},{"@authority":"bisacsh","topic":"HISTORY / Modern / 18th Century"},{"@authority":"lcsh","geographic":"France","topic":"History","temporal":"1789-1815"}],"classification":[{"@authority":"lcc","#text":"DC203"},{"@authority":"ddc","#text":"944.05092"},{"