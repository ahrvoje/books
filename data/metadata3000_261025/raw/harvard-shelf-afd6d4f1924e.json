{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Fiennes&limit=10&title=Mad, Bad and Dangerous to Know","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":[{"title":"Mad, bad & dangerous to know "},{"@type":"alternative","title":"Mad, bad and dangerous to know"}],"name":[{"@usage":"primary","@type":"personal","namePart":["Fiennes, Ranulph,",{"@type":"termsOfAddress","#text":"Sir,"},{"@type":"date","#text":"1944-"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}],"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJtX6GKyXB6bX9YBGwyw4q"},{"@type":"personal","namePart":"Grylls, Bear","role":{"roleTerm":{"@type":"text","#text":"author of introduction, etc"}}}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"biography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"rdacontent","#text":"still image"},{"@authority":"rdacontent","#text":"cartographic image"},{"@authority":"Medical Subject Headings","#text":"Autobiography"},{"@authority":"Medical Subject Headings","#text":"Biography"},{"@authority":"fast","#text":"Autobiographies"},{"@authority":"fast","#text":"Biographies"},{"@authority":"lcgft","#text":"Autobiographies"},{"@authority":"lcgft","#text":"Biographies"},{"@authority":"rvmgf","#text":"Autobiographies."},{"@authority":"rvmgf","#text":"Biographies."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},"dateIssued":{"@encoding":"marc","#text":"2019"},"copyrightDate":{"@encoding":"marc","#text":"2007"},"issuance":"monographic","edition":"Updated and revised edition."},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"London :"}},"agent":{"namePart":"Hodder & Stoughton,","role":{"roleTerm":"publisher"}},"dateIssued":"2019."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xiv, 445 pages, 16 unnumbered pages of plates : illustrations, genealogical table, maps ; 24 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Illustrative content","#text":"map"}},{"form":{"@type":"Illustrative content","#text":"genealogical table"}}],"abstract":{"@type":"Summary","#text":"Sir Ranulph Fiennes has travelled to the most dangerous and inaccessible places on Earth, almost died countless times, lost nearly half his fingers to frostbite, raised millions of pounds for charity and been awarded a polar medal and an OBE. He has been an elite soldier, an athlete, a mountaineer, an explorer, a bestselling author and nearly replaced Sean Connery as James Bond. In his bestselling autobiography, Mad, Bad & Dangerous to Know, he describes how he led expeditions all over the world and became the first person to travel to both Poles on land. He tells of how he discovered the lost city of Ubar in Oman and attempted to walk solo and unsupported to the North Pole - the expedition that cost him several fingers, and very nearly his life. And now the extraordinary life story of the world's greatest living explorer is re-published to celebrate his 75th birthday, with two new chapters to bring his story up to date - telling of more mountains climbed, including his ascent to the top of Mount Everest, and even more extraordinary and risky adventures."},"tableOfContents":{"@type":"Contents","#text":"1. At First -- 2. Young Love and the SAS -- 3. Fighting for the Arabs -- 4. The Fastest River -- 5. Ginny's Idea -- 6. The Bottom of the World -- 7. Full Circle -- 8. Hammer and Sickle -- 9. The Frankincense Trail -- 10. The Longest Track -- 11. How Not to Get Old? -- 12. Solo South -- 13. Sorry Straits -- 14. Falling Through -- 15. Amputations -- 16. Heart Attack -- 17. Ginny -- 18. Almost -- 19. Vertigo -- 20. Murder Wall -- 21. The coldest journey -- 22. The Global Reach Challenge."},"targetAudience":{"@authority":"marctarget","#text":"adult"},"note":[{"@type":"statement of responsibility","#text":"Ranulph Fiennes ; [foreword by Bear Grylls]."},"\"Updated and revised to celebrate the author's 75th year\"--Cover","Originally published: 2007."],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"e-uk---"}},{"@authority":"lcsh","topic":"Explorers","geographic":"Great Britain","genre":"Biography"},{"@authority":"lcsh","topic":"Voyages and travels"},{"@authority":"rvm","topic":"Voyages"},{"@authority":"aat","topic":"journeys"},{"@authority":"fast","@href":"(OCoLC)fst00918556","topic":"Explorers"},{"@authority":"fast","@href":"(OCoLC)fst01155558","topic":"Travel"},{"@authority":"fast","@href":"(OCoLC)fst01169308","topic":"Voyages and travels"},{"@authority":"fast","@href":"(OCoLC)fst01204623","geographic":"Great Britain"},{"@authority":"lcsh","name":{"@type":"personal","namePart":[{"@type":"termsOfAddress","#text":"Sir"},"Fiennes, Ranulph,",{"@type":"date","#text":"1944-"}]}},{"@authority":"lcsh","name":{"@type":"personal","namePart":[{"@type":"termsOfAddress","#text":"Sir"},"Fiennes, Ranulph,",{"@type":"date","#text":"1944-"}]},"topic":"Travel"},{"@authority":"fast","name":{"@type":"personal","namePart":[{"@type":"termsOfAddress","#text":"Sir"},"Fiennes, Ranulph,",{"@type":"date","#text":"1944-"}],"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJtX6GKyXB6bX9YBGwyw4q"}}],"classification":[{"@authority":"lcc","#text":"G246.F54 A3 2019"},{"@edition":"23","@authority":"ddc","#text":"910.92"}],"identifier":[{"@type":"isbn","#text":"9781473692572"},{"@type":"isbn","#text":"1473692571"},{"@type":"oclc","#text":"1091998474"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/9915377375