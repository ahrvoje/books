d Three guineas : teaching the interconnection of gender oppression and endless warfare / Vara Neverow -- Active pacifism in a world at war : the legacy of Virginia Woolf's pacifist theory on narrative structure / Nancy Knowles -- The practical wisdom of the \"educated man's daughter\" : feminist rhetorical theory and Woolf's Three guineas / Kristen Garrison.","note":[{"@type":"statement of responsibility","#text":"edited by Jane M. Wood ; with an introduction by Karen Levenback."},{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"@authority":"lcsh","name":{"@type":"personal","namePart":["Woolf, Virginia",{"@type":"date","#text":"1882-1941"}]},"titleInfo":{"title":"Three guineas"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Woolf, Virginia",{"@type":"date","#text":"1882-1941"}]},"topic":"Political and social views"},{"@authority":"lcsh","topic":"War in literature"},{"@authority":"lcsh","topic":"Pacifism in literature"},{"@authority":"lcsh","topic":"Feminism in literature"},{"@authority":"lcsh","topic":"Women and war"}],"classification":[{"@authority":"lcc","#text":"PR6045.O72 Z8814 2010"},{"@edition":"22","@authority":"ddc","#text":"823/.912"}],"identifier":[{"@type":"isbn","#text":"9780773438576"},{"@type":"isbn","#text":"0773438572"},{"@type":"lccn","#text":"^^2009042342"},{"@type":"oclc","#text":"456174214"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990126115720203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"PR6045.O72 Z8814 2010"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990126115720203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH