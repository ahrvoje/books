#text":"0701202769"},{"@type":"oclc","#text":"3638468"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990037805560203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"23837.66.261"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990037805560203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"003780556"}},"processingDate":"2024-08-03T05:23Z"}},{"sets":null}],"recordInfo":{"recordContentSource":{"@authority":"marcorg","#text":"IRU"},"recordCreationDate":{"@encoding":"marc","#text":"780214"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990037805560203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}},{"titleInfo":{"title":"Thinking fascism","subTitle":"sapphic modernism and fascist modernity"},"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":["Carlston, Erin G.",{"@type":"date","#text":"1962-"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"fast","#text":"Criticism, interpretation, etc."},{"@authority":"fast","#text":"History"}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"cau"},{"@type":"text","@authority":"marccountry","#text":"California"}]},{"placeTerm":{"@type":"text","#text":"Stanford, Calif"}}],"publisher":"Stanford University Press","dateIssued":"1998","issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"viii, 217 p. ; 23 cm."},"abstract":{"@type":"Summary","#text":"Thinking Fascism analyzes three works by women writers - Djuna Barnes's Nightwood (1936), Marguerite Yourcenar's Denier du reve (1934), and Virginia Woolf's Three Guineas (1938) - that engage, directly or indirectly, with fascist politics and ideology. Through these analyses, the author explores the conjunction between fascism and other forms of modernity, and refines the discussion about the relationship between women intellectuals and the various aesthetic and ideological practices collected under the names of modernism and facism. By demonstrating that women writers like the Sapphic Modernists and conservative or fascist male modernists often articulated very similar conceptions of these problems, this book suggests that fascism cannot be posed as the absolute other of non- or even anti-fascist politico cultural discourses in the interwar period."},"tableOfContents":"1. Women Writers / Thinking / Fascism -- 2. Political Bodies -- 3. \"The Learned Corruption of Language\": Nightwood's Failed Flirtation with Fascism -- 4. Neither Right nor Left: Marguerite Yourcenar and the Crisis of Liberalism -- 5. Another Country: Virginia Woolf's Disloyalty to Civilization -- Coda: Back to the Future.","note":[{"@type":"statement of responsibility","#text":"Erin G. Carlston."},{"@type":"bibliography","#text":"Includes bibliographical references (p. 195-207) and index."}],"subject":[{"@authority":"lcsh","name":{"@type":"personal","namePart":"Barnes, Djuna"},"titleInfo":{"title":"Nightwood"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":"Yourcenar, Marguerite"},"titleInfo":{"title":"Denier du rêve"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Woolf, Virginia",{"@type":"date","#text":"1882-1941"}]},"titleInfo":{"title":"Three guineas"}},{"@authority":"fast","temporal":"1900-1999"},{"@authority":"lcsh","topic":["Fiction","Women authors","History and criticism"]},{"@authority":"lcsh","topic":["Fiction","History and criticism"],"temporal":"20th century"},{"@authority":"lcsh","topic":"Fascism and literature"},{"@authority":"lcsh","topic":"Feminism and literature"},{"@authority":"lcsh","topic":"Modernism (Literature)"}],"classification":[{"@authority":"lcc","#text":"PN3401 .C37 1998"},{"@edition":"21","@authority":"ddc","#text":"809.3/9358"}],"identifier":[{"@type":"isbn","#text":"0804730881 (cloth : alk. paper)"},{"@type":"lccn","#text":"^^^97028947^//r98"},{"@type":"oclc","#text":"37397894"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990077010600203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000109426663","#text":"Arthur and Elizabeth Schlesinger Library on the History of Women in America, Radcliffe Institute for Advanced Study, Harvard University"},"shelfLocator":"809.3935 C284t"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"PN3401 .C37 1998"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":["Schlesinger","Widener"]},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990077010600203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"007701060"}},"processingDate":"2024-04-18T05:16Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"970722"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990077010600203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}},{"@version":"3.8","titleInfo":[{"title":"Three guineas "},{"@type":"alternative","title":"3 guineas"}],"name":[{"@usage":"primary","@type":"personal","namePart":["Woolf, Virginia,",{"@type":"date","#text":"1882-1941"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},{"@type":"personal","namePart":["Marcus, Jane,",{"@type":"date","#text":"1938-2015"}]},{"@type":"personal","namePart":["Hussey, Mark,",{"@type":"date","#text":"1956-"}]}],"typeOfResource":"text","genre":{"@authority":"marcgt","#text":"bibliography"},"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"flu"},{"@type":"text","@authority":"marccountry","#text":"Florida"}]},{"placeTerm":{"@type":"text","#text":"Orlando "}}],"dateIssued":[{"@encoding":"marc","#text":"2006"},"c2006"],"issuance":"monographic","agent":{"namePart":"Harcourt, Inc."},"edition":"Annotated ed., 1st ed."},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":{"@authority":"marcform","#text":"print"},"extent":"lxxii, 275 p. : ill. ; 21 cm."},{"form":{"@type":"Illustrative content","#text":"illustration"}}],"abstract":{"@type":"Summary","#text":"Three Guineas is written as a series of letters in which Virginia Woolf ponders the efficacy of donating to various causes to prevent war. In reflecting on her situation as the \"daughter of an educated man\" in 1930s England, Woolf challenges liberal orthodoxies and marshals vast research to make discomforting and still-challenging arguments about the relationship between gender and violence, and about the pieties of those who fail to see their complicity in war-making. This pacifist-feminist essay is a classic whose message resonates loudly in our contemporary global situation."},"note":[{"@type":"statement of responsibility","#text":"Virginia Woolf ; annotated and with an introduction by Jane Marcus ; Mark Hussey, general editor."},{"@type":"bibliography","#text":"Includes bibliographical references."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"e-uk-en"}},{"@authority":"lcsh","topic":["War","Prevention"]},{"@authority":"lcsh","topic":["Women","Social conditions"],"geographic":"England"}],"classification":[{"@authority":"lcc","#text":"PR6045.O72 T5 2006"},{"@edition":"22","@authority":"ddc","#text":"823/.912"}],"relatedItem":[{"titleInfo":{"title":"A Harvest book"}},{"@type":"series","titleInfo":{"title":"Harvest book"}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990101034510203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0156031639 (pbk.)"},{"@type":"isbn","#text":"9780156031639"},{"@type":"lccn","#text":"^^2006006360"},{"@type":"oclc","#text":"64453345"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000463633307","#text":"Lamont Library, Harvard University"},"shelfLocator":"PR6045.O72 T5 2006"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"PR6045.O72 T5 2006"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":["Lamont","Widener"]},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990101034510203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"010103451"}},"processingDate":"2026-08-08T04:16Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"060228"},"recordChangeDate":{"@encoding":"iso8601","#text":"20061012"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990101034510203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}},{"titleInfo":{"title":"Virginia Woolf's late cultural criticism","subTitle":"the genesis of 'the Years,' 'Three guineas' and 'Between the acts'"},"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":"Wood, Alice.","role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"fast","#text":"Criticism, interpretation, etc."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},"dateIssued":{"@encoding":"marc","#text":"2013"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"London :"}},"publisher":"Bloomsbury Academic,","dateIssued":"2013"}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xiv, 187 pages"},"abstract":{"@type":"Summary","#text":"\"After the Modernist literary experiments of her earlier work, Virginia Woolf became increasingly concerned with overt social and political commentary in her later writings, which are preoccupied with dissecting the links between patriarchy, patriotism, imperialism and war. This book unravels the complex textual histories of The Years (1937), Three Guineas (1938) and Between the Acts (1941) to expose the genesis and evolution of Virginia Woolf's late cultural criticism. Fusing a feminist-historicist approach with the practices and principles of genetic criticism, this innovative study scrutinizes a range of holograph, typescript and proof documents within their historical context to uncover the writing and thinking processes that produced Woolf's cultural analysis during 1931-1941. By demonstrating that Woolf's late cultural criticism developed through her literary experimentalism as well as in response to contemporary social, political and economic upheavals, this book offers a fresh perspective on her emergence as a cultural commentator in her final decade and paves the way for further genetic enquiries in the field.\"--pub. desc."},"tableOfContents":"Part 1. Introducing late Woolf -- British society and literature, 1931-41 -- Woolf in the 1930s and beyond -- A genetic approach to Woolf -- Part 2. Critiquing patriarchy in the years of The years -- Tracing origins: 'The turn of the tide', 1931 -- The Years: planning and writing and changing direction -- Writing a novel of fact -- Conclusion -- Part 3. The evolution of Woolf's feminist-pacifism in Three guineas -- Woolf's early pacifism and feminist contexts -- Three guineas: conception and contexts -- Three guineas: composition and pre-texts; the scrapbooks; the drafts -- The political power of indifference from The years to Three guineas -- Conclusion -- Part 4. Writing art in times of chaos in Between the acts -- The textual and contextual history of Between the acts -- Debating the role of art in times of chaos -- Art's social role in Between the acts -- Conclusion.","note":[{"@type":"statement of responsibility","#text":"Alice Wood."},{"@type":"bibliography","#text":"Includes bibliographical references (pages [169]-182) and index."}],"subject":{"@authority":"lcsh","name":{"@type":"personal","namePart":["Woolf, Virginia",{"@type":"date","#text":"1882-1941"}]},"topic":"Criticism and interpretation"},"classification":{"@authority":"lcc","#text":"PR6045.O72 Z929 2013"},"identifier":[{"@type":"isbn","#text":"144110285X"},{"@type":"isbn","#text":"9781441102850"},{"@type":"oclc","#text":"827694298"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990137676970203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"PR6045.O72 Z929 2013x"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990137676970203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"013767697"}},"processingDate":"2025-04-16T05:12Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"YDXCP"},"recordCreationDate":{"@encoding":"marc","#text":"130213"},"recordChangeDate":{"@encoding":"iso8601","#text":"20131009"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990137676970203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"@version":"3.8","titleInfo":{"title":"Three guineas"},"name":{"@usage":"primary","@type":"personal","namePart":["Woolf, Virginia,",{"@type":"date","#text":"1882-1941"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"New York"}}],"dateIssued":[{"@encoding":"marc","#text":"1938"},"[c1938]"],"issuance":"monographic","agent":{"namePart":"Harcourt, Brace and company"}},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"4 p. l., 3-285 p. plates 21 cm."},"note":["At head of title: Virginia Woolf.","In response to three requests for donations (to a peace society; to a woman's college rebuilding fund; to a society for obtaining employment for professional women) the author proposes that \"the daughters of educated men\" unite in opposition to man-made war.","\"First American edition.\""],"subject":[{"@authority":"lcsh","topic":"War"},{"@authority":"lcsh","topic":"Peace"}],"identifier":[{"@type":"lccn","#text":"^^^38027681^"},{"@type":"oclc","#text":"1304213"},{"@type":"oclc","#text":"1304213"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990011892340203941/catalog"}},"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990011892340203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"001189234"}},"processingDate":"2026-07-11T04:39Z"}},{"sets":null}],"recordInfo":{"recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"790809"},"recordChangeDate":{"@encoding":"iso8601","#text":"20260708"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990011892340203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.8 using\n\t\t\t\t\tMARC21slim_MODS3-8_XSL2-0.xsl (Revision 2.79 2025/03/28)"}}]}}