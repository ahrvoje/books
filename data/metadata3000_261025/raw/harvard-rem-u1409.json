,{"@type":"personal","namePart":"Rabin, Trevor"},{"@type":"corporate","namePart":"Miramax Home Entertainment (Firm)"},{"@type":"corporate","namePart":"Buena Vista Home Entertainment (Firm)"}],"typeOfResource":"moving image","genre":[{"@authority":"marcgt","#text":"videorecording"},{"@authority":"Library of Congress Subject Headings","#text":"Feature films"},{"@authority":"Library of Congress Subject Headings","#text":"DVD-Video discs."},{"@authority":"migfg","#text":"War-Feature."}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"cau"},{"@type":"text","@authority":"marccountry","#text":"California"}]},{"placeTerm":{"@type":"text","#text":"Burbank, CA] "}}],"dateIssued":[{"@encoding":"marc","#text":"2005"},"c2005"],"issuance":"monographic","agent":[{"namePart":"Miramax Home Entertainment "},{"namePart":"Distributed by Buena Vista Home Entertainment"}]},"language":[{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},{"@objectPart":"summary","languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"spa"}}],"physicalDescription":[{"form":{"@authority":"gmd","#text":"videorecording "},"extent":"1 videodisc (ca. 133 min.) : sd., col. ; 4 3/4 in."},{"form":{"@type":"Material base and configuration","#text":"videodisc"},"extent":"4 3/4 in."},{"form":[{"@type":"Type of recording","#text":"digital"},{"@type":"Recording medium","#text":"optical"},{"@type":"Configuration of playback channels","#text":"surround"},{"@type":"Special playback characteristics","#text":"Dolby Digital 5.1"}]}],"abstract":{"@type":"Summary","#text":"Based on the true story of American Rangers who rescue the survivors of the Bataan Death March from the Cabanatuan Prison Camp during WWII. When the Philippines fell to the Japanese, the remnants of Gen. MacArthur's Army were forced down the Bataan Penninsula where they were surrounded and cutoff with no hope of rescue. They were starving and dying of disease. Gen. Wainwright eventually surrendered and the troops were marched off to prison. Along the way thousands died or were murdered by the Japanese. They were taken to Camp O'Donnell and to Cabanatuan Prison Camps where they were starved and beaten. When MacArthur invaded the Philippines he made it a priority to rescue the remaining prisoners still alive in Japanese hands."},"targetAudience":[{"@authority":"marctarget","#text":"adult"},"MPAA rating: R; for strong war violence and brief language."],"note":[{"@type":"statement of responsibility","#text":"Miramax Films presents a Marty Katz production in association with Lawrence Bender Productions ; produced by Lawrence Bender, Marty Katz ; screenplay by Carlo Bernard & Doug Miro ; directed by John Dahl."},{"@type":"system details","#text":"DVD ; region 1 encoding ; NTSC."},{"@type":"language","#text":"Subtitles for the deaf & hard of hearing ; Dolby Digital 5.1 Surround Sound."},{"@type":"performers","#text":"Benjamin Bratt, James Franco, Connie Nielsen, Marton Csokas, Joseph Fiennes."},{"@type":"creation/production credits","#text":"Director of photography, Peter Menzies, Jr. ; art directors, Bill Booth, Michael Rumpf ; editors, Scott Chestnut, Pietro Scalia ; music, Trevor Rabin ; costume designer, Lizzy Gardiner ; production designer, Bruno Rubeo ; visual effects supervisor, Chris Godfrey."},"Based on the books \"The great raid on Cabanatuan\" by William B. Breuer and \"Ghost soldier\" by Hampton Sides."],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"a-ph---"}},{"@authority":"lcsh","topic":"Bataan Death March, Philippines, 1942","genre":"Drama"},{"@authority":"lcsh","topic":"Raids (Military science)","genre":"Drama"},{"@authority":"lcsh","topic":["World War, 1939-1945","Prisoners and prisons, Japanese"],"genre":"Drama"},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Breuer, William B.,",{"@type":"date","#text":"1922-2010"}]},"genre":"Film and video adaptat