"@source":"MH:ALMA","#text":"990017603930203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}},{"@version":"3.8","titleInfo":{"nonSort":{"@space":"preserve","#text":"The  "},"title":"machinery of freedom ","subTitle":"guide to a radical capitalism "},"name":{"@usage":"primary","@type":"personal","namePart":"Friedman, David D.","role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"New Rochelle, N.Y"}}],"dateIssued":[{"@encoding":"marc","#text":"1978"},"c1978"],"issuance":"monographic","agent":{"namePart":"Arlington House"}},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"xvi, 240 p. ; 21 cm."},"abstract":{"@type":"Summary","#text":"\"This book argues the case for a society organized by private property, individual rights, and voluntary co-operation, with little or no government. David Friedman's standpoint, known as 'anarcho-capitalism', has attracted a growing following as a desirable social ideal since the first edition of The Machinery of Freedom appeared in 1971. This new edition is thoroughly revised and includes much new material, exploring fresh applications of the author's libertarian principles.  Among topics covered: how the U.S. would benefit from unrestricted immigration; why prohibition of drugs is inconsistent with a free society; why the welfare state mainly takes from the poor to help the not-so-poor; how police protection, law courts, and new laws could all be provided privately; what life was really like under the anarchist legal system of medieval Iceland; why non-intervention is the best foreign policy; why no simple moral rules can generate acceptable social policies -- and why these policies must be derived in part from the new discipline of economic analysis of law.\" -- Amazon.com."},"note":[{"@type":"statement of responsibility","#text":"David Friedman."},"Includes index.",{"@type":"bibliography","#text":"Bibliography: pages [227]-236."}],"subject":[{"@authority":"lcsh","topic":"Liberty"},{"@authority":"lcsh","topic":"Individualism"},{"@authority":"lcsh","topic":"Property"},{"@authority":"lcsh","topic":"Free enterprise"},{"@authority":"mesh","topic":"Freedom"}],"classification":{"@authority":"lcc","#text":"JC585 .F76 1978"},"relatedItem":[{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":{"title":"Machinery of freedom"},"originInfo":{"publisher":"New Rochelle, N.Y. : Arlington House, ©1978"},"identifier":{"@type":"local","#text":"(OCoLC)551620641"},"name":{"namePart":"Friedman, David D."}},{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990007915180203941/catalog"}}],"identifier":[{"@type":"isbn","#text":"0870004204 :"},{"@type":"lccn","#text":"^^^78017441^"},{"@type":"oclc","#text":"3966204"}],"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"JC585 .F76 1978"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Widener"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990007915180203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"000791518"}},"processingDate":"2026-02-09T17:05Z"}},{"sets":null}],"recordInfo":{"recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"780517"},"recordChangeDate":{"@encoding":"iso8601","#text":"20020606"},"recordIden