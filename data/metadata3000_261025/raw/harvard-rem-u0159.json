or"}}},"typeOfResource":"text","genre":{"@authority":"marcgt","#text":"bibliography"},"originInfo":{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"xx"},{"@type":"text","@authority":"marccountry","#text":"No place, unknown, or undetermined"}]},"dateIssued":"1989","issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"71 leaves ; 29 cm."},"note":[{"@type":"statement of responsibility","#text":"Anthony S. Laden."},{"@type":"thesis","#text":"Thesis (A.B., Honors)--Harvard University, 1989."},{"@type":"bibliography","#text":"Includes bibliographical references."},"Thomas T. Hoopes Prizes--Harvard University, 1989."],"subject":[{"@authority":"lcsh","name":{"@type":"personal","namePart":["Rawls, John",{"@type":"date","#text":"1921-2002"}]},"titleInfo":{"title":"Idea of public reason revisited"}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Rawls, John",{"@type":"date","#text":"1921-2002"}]},"titleInfo":{"title":"Theory of justice"}},{"@authority":"lcsh","topic":"Game theory"},{"@authority":"lcsh","topic":"Fairness"}],"identifier":{"@type":"oclc","#text":"21941523"},"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990019541260203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000460737207","#text":"Harvard University Archives"},"shelfLocator":"HU 89.208.0420"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":"Harvard University Archives"},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990019541260203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"001954126"}},"processingDate":"2022-07-30T16:07Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg"},"recordCreationDate":{"@encoding":"marc","#text":"900629"},"recordChangeDate":{"@encoding":"iso8601","#text":"20030708"},"recordIdentifier":{"@source":"MH:ALMA","#text":"990019541260203941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)"}},{"titleInfo":{"title":"John Rawls and the history of political thought","subTitle":"the Rousseauvian and Hegelian heritage of justice as fairness"},"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":["Bercuson, Jeffrey",{"@type":"date","#text":"1982-"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author."}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},"dateIssued":{"@encoding":"marc","#text":"2014"},"copyrightDate":{"@encoding":"marc","#text":"2014"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"New York, NY :"}},"publisher":"Routledge,","dateIssued":"2014."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"150 pages ; 24 cm."},"abstract":{"@type":"Summary","#text":"\"In this book, Jeffrey Bercuson presents the immense, and yet for the most part unrecognized, influences of Jean-Jacques Rousseau and Georg Wilhelm Friedrich Hegel on John Rawls, the most important political philosopher of the 20th century. While the well-documented influence of Immanuel Kant on Rawls is deep and profound, Kantian features and interpretation of justice as fairness do not tell the whole story about that doctrine. Drawing on Rawls' Lectures on the History of Moral Philosophy and his Lectures on the History of Political Philosophy, Bercuson presents the reader with a more nuanced, accurate account of the moral and political philosophy of Rawls in light of these under-appreciated influences. This new, richer image of Rawls' political philosophy shows that Rawls' notion of reasonableness--his notion of the kind and extent of our obligations to those fellows with whom we are engaged in social cooperation--is conspicuously more demanding, and therefore more attractive, than most interpreters and critics assume. Rawls turns to Rousseau and to Hegel, both of whom provide attractive images of engaged citizenship worthy of emulation. Written accessibly, and contributing to key contemporary debates of global justice, this book will be read by scholars within the fields of social and political theory, ethics, and philosophy\"--"},"tableOfContents":"Beyond Kant -- The Hegelian Dimensions of Justice as Fairness -- The Rousseauvian Dimensions of Justice as Fairness -- Bringing Robust Reasonableness into View -- The Width of Public Reason.","note":[{"@type":"statement of responsibility","#text":"Jeffrey Bercuson."},{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"@authority":"lcsh","name":{"@type":"personal","namePart":["Rawls, John",{"@type":"date","#text":"1921-2002"}]}},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Rousseau, Jean-Jacques",{"@type":"date","#text":"1712-1778"}]},"topic":"Influence"},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Hegel, Georg Wilhelm Friedrich",{"@type":"date","#text":"1770-1831"}]},"topic":"Influence"},{"@authority":"gnd","name":{"@type":"personal","namePart":["Rawls, John",{"@type