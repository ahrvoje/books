"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":["Levi, Primo,",{"@type":"date","#text":"1919-1987"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},{"@type":"personal","namePart":"Woolf, S. J. (Stuart Joseph)"}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"biography"},{"@authority":"lcgft","#text":"Autobiographies"}],"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},{"placeTerm":{"@type":"text","#text":"New York "}}],"issuance":"monographic","agent":{"namePart":"Simon & Schuster"},"dateIssued":"1996","edition":"1st Touchstone ed."},"language":[{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},{"@objectPart":"translation","languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"ita"}}],"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"187 p. ; 21 cm."},"abstract":{"@type":"Summary","#text":"In 1943, Primo Levi, a 25-year-old chemist and \"Italian citizen of Jewish race,\" was arrested by Italian fascists and deported from his native Turin to Auschwitz. This is Levi's classic account of his ten months in the German death camp, a harrowing story of systematic cruelty and miraculous endurance. Remarkable for its simplicity, restraint, compassion, and even wit, Survival in Auschwitz remains a lasting testament to the indestructibility of the human spirit. Included in this new edition is an illuminating conversation between Philip Roth and Primo Levi never before published in book form.--From publisher description."},"tableOfContents":{"@type":"Contents","#text":"Author's preface -- Journey -- On the bottom -- Initiation -- Ka-Be -- Our nights -- Work -- Good day -- This side of good and evil -- Drowned and the saved -- Chemical examination -- Canto of Ulysses -- Events of the summer -- October 1944 -- Kraus -- Die drei Leute vom Labor -- Last one -- Story of ten days."},"note":[{"@type":"statement of responsibility","#text":"Primo Levi ; translated from the Italian by Stuart Woolf ; including \"A conversation with Primo Levi by Philip Roth\"."},"Translation of: Se questo è un uomo.","\"Originally appeared in English under the title: If this is a man\"--T.p.verso.","Originally published: New York : Collier Books ; 1993.","\"A Touchstone book.\""],"subject":[{"geographicCode":[{"@authority":"marcgac","#text":"e-pl---"},{"@authority":"marcgac","#text":"e-gx---"}]},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Levi, Primo,",{"@type":"date","#text":"1919-1987"}]}},{"@authority":"lcsh","name":{"@type":"corporate","namePart":"Auschwitz (Concentration camp)"}},{"@authority":"lcsh","topic":"World War, 1939-1945","genre":"Personal narratives, Italian"},{"@authority":"lcsh","topic":"Holocaust, Jewish (1939-1945)","geographic":"Italy","genre":"Personal narratives"},{"@authority":"lcsh","topic":["World War, 1939-1945","Prisoners and prisons, German"]},{"@authority":"lcsh","topic":"Prisoners of war","geographic":"Italy","genre":"Biography"},{"@authority":"lcsh","topic":"Prisoners of war","geographic":"Poland","genre":"Biography"},{"@authority":"fast","temporal":"1939-1945"}],"classification":[{"@authority":"lcc","#text":"D805.P7 L4413 1996"},{"@authority":"nlm","#text":"000120064"}],"relatedItem":[{"titleInfo":{"title":"Conversation with Primo Levi"},"name":{"@type":"personal","namePart":["Roth, Philip,",{"@type":"date","#text":"1933-2018"}]}},{"@type":"otherFormat","@otherType":"Online version:","@displayLabel":"Online version:","titleInfo":[{"title":"Survival in Auschwitz"},{"@type":"uniform","title":"Se questo è un uomo. English"}],"originInfo":{"edition":"First Touchstone edition"},"identifier":{"@type":"local","#text":"(OCoLC)1085904996"},"name":{"namePart":"Levi, Primo."}},{"@otherType":"HOLLIS record","location":{"url":"https://id.l