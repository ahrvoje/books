o survive and see my daughter again "},"name":[{"@usage":"primary","@type":"personal","namePart":["Winter-Levy, Rosa de,",{"@type":"date","#text":"1905-1985"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},{"@type":"personal","namePart":"Waters, Liz","role":{"roleTerm":{"@type":"text","#text":"translator"}}}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"biography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"rdacontent","#text":"still image"},{"@authority":"fast","#text":"Autobiographies"},{"@authority":"fast","#text":"Biographies"},{"@authority":"lcgft","#text":"Autobiographies"},{"@authority":"nli","#text":"Autobiographies"},{"@authority":"rvmgf","#text":"Autobiographies."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},"dateIssued":{"@encoding":"marc","#text":"2024"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"London :"}},"agent":{"namePart":"Monoray,","role":{"roleTerm":"publisher"}},"dateIssued":"2024."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"vi, 177 pages : illustrations ; 22 cm."},{"form":{"@type":"Illustrative content","#text":"illustration"}}],"abstract":{"@type":"Summary","#text":"\"In 1943, as Nazi power swept across central Europe, Rosa, her husband Emanuel and their daughter, Judy, were forced into hiding. But after a year and a half of living a terrifying, day-by-day existence, they were betrayed. As they arrived in Auschwitz, Rosa was torn from her husband and her only daughter. Could she dare to hope she would see either of them again? Somehow, Rosa fought the horror and humiliation of the camp, on occasion coming dangerously close to death. In nursing the people trapped beside her, she helped others survive, but tragically she also watched them die - including a mother she had met before, with a similar story and a daughter the very same age. Her name was Edith Frank. Written immediately in the months after the war, Auschwitz, A Mother's Story tells Rosa de Winter-Levy's unique and heart-breaking personal story, from the atrocities of the camp to her journey out of hell. Powerful and affecting, it is the testimony of a mother, and the pain she will endure for the chance to hold her child again\"--Publisher's description."},"note":{"@type":"statement of responsibility","#text":"Rosa de Winter-Levy ; [translated from the Dutch by Liz Waters]."},"subject":[{"@authority":"lcsh","name":{"@type":"personal","namePart":["Winter-Levy, Rosa de,",{"@type":"date","#text":"1905-1985"}]}},{"@authority":"lcsh","name":{"@type":"corporate","namePart":"Birkenau (Concentration camp)"}},{"@authority":"lcsh","topic":"Holocaust, Jewish (1939-1945)","geographic":"Netherlands"},{"@authority":"lcsh","topic":"Holocaust, Jewish (1939-1945)","geographic":"Poland"},{"@authority":"lcsh","topic":"Jewish women in the Holocaust","geographic":"Netherlands","genre":"Biography"},{"@authority":"lcsh","topic":"Holocaust survivors","geographic":"Netherlands","genre":"Biography"},{"@authority":"lcsh","topic":"Women Nazi concentration camp inmates","geographic":"Poland","genre":"Biography"},{"@authority":"rvm","topic":"Holocauste, 1939-1945","geographic":"Pays-Bas"},{"@authority":"rvm","topic":"Survivants de l'Holocauste","geographic":"Pays-Bas","genre":"Biographies"},{"@authority":"rvm","topic":"Détenues de camp de concentration nazi","geographic":"Pologne","genre":"Biographies"},{"@authority":"eflch","topic":"Warfare and Defence"},{"@authority":"fast","name":{"@type":"corporate