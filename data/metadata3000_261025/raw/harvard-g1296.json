{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Beschloss&limit=10&title=Presidents of War","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":{"title":"Presidents of War "},"name":{"@usage":"primary","@type":"personal","namePart":"Beschloss, Michael R.,","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"marcgt","#text":"biography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"fast","#text":"History."},{"@authority":"fast","#text":"Military history."},{"@authority":"lcgft","#text":"Nonfiction."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},"dateIssued":{"@encoding":"marc","#text":"2018"},"copyrightDate":{"@encoding":"marc","#text":"2018"},"issuance":"monographic","edition":"First edition."},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"New York :"}},"agent":{"namePart":"Crown,","role":{"roleTerm":"publisher"}},"dateIssued":[2018]}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xi, 739 pages, 32 unnumbered pages of plates : illustrations (some color) ; 25 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Color content","#text":"polychrome"}}],"abstract":{"@type":"Summary","#text":"Presidential historian Michael Beschloss uses original letters, diaries, declassified documents, and interviews to bring us into the room and into the minds of a procession of Chief Executives who took the nation into major conflicts, mobilized Americans for victory, and seized greater power for themselves. From James Madison and the War of 1812 to Lyndon Johnson and Vietnam, we see these leaders struggling with Congress, the courts, the press, their own advisers, and antiwar protesters; seeking comfort from their spouses, families, and friends; and dropping to their knees in prayer. We come to understand how these Presidents were able to withstand the pressures of war -- both physically and emotionally -- or were broken by them."},"tableOfContents":{"@type":"Contents","#text":"Prologue: The fugitive -- \"Torrent of passion\" -- \"Man of straw\" -- \"The most glorious war\" -- \"The country is now virtually ours\" -- \"A presidential war\" -- Fort Sumter -- \"Blood flowing all about me\" -- \"Maine blown up\" -- \"We must keep what we want\" -- \"The world is on fire\" -- \"Salvation of mankind\" -- \"How could this thing happen?\" -- \"The survival war\" -- \"I am going to let them have it\" -- \"I don't ask their permission\" -- \"We got slapped\" -- \"I do not have a parachute\" -- Epilogue."},"note":[{"@type":"statement of responsibility","#text":"Michael Beschloss."},{"@type":"bibliography","#text":"Includes bibliographical references and index."},"New York Times Bestseller Nonfiction 2018.","New York Times Bestsellers Nonfiction 2018."],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"n-us---"}},{"@authority":"lcsh","topic":["Presidents","History"],"geographic":"United States"},{"@authority":"lcsh","topic":["Political leadership","History"],"geographic":"United States"},{"@authority":"lcsh","topic":["Executive power","History"],"geographic":"United States"},{"@authority":"rvm","topic":["Présidents","Histoire"],"geographic":"États-Unis"},{"@authority":"rvm","topic":["Pouvoir exécutif","Histoire"],"geographic":"États-Unis"},{"@authority":"bisacsh","topic":["HISTORY","Military","United States"]},{"@authority":"bisacsh","topic":["HISTORY","Milita