a","Government relations"],"temporal":"1789-1869"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/99156778846703941/catalog"}},"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99156778846703941","processingDate":"2024-08-03T06:11Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"UkMbAM-D"},"recordCreationDate":{"@encoding":"marc","#text":"131113"},"recordChangeDate":{"@encoding":"iso8601","#text":"20131130"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99156778846703941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"@version":"3.8","titleInfo":{"title":"All that remains ","subTitle":"a life in death "},"name":{"@usage":"primary","@type":"personal","namePart":"Black, Sue M.","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"biography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"Medical Subject Headings","#text":"Personal Narrative"},{"@authority":"Medical Subject Headings","#text":"Autobiography"},{"@authority":"Medical Subject Headings","#text":"Anecdotes"},{"@authority":"aat","#text":"autobiographies (literary genre)"},{"@authority":"fast","#text":"Personal narratives"},{"@authority":"fast","#text":"Autobiographies"},{"@authority":"fast","#text":"Anecdotes"},{"@authority":"fast","#text":"Biographies"},{"@authority":"lcgft","#text":"Autobiographies"},{"@authority":"lcgft","#text":"Personal narratives"},{"@authority":"lcgft","#text":"Anecdotes"},{"@authority":"rbgenr","#text":"Autobiographies."},{"@authority":"rvmgf","#text":"Récits personnels."},{"@authority":"rvmgf","#text":"Autobiographies."},{"@authority":"rvmgf","#text":"Anecdotes."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},"dateIssued":{"@encoding":"marc","#text":"2018"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"London :"}},"agent":{"namePart":"Doubleday,","role":{"roleTerm":"publisher"}},"dateIssued":"2018."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"354 pages : illustrations, portraits ; 23 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Illustrative content","#text":"portrait"}}],"abstract":{"@type":"Summary","#text":"\"Sue Black confronts death every day. As Professor of Anatomy and Forensic Anthropology, she focuses on mortal remains in her lab, at burial sites, at scenes of violence, murder and criminal dismemberment, and when investigating mass fatalities due to war, accident or natural disaster. In All That Remains she reveals the many faces of death she has come to know, using key cases to explore how forensic science has developed, and what her work has taught her. Do we expect a book about death to be sad? Macabre? Sue's book is neither. There is tragedy, but there is also humour in stories as gripping as the best crime novel. Our own death will remain a great unknown. But as an expert witness from the final frontier, Sue Black is the wisest, most reassuring, most compelling of guides.\"--Amazon.com."},"note":[{"@type":"statement of responsibility","#text":"Sue Black."},"Includes index."],"subject":[{"geographicCode":{"@authority":"marcg