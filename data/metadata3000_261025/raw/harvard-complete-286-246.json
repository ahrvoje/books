{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Magness&limit=10&title=The 1619 Project","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":[{"nonSort":{"@space":"preserve","#text":"The  "},"title":"1619 Project myth "},{"@type":"alternative","title":"Sixteen Hundred Nineteen Project myth"},{"@type":"alternative","title":"Sixteen Nineteen Project myth"}],"name":[{"@usage":"primary","@type":"personal","namePart":"Magness, Phillip W.,","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}},{"roleTerm":{"@type":"code","@authority":"marcrelator","#text":"aut"}},{"roleTerm":{"@type":"code","@authority":"marcrelator","#text":"http://id.loc.gov/vocabulary/relators/aut"}}],"nameIdentifier":["https://id.oclc.org/worldcat/entity/E39PCjvGTfdxDBCrVmB4FRXw4q","http://id.loc.gov/rwo/agents/no2011038377"]},{"@type":"corporate","namePart":"1619 Project","nameIdentifier":"http://id.loc.gov/resources/hubs/033d5a0a-0966-d411-242b-44bb199f3abc"}],"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","@valueURI":"http://id.loc.gov/vocabulary/contentTypes/txt","#text":"text"},{"@authority":"fast","#text":"History"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"cau"},{"@type":"text","@authority":"marccountry","#text":"California"}]},"dateIssued":{"@encoding":"marc","#text":"2025"},"issuance":"monographic","edition":"Updated edition."},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"Oakland, CA :"}},"agent":{"namePart":"Independent Institute,","role":{"roleTerm":"publisher"}},"dateIssued":[2025],"issuance":"single unit"}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@authority":"marccategory","#text":"text"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xiv, 166 pages : illustrations ; 24 cm"},{"form":{"@type":"Illustrative content","#text":"illustrations"}}],"abstract":{"@type":"Summary","#text":"\"Economic historian Phil Magness tackles the many falsehoods and misconceptions of the New York Times 1619 Project, a progressive political project that attempts to rewrite the American founding story as one of oppression (1619), rather than liberation (1776). When historical discussions devolve into partisan identity politics, Magness steps up to apply his decades of rigorous scholarship. Magness's critique caused the New York Times to recall and quietly revise portions of the text, including outright factual errors ignored by the editors. But more importantly, the book aims to reignite a worthwhile conversation on the consequences of slavery and abolition in the United States--one based in intellectual humility and factual history, not an ideological agenda\"-- Provided by publisher."},"tableOfContents":{"@type":"Contents","#text":"How the 1619 Project Rehabilitates the \"King Cotton\" Thesis -- The Anti-Capitalist Ideology of Slavery -- How Capitalist-Abolitionists Fought Slavery -- The Statistical Errors of the Reparations Agenda -- Fact-Checking the 1619 Project and Its Critics -- The Case for Retracting Matthew Desmond's 1619 Project Essay -- A Comment on the \"New\" History of American Capitalism -- The New History of Capitalism Has a \"Whiteness\" Problem -- What the 1619 Project's Critics Get Wrong About Lincoln -- The 1619 Project : An Epitaph -- Should K-12 Classrooms Teach from the 1619 Project? -- Down the 1619 Project's Memory Hole -- The Suicide of the American Historical Association -- The 1619 Project Unrepentantly Pushes Junk History -- Hulu's 1619 Docuseries Peddles False History -- The 1619 Project's Confusion on Capitalism -- The Tooth-Fairy Economics of Slavery Reparations."},"note":[{"@type":"statement of responsibility","#text":"by Phillip W. Magness."},{"@type":"bibliography","#text":"Includes bibliographical references and index."},"Earlier title: \"The 1619 Project: A Critique.\""],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"n-us---"}},{"@authority":"lcsh","topic":["Slavery","Political aspects"],"geographic":"United States"},{"@authority":"lcsh","topic":["Slavery","Economic aspects"],"geographic":"United States"},{"@authority":"rvm","topic":["Esclavage","Aspect politique"],"geographic":"États-Unis"},{"@authority":"rvm","topic":["Esclavage","Aspect économique"],"geographic":"États-Unis"},{"@authority":"bisacsh","topic":"HISTORY / United States / Colonial Period (1600-1775)"},{"@authority":"bisacsh","topic":"POLITICAL SCIENCE / American Government / National"},{"@authority":"fast","topic":["Race relations","Political aspects"]},{"@authority":"fast","topic":["Slavery","Economic aspects"]},{"@authority":"fast","topic":["Slavery","Political aspects"]},{"@authority":"lcsh","geographic":"United States","topic":["History","Errors, inventions, etc"]},{"@authority":"lcsh","geographic":"United States","topic":["Race relations","Political aspects"]},{"@authority":"rvm","geographic":"États-Unis","topic":["Relations raciales","Aspect politique"]},{"@authority":"fast","geographic":"United States"},{"@authority":"lcsh","name":{"@type":"corporate","namePart":"1619 Project"}},{"@authority":"fast","name":{"@type":"corporate","namePart":"1619 Project"}}],"classification":[{"@authority":"lcc","#text":"E441 .A17 2025"},{"@edition":"23/eng/20250325","@authority":"ddc","#text":"306.3/620973"},{"@authority":"bisacsh","#text":"HIS036020"},{"@authority":"bisacsh","#text":"POL030000"}],"identifier":[{"@type":"isbn","#text":"9781598134094"},{"@type":"isbn","#text":"1598134094"},{"@type":"isbn","@invalid":"yes","#text":"9781598134117"},{"@type":"lccn","#text":"2025004489"},{"@type":"oclc","#text":"1511562850"}],"relatedItem":{"@othe