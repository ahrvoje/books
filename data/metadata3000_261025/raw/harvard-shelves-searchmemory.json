b","#text":"English"}]},{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"fre"}},{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"ger"}}],"physicalDescription":[{"form":[{"@authority":"gmd","#text":"videorecording "},{"@type":"media","@authority":"rdamedia","#text":"video"},{"@type":"carrier","@authority":"rdacarrier","#text":"videodisc"}],"extent":"1 videodisc (95 min.) : sd., col. ; 4 3/4 in."},{"form":{"@type":"Material base and configuration","#text":"plastic"}},{"extent":"4 3/4 in."},{"form":[{"@type":"Type of recording","#text":"digital"},{"@type":"Recording medium","#text":"optical"}]}],"abstract":{"@type":"Summary","#text":"The life and work of one of the most important neuroscientists of the 20th century, Nobel Prize winner Eric Kandel. A compelling blend of autobiography and history that recounts the life of one of the most important neuroscientists of the 20th century and illuminates scientific developments in our understanding of the brain's role in recording and preserving memory. In addition to archival footage and dramatic re-creations of Kandel's childhood experiences in Nazi-occupied Vienna and his formative years as an emigrant in New York, the film features discussions with Kandel, friends and family, as well as his public lectures in Vienna and New York, which explore both his professional and personal life, especially his emotional ties to Judaism."},"note":[{"@type":"statement of responsibility","#text":"FilmForm Köln presents a film by Petra Seeger."},{"@type":"creation/production credits","#text":"Producer, director, writer, Petra Seeger ; director of photography, Robert Winkler, Mario Masini ; editor, Oliver Neumann."},{"@type":"system details","#text":"DVD."},{"@type":"language","#text":"Closed-captioned."},{"@type":"language","#text":"In English, with some spoken German and French with subtitles in English."},{"@type":"performers","#text":"Featuring Eric Kandel."}],"subject":[{"geographicCode":{"@authority"