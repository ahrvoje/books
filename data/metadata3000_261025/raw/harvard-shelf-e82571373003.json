{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Mortimer&limit=10&title=Medieval Horizons","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":{"title":"Medieval horizons ","subTitle":"why the Middle Ages matter "},"name":{"@usage":"primary","@type":"personal","namePart":["Mortimer, Ian,",{"@type":"date","#text":"1967-"}],"role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}],"nameIdentifier":"https://id.oclc.org/worldcat/entity/E39PBJgMFRVvP74KyXG97rpwYP"},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"fast","#text":"History"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},"dateIssued":{"@encoding":"marc","#text":"2023"},"copyrightDate":{"@encoding":"marc","#text":"2023"},"issuance":"monographic"},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"London :"}},"agent":{"namePart":"The Bodley Head,","role":{"roleTerm":"publisher"}},"dateIssued":"2023."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"246 pages, 8 unnumbered pages of plates : color illustrations ; 24 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}},{"form":{"@type":"Color content","#text":"polychrome"}}],"abstract":{"@type":"Summary","#text":"\"We tend to think of the Middle Ages as a dark, backward and unchanging time characterised by violence, ignorance and superstition. By contrast we believe progress arose from science and technological innovation, and that inventions of recent centuries created the modern world. We couldn't be more wrong. As Ian Mortimer shows in this fascinating book, people's horizons - their knowledge, experience and understanding of the world - expanded dramatically. Life was utterly transformed between 1000 and 1600, marking the transition from a warrior-led society to that of Shakespeare. Just as The Time Traveller's Guide to Medieval England revealed what it was like to live in the fourteenth century, Medieval Horizons provides the perfect primer to the era as a whole. It outlines the enormous cultural changes that took place -- from literacy to living standards, inequality and even the developing sense of self -- thereby correcting misconceptions and presenting the period as a revolutionary age of fundamental importance in the development of the Western world.\" -- Provided by publisher."},"tableOfContents":{"@type":"Contents","#text":"Horizons -- War -- Inequality -- Comfort -- Speed -- Literacy -- Individualism -- Envoi."},"note":[{"@type":"statement of responsibility","#text":"Ian Mortimer."},{"@type":"bibliography","#text":"Includes bibliographical references and index."}],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"e-uk---"}},{"@authority":"lcsh","topic":"Middle Ages"},{"@authority":"lcsh","topic":"Civilization, Medieval"},{"@authority":"rvm","topic":"Moyen Âge"},{"@authority":"rvm","topic":"Civilisation médiévale"},{"@authority":"eflch","topic":"History"},{"@authority":"fast","topic":"Middle Ages"},{"@authority":"fast","topic":"Civilization, Medieval"},{"@authority":"fast","topic":"Civilization"},{"@authority":"thema","topic":"England"},{"@authority":"thema","topic":"c 1000 CE to c 1500"},{"@authority":"thema","topic":"European history"},{"@authority":"thema","topic":"History"},{"@authority":"ukslc","topic":"History"},{"@authority":"lcsh","geographic":"Great Britain","topic":"Civilization","temporal":"1066-1485"},{"@authority":"lcsh","geographic":"Great Britain","topic":"Civil