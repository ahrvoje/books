{"pagination":{"maxPageableSet":"10000","numFound":4,"query":"name=Hawking&limit=10&title=The Grand Design","limit":10,"start":0},"items":{"mods":[{"titleInfo":{"title":"God and Stephen Hawking","subTitle":"whose design is it anyway?"},"name":{"@nameTitleGroup":"1","@usage":"primary","@type":"personal","namePart":["Lennox, John C.",{"@type":"date","#text":"1943-"}],"role":{"roleTerm":{"@type":"text","#text":"creator"}}},"typeOfResource":"text","genre":{"@authority":"marcgt","#text":"bibliography"},"originInfo":{"place":[{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},{"placeTerm":{"@type":"text","#text":"Oxford"}}],"publisher":"Lion","dateIssued":"2010","edition":"1st ed.","issuance":"monographic"},"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":{"@authority":"marcform","#text":"print"},"extent":"96 p. ; 18 cm."},"abstract":{"@type":"Summary","#text":"'The Grand Design', by eminent scientist Stephen Hawking, is the latest blockbusting contribution to the so-called New Atheist debate, and claims that the laws of physics themselves brought the Universe into being, rather than God. In this swift and forthright reply, John Lennox, Oxford mathematician and author of 'God's Undertaker', exposes the flaws in Hawking's logic. In lively, layman's terms, Lennox guides us through the key points in Hawking's arguments - with clear explanations of the latest scientific and philosophical methods and theories - and demonstrates that far from disproving a Creator God, they make his existence seem all the more probable."},"tableOfContents":"The big questions -- God or the laws of nature? -- God or the multiverse? -- Whose design is it anyway? -- Science and rationality.","note":[{"@type":"statement of responsibility","#text":"John C. Lennox."},{"@type":"bibliography","#text":"Includes bibliographical references."}],"subject":[{"@authority":"lcsh","name":{"@type":"personal","namePart":["Hawking, Stephen",{"@type":"date","#text":"1942-2018"}]},"titleInfo":{"title":"Grand design"}},{"@authority":"lcsh","topic":"Creation"},{"@authority":"lcsh","topic":"Religion and science"},{"@authority":"lcsh","topic":["Cosmology","Religious aspects"]},{"@authority":"lcsh","topic":"Intelligent design (Teleology)"},{"@authority":"lcsh","topic":"God"},{"@authority":"lcsh","topic":"Apologetics"}],"classification":[{"@authority":"lcc","#text":"BL240.3 .L458 2010"},{"@authority":"ddc","#text":"231.765"}],"identifier":[{"@type":"isbn","#text":"9780745955490 (pbk)"},{"@type":"isbn","#text":"0745955495 (pbk)"},{"@type":"lccn","#text":"^^2011500180"},{"@type":"oclc","#text":"720523343"}],"relatedItem":{"@otherType":"HOLLIS record","location":{"url":"https://id.lib.harvard.edu/alma/990127433990203941/catalog"}},"location":[{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://isni.org/isni/0000000121705139","#text":"Harvard Divinity School Library, Harvard University"},"shelfLocator":"BL240.3 .L458 2010"},{"physicalLocation":{"@displayLabel":"Harvard repository","@type":"repository","@valueURI":"http://id.loc.gov/rwo/agents/no2014094889","#text":"Widener Library, Harvard University"},"shelfLocator":"BL240.3 .L458 2010"},null,null],"extension":[{"librarycloud":{"HarvardRepositories":{"HarvardRepository":["Divinity Library","Widener"]},"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/990127433990203941","priorrecordids":{"recordIdentifier":{"@source":"MH:ALEPH","#text":"012743399"}},"processingDate":"2024-08-15T05:10Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"aacr","recordContentSource":{"@authority":"marcorg","#text":"UNITY"},"recordCreationDate":{"@encoding":"marc","#text":"101126"},"recordChangeDate":{"@encoding":"iso8601","#text":"20120210"},"recordIdentifier":{"@source":"MH:ALMA