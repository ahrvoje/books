2"},{"@type":"lccn","#text":"2022021295"},{"@type":"oclc","#text":"1287264423"},{"@type":"oclc","#text":"1287264423"},{"@type":"stock number","#text":"646F6370-3234-4D8A-8F44-3ED66F57EFA0 OverDrive, Inc."}],"location":[null,null],"extension":[{"librarycloud":{"originalDocument":"https://s3.amazonaws.com/harvard.librarycloud.marc/99156344624903941","processingDate":"2025-05-18T05:14Z"}},{"sets":null}],"recordInfo":{"descriptionStandard":"rda","recordContentSource":{"@authority":"marcorg","#text":"DLC"},"recordCreationDate":{"@encoding":"marc","#text":"220604"},"recordChangeDate":{"@encoding":"iso8601","#text":"20220804"},"recordIdentifier":{"@source":"MH:ALMA","#text":"99156344624903941"},"recordOrigin":"Converted from MARCXML to MODS version 3.6 using MARC21slim2MODS3-6.xsl\n        (Revision 1.117 2017/02/14)","languageOfCataloging":{"languageTerm":{"@type":"code","@authority":"iso639-2b","#text":"eng"}}}},{"@version":"3.8","titleInfo":{"title":"Kissinger on Kissinger ","subTitle":"reflections on diplomacy, grand strategy, and leadership "},"name":{"@type":"personal","namePart":"Lord, Winston","role":{"roleTerm":{"@type":"text","#text":"compiler"}}},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"biography"},{"@authority":"rdacontent","#text":"text"},{"@authority":"Medical Subject Headings","#text":"Interview"},{"@authority":"aat","#text":"interviews."},{"@authority":"fast","#text":"Interviews."},{"@authority":"lcgft","#text":"Interviews."},{"@authority":"rvmgf","#text":"Interviews."}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"nyu"},{"@type":"text","@authority":"marccountry","#text":"New York (State)"}]},"dateIssued":{"@encoding":"marc","#text":"2019"},"issuance":"monographic","edition":"First edition."},{"@eventType":"publication","place":{"placeTerm":{"@type":"text","#text":"New York, NY :"}},"agent":{"namePart":"All Points Books,","role":{"roleTerm":"publisher"}},"dateIssued":"2019."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":[{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"xxi, 147 pages : illustration ; 20 cm"},{"form":{"@type":"Illustrative content","#text":"illustration"}}],"abstract":{"@type":"Summary","#text":"\"In a series of riveting interviews, America's senior statesman discusses the challenges of directing foreign policy during times of great global tension. As National Security Advisor to Richard Nixon, Henry Kissinger transformed America's approach to diplomacy with China, the USSR, Vietnam, and the Middle East, laying the foundations for geopolitics as we know them today. Nearly fifty years later, escalating tensions between the US, China, and Russia are threatening a swift return to the same diplomatic game of tug-of-war that Kissinger played so masterfully. Kissinger on Kissinger is a series of faithfully transcribed interviews overseen by the elder statesman's longtime associate, Winston Lord, which captures Kissinger's thoughts on the specific challenges that he faced during his tenure as national security advisor, his general advice on leadership and international relations, and stunning portraits of the larger-than-life world leaders of the era. The result is a frank and well-informed overview of US foreign policy in the first half of the 1970s--essential reading for anyone hoping to understand tomorrow's global challenges.\" -- Dust jacket flap."},"tableOfContents":{"@type":"Contents","#text":"Statesmanship -- Setting the scene -- Opening to China -- The Nixon-Mao Summit -- Seeking stability with the Soviet Union -- Searching for peace in Vietnam -- Breakthrough and the Paris Accords -- Initial advances in the Middle East -- Negotiating styles and personal profiles -- The foreign policy process -- Strategy."},"note":[{"@type":"statement of responsibility","#text":"[compiled by] Winston Lord ; introduction by Henry Kissinger."},"Includes index."],"subject":[{"geographicCode":{"@authority":"marcgac","#text":"n-us---"}},{"@authority":"lcsh","topic":"Statesmen","geographic":"United States","genre":"Interviews"},{"@authority":"lcsh","topic":"Diplomacy"},{"@authority":"lcsh","topic":"Leadership"},{"@authority":"lcsh","topic":"International relations"},{"@authority":"mesh","topic":"Leadership"},{"@authority":"rvm","topic":"Hommes d'État","geographic":"États-Unis","genre":"Entretiens"},{"@authority":"rvm","topic":"Diplomatie"},{"@authority":"rvm","topic":"Leadership"},{"@authority":"rvm","topic":"Relations internationales"},{"@authority":"aat","topic":"diplomacy"},{"@authority":"aat","topic":"international relations"},{"@authority":"fast","@href":"(OCoLC)fst00894188","topic":"Diplomacy"},{"@authority":"fast","@href":"(OCoLC)fst01907412","topic":"Diplomatic relations"},{"@authority":"fast","@href":"(OCoLC)fst00977053","topic":"International relations"},{"@authority":"fast","@href":"(OCoLC)fst00994701","topic":"Leadership"},{"@authority":"fast","@href":"(OCoLC)fst01131990","topic":"Statesmen"},{"@authority":"gnd","topic":"Auslandsbeziehungen"},{"@authority":"gnd","topic":"Diplomatie"},{"@authority":"gnd","topic":"Politische Führung"},{"@authority":"gnd","topic":"Strategie"},{"@authority":"lcsh","geographic":"United States","topic":"Foreign relations","temporal":"1969-1974"},{"@authority":"rvm","geographic":"États-Unis","topic":"Relations extérieures","temporal":"1969-1974"},{"@authority":"fast","@href":"(OCoLC)fst01204155","geographic":"United States"},{"@authority":"gnd","geographic":"USA"},{"@authority":"lcsh","name":{"@type":"personal","namePart":["Kissinger, Henry,",{"@type":"date","#text":"1923-2023"}]},"genre":"Interviews"},{"@authority":"fast","name":{"@type":"personal","namePart":["Kissinger, Henry,",{"@type":"date","#text":"1923-"}]}},