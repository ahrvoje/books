{"pagination":{"maxPageableSet":"10000","numFound":1,"query":"name=Jurgenson&limit=10&title=The Social Photo","limit":10,"start":0},"items":{"mods":{"@version":"3.8","titleInfo":{"nonSort":{"@space":"preserve","#text":"The  "},"title":"social photo ","subTitle":"on photography and social media "},"name":{"@usage":"primary","@type":"personal","namePart":"Jurgenson, Nathan,","role":[{"roleTerm":{"@type":"text","#text":"creator"}},{"roleTerm":{"@type":"text","#text":"author"}}]},"typeOfResource":"text","genre":[{"@authority":"marcgt","#text":"bibliography"},{"@authority":"rdacontent","#text":"text"}],"originInfo":[{"place":{"placeTerm":[{"@type":"code","@authority":"marccountry","#text":"enk"},{"@type":"text","@authority":"marccountry","#text":"England"}]},"dateIssued":{"@encoding":"marc","#text":"2019"},"issuance":"monographic"},{"@eventType":"publication","place":[{"placeTerm":{"@type":"text","#text":"London ;"}},{"placeTerm":{"@type":"text","#text":"New York :"}}],"agent":[{"namePart":"Verso Books,","role":{"roleTerm":"publisher"}},{"namePart":"Verso Books,","role":{"roleTerm":"publisher"}}],"dateIssued":"2019."}],"language":{"languageTerm":[{"@type":"code","@authority":"iso639-2b","#text":"eng"},{"@type":"text","@authority":"iso639-2b","#text":"English"}]},"physicalDescription":{"form":[{"@authority":"marcform","#text":"print"},{"@type":"media","@authority":"rdamedia","#text":"unmediated"},{"@type":"carrier","@authority":"rdacarrier","#text":"volume"}],"extent":"135 pages ; 22 cm"},"abstract":{"@type":"Summary","#text":"With the rise of the smart phone and social media, cameras have become ubiquitous, infiltrating nearly every aspect of social life. The glowing camera screen is the lens through which many of us communicate our experience. But our thinking about photography has been slow to catch up; this major fixture of everyday life is still often treated in the terms of art or journalism. The author, a social theorist, develops bold new ways of understanding photography in the age of social media now that many new kinds of image have emerged: the selfie, the faux-vintage photo, the self-destructing image, the food photo. These new visual forms - and the devices and platforms that facilitate them - have remade the world and our understanding of ourselves within it."},"tableOfContents":{"@type":"Contents","#text":"Documentary vision -- Real life -- Coda: the social video."},"note":[{"@type":"statement of responsibility","#text":"Nathan Jurgenson."},{"@type":"bibliography","#text":"Includes bibliographical references (pages 121-135)."}],"subject":[{"@authority":"lcsh","topic":["Photography","Philosophy"]},{"@authority":"lcsh","topic":["Photography","Social aspects"]},{"@authority":"lcsh","topic":"Vernacular photography"},{"@authority":"lcsh","topic":"Computer file sharing"},{"@authority":"lcsh","topic":"Online social networks"},{"@authority":"rvm","topic":["Photographie","Philosophie"]},{"@authority":"rvm","topic":["Photographie","Aspect social"]},{"@authority":"rvm","topic":"Photographie vernaculaire"},{"@authority":"rvm","topic":"Partage de fichiers (Informatique)"},{"@authority":"rvm","topic":"Réseaux sociaux (Internet)"},{"@authority":"bisacsh","topic":"COMPUTERS / General"},{"@authority":"bisacsh","topic":"COMPUTERS / Web / Social Media"},{"@authority":"bisacsh","topic":"PHOTOGRAPHY"},{"@authority":"bisacsh","topic":"PHOTOGRAPHY / General"},{"@authority":"eflch","topic":"Photography"},{"@authority":"fast","@href":"(OCoLC)fst01762114","topic":"Computer file sharing"},{"@authority":"fast","@href":"(OCoLC)fst01741311","topic":"Online social networks"},{"@authority":"fast","@href":"(OCoLC)fst01061781","topic":["Photography","Philosophy"]},{"@authority":"fast","@href":"(OCoLC)fst01061826","topic":["Photography","Social aspects"]},{"@authority":"fast","@href":"(OCoLC)fst01746380","topic":"Vernacular photography"},{"@authority":"gnd","topic":"Datenaustausch"},{"@authority":"gnd","topic":"Fotografie"},{"@authority":"gnd","topic