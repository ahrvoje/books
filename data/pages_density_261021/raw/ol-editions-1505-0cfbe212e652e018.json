 ["46642"], "librarything": ["2366599"]}, "isbn_13": ["9781586484118"], "edition_name": "1st ed.", "lccn": ["2006027765"], "subjects": ["Charities -- United States", "Endowments -- United States", "Associations, institutions, etc. -- United States"], "publish_date": "2007", "publish_country": "nyu", "by_statement": "Joel L. Fleishman.", "works": [{"key": "/works/OL6323606W"}], "type": {"key": "/type/edition"}, "oclc_numbers": ["71368900"], "description": {"type": "/type/text", "value": "\"Foundations are a peculiarly American institutions. They have been the dynamo of social change since the beginning of the last century. Yet they are cloaked in secrecy - their decision-making and operations are inscrutable to the point of obscurity, leaving them substantially unaccountable. Joel Fleishman has been in and around foundations for almost half a century, running them, sitting on their boards, and seeking grants from them. In this book, he explains the history of foundations and focuses on some of the most successful foundation initiatives and on how some foundations have failed in their mission.\"--Jacket."}, "latest_revision": 15, "revision": 15, "created": {"type": "/type/datetime", "value": "2008-10-18T12:00:17.340023"}, "last_modified": {"type": "/type/datetime", "value": "2025-11-22T10:44:43.974509"}}}, "OLID:OL8820712M": {"bib_key": "OLID:OL8820712M", "info_url": "http://openlibrary.org/books/OL8820712M/The_Foundation", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL8820712M/The_Foundation", "thumbnail_url": "https://covers.openlibrary.org/b/id/853003-S.jpg", "details": {"identifiers": {"goodreads": ["46642"], "librarything": ["2366599"]}, "title": "The Foundation", "subtitle": "A Great American Secret; How Private Wealth is Changing the World", "authors": [{"key": "/authors/OL3107867A", "name": "Joel Fleishman"}], "publish_date": "January 9, 2007", "publishers": ["PublicAffairs"], "weight": "1.4 pounds", "covers": [853003], "physical_format":