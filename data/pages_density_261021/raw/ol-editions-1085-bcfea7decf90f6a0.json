ibrary.org/books/OL24248879M/Open", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL24248879M/Open", "thumbnail_url": "https://covers.openlibrary.org/b/id/6396164-S.jpg", "details": {"publishers": ["Knopf Doubleday Publishing Group"], "physical_format": "Electronic resource", "source_records": ["marc_overdrive/InternetArchiveCrMarc-2010-06-11b.mrc:7811522:3810", "promise:bwb_daily_pallets_2020-06-04"], "title": "Open", "identifiers": {"overdrive": ["60E1B8D0-6FE8-4470-9178-196909C4E5D0"], "amazon": [""]}, "isbn_13": ["9780307592804"], "covers": [6396164], "languages": [{"key": "/languages/eng"}], "publish_date": "2009", "publish_country": "nyu", "key": "/books/OL24248879M", "authors": [{"key": "/authors/OL6697108A", "name": "Andre Agassi"}], "publish_places": ["New York"], "works": [{"key": "/works/OL13826401W"}], "type": {"key": "/type/edition"}, "local_id": ["urn:bwbsku:046-BAB-724"], "latest_revision": 4, "revision": 4, "created": {"type": "/type/datetime", "value": "2010-06-17T00:08:04.811571"}, "last_modified": {"type": "/type/datetime", "value": "2022-12-10T08:19:28.022357"}}}, "OLID:OL31851637M": {"bib_key": "OLID:OL31851637M", "info_url": "http://openlibrary.org/books/OL31851637M/Open", "preview": "restricted", "preview_url": "https://archive.org/details/openlamiastoria0000agas", "thumbnail_url": "https://covers.openlibrary.org/b/id/10541608-S.jpg", "details": {"works": [{"key": "/works/OL13826401W"}], "title": "Open", "publishers": ["Einaudi"], "publish_date": "2011", "key": "/books/OL31851637M", "type": {"key": "/type/edition"}, "identifiers": {}, "covers": [10541608], "isbn_13": ["9788806207267"], "classifications": {}, "translated_from": [{"key": "/languages/eng"}], "subtitle": "La mia storia", "contributors": [{"role": "Translator", "name": "Giuliana Lupi"}], "languages": [{"key": "/languages/ita"}], "translation_of": "Open: An Autobiography", "number_of_pages": 502, "physical_format": "Paperback", "ocaid": "openlamiastoria0000agas", "source_records": ["ia:openlamiastoria0000agas", "promise:bwb_daily_pallets_2022-03-17"], "local_id": ["urn:bwbsku:P7-BPM-295"], "latest_revision": 5, "revision": 5, "created": {"type": "/type/datetime", "value": "2021-01-09T17:04:05.775414"}, "last_modified": {"type": "/type/datetime", "value": "2022-12-07T04:25:09.215054"}}}, "OLID:OL25622192M": {"bib_key": "OLID:OL25622192M", "info_url": "http://openlibrary.org/books/OL25622192M/Open", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL25622192M/Open", "details": {"publishers": ["Duomo"], "last_modified": {"type": "/type/datetime", "value": "2020-08-22T11:14:07.224001"}, "latest_revision": 2, "key": "/books/OL25622192M", "created": {"type": "/type/datetime", "value": "2014-09-23T09:02:45.332118"}, "title": "Open", "isbn_10": ["9788415945482"], "publish_date": "2014", "works": [{"key": "/works/OL13826401W"}], "type": {"key": "/type/edition"}, "revision": 2}}, "OLID:OL24298591M": {"bib_key": "OLID:OL24298591M", "info_url": "http://openlibrary.org/books/OL24298591M/Open", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL24298591M/Open", "details": {"publishers": ["HarperCollins"], "description": {"type": "/type/text", "value": "Coaxed to swing a racket while still in the crib, forced to hit hundreds of balls a day while still in grade school, Agassi resented the constant pressure even as he drove himself to become a prodigy, an inner conflict that would define him. Now, in his beautiful, haunting autobiography, Agassi tells the story of a life framed by such conflicts.Agassi makes us feel his panic as an undersized seven-year-old in Las Vegas, practicing all day under the obsessive gaze of his violent father. We see him at thirteen, banished to a Florida tennis camp. Lonely, scared, a ninth-grade dropout, he rebels in ways that will soon make him a 1980s icon. By the time he turns pro at sixteen, his new look promises to change tennis forever, as does his lightning fast return.And yet, despite his raw talent, he struggles early on. We feel his confusion as he loses to the world's best, his greater confusion as he starts to win. After stumbling in three Grand Slam finals, Agassi shocks the world, and himself, by capturing the 1992 Wimbledon. Overnight he becomes a fan favorite and a media target.Agassi brings a near-photographic memory to every pivotal match, and every public relationship. Alongside vivid portraits of rivals, Agassi gives unstinting accounts of his brief time with Barbra Streisand and his doomed marriage to Brooke Shields. He reveals the depression that shatters his confidence, and the mistake that nearly costs him everything. Finally, he recounts his spectacular resurrection and his march to become the oldest man ever ranked number one.In clear, taut prose, Agassi evokes his loyal brother, his wise coach, his gentle trainer, all the people who help him regain his balance and find love at last with Stefanie Graf.With its breakneck tempo and raw candor, Open will be read and cherished for years. A treat for ardent fans, it will also captivate readers who know nothing about tennis. Like Agassi's game, it sets a new standard for grace, style, speed and power."}, "original_isbn": "9780007281428", "physical_format": "eBook", "key": "/books/OL24298591M", "publish_places": ["Glasgow"], "isbn_13": ["9780007346301"], "source_records": ["marc_overdrive/InternetArchiveCrMarc-2010-06-11r.mrc:6798703:3145", "bwb:9780007346301"], "title": "Open", "identifiers": {"overdrive": ["CAFA5EF9-3A38-4290-AC06-EF95DE4C1A3A"]}, "languages": [{"key": "/languages/eng"}], "publish_date": "2009", "publish_country": "nyu", "oclc_numbers": ["587497401"], "works": [{"key": "/works/OL13826401W"}], "type": {"key": "/type/edition"}, "latest_revision": 5, "revision": 5, "created": {"type": "/type/datetime", "value": "2010-06-23T22:51:56.588046"}, "last_modified": {"type": "/type/datetime", "value": "2022-08-17T04:53:05.456666"}}}, "OLID:OL24460818M": {"bib_key": "OLID:OL24460818M", "info_url": "http://openlibrary.org/books/OL24460818M/Open", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL24460818M/Open", "details": {"publishers": ["A. Knopf"], "subtitle": "an autobiography", "ia_box_id": ["IA174001"], "ia_loaded_id": ["openautobiograph00agas"], "lc_classifications": ["GV994.A43 A3 2009"], "latest_revision": 3, "key": "/books/OL24460818M", "authors": [{"key": "/authors/OL6697108A", "name": "Andre Agassi"}], "publish_places": ["New York"], "languages": [{"key": "/languages/eng"}], "pagination": "385 p. :", "source_records": ["marc:marc_loc_updates/v38.i16.records.utf8:8697157:659", "ia:openautobiograph00agas"], "title": "Open", "lccn": ["2009024004"], "notes": {"type": "/type/text", "value": "\"Borzoi Book.\""}, "number_of_pages": 385, "isbn_13": ["9780307268198"], "created": {"type": "/type/datetime", "value": "2010-11-23T23:21:57.007128"}, "edition_name": "1st ed.", "dewey_decimal_class": ["796.342092", "B"], "last_modified": {"type": "/type/datetime", "value": "2011-11-11T20:59:33.855302"}, "publish_date": "2009", "publish_country": "nyu", "by_statement": "Andre Agassi", "oclc_numbers": ["318431866"], "works": [{"key": "/works/OL15498745W"}], "type": {"key": "/type/edition"}, "revision": 3}}, "OLID:OL51807349M": {"bib_key": "OLID:OL51807349M", "info_url": "http://openlibrary.org/books/OL51807349M/Patriot", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL51807349M/Patriot", "thumbnail_url": "https://covers.openlibrary.org/b/id/15095308-S.jpg", "details": {"type": {"key": "/type/edition"}, "authors": [{"key": "/authors/OL13698247A", "name": "Alexei Navalny"}], "isbn_13": ["9781847927033"], "languages": [{"key": "/languages/eng"}], "lc_classifications": ["DK510.766.N38A3 2024"], "pagination": "320", "publish_date": "2024", "publishers": ["Random House Children's Books"], "source_records": ["bwb:9781847927033"], "subjects": ["Europe, eastern, history"], "title": "Patriot", "full_title": "Patriot", "works": [{"key": "/works/OL38123768W"}], "key": "/books/OL51807349M", "covers": [15095308], "latest_revision": 2, "revision": 2, "created": {"type": "/type/datetime", "value": "2024-06-17T17:15:35.352992"}, "last_modified": {"type": "/type/datetime", "value": "2025-06-18T12:00:20.410821"}}}, "OLID:OL57595467M": {"bib_key": "OLID:OL57595467M", "info_url": "http://openlibrary.org/books/OL57595467M/Patriota_Memorias_Patriot", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL57595467M/Patriota_Memorias_Patriot", "details": {"type": {"key": "/type/edition"}, "authors": [{"key": "/authors/OL13698247A", "name": "Alexei Navalny"}, {"key": "/authors/OL15009302A", "name": "Ana Camallonga Claveria"}, {"key": "/authors/OL7953563A", "name": "Gemma Deza Guil"}], "isbn_13": ["9786075698762"], "languages": [{"key": "/languages/spa"}], "number_of_pages": 640, "publish_date": "2025", "publishers": ["Editorial Planeta Mexicana"], "source_records": ["bwb:9786075698762"], "title": "Patriota : Memorias / Patriot", "subtitle": "a Memoir", "works": [{"key": "/works/OL38123768W"}], "key": "/books/OL57595467M", "latest_revision": 4, "revision": 4, "created": {"type": "/type/datetime", "value": "2025-01-25T03:21:38.003146"}, "last_modified": {"type": "/type/datetime", "value": "2026-04-27T13:21:07.818280"}}}, "OLID:OL57569187M": {"bib_key": "OLID:OL57569187M", "info_url": "http://openlibrary.org/books/OL57569187M/Patriot", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL57569187M/Patriot", "thumbnail_url": "https://covers.openlibrary.org/b/id/15102438-S.jpg", "details": {"type": {"key": "/type/edition"}, "authors": [{"key": "/authors/OL13698247A", "name": "Alexei Navalny"}], "languages": [{"key": "/languages/eng"}], "number_of_pages": 320, "publish_date": "2024", "publishers": ["Alfred A. Knopf"], "source_records": ["bwb:9780593320976"], "subjects": ["Political activists", "Russia (federation), history", "Russia (federation), biography", "Russia (federation), politics and government", "Personal memoirs"], "title": "Patriot", "subtitle": "A Memoir", "full_title": "Patriot A Memoir", "works": [{"key": "/works/OL38123768W"}], "key": "/books/OL57569187M", "covers": [15102438], "identifiers": {"amazon": ["B0D11LM6YR"]}, "isbn_13": ["9780593320976"], "oclc_numbers": ["1460031950"], "dewey_decimal_class": ["947.086092"], "lc_classifications": ["DK510.763.N38"], "publish_places": ["New York"], "copyright_date": "2024", "description": {"type": "/type/text", "value": "Alexei Navalny began writing Patriot shortly after his near-fatal poisoning in 2020. It is the full story of his life: his youth, his call to activism, his marriage and family, his commitment to challenging a world super-power determined to silence him, and his total conviction that change cannot be resisted\u2014and will come.\r\n\r\nIn vivid, page-turning detail, including never-before-seen correspondence from prison, Navalny recounts, among other things, his political career, the many attempts on his life, and the lives of the people closest to him, and the relentless campaign he and his team waged against an increasingly dictatorial regime.\r\n\r\nWritten with the passion, wit, candor, and bravery for which he was justly acclaimed, Patriot is Navalny\u2019s final letter to the world: a moving account of his last years spent in the most brutal prison on earth; a reminder of why the principles of individual freedom matter so deeply; and a rousing call to continue the work for which he sacrificed his life. \r\nSource: [penguinrandomhouse.com](https://www.penguinrandomhouse.com/books/689896/patriot-by-alexei-navalny/)"}, "physical_format": "ebook", "latest_revision": 3, "revision": 3, "created": {"type": "/type/datetime", "value": "2025-01-25T00:47:17.670489"}, "last_modified": {"type": "/type/datetime", "value": "2025-07-12T11:00:00.297455"}}}, "OLID:OL51807662M": {"bib_key": "OLID:OL51807662M", "info_url": "http://openlibrary.org/books/OL51807