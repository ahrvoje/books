ion": 5, "revision": 5, "created": {"type": "/type/datetime", "value": "2008-10-16T22:15:44.225619"}, "last_modified": {"type": "/type/datetime", "value": "2022-12-17T03:02:50.329756"}}}, "OLID:OL25978277M": {"bib_key": "OLID:OL25978277M", "info_url": "http://openlibrary.org/books/OL25978277M/The_Mummies_Of_U\u0308ru\u0308mchi", "preview": "borrow", "preview_url": "https://archive.org/details/mummiesofurumchi0000barb", "thumbnail_url": "https://covers.openlibrary.org/b/id/7497891-S.jpg", "details": {"publishers": ["W. W. Norton & Company"], "title": "The Mummies Of U\u0308ru\u0308mchi", "identifiers": {}, "covers": [7497891], "publish_date": "2000", "key": "/books/OL25978277M", "works": [{"key": "/works/OL1879848W"}], "type": {"key": "/type/edition"}, "isbn_13": ["9780393320190"], "classifications": {}, "source_records": ["bwb:9780393320190", "ia:mummiesofurumchi0000barb", "promise:bwb_daily_pallets_2022-03-17", "promise:bwb_daily_pallets_2021-05-21"], "ocaid": "mummiesofurumchi0000barb", "lc_classifications": ["GN778.32.C5 B37 2000"], "local_id": ["urn:bwbsku:O7-BPO-726", "urn:bwbsku:P7-BKL-597"], "latest_revision": 8, "revision": 8, "created": {"type": "/type/datetime", "value": "2016-10-14T03:30:10.869509"}, "last_modified": {"type": "/type/datetime", "value": "2023-01-14T18:56:30.465093"}}}, "OLID:OL358977M": {"bib_key": "OLID:OL358977M", "info_url": "http://openlibrary.org/books/OL358977M/The_mummies_of_U\u0308ru\u0308mchi", "preview": "borrow", "preview_url": "https://archive.org/details/mummiesofurumchi00barb", "thumbnail_url": "https://covers.openlibrary.org/b/id/10708239-S.jpg", "details": {"publishers": ["W.W. Norton & Company"], "number_of_pages": 240, "isbn_10": ["0393045218"], "subject_place": ["Tarim Basin (China)", "Xinjiang Uygur Zizhiqu (China)", "China", "Xinjiang Uygur Zizhiqu."], "covers": [10708239], "lc_classifications": ["GN778.32.C5 B37 1999", "GN778.32.C5B37 1999"], "key": "/books/OL358977M", "authors": [{"key": "/authors/OL225040A", "name": "E. J. W. Barber"}], "ocaid": "mummiesofurumchi00barb", "publish_places": ["New York"], "subjects": ["Mummies -- China -- Xinjiang Uygur Zizhiqu", "Bronze age -- China -- Xinjiang Uygur Zizhiqu", "Textile fabrics, Prehistoric -- China -- Xinjiang Uygur Zizhiqu", "Tarim Basin (China) -- Antiquities", "Xinjiang Uygur Zizhiqu (China) -- Antiquities"], "languages": [{"key": "/languages/eng"}], "pagination": "240 p. :", "source_records": ["marc:marc_records_scriblio_net/part27.dat:71348224:937", "marc:marc_ithaca_college/ic_marc.mrc:170908957:1315", "ia:mummiesofurumchi00barb", "marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run02.mrc:175850105:2227", "bwb:9780393045215", "marc:marc_loc_2016/BooksAll.2016.part27.utf8:14144213:939", "promise:bwb_daily_pallets_2023-11-03:O9-BIE-136", "marc:marc_columbia/Columbia-extract-20221130-005.mrc:306754509:3126", "marc:harvard_bibliographic_metadata/20220215_031.bib.mrc:206512641:2634"], "title": "The mummies of U\u0308ru\u0308mchi", "dewey_decimal_class": ["393/.3"], "notes": {"type": "/type/text", "value": "Includes bibliographical references and index."}, "identifiers": {"goodreads": ["1357556"], "librarything": ["147622"]}, "edition_name": "1st ed.", "lccn": ["98018958"], "local_id": ["urn:sfpl:31223053668241", "urn:sfpl:31223054026266", "urn:sfpl:31223054026274", "urn:sfpl:31223053668274", "urn:bwbsku:O9-BIE-136"], "publish_date": "1999", "publish_country": "nyu", "by_statement": "Elizabeth Wayland Barber.", "works": [{"key": "/works/OL1879848W"}], "type": {"key": "/type/edition"}, "oclc_numbers": ["39093534"], "description": {"type": "/type/text", "value": "In the museums of Urumchi, the wind-swept regional capital of the Uyghur Autonomous Region in Western China, a collection of ancient mummies date back as far as 4,000 years - contemporary to the famous Egyptian mummies, but even more beautifully preserved, especially their clothing. Surprisingly, these prehistoric people are not Asian but Caucasoid - tall and large-nosed and blond with thick beards and round eyes (probably blue). What were these blond Caucasians doing in the heart of Asia?\n\nWhere did they come from and what language did they speak? Might they be related to a \"lost tribe\" of Indo-Europeans known from later inscriptions? Few gifts are to be found in the graves of Urumchi, making it difficult for archaeologists to pinpoint cultural connections from clues offered by pottery and tools. But their clothes - woolens that rarely survive more than a few centurieshave been preserved as brightly hued as the day they were woven.\n\nElizabeth Wayland Barber describes these remarkable mummies, their clothing, their sheepherding ways, and their path to this remote, mysterious, and forbidding place. She pieces together their history and peculiar Western connections from both what she saw in Urumchi and the testimony of explorers who traveled along the Silk Road a century earlier."}, "latest_revision": 18, "revision": 18, "created": {"type": "/type/datetime", "value": "2008-04-01T03:28:50.625462"}, "last_modified": {"type": "/type/datetime", "value": "2026-02-19T21:54:30.330647"}}}, "OLID:OL45773711M": {"bib_key": "OLID:OL45773711M", "info_url": "http://openlibrary.org/books/OL45773711M/The_Mummies_of_Urumchi", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL45773711M/The_Mummies_of_Urumchi", "details": {"type": {"key": "/type/edition"}, "authors": [{"key": "/authors/OL3078690A", "name": "Elizabeth Barber"}], "isbn_10": ["0965684067"], "isbn_13": ["9780965684064"], "local_id": ["urn:bwbsku:W3-BMP-339"], "publish_date": "1999-01-01", "publishers": ["W.W. Norton"], "source_records": ["promise:bwb_daily_pallets_2021-08-19"], "title": "The Mummies of Urumchi", "full_title": "The Mummies of Urumchi", "works": [{"key": "/works/OL33800565W"}], "key": "/books/OL45773711M", "latest_revision": 1, "revision": 1, "created": {"type": "/type/datetime", "value": "2023-01-14T14:57:02.764634"}, "last_modi