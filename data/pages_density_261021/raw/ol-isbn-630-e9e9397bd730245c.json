26580-S.jpg", "details": {"number_of_pages": 404, "subtitle": "reexamining the life and legacy of America's most hated senator", "isbn_10": ["0684836254"], "subject_place": ["United States"], "covers": [426580], "ia_loaded_id": ["josephmccarthyre00herm"], "lc_classifications": ["E748.M143 H47 2000"], "url": ["http://www.loc.gov/catdir/bios/simon051/99037011.html", "http://www.loc.gov/catdir/description/simon032/99037011.html"], "subject_time": ["20th century."], "genres": ["Biography."], "source_records": ["marc:marc_records_scriblio_net/part28.dat:11703638:1210", "ia:josephmccarthyre00herm", "marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run02.mrc:196921918:1669", "marc:marc_loc_2016/BooksAll.2016.part28.utf8:5799534:1403", "ia:josephmccarthyre0000herm", "idb:9780684836256", "marc:marc_columbia/Columbia-extract-20221130-005.mrc:479833396:2769", "marc:harvard_bibliographic_metadata/20220215_035.bib.mrc:281424846:3547"], "title": "Joseph McCarthy", "languages": [{"key": "/languages/eng"}], "subjects": ["McCarthy, Joseph, 1908-1957", "United States. Congress. Senate -- Biography", "Legislators -- United States -- Biography", "Anti-communist movements -- United States -- History -- 20th century", "Internal security -- United States -- History -- 20th century"], "publish_country": "nyu", "by_statement": "Arthur Herman.", "type": {"key": "/type/edition"}, "uris": ["http://www.loc.gov/catdir/bios/simon051/99037011.html", "http://www.loc.gov/catdir/description/simon032/99037011.html"], "publishers": ["Free Press"], "ia_box_id": ["IA171501"], "key": "/books/OL43222M", "authors": [{"key": "/authors/OL28245A", "name": "Arthur Herman"}], "publish_places": ["New York"], "pagination": "404 p., [8] leaves of plates :", "uri_descriptions": ["Contributor biographical information", "Publisher description"], "dewey_decimal_class": ["973.921/092", "B"], "notes": {"type": "/type/text", "value": "Includes bibliographical references   (373-384 p.) and index."}, "i