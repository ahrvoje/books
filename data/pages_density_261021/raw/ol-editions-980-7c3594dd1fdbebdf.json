 ["New York"], "pagination": "xxiii, 907 p. :", "source_records": ["marc:marc_loc_2016/BooksAll.2016.part23.utf8:10700464:735", "bwb:9780451175731"], "title": "Best evidence", "dewey_decimal_class": ["364.1/523/092"], "notes": {"type": "/type/text", "value": "Includes bibliographical references and indexes."}, "number_of_pages": 907, "languages": [{"key": "/languages/eng"}], "lccn": ["93152137"], "subjects": ["Kennedy, John F. 1917-1963 -- Assassination."], "publish_date": "1992", "publish_country": "nyu", "by_statement": "David S. Lifton.", "works": [{"key": "/works/OL2596571W"}], "type": {"key": "/type/edition"}, "latest_revision": 7, "revision": 7, "created": {"type": "/type/datetime", "value": "2008-04-01T03:28:50.625462"}, "last_modified": {"type": "/type/datetime", "value": "2022-12-17T12:09:17.280005"}}}, "OLID:OL35088241M": {"bib_key": "OLID:OL35088241M", "info_url": "http://openlibrary.org/books/OL35088241M/Born_to_Run", "preview": "restricted", "preview_url": "https://archive.org/details/borntorunhiddent0000mcdo", "thumbnail_url": "https://covers.openlibrary.org/b/id/12063992-S.jpg", "details": {"description": {"type": "/type/text", "value": "An epic adventure that began with one simple question: Why does my foot hurt?\r\n\r\nIsolated by Mexico's deadly Copper Canyons, the blissful Tarahumara Indi- ans have honed the ability to run hundreds of miles without rest or injury.\r\n\r\nIn a riveting narrative, award-winning journalist and often-injured runner Christopher McDougall sets out to discover their secrets. In the process, he takes his readers from science labs at Harvard to the sun- baked valleys and freezing peaks across North America, where ever- growing numbers of ultra-runners are pushing their bodies to the limit, and, finally, to a climactic race in the Copper Canyons that pits America's best ultra-runners against the tribe. McDougall's incredible story will not only engage your mind but inspire your body when you realize that you, indeed all of 