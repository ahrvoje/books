/archive.org/details/stretchingschool0000unse", "thumbnail_url": "https://covers.openlibrary.org/b/id/7760222-S.jpg", "details": {"title": "Stretching The School Dollar How Schools And Districts Can Save Money While Serving Students Best", "publish_date": "2010", "publishers": ["Harvard Education Press"], "source_records": ["bwb:9781934742648", "marc:marc_loc_2016/BooksAll.2016.part38.utf8:150839444:954", "promise:bwb_daily_pallets_2022-04-15", "marc:harvard_bibliographic_metadata/ab.bib.12.20150123.full.mrc:419334318:1936", "marc:marc_nuls/NULS_PHC_180925.mrc:184829442:2118", "marc:harvard_bibliographic_metadata/20220215_008.bib.mrc:229541784:3102"], "lccn": ["2010931317"], "covers": [7760222], "isbn_13": ["9781934742648"], "lc_classifications": ["LB2825 .S726 2010"], "type": {"key": "/type/edition"}, "local_id": ["urn:bwbsku:W7-BQM-896", "urn:nuls:31786102650659"], "oclc_numbers": ["659712295"], "ocaid": "stretchingschool0000unse", "key": "/books/OL26118649M", "number_of_pages": 351, "works": [{"key": "/works/OL17529287W"}], "languages": [{"key": "/languages/eng"}], "description": {"type": "/type/text", "value": "Simultaneous pressures to reduce costs and increase student achievement have never been greater than they are today. Not only is cost-cutting essential in this era of tightened resources, argue Hess and Osberg, but eliminating inefficient spending is critical for freeing up resources to drive school reform. Stretching the School Dollar book brings together a dynamic group of authors--scholars, consultants, journalists, and entrepreneurs--who offer fresh insights into an issue no school or district can afford to ignore. --Publisher description."}, "latest_revision": 9, "revision": 9, "created": {"type": "/type/datetime", "value": "2016-10-14T17:51:59.405170"}, "last_modified": {"type": "/type/datetime", "value": "2025-07-09T14:46:00.033425"}}}, "OLID:OL36778851M": {"bib_key": "OLID:OL36778851M", "info_url": "http://openlibrary.org/books/OL36778851M/Stretch