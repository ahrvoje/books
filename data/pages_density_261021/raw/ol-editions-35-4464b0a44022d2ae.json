M": {"bib_key": "OLID:OL33911234M", "info_url": "http://openlibrary.org/books/OL33911234M/How_Minds_Change", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL33911234M/How_Minds_Change", "thumbnail_url": "https://covers.openlibrary.org/b/id/14760950-S.jpg", "details": {"type": {"key": "/type/edition"}, "authors": [{"key": "/authors/OL7153291A", "name": "David McRaney"}], "isbn_13": ["9781786075949"], "languages": [{"key": "/languages/eng"}], "lc_classifications": ["HM1176"], "number_of_pages": 352, "publish_date": "2022", "publishers": ["Oneworld Publications"], "source_records": ["bwb:9781786075949"], "subjects": ["Sociology"], "title": "How Minds Change", "subtitle": "The Science of Belief, Opinion and Persuasion", "full_title": "How Minds Change The Science of Belief, Opinion and Persuasion", "works": [{"key": "/works/OL21345941W"}], "key": "/books/OL33911234M", "covers": [14760950], "latest_revision": 2, "revision": 2, "created": {"type": "/type/datetime", "value": "2021-09-28T08:46:39.229556"}, "last_modified": {"type": "/type/datetime", "value": "2024-08-23T23:27:45.477327"}}}, "OLID:OL39552578M": {"bib_key": "OLID:OL39552578M", "info_url": "http://openlibrary.org/books/OL39552578M/How_Minds_Change", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL39552578M/How_Minds_Change", "thumbnail_url": "https://covers.openlibrary.org/b/id/15124646-S.jpg", "details": {"type": {"key": "/type/edition"}, "authors": [{"key": "/authors/OL7153291A", "name": "David McRaney"}], "languages": [{"key": "/languages/eng"}], "pagination": "xx, 330p.", "publish_date": "2023", "publishers": ["Oneworld Publications"], "source_records": ["bwb:9780861545681", "promise:bwb_daily_pallets_2024-12-20:KU-472-644"], "title": "How Minds Change", "subtitle": "The New Science of Belief, Opinion and Persuasion", "full_title": "How Minds Change The New Science of Belief, Opinion and Persuasion", "works": [{"key": "/works/OL21345941W"}], "key": "/books/OL39552578M", "identifiers": {}, "isbn_13": ["9780861545681"], "publish_places": ["Great Britain"], "copyright_date": "2022", "description": {"type": "/type/text", "value": "'In a time when too many minds seem closed, this is a masterful analysis of what it takes to open them'\r\n- Adam Grant, author of the bestselling *Think Again*\r\n\r\n'Fascinating'\r\n- *Daily Mail*\r\n\r\nYou might feel like the world is getting nastier and more polarised. But you could be the conversation away from changing someone's mind about something, maybe a lot of things.\r\n\r\nDavid McRaney sets out to discover not just what it takes to influence others, but why we believe in the first place. Along the way he meets a former Westboro Baptist Church member who was deradicalized on Twitter, finds a 9/11 Truther who turns his back on it all, and reveals how, within a few years, half a ciuntry can go from opposing the 'gay agenda' to happily attending same-sex weddings.\r\n\r\n*How Minds Change* reveals how beliefs take hold, not over hundred of years, but in less than a generation, in less than a decade, and sometimes in an instant."}, "physical_format": "Paperback", "first_sentence": {"type": "/type/text", "value": "We are about to go on a journey together to understand how minds change."}, "covers": [15124646], "local_id": ["urn:bwbsku:KU-472-644"], "latest_revision": 4, "revision": 4, "created": {"type": "/type/datetime", "value": "2022-09-17T16:39:21.992975"}, "last_modified": {"type": "/type/datetime", "value": "2025-10-01T08:29:47.324833"}}}, "OLID:OL33705370M": {"bib_key": "OLID:OL33705370M", "info_url": "http://openlibrary.org/books/OL33705370M/How_Minds_Change", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL33705370M/How_Minds_Change", "details": {"type": {"key": "/type/edition"}, "authors": [{"key": "/authors/OL7153291A", "name": "David McRaney"}], "isbn_13": ["9781786071644"], "languages": [{"key": "/languages/eng"}], "number_of_pages": 352, "publish_date": "2022", 