 "promise:bwb_daily_pallets_2020-07-07", "bwb:9780670034826", "marc:marc_columbia/Columbia-extract-20221130-012.mrc:100065681:2931", "marc:marc_nuls/NULS_PHC_180925.mrc:234383846:2261", "marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:833182086:1957", "ia:threecupsoftea0000greg", "marc:harvard_bibliographic_metadata/20220215_018.bib.mrc:132591179:4431"], "title": "Three Cups Of Tea", "covers": [9303565], "local_id": ["urn:phillips:31867003017865", "urn:sfpl:31223073734916", "urn:sfpl:31223118791434", "urn:sfpl:31223071369616", "urn:sfpl:31223067268194", "urn:sfpl:31223118791483", "urn:sfpl:31223118791475", "urn:sfpl:31223118791467", "urn:sfpl:31223118791459", "urn:sfpl:31223082099558", "urn:sfpl:31223118791442", "urn:sfpl:31223106870398", "urn:bwbsku:P6-BIX-825", "urn:nuls:31786102279939"], "publish_date": "2006", "key": "/books/OL24405749M", "works": [{"key": "/works/OL5702375W"}], "type": {"key": "/type/edition"}, "number_of_pages": 338, "identifiers": {}, "ocaid": "threecupsofteaon0000mort", "isbn_10": ["0670034827"], "lccn": ["2005043466"], "oclc_numbers": ["61859864", "427413735"], "classifications": {}, "lc_classifications": ["LC2330 .M67 2006", "LC2330.M67 2006"], "dewey_decimal_class": ["371.82209549"], "languages": [{"key": "/languages/eng"}], "description": {"type": "/type/text", "value": "One man's campaign to build schools in the most dangerous, remote, and anti-American reaches of Asia: in 1993 Greg Mortenson was an American mountain-climbing bum wandering emaciated and lost through Pakistan's Karakoram. After he was taken in and nursed back to health by the people of a Pakistani village, he promised to return one day and build them a school. From that rash, earnest promise grew one of the most incredible humanitarian campaigns of our time--Mortenson's one-man mission to counteract extremism by building schools, especially for girls, throughout the breeding ground of the Taliban. In a region where Americans are often feared and hated, he has survived kidnapping, fatwas issued by enraged mullahs, death threats, and wrenching separations from his wife and children. But his success speaks for itself--at last count, his Central Asia Institute had built fifty-five schools.--From publisher description."}, "latest_revision": 15, "revision": 15, "created": {"type": "/type/datetime", "value": "2010-11-07T15:23:07.120419"}, "last_modified": {"type": "/type/datetime", "value": "2025-10-07T14:44:58.926531"}}}, "OLID:OL49963415M": {"bib_key": "OLID:OL49963415M", "info_url": "http://openlibrary.org/books/OL49963415M/\u05e9\u05dc\u05d5\u05e9_\u05db\u05d5\u05e1\u05d5\u05ea_\u05ea\u05d4", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL49963415M/\u05e9\u05dc\u05d5\u05e9_\u05db\u05d5\u05e1\u05d5\u05ea_\u05ea\u05d4", "details": {"type": {"key": "/type/edition"}, "publish_date": "2008", "publish_country": "is", "languages": [{"key": "/languages/heb"}], "work_titles": ["Three cups of tea"], "title": "\u05e9\u05dc\u05d5\u05e9 \u05db\u05d5\u05e1\u05d5\u05ea \u05ea\u05d4", "other_titles": ["Shalosh kosot teh", "3 kosot teh"], "subtitle": "sheli\u1e25uto shel adam e\u1e25ad le-\u1e33adem et ha-shalom ... bet sefer e\u1e25ad be-khol pa\u02bbam", "by_statement": "Greg Mor\u1e6denson, Da\u1e7fid Oliver Relin ; me-Anglit Merav Miler", "authors": [{"key": "/authors/OL1434011A", "name": "Greg Mortenson"}], "oclc_numbers": ["261376764"], "contributions": ["Relin, David Oliver", "Miler, Merav"], "subjects": ["American Humanitarian assistance", "Girls' schools"], "subject_people": ["Greg Mortenson"], "subject_places": ["Afghanistan", "Pakistan"], "publishers": ["Ag'endah"], "publish_places": ["Ra\u1e33efet"], "pagination": "384 p.", "number_of_pages": 384, "source_records": ["marc:harvard_bibliographic_metadata/ab.bib.11.20150123.full.mrc:497774350:1157", "marc:harvard_bibliographic_metadata/20220215_018.bib.mrc:164198519:2075"], "works": [{"key": "/works/OL5702375W"}], "key": "/books/OL49963415M", "latest_revis