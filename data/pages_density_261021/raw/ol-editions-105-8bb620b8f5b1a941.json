48.483506"}, "source_records": ["bwb:9780520966154"], "title": "Greeks, Romans, Germans", "number_of_pages": 520, "isbn_13": ["9780520966154"], "created": {"type": "/type/datetime", "value": "2020-08-30T18:02:48.483506"}, "languages": [{"key": "/languages/eng"}], "full_title": "Greeks, Romans, Germans How the Nazis Usurped Europe's Classical Past", "lc_classifications": [""], "publish_date": "2016", "key": "/books/OL29747125M", "authors": [{"key": "/authors/OL6608855A", "name": "Johann Chapoutot"}], "latest_revision": 1, "works": [{"key": "/works/OL21132280W"}], "type": {"key": "/type/edition"}, "subjects": ["National socialism", "Civilization, classical", "Germany, history, 1933-1945"], "revision": 1}}, "OLID:OL28606739M": {"bib_key": "OLID:OL28606739M", "info_url": "http://openlibrary.org/books/OL28606739M/Greeks_Romans_Germans", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL28606739M/Greeks_Romans_Germans", "details": {"publishers": ["University of California Press"], "subtitle": "How the Nazis Usurped Europe's Classical Past", "source_records": ["bwb:9780520275720", "marc:harvard_bibliographic_metadata/20220215_034.bib.mrc:31297478:5741"], "title": "Greeks, Romans, Germans", "number_of_pages": 452, "isbn_13": ["9780520275720"], "languages": [{"key": "/languages/eng"}], "full_title": "Greeks, Romans, Germans How the Nazis Usurped Europe's Classical Past", "lc_classifications": ["DD256.6.C4313 2016", "DD256.6 .C4313 2016"], "publish_date": "2016", "key": "/books/OL28606739M", "authors": [{"key": "/authors/OL6608855A", "name": "Johann Chapoutot"}, {"key": "/authors/OL8090533A", "name": "Richard R. Nybakken"}], "works": [{"key": "/works/OL21132280W"}], "type": {"key": "/type/edition"}, "subjects": ["National socialism", "Civilization, classical", "Germany, history, 1933-1945"], "lccn": ["2016016557"], "oclc_numbers": ["945028474"], "description": {"type": "/type/text", "value": "\"Much has been written about the conditions that made possible Hitler's rise and the Nazi takeover of Germany, but when we tell the story of the National Socialist Party, should we not also speak of Julius Caesar and Pericles? Greeks, Romans, Germans argues that to fully understand the racist, violent end of the Nazi regime, we must examine its appropriation of the heroes and lessons of the ancient world. When Hitler told the assembled masses that they were a people with no past, he meant that they had no past following their humiliation in World War I of which to be proud. The Nazis' constant use of classical antiquity--in official speeches, film, state architecture, the press, and state-sponsored festivities--conferred on them the prestige and heritage of Greece and Rome that the modern German people so desperately needed. At the same time, the lessons of antiquity served as a warning: Greece and Rome fell because they were incapable of protecting the purity of their blood against mixing and infiltration. To regain their rightful place in the world, the Nazis had to make all-out war on Germany's enemies, within and without\"--Provided by publisher."}, "latest_revision": 2, "revision": 2, "created": {"type": "/type/datetime", "value": "2020-08-05T05:57:12.420168"}, "last_modified": {"type": "/type/datetime", "value": "2026-03-27T12:01:57.369214"}}}, "OLID:OL3179378M": {"bib_key": "OLID:OL3179378M", "info_url": "http://openlibrary.org/books/OL3179378M/Influence", "preview": "borrow", "preview_url": "https://archive.org/details/influencehowwhyp0000cial", "thumbnail_url": "https://covers.openlibrary.org/b/id/14633417-S.jpg", "details": {"publishers": ["Morrow"], "number_of_pages": 302, "subtitle": "how and why people agree to things", "covers": [14633417, 14622878, 10934185], "key": "/books/OL3179378M", "authors": [{"key": "/authors/OL709877A", "name": "Robert B. Cialdini"}], "publish_places": ["New York"], "subjects": ["Persuasion (Psychology)", "Influence (Psychology)"], "languages": [{"key": "/languages/eng"}], "pagination": "30