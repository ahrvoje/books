{"ISBN:0198570643": {"bib_key": "ISBN:0198570643", "info_url": "http://openlibrary.org/books/OL7401198M/Ludwig_Boltzmann", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL7401198M/Ludwig_Boltzmann", "thumbnail_url": "https://covers.openlibrary.org/b/id/1136496-S.jpg", "details": {"publishers": ["Oxford University Press, USA"], "identifiers": {"librarything": ["1115166"], "goodreads": ["264477"]}, "subtitle": "The Man Who Trusted Atoms", "covers": [1136496], "lc_classifications": ["QC16", "QC16.B64 C47 2006"], "key": "/books/OL7401198M", "authors": [{"key": "/authors/OL20834A", "name": "Carlo Cercignani"}], "contributions": ["Roger Penrose (Foreword)"], "languages": [{"key": "/languages/eng"}], "source_records": ["bwb:9780198570646", "promise:bwb_daily_pallets_2023-01-24:P8-AQW-279", "idb:9780198570646", "marc:harvard_bibliographic_metadata/ab.bib.13.20150123.full.mrc:636947001:1177"], "title": "Ludwig Boltzmann", "number_of_pages": 348, "isbn_13": ["9780198570646"], "isbn_10": ["0198570643"], "publish_date": "February 10, 2006", "works": [{"key": "/works/OL14855265W"}], "type": {"key": "/type/edition"}, "first_sentence": {"type": "/type/text", "value": "The existence of irreversible processes is well known from everyday life: one cannot go backwards in time."}, "local_id": ["urn:bwbsku:P8-AQW-279"], "description": {"type": "/type/text", "value": "Aimed at scientists, historians, philosophers of science and the general public interested in his work, this is a biography of Ludwig Boltzmann, a seminal figure in the foundations of modern science."}, "latest_revision": 13, "revision": 13, "created": {"type": "/type/datetime", "value": "2008-04-29T13:35:46.876380"}, "last_modified": {"type": "/type/datetime", "value": "2025-03-28T17:52:32.469975"}}}, "ISBN:0684851865": {"bib_key": "ISBN:0684851865", "info_url": "http://openlibrary.org/books/OL7722103M/Boltzmanns_Atom", "preview": "restricted", "preview_url": "https://archive.org/details/isbn_9780684851860", "thumbnail_url": "https://covers.openlibrary.org/b/id/427536-S.jpg", "details": {"publishers": ["Free Press"], "number_of_pages": 272, "subtitle": "The Great Debate That Launched A Revolution In Physics", "weight": "1 pounds", "covers": [427536], "local_id": ["urn:trent:0116404629887", "urn:phillips:31867000891106", "urn:scms:0188600218997", "urn:nuls:31786101486618"], "physical_format": "Hardcover", "key": "/books/OL7722103M", "authors": [{"key": "/authors/OL2631432A", "name": "David Lindley - undifferentiated"}], "languages": [{"key": "/languages/eng"}], "first_sentence": "ON DECEMBER 11, 1845, A LENGTHY MANUSCRIPT arrived in the London offices of the Royal Society, the highest scientific association in Great Britain.", "source_records": ["amazon:0684851865", "marc:marc_ithaca_college/ic_marc.mrc:187531459:1517", "marc:OpenLibraries-Trent-MARCs/tier4.mrc:5319227:995", "ia:isbn_9780684851860", "marc:marc_openlibraries_phillipsacademy/PANO_FOR_IA_05072019.mrc:55150275:1876", "marc:marc_loc_2016/BooksAll.2016.part01.utf8:17188498:1202", "ia:boltzmannsatomgr0000lind", "marc:marc_scms/20220805_ADAM_MARC_records.mrc:7396437:2324", "marc:marc_nuls/NULS_PHC_180925.mrc:154957078:1103", "bwb:9780684851860", "marc:harvard_bibliographic_metadata/20220215_043.bib.mrc:54869956:3136"], "title": "Boltzmanns Atom", "identifiers": {"librarything": ["604613"], "goodreads": ["309719"]}, "edition_name": "1st edition", "subjects": ["Atomic & molecular physics", "Popular science", "20th century", "Boltzmann, Ludwig,", "Atomic And Nuclear Physics", "History Of Physics", "Scientists - General", "Science", "Physics", "Science/Mathematics", "Physicists", "History", "Science / Physics", "1844-1906", "19th century", "Atomic theory", "Austria", "Biography"], "publish_date": "January 18, 2001", "works": [{"key": "/works/OL17976165W"}], "type": {"key": "/type/edition"}, "physical_dimensions": "8.6 x 5.6 x 1 inches", "ocaid": "isbn_9780684851860", "isbn_10": ["0684851865"], "isbn_13": ["9780684851860"], "lccn": ["00032167"], "classifications": {}, "lc_classifications": ["QC16.B64 L56 2001", "QC 16 .B64 L56 2001", "QC 16 B64 L56 2001", "QC16.B64L56 2001"], "oclc_numbers": ["44118328"], "description": {"type": "/type/text", "value": "\"Now writer David Lindley portrays the dramatic story of Boltzmann and his embrace of the atom, while providing a window on the civilized world that gave birth to our scientific era. Boltzmann emerges as an endearingly quixotic character, passionately inspired by Beethoven, who muddled through the practical matters of life in a European gilded age. Boltzmann's story reaches from fin de siecle Vienna, across Germany and Britain, to America. As the Habsburg Empire was crumbling, Germany's intellectual might was growing; Edinburgh in Scotland was one of the most intellectually fertile places on earth; and, in America, brilliant independent minds were beginning to draw on the best ideas of the bureaucratized old world.\"--Jacket."}, "latest_revision": 18, "revision": 18, "created": {"type": "/type/datetime", "value": "2008-04-29T15:03:11.581851"}, "last_modified": {"type": "/type/datetime", "value": "2026-07-04T03:00:01.065237"}}}, "ISBN:0387971807": {"bib_key": "ISBN:0387971807", "info_url": "http://openlibrary.org/books/OL1871770M/Joseph_Liouville_1809-1882_master_of_pure_and_applied_mathematics", "preview": "restricted", "preview_url": "https://archive.org/details/josephliouville10000lutz", "thumbnail_url": "https://covers.openlibrary.org/b/id/9621196-S.jpg", "details": {"publishers": ["Springer-Verlag"], "identifiers": {"goodreads": ["4469406"]}, "isbn_10": ["0387971807"], "subject_place": ["France"], "covers": [9621196], "lc_classifications": ["QA29.L62 J67 1990", "QA21-27D1-DX301"], "key": "/books/OL1871770M", "authors": [{"key": "/authors/OL889662A", "name": "Jesper Lu\u0308tzen"}], "ocaid": "josephliouville10000lutz", "publish_places": ["New York"], "subjects": ["Liouville, Joseph, 1809-1882", "Mathematicians -- France