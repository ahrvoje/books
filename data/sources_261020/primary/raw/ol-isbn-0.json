"}}}, "ISBN:0199655987": {"bib_key": "ISBN:0199655987", "info_url": "http://openlibrary.org/books/OL28482122M/Galileo", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL28482122M/Galileo", "thumbnail_url": "https://covers.openlibrary.org/b/id/13903418-S.jpg", "details": {"publishers": ["Oxford University Press"], "source_records": ["bwb:9780199655984", "amazon:0199655987"], "title": "Galileo", "number_of_pages": 528, "isbn_13": ["9780199655984"], "languages": [{"key": "/languages/eng"}], "full_title": "Galileo", "lc_classifications": ["QB36.G2"], "publish_date": "2012", "key": "/books/OL28482122M", "authors": [{"key": "/authors/OL394210A", "name": "J. L. Heilbron"}], "works": [{"key": "/works/OL15979757W"}], "type": {"key": "/type/edition"}, "subjects": ["Astronomers", "Scientists, biography", "Italy, biography", "Galilei, galileo, 1564-1642"], "covers": [13903418], "latest_revision": 4, "revision": 4, "created": {"type": "/type/datetime", "value": "2020-08-03T01:52:28.904951"}, "last_modified": {"type": "/type/datetime", "value": "2024-06-17T21:49:13.646248"}}}, "ISBN:0226469298": {"bib_key": "ISBN:0226469298", "info_url": "http://openlibrary.org/books/OL1084835M/Between_Copernicus_and_Galileo", "preview": "restricted", "preview_url": "https://archive.org/details/isbn_9780226469294", "thumbnail_url": "https://covers.openlibrary.org/b/id/1148140-S.jpg", "details": {"publishers": ["University of Chicago Press"], "identifiers": {"goodreads": ["7227192", "1417221"], "librarything": ["3185110"]}, "subtitle": "Christoph Clavius and the collapse of Ptolemaic cosmology", "isbn_10": ["0226469271", "0226469298"], "covers": [1148140, 1148138], "lc_classifications": ["QB981 .L32 1994", "QB981.L32 1994"], "key": "/books/OL1084835M", "authors": [{"key": "/authors/OL577686A", "name": "James M. Lattis"}], "ocaid": "isbn_9780226469294", "publish_places": ["Chicago"], "lccn": ["94008675"], "uri_descriptions": ["Publisher description", "Table of contents"], "pagination": "xix, 293 p. :", "source_records": ["ia:isbn_9780226469294", "bwb:9780226469270", "bwb:9780226469294", "marc:marc_loc_2016/BooksAll.2016.part23.utf8:121393689:1062", "marc:marc_columbia/Columbia-extract-20221130-004.mrc:66602066:2447", "marc:harvard_bibliographic_metadata/20220215_012.bib.mrc:287388174:3640"], "title": "Between Copernicus and Galileo", "url": ["http://www.loc.gov/catdir/description/uchi052/94008675.html", "http://www.loc.gov/catdir/toc/uchi051/94008675.html"], "notes": {"type": "/type/text", "value": "Includes bibliographical references (p. 265-284) and index."}, "number_of_pages": 293, "languages": [{"key": "/languages/eng"}], "dewey_decimal_class": ["523.1"], "subjects": ["Clavius, Christoph, 1538-1612.", "Ptolemy, 2nd cent.", "Cosmology, Medieval.", "Astronomy, Medieval."], "publish_date": "1994", "publish_country": "ilu", "by_statement": "James M. Lattis.", "works": [{"key": "/works/OL3466137W"}], "type": {"key": "/type/edition"}, "uris": ["http://www.loc.gov/catdir/description/uchi052/94008675.html", "http://www.loc.gov/catdir/toc/uchi051/94008675.html"], "oclc_numbers": ["29953006"], "description": {"type": "/type/text", "value": "Between Copernicus and Galileo is the story of Christoph Clavius, the Jesuit astronomer who played a central role in integrating traditional Ptolemaic astronomy and Aristotelian world views into the Church's accepted teachings. When Galileo first collided with the Church over his own work, he was in effect combatting a cosmological and intellectual agenda Clavius had worked to create, and a coterie of Church intellectuals Clavius had helped to educate.\n\nBy tracing Clavius's views from their medieval origins into the seventeenth century, Lattis illuminates the conceptual shift from Ptolemaic to Copernican astronomy and the social, intellectual, and theological impact of the Scientific Revolution."}, "latest_revision": 13, "revision": 13, "created": {"type": "/type/datetime", "value": "2008-04-01T03:28:50.6254