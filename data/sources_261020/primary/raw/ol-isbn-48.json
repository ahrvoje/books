ttps://archive.org/details/mathematicsoftim0000step", "thumbnail_url": "https://covers.openlibrary.org/b/id/8692367-S.jpg", "details": {"publishers": ["Springer-Verlag"], "subtitle": "essays on dynamical systems, economic processes and related topics", "covers": [8692367], "key": "/books/OL21346057M", "authors": [{"key": "/authors/OL4836798A", "name": "Stephen Smale"}], "publish_places": ["New York"], "source_records": ["ia:mathematicstimee00smal", "bwb:9780387905198", "promise:bwb_daily_pallets_2022-10-10", "marc:harvard_bibliographic_metadata/ab.bib.13.20150123.full.mrc:955980446:1409", "ia:mathematicsoftim0000step"], "title": "The mathematics of time", "identifiers": {"goodreads": ["5470445"], "librarything": ["1925756"]}, "languages": [{"key": "/languages/eng"}], "isbn_10": ["0387905197"], "publish_date": "1980", "publish_country": "xxu", "by_statement": "Stephen Smale.", "works": [{"key": "/works/OL11507865W"}], "type": {"key": "/type/edition"}, "lc_classifications": ["QA273.A1-274.9", "QA274-274.9"], "local_id": ["urn:bwbsku:O8-CPY-579"], "number_of_pages": 151, "ocaid": "mathematicsoftim0000step", "latest_revision": 10, "revision": 10, "created": {"type": "/type/datetime", "value": "2008-11-02T02:00:06.085280"}, "last_modified": {"type": "/type/datetime", "value": "2025-05-07T14:20:22.107877"}}}, "ISBN:0857291149": {"bib_key": "ISBN:0857291149", "info_url": "http://openlibrary.org/books/OL25982946M/A_Short_History_Of_Mathematical_Population_Dynamics", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL25982946M/A_Short_History_Of_Mathematical_Population_Dynamics", "thumbnail_url": "https://covers.openlibrary.org/b/id/7506626-S.jpg", "details": {"publishers": ["Springer"], "source_records": ["marc:marc_loc_2016/BooksAll.2016.part38.utf8:306115422:3784", "bwb:9780857291141", "marc:harvard_bibliographic_metadata/ab.bib.12.20150123.full.mrc:549636765:3763", "marc:harvard_bibliographic_metadata/20220215_024.bib.mrc:281365420:4822"], "title": "A Short History Of Mathematical Population Dynamics", "lccn": ["2011377450"], "identifiers": {}, "covers": [7506626], "isbn_13": ["9780857291141"], "lc_classifications": ["HB849.51 .B33 2011", "QA21-27QH323.5QH455Q"], "publish_date": "2010", "key": "/books/OL25982946M", "works": [{"key": "/works/OL17401895W"}], "type": {"key": "/type/edition"}, "oclc_numbers": ["668190697"], "languages": [{"key": "/languages/eng"}], "description": {"type": "/type/text", "value": "This book traces the history of population dynamics--a theoretical subject closely connected to genetics, ecology, epidemiology and demography--where mathematics has brought significant insights. It presents an overview of the genesis of several important themes: exponential growth, from Euler and Malthus to the Chinese one-child policy; the development of stochastic models, from Mendel's laws and the question of extinction of family names to percolation theory for the spread of epidemics, and chaotic populations, where determinism and randomness intertwine. From a different perspective, it also shows the problems that scientists face when governments ask for reliable predictions to help control epidemics (AIDS, SARS, swine flu), manage renewable resources (fishing quotas, spread of genetically modified organisms) or anticipate demographic evolutions such as aging. -- from Back Cover"}, "number_of_pages": 160, "latest_revision": 6, "revision": 6, "created": {"type": "/type/datetime", "value": "2016-10-14T03:57:25.556581"}, "last_modified": {"type": "/type/datetime", "value": "2025-12-08T21:16:54.871309"}}}, "ISBN:0199219222": {"bib_key": "ISBN:0199219222", "info_url": "http://openlibrary.org/books/OL16754355M/On_the_origin_of_species", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL16754355M/On_the_origin_of_species", "thumbnail_url": "https://covers.openlibrary.org/b/id/9726232-S.jpg", "details": {"publishers": ["Oxford University Press"], "series": ["Oxford world's classics"], "covers": [