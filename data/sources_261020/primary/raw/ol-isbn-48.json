publishers": ["Waveland Press"], "number_of_pages": 637, "weight": "2.8 pounds", "covers": [1933291], "physical_format": "Hardcover", "key": "/books/OL9581365M", "authors": [{"key": "/authors/OL31679A", "name": "Robert B. Ekelund Jr."}, {"key": "/authors/OL2663556A", "name": "Robert F. Hebert"}], "subjects": ["Business & Economics", "Business / Economics / Finance", "Business/Economics", "General", "Reference - General", "Economics", "History"], "edition_name": "5 edition", "languages": [{"key": "/languages/eng"}], "source_records": ["amazon:1577664868:2-an:608858021:200146", "marc:marc_loc_updates/v35.i24.records.utf8:14219490:700", "marc:marc_loc_2016/BooksAll.2016.part34.utf8:173262801:700", "promise:bwb_daily_pallets_2023-02-08:W8-AAQ-819", "promise:bwb_daily_pallets_2023-03-06:T3-AFB-867", "ia:historyofeconomi0000ekel_q1f6"], "title": "A History of Economic Theory and Method", "identifiers": {"goodreads": ["3004609"], "librarything": ["1660015"]}, "isbn_13": ["9781577664864"], "isbn_10": ["1577664868"], "publish_date": "November 30, 2007", "works": [{"key": "/works/OL18751089W"}], "type": {"key": "/type/edition"}, "physical_dimensions": "9.4 x 7.1 x 1.5 inches", "lccn": ["2007274568"], "lc_classifications": ["HB75 .E47 2007"], "local_id": ["urn:bwbsku:W8-AAQ-819", "urn:bwbsku:T3-AFB-867"], "ocaid": "historyofeconomi0000ekel_q1f6", "latest_revision": 11, "revision": 11, "created": {"type": "/type/datetime", "value": "2008-04-30T09:38:13.731961"}, "last_modified": {"type": "/type/datetime", "value": "2023-06-28T04:35:31.232939"}}}, "ISBN:0674023382": {"bib_key": "ISBN:0674023382", "info_url": "http://openlibrary.org/books/OL7691827M/Evolutionary_Dynamics", "preview": "noview", "preview_url": "https://archive.org/details/evolutionarydyna00nowa", "thumbnail_url": "https://covers.openlibrary.org/b/id/412699-S.jpg", "details": {"publishers": ["Belknap Press", "Belknap Press of Harvard University Press"], "number_of_pages": 384, "subtitle": "Exploring the Equations of Life", "weight": "2.5 pounds", "covers": [412699], "physical_format": "Hardcover", "key": "/books/OL7691827M", "authors": [{"key": "/authors/OL2667420A", "name": "Martin A. Nowak"}], "ocaid": "evolutionarydyna00nowa", "subjects": ["Evolution", "Mathematical models", "Science", "Science/Mathematics", "Life Sciences - Evolution", "Science / Evolution", "Life Sciences - Biology - General", "Evolution (Biology)"], "isbn_13": ["9780674023383"], "source_records": ["amazon:0674023382:cg:69181731:234108", "marc:marc_loc_updates/v35.i14.records.utf8:9555450:978", "ia:evolutionarydyna00nowa", "ia:evolutionarydyna00nowa_495", "ia:evolutionarydyna00nowa_778", "bwb:9780674023383", "marc:marc_loc_2016/BooksAll.2016.part33.utf8:144348514:978", "marc:marc_columbia/Columbia-extract-20221130-013.mrc:104406304:1672", "promise:bwb_daily_pallets_2023-03-23:P8-CZD-008", "ia:evolutionarydyna0000nowa", "marc:harvard_bibliographic_metadata/ab.bib.10.20150123.full.mrc:39199649:903", "marc:harvard_bibliographic_metadata/20220215_019.bib.mrc:223442027:4693"], "title": "Evolutionary Dynamics", "identifiers": {"goodreads": ["204688"], "librarything": ["1712391"]}, "languages": [{"key": "/languages/eng"}], "isbn_10": ["0674023382"], "publish_date": "September 29, 2006", "works": [{"key": "/works/OL8012945W"}], "type": {"key": "/type/edition"}, "physical_dimensions": "9.3 x 6.7 x 1.4 inches", "lccn": ["2006042693"], "lc_classifications": ["QH371.3.M37 N69 2006", "QH371.3.M37N69 2006"], "oclc_numbers": ["64688986"], "local_id": ["urn:bwbsku:P8-CZD-008"], "description": {"type": "/type/text", "value": "\"At a time of unprecedented expansion in the life sciences, evolution is the one theory that transcends all of biology. Any observation of a living system must ultimately be interpreted in the context of its evolution. Evolutionary change is the consequence of mutation and natural selection, which are two concepts that can be described by mathematical equations. Evolutionary Dynamics is concerned with these equations of life. In this book, Martin A. Nowak draws on the languages of biology and mathematics to outline the mathematical principles according to which life evolves. His work introduces readers to the powerful yet simple laws that govern the evolution of living systems, no matter how complicated they might seem. Evolution has become a mathematical theory, Nowak suggests, and any idea of an evolutionary process or mechanism should be studied in the context of the mathematical equations of evolutionary dynamics. His book presents a range of analytical tools that can be used to this end: fitness landscapes, mutation matrices, genomic sequence space, random drift, quasispecies, replicators, the Prisoner's Dilemma, games in finite and infinite populations, evolutionary graph theory, games on grids, evolutionary kaleidoscopes, fractals, and spatial chaos. Nowak then shows how evolutionary dynamics applies to critical real-world problems, including the progression of viral diseases such as AIDS, the virulence of infectious agents, the unpredictable mutations that lead to cancer, the evolution of altruism, and even the evolution of human language. His book makes a clear and compelling case for understanding every living system--and everything that arises as a consequence of living systems--in terms of evolutionary dynamics.\"--Publisher's website."}, "latest_revision": 18, "revision": 18, "created": {"type": "/type/datetime", "value": "2008-04-29T15:03:11.581851"}, "last_modified": {"type": "/type/datetime", "value": "2025-10-22T21:30:34.822459"}}}, "ISBN:0226684733": {"bib_key": "ISBN:0226684733", "info_url": "http://openlibrary.org/books/OL9823754M/Sewall_Wright_and_Evolutionary_Biology", "preview": "restricted", "preview_url": "https://archive.org/details/sewallwrightevol00will", "thumbnail_url": "https://covers.openlibrary.org/b/id/142589-S.jpg", "details": {"publishers": ["University Of Chicago Press"], "identifiers": {"goodreads": ["2841084"], "libraryth