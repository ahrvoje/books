{"ISBN:0198716745": {"bib_key": "ISBN:0198716745", "info_url": "http://openlibrary.org/books/OL28535784M/Energy_the_Subtle_Concept", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL28535784M/Energy_the_Subtle_Concept", "thumbnail_url": "https://covers.openlibrary.org/b/id/13942666-S.jpg", "details": {"publishers": ["Oxford University Press", "Oxford University Press, USA"], "subtitle": "The Discovery of Feynman's Blocks from Leibniz to Einstein", "full_title": "Energy, the Subtle Concept The Discovery of Feynman's Blocks from Leibniz to Einstein", "lc_classifications": ["QC72", "QC72 .C66 2015"], "key": "/books/OL28535784M", "authors": [{"key": "/authors/OL6864340A", "name": "Jennifer Coopersmith"}], "isbn_13": ["9780198716747"], "source_records": ["bwb:9780198716747", "marc:marc_loc_2016/BooksAll.2016.part42.utf8:217540146:1115", "amazon:0198716745"], "title": "Energy, the Subtle Concept", "lccn": ["2015930102"], "number_of_pages": 416, "languages": [{"key": "/languages/eng"}], "subjects": ["Force and energy"], "publish_date": "2015", "works": [{"key": "/works/OL19847444W"}], "type": {"key": "/type/edition"}, "covers": [13942666], "latest_revision": 3, "revision": 3, "created": {"type": "/type/datetime", "value": "2020-08-03T23:27:30.665004"}, "last_modified": {"type": "/type/datetime", "value": "2023-04-13T17:03:36.024357"}}}, "ISBN:1888009322": {"bib_key": "ISBN:1888009322", "info_url": "http://openlibrary.org/books/OL12182522M/Mechanics_from_Aristotle_to_Einstein", "preview": "borrow", "preview_url": "https://archive.org/details/mechanicsfromari0000crow", "thumbnail_url": "https://covers.openlibrary.org/b/id/3029404-S.jpg", "details": {"publishers": ["Green Lion Press"], "identifiers": {"librarything": ["5036613"], "goodreads": ["2651010"]}, "weight": "1.4 pounds", "covers": [3029404], "physical_format": "Paperback", "lc_classifications": ["QA802.C76 2007", "QA802 .C76 2007"], "key": "/books/OL12182522M", "authors": [{"key": "/authors/OL19634A", "name": "Michael J. Crowe"}], "subjects": ["Science / Physics"], "isbn_13": ["9781888009323"], "source_records": ["amazon:1888009322", "bwb:9781888009323", "marc:marc_loc_2016/BooksAll.2016.part35.utf8:81978250:825", "ia:mechanicsfromari0000crow", "promise:bwb_daily_pallets_2022-03-17", "promise:bwb_daily_pallets_2021-05-21", "marc:harvard_bibliographic_metadata/ab.bib.11.20150123.full.mrc:382695084:795", "marc:harvard_bibliographic_metadata/20220215_035.bib.mrc:202332193:8423"], "title": "Mechanics from Aristotle to Einstein", "number_of_pages": 354, "languages": [{"key": "/languages/eng"}], "isbn_10": ["1888009322"], "publish_date": "July 16, 2007", "works": [{"key": "/works/OL55057W"}], "type": {"key": "/type/edition"}, "physical_dimensions": "9.8 x 7 x 0.9 inches", "lccn": ["2007925664"], "ocaid": "mechanicsfromari0000crow", "local_id": ["urn:bwbsku:P7-DJO-428", "urn:bwbsku:O6-CJD-296"], "oclc_numbers": ["190850886"], "description": {"type": "/type/text", "value": "Mechanics, the science of moving bodies and their interactions, is among the finest accomplishments of western civilization. This is the story of development, from the ground-breaking attempts of the Greeks, through the brilliant abstractions of medieval logicians, to the breathtaking achievements of Galileo, Huygens, and Newton, to the dazzling virtuosity of Maxwell and Einstein. Crowe's presentation allows the reader to appreciate this story from the inside, following the thoughts of the original authors in their own words. Ample commentary places these scientific giants in their context and helps modern readers understand the unfamiliar modes of expression of earlier times. In the course of telling the story, this book also provides a practical introduction to mechanics, with sample computations and problems in both classical physics and relativistic kinematics."}, "latest_revision": 14, "revision": 14, "created": {"type": "/type/datetime", "value": "2008-04-30T20:50:18.033121"}, "last_modified