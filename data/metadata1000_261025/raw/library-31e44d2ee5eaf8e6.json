h_date":"2018","key":"/books/OL26456619M","works":[{"key":"/works/OL17825802W"}],"type":{"key":"/type/edition"},"source_records":["bwb:9781501135927"],"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2018-06-04T21:45:15.404072"},"last_modified":{"type":"/type/datetime","value":"2021-12-27T06:10:49.815352"}}},"OLID:OL27003943M":{"bib_key":"OLID:OL27003943M","info_url":"http://openlibrary.org/books/OL27003943M/Nunca_te_pares_autobiografía_del_fundador_de_Nike_-_2._edición","preview":"noview","preview_url":"http://openlibrary.org/books/OL27003943M/Nunca_te_pares_autobiografía_del_fundador_de_Nike_-_2._edición","thumbnail_url":"https://covers.openlibrary.org/b/id/8596787-S.jpg","details":{"publishers":["Conecta","CONECTA"],"title":"Nunca te pares: autobiografía del fundador de Nike - 2. edición","identifiers":{},"covers":[8596787],"isbn_13":["9788416029778"],"publish_date":"2016","key":"/books/OL27003943M","works":[{"key":"/works/OL17825802W"}],"type":{"key":"/type/edition"},"source_records":["amazon:8416029776"],"number_of_pages":432,"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2019-06-13T20:15:15.145313"},"last_modified":{"type":"/type/datetime","value":"2026-01-27T04:58:05.277635"}}},"OLID:OL27206755M":{"bib_key":"OLID:OL27206755M","info_url":"http://openlibrary.org/books/OL27206755M/Shoe_dog","preview":"restricted","preview_url":"https://archive.org/details/shoedogmemoirbyc0000knig","thumbnail_url":"https://covers.openlibrary.org/b/id/15178238-S.jpg","details":{"description":{"type":"/type/text","value":"\"In this candid and riveting memoir, for the first time ever, Nike founder and CEO Phil Knight shares the inside story of the company's early days as an intrepid start-up and its evolution into one of the world's most iconic, game-changing, and profitable brands. In 1962, fresh out of business school, Phil Knight borrowed $50 from his father and created a company with a simple mission: import high-quality, low-cost athletic shoes from Japan. Selling the shoes from the trunk of his lime green Plymouth Valiant, Knight grossed $8,000 his first year. Today, Nike's annual sales top $30 billion. In an age of startups, Nike is the ne plus ultra of all startups, and the swoosh has become a revolutionary, globe-spanning icon, one of the most ubiquitous and recognizable symbols in the world today. But Knight, the man behind the swoosh, has always remained a mystery. Now, for the first time, in a memoir that is candid, humble, gutsy, and wry, he tells his story, beginning with his crossroads moment. At 24, after backpacking around the world, he decided to take the unconventional path, to start his own business--a business that would be dynamic, different. Knight details the many risks and daunting setbacks that stood between him and his dream--along with his early triumphs. Above all, he recalls the formative relationships with his first partners and employees, a ragtag group of misfits and seekers who became a tight-knit band of brothers. Together, harnessing the transcendent power of a shared mission, and a deep belief in the spirit of sport, they built a brand that changed everything\"--"},"title":"Shoe dog","subtitle":"a memoir by the creator of Nike","authors":[{"key":"/authors/OL6787957A","name":"Phil Knight"}],"publish_date":"2016","local_id":["urn:sfpl:31223114776116","urn:sfpl:31223114776124","urn:sfpl:31223116658841","urn:sfpl:31223114776017","urn:sfpl:31223117761651","urn:sfpl:31223116658858","urn:sfpl:31223114776082","urn:sfpl:31223114776108","urn:sfpl:31223117761636","urn:sfpl:31223117194770","urn:sfpl:31223116658825","urn:sfpl:31223116658833","urn:sfpl:31223117761677","urn:sfpl:31223117761735","urn:sfpl:31223117761628","urn:sfpl:31223125773276","urn:sfpl:31223117761693","urn:sfpl:31223114776009","urn:sfpl:31223116658866","urn:sfpl:31223114776132","urn:sfpl:31223117761644","urn:sfpl:31223117761727","urn:sfpl:31223114776140","urn:sfpl:31223117761701","urn:sfpl:31223117760802","urn:sfpl:31223114776025","urn:sfpl:31223117761719","urn:sfpl:31223117761743","urn:sfpl:31223117761750","urn:sfpl:31223117761669","urn:sfpl:31223114776157"],"copyright_date":"2016","full_title":"Shoe dog a memoir by the creator of Nike","lc_classifications":["HD9992.U52 K555 2016","HD9992.U52K555 2016"],"subjects":["Sporting goods industry","Nike (Firm)","Businesspeople","Biography","History"],"languages":[{"key":"/languages/eng"}],"pagination":"386 pages","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run05.mrc:302475292:9780","bwb:9781501135910","ia:shoedogmemoirbyc0000knig","marc:marc_columbia/Columbia-extract-20221130-027.mrc:56584677:7153","marc:marc_nuls/NULS_PHC_180925.mrc:10314795:2146","marc:harvard_bibliographic_metadata/20220215_067.bib.mrc:79626424:8599"],"lccn":["2016010080"],"isbn_13":["9781501135910"],"edition_name":"First Scribner hardcover edition.","dewey_decimal_class":["338.7/68876092","B"],"subject_places":["United States"],"isbn_10":["1501135910"],"subject_people":["Philip H. Knight (1938-)"],"publish_country":"nyu","by_statement":"Phil Knight","oclc_numbers":["945804148"],"type":{"key":"/type/edition"},"ocaid":"shoedogmemoirbyc0000knig","key":"/books/OL27206755M","number_of_pages":386,"works":[{"key":"/works/OL17825802W"}],"covers":[15178238,-1],"publishers":["Scribner, an imprint of Simon & Schuster, Inc."],"latest_revision":13,"revision":13,"created":{"type":"/type/datetime","value":"2019-07-19T12:03:51.701782"},"last_modified":{"type":"/type/datetime","value":"2026-03-10T18:52:03.532675"}}},"OLID:OL27237517M":{"bib_key":"OLID:OL27237517M","info_url":"http://openlibrary.org/books/OL27237517M/Nunca_te_pares","preview":"borrow","preview_url":"https://archive.org/details/nuncateparesauto0000knig","thumbnail_url":"https://covers.openlibrary.org/b/id/15178236-S.jpg","details":{"description":{"type":"/type/text","value":"In this candid and riveting memoir, for the first time ever, Nike founder and CEO Phil Knight shares the inside story of the company's early days as an intrepid start-up and its evolution into one of the world's most iconic, game-changing, and profitable brands. In 1962, fresh out of business school, Phil Knight borrowed $50 from his father and created a company with a simple mission: import high-quality, low-cost athletic shoes from Japan. Selling the shoes from the trunk of his lime green Plymouth Valiant, Knight grossed $8,000 his first year. Today, Nike's annual sales top $30 billion. In an age of startups, Nike is the ne plus ultra of all startups, and the swoosh has become a revolutionary, globe-spanning icon, one of the most ubiquitous and recognizable symbols in the world today. But Knight, the man behind the swoosh, has always remained a mystery. Now, for the first time, in a memoir that is candid, humble, gutsy, and wry, he tells his story, beginning with his crossroads moment. At twenty-four, after backpacking around the world, he decided to take the unconventional path, to start his own business--a business that would be dynamic, different. Knight details the many risks and daunting setbacks that stood between him and his dream--along with his early triumphs. Above all, he recalls the formative relationships with his first partners and employees, a ragtag group of misfits and seekers who became a tight-knit band of brothers. Together, harnessing the transcendent power of a shared mission, and a deep belief in the spirit of sport, they built a brand that changed everything.\r\n\r\n\"Phil Knight nos habla por primera vez de la auténtica historia que hay detrás de Nike, la empresa que fundó en 1962, que hoy en día factura más de 30.000 millones de dólares al año, y cuyo logo ha llegado a ser un símbolo global, el icono más ubicuo y reconocido en todo el mundo\"--Cover."},"notes":{"type":"/type/text","value":"Translation of: Shoe dog : a memoir by the creator of Nike.\r\n\r\nText in Spanish.Texto en español."},"title":"Nunca te pares","subtitle":"autobiografía del fundador de Nike","authors":[{"key":"/authors/OL6787957A","name":"Phil Knight"}],"publish_date":"2017","copyright_date":"2016","contributions":["Del Valle Peñamil, Efrén, translator","Ramos Mena, Francisco José, translator"],"subjects":["Biografia","Businesspeople","Nike (Firm)","Gente de negocios","Biography","Nike (Compana)"],"languages":[{"key":"/languages/spa"}],"pagination":"430 pages","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run05.mrc:464945118:4586","promise:bwb_daily_pallets_2022-06-13","ia:nuncateparesauto0000knig"],"work_titles":["Shoe dog"],"edition_name":"Primera edición Vintage Español.","subject_places":["United States","Estados Unidos"],"local_id":["urn:sfpl:31223122455711","urn:sfpl:31223122456404","urn:sfpl:31223122455794","urn:bwbsku:O8-CBL-524"],"subject_people":["Philip H. Knight (1938-)"],"publish_country":"nyu","by_statement":"Phil Knight ; traducción de Efrén Del Valle Peñamil y Francisco José Ramos Mena","type":{"key":"/type/edition"},"key":"/books/OL27237517M","number_of_pages":430,"works":[{"key":"/works/OL17825802W"}],"covers":[15178236,14502099,-1],"publishers":["Vintage Español, una división de Penguin Random House LLC"],"identifiers":{},"ocaid":"nuncateparesauto0000knig","isbn_10":["0525433546"],"isbn_13":["9780525433545"],"oclc_numbers":["954427072"],"dewey_decimal_class":["338.7/68876092","B"],"lc_classifications":["HD9992.U52 K55518 2017"],"latest_revision":10,"revision":10,"created":{"type":"/type/datetime","value":"2019-07-19T23:58:58.249310"},"last_modified":{"type":"/type/datetime","value":"2026-03-10T18:50:40.385128"}}},"OLID:OL27396043M":{"bib_key":"OLID:OL27396043M","info_url":"http://openlibrary.org/books/OL27396043M/Shoe_Dog","preview":"noview","preview_url":"http://openlibrary.org/books/OL27396043M/Shoe_Dog","thumbnail_url":"https://covers.openlibrary.org/b/id/8858487-S.jpg","details":{"publishers":["Simon & Schuster/Paula Wiseman Books"],"num