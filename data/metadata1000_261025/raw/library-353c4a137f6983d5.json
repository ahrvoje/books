{"url":"https://openlibrary.org/api/books?bibkeys=OLID:OL26323920M,OLID:OL27410311M,OLID:OL28579256M,OLID:OL28616176M,OLID:OL34147253M,OLID:OL37859579M,OLID:OL38800145M,OLID:OL47157844M,OLID:OL51332986M&jscmd=details&format=json","file":"data/metadata1000_261025/raw/library-353c4a137f6983d5.json","retrieved":"2026-10-25T14:40:39.310Z","status":200,"data":{"OLID:OL26323920M":{"bib_key":"OLID:OL26323920M","info_url":"http://openlibrary.org/books/OL26323920M/The_gates_of_Europe","preview":"noview","preview_url":"http://openlibrary.org/books/OL26323920M/The_gates_of_Europe","thumbnail_url":"https://covers.openlibrary.org/b/id/7999053-S.jpg","details":{"publishers":["Basic books","Basic Books, a member of the Perseus Books Group"],"classifications":{},"source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run05.mrc:247387731:4263","marc:marc_loc_2016/BooksAll.2016.part42.utf8:56853578:3216","bwb:9780465050918","promise:bwb_daily_pallets_2022-03-17","marc:marc_columbia/Columbia-extract-20221130-024.mrc:121403242:3463","marc:marc_nuls/NULS_PHC_180925.mrc:186666621:3220","marc:harvard_bibliographic_metadata/20220215_001.bib.mrc:346769844:4521","marc:harvard_bibliographic_metadata/20220215_005.bib.mrc:319841887:2547"],"title":"The gates of Europe","lccn":["2015015256"],"identifiers":{},"covers":[7999053],"local_id":["urn:sfpl:31223123462302","urn:sfpl:31223114345417","urn:sfpl:31223112582771","urn:bwbsku:P7-DMX-607"],"isbn_13":["9780465050918"],"lc_classifications":["DK508.51 .P55 2015","DK508.51 .P54 2015"],"publish_date":"2015","key":"/books/OL26323920M","works":[{"key":"/works/OL17722572W"}],"type":{"key":"/type/edition"},"oclc_numbers":["905686141","958394011"],"number_of_pages":395,"languages":[{"key":"/languages/eng"},{"key":"/languages/ukr"}],"description":{"type":"/type/text","value":"\"From one of the foremost experts on Ukraine and the former USSR, a concise, authoritative history of Ukraine. Ukraine is currently embroiled in a tense battle with Russia to preserve its economic and political independence. But today's conflict is only the latest in a long history of battles over Ukraine's existence as a sovereign nation. As award-winning historian Serhii Plokhy argues in The Gates of Europe, we must examine Ukraine's past in order to understand its fraught present and likely future. Situated between Europe, Russia, and the Asian East, Ukraine was shaped by the empires that have used it as a strategic gateway between East and West--from the Romans and Ottomans to the Third Reich and the Soviet Union, all have engaged in global fights for supremacy on Ukrainian soil. Each invading army left a lasting mark on the landscape and on the population, making modern Ukraine an amalgam of competing cultures. Authoritative and vividly written, The Gates of Europe will be the definitive history of Ukraine for years to come\"--"},"latest_revision":11,"revision":11,"created":{"type":"/type/datetime","value":"2017-06-12T23:31:28.474757"},"last_modified":{"type":"/type/datetime","value":"2025-06-25T03:29:24.696027"}}},"OLID:OL27410311M":{"bib_key":"OLID:OL27410311M","info_url":"http://openlibrary.org/books/OL27410311M/The_Gates_of_Europe","preview":"noview","preview_url":"http://openlibrary.org/books/OL27410311M/The_Gates_of_Europe","thumbnail_url":"https://covers.openlibrary.org/b/id/8872269-S.jpg","details":{"publishers":["Basic Books"],"identifiers":{"amazon":["0465094864"]},"subtitle":"A History of Ukraine","covers":[8872269],"physical_format":"paperback","full_title":"The Gates of Europe A History of Ukraine","key":"/books/OL27410311M","authors":[{"key":"/authors/OL6464882A","name":"Serhii Plokhy"}],"source_records":["amazon:0465094864","bwb:9780465094868"],"title":"The Gates of Europe","notes":{"type":"/type/text","value":"Source title: The Gates of Europe: A History of Ukraine"},"number_of_pages":432,"isbn_13":["9780465094868"],"isbn_10":["0465094864"],"publish_date":"May 30, 2017","works":[{"key":"/work