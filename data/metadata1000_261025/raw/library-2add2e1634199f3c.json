created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2022-12-07T18:00:19.666193"}}},"OLID:OL701348M":{"bib_key":"OLID:OL701348M","info_url":"http://openlibrary.org/books/OL701348M/Ship_of_gold_in_the_deep_blue_sea","preview":"borrow","preview_url":"https://archive.org/details/shipofgoldindeep00kind","thumbnail_url":"https://covers.openlibrary.org/b/id/660477-S.jpg","details":{"publishers":["Atlantic Monthly Press"],"identifiers":{"goodreads":["1586921"],"librarything":["102"]},"ia_box_id":["IA100316"],"isbn_10":["0871134640"],"subject_place":["North Atlantic Ocean."],"covers":[660477],"lc_classifications":["G530.C4 K55 1998","G530.C4K55 1998"],"key":"/books/OL701348M","authors":[{"key":"/authors/OL235600A","name":"Gary Kinder"}],"ocaid":"shipofgoldindeep00kind","publish_places":["New York"],"subjects":["Central America (Ship)","Shipwrecks -- North Atlantic Ocean","Survival after airplane accidents, shipwrecks, etc"],"languages":[{"key":"/languages/eng"}],"pagination":"xvi, 507 p. :","source_records":["marc:marc_records_scriblio_net/part26.dat:153533962:707","marc:CollingswoodLibraryMarcDump10-27-2008/Collingswood.out:19713080:1425","marc:marc_ithaca_college/ic_marc.mrc:161614310:752","ia:shipofgoldindeep00kind","marc:marc_loc_updates/v39.i38.records.utf8:2052654:697","marc:marc_openlibraries_phillipsacademy/PANO_FOR_IA_05072019.mrc:30192831:1403","marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run02.mrc:164533553:2090","marc:marc_loc_2016/BooksAll.2016.part26.utf8:76146707:697","ia:shipofgoldindeep0000kind","ia:shipofgoldindeep0000kind_d3x7","bwb:9780871134646","marc:marc_columbia/Columbia-extract-20221130-005.mrc:189501275:2431","marc:harvard_bibliographic_metadata/20220215_008.bib.mrc:138566724:1843"],"title":"Ship of gold in the deep blue sea","dewey_decimal_class":["910/.91631"],"number_of_pages":507,"edition_name":"1st ed.","lccn":["97049812"],"local_id":["urn:phillips:31867001113732","urn:sfpl:31223046987658","urn:sfpl:31223046987666","urn:sfpl:31223046952710","urn:sfpl:31223064307276"],"publish_date":"1998","publish_country":"nyu","by_statement":"Gary Kinder.","works":[{"key":"/works/OL1962652W"}],"type":{"key":"/type/edition"},"oclc_numbers":["38048517"],"description":{"type":"/type/text","value":"In September 1857, the SS Central America, a side-wheel steamer carrying nearly six hundred passengers returning from the California Gold Rush, foundered in a hurricane and sank two hundred miles off the Carolina coast. Over four hundred lives and twenty-one tons of California gold were lost. It was the worst peacetime disaster at sea in American history, a tragedy that remained lost in legend for over a century.\n\nIn the 1980s, a young engineer from Ohio set out to do what no one, not even the United States Navy, had been able to do: establish a working presence on the deep-ocean floor and open it to science, archaeology, history, medicine, and recovery. The SS Central America became the target of his project.\n\nAfter years of intensive efforts, Tommy Thompson and the Columbus-America Discovery Group found the Central America in eight thousand feet of water, and in October 1989 they sailed into Norfolk with her recovered treasure: gold coins, bars, nuggets, and dust, plus steamer trunks filled with period clothes, newspapers, books, journals, and even an intact cigar sealed under water for 130 years.\n\nNow Gary Kinder tells for the first time this extraordinary tale of history, human drama, heroic rescue, scientific ingenuity, and individual courage."},"latest_revision":20,"revision":20,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-07-06T13:19:17.807848"}}},"OLID:OL7995818M":{"bib_key":"OLID:OL7995818M","info_url":"http://openlibrary.org/books/OL7995818M/Ship_of_Gold_in_the_Deep_Blue_Sea","preview":"noview","preview_url":"http://openlibrary.org/books/OL7995818M/Ship_of_Gold_in_the_Deep_Blue_Sea","details":{"identifiers":{"goodreads":["5535480"],"librarything":["102"]},"title":"Ship of Gold in the Deep Blue Sea","authors":[{"key":"/authors/OL235600A","name":"Gary Kinder"}],"publish_date":"February 1, 2002","publishers":["DIANE Publishing Company"],"isbn_13":["9780756718749"],"physical_format":"Hardcover","isbn_10":["0756718740"],"type":{"key":"/type/edition"},"subjects":["Fiction","Action & Adventure","Essays & Travelogues","Special Interest - Adventure","Travel"],"first_sentence":{"type":"/type/text","value":"THE GLASS LAMPS of Havana cast erratic ribbons of light out across the harbor, zigzagging among the dark silhouettes of more than a hundred ships at anchor."},"source_records":["amazon:0756718740"],"key":"/books/OL7995818M","works":[{"key":"/works/OL1962652W"}],"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2008-04-29T15:03:11.581851"},"last_modified":{"type":"/type/datetime","value":"2025-12-23T03:41:38.171515"}}},"OLID:OL11127704M":{"bib_key":"OLID:OL11127704M","info_url":"http://openlibrary.org/books/OL11127704M/Ship_of_Gold_in_the_Deep_Blue_Sea_Easel-Backed_Riser_Poster","preview":"noview","preview_url":"http://openlibrary.org/books/OL11127704M/Ship_of_Gold_in_the_Deep_Blue_Sea_Easel-Backed_Riser_Poster","details":{"identifiers":{"goodreads":["3270210"]},"title":"Ship of Gold in the Deep Blue Sea Easel-Backed Riser Poster","authors":[{"key":"/authors/OL235600A","name":"Gary Kinder"}],"publish_date":"June 1999","publishers":["Vintage Books USA"],"physical_format":"Unknown Binding","isbn_13":["9780676585919"],"languages":[{"key":"/languages/eng"}],"isbn_10":["0676585914"],"type":{"key":"/type/edition"},"subjects":["Non-Classifiable","Promotional Items"],"source_records":["amazon:0676585914"],"key":"/books/OL11127704M","works":[{"key":"/works/OL1962648W"}],"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2008-04-30T09:38:13.731961"},"last_modified":