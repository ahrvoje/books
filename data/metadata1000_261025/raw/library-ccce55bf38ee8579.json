"xix, 274 p.","covers":[297070],"key":"/books/OL32584M","authors":[{"key":"/authors/OL2571405A","name":"Samuel Rush Watkins"}],"publish_places":["New York"],"contributions":["Inge, M. Thomas."],"subject_time":["Civil War, 1861-1865"],"genres":["Personal narratives, Confederate.","Personal narratives.","Regimental histories."],"source_records":["marc:marc_records_scriblio_net/part28.dat:2056411:1467","marc:marc_loc_updates/v36.i33.records.utf8:2959369:1467","bwb:9780452281240","marc:marc_loc_2016/BooksAll.2016.part27.utf8:224198587:1670","ia:coaytchorsidesho0000watk","promise:bwb_daily_pallets_2021-06-24","promise:bwb_daily_pallets_2021-07-13","idb:9780452281240","marc:marc_columbia/Columbia-extract-20221130-005.mrc:488945428:3321","marc:harvard_bibliographic_metadata/20220215_022.bib.mrc:356532887:3921"],"title":"Co. Aytch","notes":{"type":"/type/text","value":"Includes bibliographical references (p. xix) and indexes.\r\nOriginally published: Nashville, Tenn. : Cumberland Presbyterian Pub. House, 1882."},"identifiers":{"librarything":["69709"],"goodreads":["77725"]},"languages":[{"key":"/languages/eng"}],"subjects":["Watkins, Samuel R","Confederate States of America. Army. Tennessee Infantry Regiment, 1st. Company H","Soldiers -- Tennessee -- Biography","United States -- History -- Civil War, 1861-1865 -- Personal narratives, Confederate","Tennessee -- History -- Civil War, 1861-1865 -- Personal narratives","United States -- History -- Civil War, 1861-1865 -- Regimental histories","Tennessee -- History -- Civil War, 1861-1865 -- Regimental histories"],"publish_date":"1999","publish_country":"nyu","by_statement":"Sam R. Watkins ; edited and with an introduction by M. Thomas Inge.","works":[{"key":"/works/OL248590W"}],"type":{"key":"/type/edition"},"isbn_10":["0452281245"],"lccn":["99014337"],"classifications":{},"dewey_decimal_class":["973.7/468"],"lc_classifications":["E579.5 1st .W35 1999","E579.5 1st.W35 1999"],"subtitle":"or, A side show of the big show and other sketches","ocaid":"coaytchorsidesho0000watk","local_id":["urn:bwbsku:T2-BBX-966","urn:bwbsku:O7-DGX-376"],"oclc_numbers":["40881437"],"description":{"type":"/type/text","value":"\"Samuel Rush Watkins was a private in the Confederate Army, a twenty-one-year-old Southerner from Tennessee who knew about war but had never experienced it firsthand.\"--BOOK JACKET.\n\n\"With the immediacy of a dispatch from the front lines, here are Watkins' firsthand observations and recollections, from combat on the battlefields of Shiloh (\"On Sunday morning, the order was given for the whole army to advance, and to attack immediately. The fire opened - a ripping, roaring boom, bang!\") and Chickamauga (\"We debouched through the woods, firing as we marched. The Yankee line was about two hundred yards off.\n\nIn ten minutes we were face to face with the foe\") to encounters with Stonewall Jackson and Robert E. Lee, from the tedium of grueling marches to the terror of fellow soldiers' deaths, from breaking bread with a Georgia family to confronting the enemy eye to eye.\"--BOOK JACKET."},"latest_revision":17,"revision":17,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2025-11-27T11:11:39.581210"}}},"ISBN:9781481211079":{"bib_key":"ISBN:9781481211079","info_url":"http://openlibrary.org/books/OL54179809M/Company_Aytch","preview":"noview","preview_url":"http://openlibrary.org/books/OL54179809M/Company_Aytch","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL14303934A","name":"Samuel \"Sam\" Rush Watkins"}],"isbn_13":["9781481211079"],"languages":[{"key":"/languages/eng"}],"number_of_pages":184,"publish_date":"2012","publishers":["CreateSpace Independent Publishing Platform"],"source_records":["bwb:9781481211079"],"title":"Company Aytch","weight":"0.336","full_title":"Company Aytch","works":[{"key":"/works/OL39770382W"}],"key":"/books/OL54179809M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2024-09-19T10:17:38.723424"},"last_modified":{"type":"/type/datetime","value":"2024-09-19T10:17:38.723424"}}},"OLID:OL6201194M":{"bib_key":"OLID:OL6201194M","info_url":"http://openlibrary.org/books/OL6201194M/My_confession","preview":"borrow","preview_url":"https://archive.org/details/myconfession0000unse","thumbnail_url":"https://covers.openlibrary.org/b/id/10789399-S.jpg","details":{"publishers":["Harper"],"number_of_pages":301,"lc_classifications":["E411 .C45"],"key":"/books/OL6201194M","authors":[{"key":"/authors/OL538002A","name":"Samuel E. Chamberlain"}],"publish_places":["New York"],"subjects":["Mexican War, 1846-1848 -- Personal narratives"],"pagination":"x, 301 p.","source_records":["marc:marc_records_scriblio_net/part04.dat:121766213:759","marc:marc_ithaca_college/ic_marc.mrc:117791123:786","marc:marc_openlibraries_phillipsacademy/PANO_FOR_IA_05072019.mrc:64785273:1064","marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run01.mrc:46779808:1646","marc:marc_marygrove/marygrovecollegelibrary.full.D20191108.T213022.internetarchive2nd_REPACK.mrc:48427134:5268","marc:marc_loc_2016/BooksAll.2016.part05.utf8:25583227:753","ia:myconfession0000unse","marc:harvard_bibliographic_metadata/ab.bib.00.20150123.full.mrc:829806666:804","marc:marc_columbia/Columbia-extract-20221130-003.mrc:213233982:1084","marc:harvard_bibliographic_metadata/20220215_041.bib.mrc:276703291:5441"],"title":"My confession","dewey_decimal_class":["973.628"],"notes":{"type":"/type/text","value":"A condensed version was published in Life magazine in July and August 1956."},"identifiers":{"librarything":["1917992"]},"languages":[{"key":"/languages/eng"}],"lccn":["56010524"],"local_id":["urn:phillips:31867000561568","urn:sfpl:31223001492215","urn:sfpl:31223040301104","urn:mgc:31927001096806"],"publish_date":"1956","publish_country":"nyu","by_statement":"written and illustrated by Samuel E. Chamberlain. Introd. and postscript by Roger Butterfield.","works":[{"key":"/works/OL3290424W"}],"type":{"key":"/type/edition"},"covers":[10789399],"ocaid":"myconfession0000unse","oclc_numbers":["740710"],"description":{"type":"/type/text","value":"\"\"The sun rose bright and clear...on the morning of the 23rd of February, 1847. it shone on a scene well calculated to stir one's blood to a fever heat with warlike enthusiasm and make a coward brave...twenty thousand men clad in new uniforms, belts, as white as snow, brasses and arms burnished until they glittered like gold and silver. Their Cavalry...some six thousand cavaliers...advanced towards us as if they would ride down out little band and finish the battle at one blow.\" This was the beginning of the famous Mexican War battle of Buena Vista, as seen by a seventeen-year-old U.S. dragoon who was in the thick of it. Half scoundrel, half hero, a lad who gloried in a fray, either personal duel or large-scale battle, with an eye for a pretty girl and talents that would have made Don Juan, Casanova, Gil Blas and d'Artagnan envious, he was also something of an artist and considerable of a writer.^\n\nAnd he left behind him when he died (years later, a respected Civil War general) this matchless piece of Americana, his personally illustrated and illuminated account of his extraordinary adventures and youthful escapades just before, during and after the Mexican War. Here are the stories of battles, of love and dalliance, of duels, chases, escapes, murder, of massacres, ghosts, wild rides and gay fiestas, of the butchery, cruelty and barbarous punishment as well as the gallantry, heroism and glamour that characterized the Mexican War. Here are unparalleled glimpses of real heroes and villains such as General Zachary Taylor and Santa Anna, and of a number of young officers later to win fame in another war, including Captain R. E. Lee and his fellow officer, Captain Jefferson Davis. Here is a scalp-tingling account of young Chamberlain's postwar adventures with a gang of notorious outlaws.^\n\nHere, in short, are the very sight and sound and smell of an almost neglected chunk of American history. Now brought to light after more than one hundred years, this unique document will surely excite nation wide interest and delight as a classic of picaresque adventure. The manuscript has been checked and rechecked by experts for accuracy and authenticity. Less than one-fifth of the book appeared in Life in three installments in July and August, 1956. With 55 illustrations and decorations including 16 pages in full color.\"--BOOK JACKET."},"latest_revision":14,"revision":14,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-06-26T22:50:09.998833"}}},"ISBN:1519285973":{"bib_key":"ISBN:1519285973","info_url":"http://openlibrary.org/books/OL54640786M/Listening_to_Prestige","preview":"noview","preview_url":"http://openlibrary.org/books/OL54640786M/Listening_to_Prestige","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL714410A","name":"Tad Richards"}],"isbn_13":["9781519285973"],"languages":[{"key":"/languages/eng"}],"number_of_pages":314,"publish_date":"2015","publishers":["CreateSpace Independent Publishing Platform"],"source_records":["bwb:9781519285973"],"title":"Listening to Prestige","weight":"0.541","subtitle":"Vol. 1 1949-54","works":[{"key":"/works/OL40154427W"}],"key":"/books/OL54640786M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2024-09-22T11:40:05.289695"},"last_modified":{"type":"/type/datetime","value":"2024-09-22T11:40:05.289695"}}},"OLID:OL8321313M":{"bib_key":"OLID:OL8321313M","info_url":"http://openlibrary.org/books/OL8321313M/The_Creature_from_Jekyll_Island","preview":"noview","preview_url":"http://openlibrary.org/books/OL8321313M/The_Creature_from_Jekyll_Island","thumbnail_url":"https://covers.openlibrary.org/b/id/703966-S.jpg","details":{"identifiers":{"goodreads":["66500"],"librarything":["443844"]},"titl