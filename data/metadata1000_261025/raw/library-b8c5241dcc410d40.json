{"url":"https://openlibrary.org/api/books?bibkeys=OLID:OL27343357M,OLID:OL28283354M,OLID:OL28724401M,OLID:OL33690922M,OLID:OL34667869M&jscmd=details&format=json","file":"data/metadata1000_261025/raw/library-b8c5241dcc410d40.json","retrieved":"2026-10-25T14:21:49.590Z","status":200,"data":{"OLID:OL27343357M":{"bib_key":"OLID:OL27343357M","info_url":"http://openlibrary.org/books/OL27343357M/Working","preview":"noview","preview_url":"http://openlibrary.org/books/OL27343357M/Working","thumbnail_url":"https://covers.openlibrary.org/b/id/8807459-S.jpg","details":{"publishers":["Knopf","Alfred A. Knopf"],"identifiers":{"amazon":["0525656340"]},"source_records":["amazon:0525656340","bwb:9780525656340","promise:bwb_daily_pallets_2022-05-25","marc:marc_columbia/Columbia-extract-20221130-028.mrc:184391951:3755","marc:marc_nuls/NULS_PHC_180925.mrc:116307492:3225","marc:harvard_bibliographic_metadata/20220215_009.bib.mrc:57420019:5188"],"title":"Working","type":{"key":"/type/edition"},"number_of_pages":240,"covers":[8807459],"isbn_13":["9780525656340"],"full_title":"Working","isbn_10":["0525656340"],"publish_date":"Apr 09, 2019","key":"/books/OL27343357M","authors":[{"key":"/authors/OL797731A","name":"Robert A. Caro"}],"works":[{"key":"/works/OL20161697W"}],"physical_format":"hardcover","lc_classifications":["PN4874.C2528A3 2019","PN4874.C2528 A3 2019"],"local_id":["urn:bwbsku:W7-CAE-116"],"lccn":["2018055999"],"oclc_numbers":["1077960782"],"languages":[{"key":"/languages/eng"}],"description":{"type":"/type/text","value":"Two-time Pulitzer Prize winner Robert Caro gives us a glimpse into his own life and work. He describes what it was like to interview the mighty Robert Moses; what it felt like to begin discovering the extent of the political power Moses wielded; the combination of discouragement and exhilaration he felt confronting the vast holdings of the Lyndon B. Johnson Library in Austin, Texas; his encounters with witnesses, including longtime residents wrenchingly displaced by the construction of Moses' Cross-Bronx Expressway and Lady Bird Johnson acknowledging the beauty and influence of one of LBJ's mistresses. He gratefully remembers how, after years of working in solitude, he found a writers' community at the New York Public Library, and details the ways he goes about planning and composing his books. Caro recalls the moments at which he came to understand that he wanted to write not just about the men who wielded power but about the people and the politics that were shaped by that power. And he talks about the importance to him of the writing itself, of how he tries to infuse it with a sense of place and mood to bring characters and situations to life on the page."},"latest_revision":7,"revision":7,"created":{"type":"/type/datetime","value":"2019-10-04T19:57:53.451394"},"last_modified":{"type":"/type/datetime","value":"2025-07-14T11:26:27.007261"}}},"OLID:OL28283354M":{"bib_key":"OLID:OL28283354M","info_url":"http://openlibrary.org/books/OL28283354M/Working","preview":"noview","preview_url":"http://openlibrary.org/books/OL28283354M/Working","thumbnail_url":"https://covers.openlibrary.org/b/id/10208782-S.jpg","details":{"publishers":["Vintage"],"source_records":["amazon:0593081919","bwb:9780593081914","idb:9780593081914"],"title":"Working","number_of_pages":240,"isbn_13":["9780593081914"],"covers":[10208782],"physical_format":"paperback","full_title":"Working","isbn_10":["0593081919"],"publish_date":"Jan 07, 2020","key":"/books/OL28283354M","authors":[{"key":"/authors/OL797731A","name":"Robert A. Caro"}],"works":[{"key":"/works/OL20161697W"}],"type":{"key":"/type/edition"},"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2020-06-23T14:38:31.112188"},"last_modified":{"type":"/type/datetime","value":"2023-12-19T23:09:39.898413"}}},"OLID:OL28724401M":{"bib_key":"OLID:OL28724401M","info_url":"http://openlibrary.org/books/OL28724401M/Working","preview":"noview","preview_url":"http://openlibrary.org/books/O