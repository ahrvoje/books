ry.org/books/OL28302641M/With_All_Due_Respect","preview":"noview","preview_url":"http://openlibrary.org/books/OL28302641M/With_All_Due_Respect","thumbnail_url":"https://covers.openlibrary.org/b/id/10229136-S.jpg","details":{"publishers":["St. Martin's Press"],"subtitle":"Defending America with Grit and Grace","covers":[10229136],"physical_format":"hardcover","full_title":"With All Due Respect Defending America with Grit and Grace","key":"/books/OL28302641M","authors":[{"key":"/authors/OL7832980A","name":"Nikki R. Haley"}],"source_records":["amazon:1250266556","bwb:9781250266552","promise:bwb_daily_pallets_2021-06-03","marc:marc_columbia/Columbia-extract-20221130-030.mrc:990054:3575","marc:harvard_bibliographic_metadata/20220215_067.bib.mrc:109756457:5097"],"title":"With All Due Respect","notes":{"type":"/type/text","value":"Source title: With All Due Respect: Defending America with Grit and Grace"},"number_of_pages":272,"isbn_13":["9781250266552"],"isbn_10":["1250266556"],"publish_date":"Nov 12, 2019","works":[{"key":"/works/OL20665857W"}],"type":{"key":"/type/edition"},"local_id":["urn:bwbsku:P7-AGE-956"],"lccn":["2019036363"],"lc_classifications":["E901.1.H35 A3 2019"],"oclc_numbers":["1100592075"],"languages":[{"key":"/languages/eng"}],"description":{"type":"/type/text","value":"\"A revealing, dramatic, deeply personal book about the most significant events of our time, written by the former United States Ambassador to the United Nations Nikki Haley who is widely admired for her forthright manner (\"With all due respect, I don't get confused\"), her sensitive approach to tragic events, and her confident representation of America's interests as our Ambassador to the United Nations during times of crisis and consequence. In this book, Haley offers a first-hand perspective on major national and international matters, as well as a behind-the-scenes account of her tenure in the Trump administration. This book reveals a woman who can hold her own--and better--in domestic and international power politics, a diplomat who is unafraid to take a principled stand even when it is unpopular, and a leader who seeks to bring Americans together in divisive times\"--"},"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2020-07-02T19:51:07.713759"},"last_modified":{"type":"/type/datetime","value":"2025-05-17T03:31:54.993444"}}},"ISBN:1250266556":{"bib_key":"ISBN:1250266556","info_url":"http://openlibrary.org/books/OL28302641M/With_All_Due_Respect","preview":"noview","preview_url":"http://openlibrary.org/books/OL28302641M/With_All_Due_Respect","thumbnail_url":"https://covers.openlibrary.org/b/id/10229136-S.jpg","details":{"publishers":["St. Martin's Press"],"subtitle":"Defending America with Grit and Grace","covers":[10229136],"physical_format":"hardcover","full_title":"With All Due Respect Defending America with Grit and Grace","key":"/books/OL28302641M","authors":[{"key":"/authors/OL7832980A","name":"Nikki R. Haley"}],"source_records":["amazon:1250266556","bwb:9781250266552","promise:bwb_daily_pallets_2021-06-03","marc:marc_columbia/Columbia-extract-20221130-030.mrc:990054:3575","marc:harvard_bibliographic_metadata/20220215_067.bib.mrc:109756457:5097"],"title":"With All Due Respect","notes":{"type":"/type/text","value":"Source title: With All Due Respect: Defending America with Grit and Grace"},"number_of_pages":272,"isbn_13":["9781250266552"],"isbn_10":["1250266556"],"publish_date":"Nov 12, 2019","works":[{"key":"/works/OL20665857W"}],"type":{"key":"/type/edition"},"local_id":["urn:bwbsku:P7-AGE-956"],"lccn":["2019036363"],"lc_classifications":["E901.1.H35 A3 2019"],"oclc_numbers":["1100592075"],"languages":[{"key":"/languages/eng"}],"description":{"type":"/type/text","value":"\"A revealing, dramatic, deeply personal book about the most significant events of our time, written by the former United States Ambassador to the United Nations Nikki Haley who is widely admired for her forthright manner (\"With all due respect, I don't get confused\"), her sensitive approach to tragic events, and her confident representation of America's interests as our Ambassador to the United Nations during times of crisis and consequence. In this book, Haley offers a first-hand perspective on major national and international matters, as well as a behind-the-scenes account of her tenure in the Trump administration. This book reveals a woman who can hold her own--and better--in domestic and international power politics, a diplomat who is unafraid to take a principled stand even when it is unpopular, and a leader who seeks to bring Americans together in divisive times\"--"},"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2020-07-02T19:51:07.713759"},"last_modified":{"type":"/type/datetime","value":"2025-05-17T03:31:54.993444"}}},"ISBN:1782793615":{"bib_key":"ISBN:1782793615","info_url":"http://openlibrary.org/books/OL36804945M/Why_Materialism_Is_Baloney","preview":"noview","preview_url":"http://openlibrary.org/books/OL36804945M/Why_Materialism_Is_Baloney","details":{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL7309207A","name":"Bernardo Kastrup"}],"isbn_13":["9781782793618"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["B825"],"pagination":"250","publish_date":"2014","publishers":["Hunt Publishing Limited, John"],"source_records":["bwb:9781782793618"],"subjects":["Metaphysics","Materialism","Skepticism"],"title":"Why Materialism Is Baloney","subtitle":"How True Skeptics Know There Is No Death and Fathom Answers to Life, the Universe, and Everything","full_title":"Why Materialism Is Baloney How True Skeptics Know There Is No Death and Fathom Answers to Life, the Universe, and Everything","works":[{"key":"/works/OL20033271W"}],"key":"/books/OL36804945M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2022-01-28T04:22:53.911802"},"last_modified":{"type":"/type/datetime","value":"2022-01-28T04:22:53.911802"}}},"OLID