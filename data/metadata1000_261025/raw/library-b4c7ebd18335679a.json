type/datetime","value":"2021-12-26T02:32:40.108871"}}},"ISBN:0970950519":{"bib_key":"ISBN:0970950519","info_url":"http://openlibrary.org/books/OL25541521M/The_God_virus","preview":"noview","preview_url":"http://openlibrary.org/books/OL25541521M/The_God_virus","thumbnail_url":"https://covers.openlibrary.org/b/id/15256947-S.jpg","details":{"publishers":["IPC Press"],"table_of_contents":[{"level":0,"label":"","title":"Religion as a virus","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"How religions survive and dominate","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"American civil religion","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"God loves you : the guilt that binds","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Sex and the god virus","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The myth of unchanging morality","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Jesus my personal savior : the roots of American Evangelism","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Intelligence, personality, and the god virus","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Understanding and living with the god virus","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The journey : living a virus-free life","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The god virus and science","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The future of an illusion.","pagenum":"","type":{"key":"/type/toc_item"}}],"description":{"type":"/type/text","value":"Dawkins, Hitchens, Harris and Dennett opened the door to a hard nosed look at religion in our society but no one seemed to be using their concepts to explain the psychology of religion and its practical effects on people. Dr. Darrel Ray, psychologist and lifelong student of religion stepped into this gap to discuss religious infection from the inside out. How does guilt play into religious infection? Why is sexual control so important to so many religions? What causes the anxiety and neuroticism around death and dying? How does religion inject itself into so many areas of life, culture and politics? Dr. Ray explores this and much more in his book, The God Virus: How religion infects our lives and culture. This second generation book takes the reader several steps beyond Dawkins, et al. into the realm of the personal and emotional mechanisms that affect anyone who lives in a culture steeped in religion. He uses examples that anyone can relate to and gives real world guidance in how to deal with and respond to people who are religious among our families, friends and coworkers."},"isbn_10":["0970950519"],"covers":[15256947,10013148],"lc_classifications":["BL2775.3 .R38 2009"],"key":"/books/OL25541521M","authors":[{"key":"/authors/OL586226A","name":"Darrel Ray"}],"publish_places":["Bonner Springs, Kan"],"isbn_13":["9780970950512"],"pagination":"241 p. :","source_records":["ia:godvirushowrelig00rayd_799","promise:bwb_daily_pallets_2023-02-15:P8-AWI-105","ia:godvirushowrelig0000rayd"],"subtitle":"how religion infects our lives and culture","title":"The God virus","lccn":["2008939657"],"notes":{"type":"/type/text","value":"Includes bibliographical references and index."},"number_of_pages":241,"languages":[{"key":"/languages/eng"}],"dewey_decimal_class":["215/.7"],"subjects":["Controversial literature","Religious Psychology","Sociobiology","Religion","Religion and science","Religious aspects"],"publish_date":"2009","publish_country":"ksu","by_statement":"Darrel W. Ray","oclc_numbers":["282753096"],"works":[{"key":"/works/OL16931623W"}],"type":{"key":"/type/edition"},"local_id":["urn:bwbsku:P8-AWI-105"],"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2014-07-28T