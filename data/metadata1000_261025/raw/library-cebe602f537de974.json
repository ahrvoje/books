vision":9}},"OLID:OL7489213M":{"bib_key":"OLID:OL7489213M","info_url":"http://openlibrary.org/books/OL7489213M/King_Solomon's_Ring","preview":"noview","preview_url":"http://openlibrary.org/books/OL7489213M/King_Solomon's_Ring","thumbnail_url":"https://covers.openlibrary.org/b/id/266713-S.jpg","details":{"publishers":["Routledge"],"number_of_pages":224,"subtitle":"New Light on Animal Ways (Routledge Classics)","covers":[266713],"key":"/books/OL7489213M","authors":[{"key":"/authors/OL586069A","name":"Konrad Lorenz"}],"languages":[{"key":"/languages/eng"}],"source_records":["ia:kingsolomonsring00lore_200","bwb:9780415267472","marc:marc_loc_2016/BooksAll.2016.part29.utf8:204691558:1187","marc:marc_columbia/Columbia-extract-20221130-031.mrc:32483543:3470","marc:marc_nuls/NULS_PHC_180925.mrc:276546134:1256","marc:marc_columbia/Columbia-extract-20221130-007.mrc:349904677:2744"],"title":"King Solomon's Ring","identifiers":{"goodreads":["13965"],"librarything":["235085"]},"isbn_13":["9780415267472"],"isbn_10":["0415267471"],"publish_date":"August 9, 2002","works":[{"key":"/works/OL3506035W"}],"type":{"key":"/type/edition"},"first_sentence":{"type":"/type/text","value":"Why should I tell first of the darker side of life with animals?"},"lccn":["2002067984"],"lc_classifications":["QL751 .L69413 2002","QL751.L69413 2002","QL751 .L69413 2002eb"],"oclc_numbers":["70721464","49894081","505798170"],"local_id":["urn:nuls:31786101690839"],"description":{"type":"/type/text","value":"\"Solomon, the legend goes, had a magic ring which enabled him to speak to the animals in their own language. Konrad Lorenz was gifted with a similar power of understanding the animal world. He was that rare beast, a brilliant scientist who could write (and indeed draw) beautifully. He did more than any other person to establish and popularize the study of how animals behave, receiving a Nobel Prize for his work.\n\nKing Solomon's Ring, the book which brought him worldwide recognition, is a delightful treasury of observations and insights into the lives of all sorts of creatures, from jackdaws and water-shrews to dogs, cats and even wolves. Charmingly illustrated by Lorenz himself, the book is wonderfully written introduction to the world of our furred and feathered friends, a world which often provides an uncanny resemblance to our own. A must for any animal-lover.\"--BOOK JACKET."},"latest_revision":15,"revision":15,"created":{"type":"/type/datetime","value":"2008-04-29T13:35:46.876380"},"last_modified":{"type":"/type/datetime","value":"2025-03-28T17:36:45.756740"}}},"OLID:OL7499088M":{"bib_key":"OLID:OL7499088M","info_url":"http://openlibrary.org/books/OL7499088M/King_Solomon's_ring","preview":"noview","preview_url":"http://openlibrary.org/books/OL7499088M/King_Solomon's_ring","details":{"publishers":["Thomas Y. Crowell"],"identifiers":{"goodreads":["6713282"],"librarything":["235085"],"amazon":[""]},"subtitle":"New light on animal ways","title":"King Solomon's ring;","number_of_pages":202,"isbn_13":["9780416678802"],"isbn_10":["0416678807"],"publish_date":"1961","key":"/books/OL7499088M","authors":[{"key":"/authors/OL586069A","name":"Konrad Lorenz"}],"works":[{"key":"/works/OL3506035W"}],"type":{"key":"/type/edition"},"source_records":["bwb:9780416678802","promise:bwb_daily_pallets_2020-10-07"],"local_id":["urn:bwbsku:P4-AFX-596"],"latest_revision":8,"revision":8,"created":{"type":"/type/datetime","value":"2008-04-29T13:35:46.876380"},"last_modified":{"type":"/type/datetime","value":"2022-12-09T23:01:20.834254"}}},"OLID:OL7571575M":{"bib_key":"OLID:OL7571575M","info_url":"http://openlibrary.org/books/OL7571575M/King_Solomon's_Ring","preview":"noview","preview_url":"http://openlibrary.org/books/OL7571575M/King_Solomon's_Ring","details":{"publishers":["Signet"],"number_of_pages":1,"title":"King Solomon's Ring","identifiers":{"librarything":["235085"],"goodreads":["3297856"]},"isbn_13":["9780451132291"],"isbn_10":["0451132297"],"publish_date":"September 1, 1972","ke