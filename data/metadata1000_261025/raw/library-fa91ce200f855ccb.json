{"url":"https://openlibrary.org/api/books?bibkeys=OLID:OL51704M,OLID:OL7384520M,OLID:OL44245173M&jscmd=details&format=json","file":"data/metadata1000_261025/raw/library-fa91ce200f855ccb.json","retrieved":"2026-10-25T14:34:38.379Z","status":200,"data":{"OLID:OL51704M":{"bib_key":"OLID:OL51704M","info_url":"http://openlibrary.org/books/OL51704M/History","preview":"restricted","preview_url":"https://archive.org/details/historyveryshort00arno_0","thumbnail_url":"https://covers.openlibrary.org/b/id/119861-S.jpg","details":{"publishers":["Oxford University Press"],"number_of_pages":134,"subtitle":"a very short introduction","isbn_10":["019285352X"],"series":["Very short introductions"],"covers":[119861],"lc_classifications":["D16.8 .A69 2000","D16.8.A69 2000","D16.8 .A68 2000"],"key":"/books/OL51704M","authors":[{"key":"/authors/OL33933A","name":"Arnold, John"}],"ocaid":"historyveryshort00arno_0","publish_places":["Oxford","New York"],"pagination":"134 p. :","source_records":["marc:marc_records_scriblio_net/part28.dat:19539421:743","marc:marc_loc_updates/v35.i21.records.utf8:5878703:1062","ia:historyveryshort00arno_021","ia:historyveryshort00arno_032","ia:historyveryshort00arno_084","ia:historyveryshort00arno_569","ia:historyveryshort00arno_608","ia:historyveryshort00arno_802","bwb:9780192853523","marc:marc_loc_2016/BooksAll.2016.part28.utf8:22831707:1062","marc:marc_nuls/NULS_PHC_180925.mrc:185788798:1052","idb:9780192853523","marc:marc_columbia/Columbia-extract-20221130-006.mrc:30207389:1133","marc:harvard_bibliographic_metadata/20220215_033.bib.mrc:328391515:3292"],"title":"History","dewey_decimal_class":["901"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. 127-130) and index."},"identifiers":{"librarything":["5311"],"goodreads":["74635"]},"languages":[{"key":"/languages/eng"}],"lccn":["99057694"],"subjects":["History -- Philosophy","History, Methodology","Historiography"],"publish_date":"2000","publish_country":"enk","by_statement":"John H. Arnold.","works":[{"key":"/works/OL511301W"}],"type":{"key":"/type/edition"},"local_id":["urn:nuls:31786101253554"],"oclc_numbers":["42882934"],"description":{"type":"/type/text","value":"\"Do historians reconstruct the truth or simply tell stories? This book suggests that they do both, and that the balance between 'truth' and 'story' is tremendously important to history. Taking us from the fabulous tales of ancient Greek historians to the varied approaches of modern professionals, History: A Very Short Introduction illuminates our relationship to the past by making us aware of how 'history' has changed as a subject. Concepts such as periodization and causation are discussed, but not in a dry or abstract fashion. Instead, the book works through particular historical examples - including a medieval murderer, a seventeenth-century colonist, and an ex-slave woman - to illustrate and explain the ways in which we study and understand history, giving the reader a sense of the excitement of discovering not only the past, but also ourselves.\"--Jacket."},"latest_revision":20,"revision":20,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-03-30T23:02:20.981097"}}},"OLID:OL7384520M":{"bib_key":"OLID:OL7384520M","info_url":"http://openlibrary.org/books/OL7384520M/History","preview":"noview","preview_url":"http://openlibrary.org/books/OL7384520M/History","thumbnail_url":"https://covers.openlibrary.org/b/id/119862-S.jpg","details":{"publishers":["Oxford University Press, USA"],"identifiers":{"goodreads":["74635"],"librarything":["5311"]},"subtitle":"A Very Short Introduction (Very Short Introductions)","covers":[119862],"key":"/books/OL7384520M","authors":[{"key":"/authors/OL2662613A","name":"John H. Arnold"}],"isbn_13":["9780192853523"],"source_records":["ia:historyveryshort00arno_032","ia:historyveryshort00arno_802","ia:historyveryshort00arno_084","ia:historyveryshort00arno_608","ia:historyverys