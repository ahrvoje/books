9T02:23:18.705515"}, "last_modified": {"type": "/type/datetime", "value": "2024-02-18T08:26:50.103620"}}}, "OLID:OL48794490M": {"bib_key": "OLID:OL48794490M", "info_url": "http://openlibrary.org/books/OL48794490M/Language_of_Emotions", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL48794490M/Language_of_Emotions", "details": {"type": {"key": "/type/edition"}, "authors": [{"key": "/authors/OL226907A", "name": "Karla McLaren"}], "isbn_13": ["9781591798972"], "languages": [{"key": "/languages/eng"}], "pagination": "432", "publish_date": "2010", "publishers": ["Sounds True, Incorporated"], "source_records": ["bwb:9781591798972"], "title": "Language of Emotions", "subtitle": "What Your Feelings Are Trying to Tell You", "full_title": "Language of Emotions What Your Feelings Are Trying to Tell You", "works": [{"key": "/works/OL18715841W"}], "key": "/books/OL48794490M", "latest_revision": 1, "revision": 1, "created": {"type": "/type/datetime", "value": "2023-07-17T14:13:17.585064"}, "last_modified": {"type": "/type/datetime", "value": "2023-07-17T14:13:17.585064"}}}, "OLID:OL3937952M": {"bib_key": "OLID:OL3937952M", "info_url": "http://openlibrary.org/books/OL3937952M/Frontier_blood", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL3937952M/Frontier_blood", "thumbnail_url": "https://covers.openlibrary.org/b/id/850440-S.jpg", "details": {"publishers": ["Texas A & M University Press"], "number_of_pages": 331, "subtitle": "the saga of the Parker family", "isbn_10": ["1585441368"], "subject_place": ["Texas", "Texas.", "Southern States", "Southern States."], "pagination": "xiii, 331 p. :", "covers": [850440], "lc_classifications": ["F385 .E95 2001"], "key": "/books/OL3937952M", "authors": [{"key": "/authors/OL1601703A", "name": "Jo Ella Powell Exley"}], "publish_places": ["College Station"], "subjects": ["Parker family.", "Parker, Cynthia Ann, 1827?-1864.", "Parker, Quanah, 1845?-1911.", "Pioneers -- Texas -- Biography.", "Frontier and pioneer life -- Texas.", "Comanche Indians -- Texas -- History -- 19th century.", "Indian captivities -- Texas.", "Pioneers -- Southern States -- Biography.", "Frontier and pioneer life -- Southern States.", "Texas -- History -- 19th century -- Biography."], "subject_time": ["19th century.", "19th century"], "languages": [{"key": "/languages/eng"}], "genres": ["Biography."], "source_records": ["amazon:1585441368", "marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run04.mrc:32175374:2627", "marc:marc_loc_2016/BooksAll.2016.part28.utf8:188287722:1303", "ia:frontierbloodsag0000exle", "promise:bwb_daily_pallets_2022-03-17", "marc:marc_columbia/Columbia-extract-20221130-007.mrc:163730258:3429", "marc:harvard_bibliographic_metadata/20220215_019.bib.mrc:254003017:6395"], "title": "Frontier blood", "dewey_decimal_class": ["976.4/004974/00922", "B"], "notes": {"type": "/type/text", "value": "Includes bibliographical references (p. [303]-321) and index."}, "identifiers": {"goodreads": ["614026"], "librarything": ["1425929"]}, "edition_name": "1st ed.", "lccn": ["2001002241"], "local_id": ["urn:sfpl:31223086085975", "urn:sfpl:31223086085983", "urn:bwbsku:W7-BAY-960"], "publish_date": "2001", "publish_country": "txu", "series": ["The centennial series of the Association of Former Students, Texas A&M University ;", "no. 90"], "by_statement": "Jo Ella Powell Exley.", "works": [{"key": "/works/OL6208303W"}], "type": {"key": "/type/edition"}, "oclc_numbers": ["46835787"], "description": {"type": "/type/text", "value": "\"The descendants of Elder John Parker were a strange and often brilliant family who may have changed the course of Texas and western history. Their obsession with religion and their desire for land took them from Virginia to Georgia, Tennessee, Illinois, and finally Texas. From their midst came Cynthia Ann, taken captive by Comanches as a young girl and recaptured as an adult to live in grief among her birth family until she died.\n\nFrom their line too came her son, Quanah Parker, last of the great Comanche war chiefs - and first of their great peace leaders.\".\n\n\"Though the broad outlines of the stories of Cynthia Ann and Quanah are familiar, Jo Ella Powell Exley adds a new dimension by placing them in the context of the stubborn, strong, contentious Parker clan, who lived near and dealt with restive Indians across successive frontiers until history finally brought them to Texas, where their fate changed.\n\nDrawing on a wealth of contemporary accounts, including several first-person stories, she follows Cynthia Ann through her life in the Indian camp and eventually her recapture by her birth family. Exley also tells the dramatic story of Quanah Parker, often in his own words as recorded by his friends, through childhood, battle, surrender, and reservation life.\"--BOOK JACKET."}, "latest_revision": 15, "revision": 15, "created": {"type": "/type/datetime", "value": "2008-04-01T03:28:50.625462"}, "last_modified": {"type": "/type/datetime", "value": "2025-10-24T11:01:47.623105"}}}, "OLID:OL37097119M": {"bib_key": "OLID:OL37097119M", "info_url": "http://openlibrary.org/books/OL37097119M/Frontier_Blood", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL37097119M/Frontier_Blood", "details": {"type": {"key": "/type/edition"}, "authors": [{"key": "/authors/OL10226890A", "name": "Jo Ella Powell Exley"}], "isbn_13": ["9781603441094"], "languages": [{"key": "/languages/eng"}], "pagination": "346", "publish_date": "2009", "publishers": ["Texas A&M University Press"], "source_records": ["bwb:9781603441094", "promise:bwb_daily_pallets_2022-06-13"], "subjects": ["Frontier and pioneer life, texas", "Indian captivities", "Indians of north america, west (u.s.)", "Pioneers", "Texas, history"], "title": "Frontier Blood", "weight": "0.545", "subtitle": "The Saga of the Parker Family", "full_title": "Frontier Blood The Saga of the Parker Family", "works": [{"key": "/works/OL27323545W"}], "key": "/books/OL