 Press"], "isbn_10": ["0198200927"], "subject_place": ["Great Britain", "Maryland", "Virginia"], "lc_classifications": ["HV8950.M38 E55 1987"], "publish_places": ["Oxford", "New York"], "subject_time": ["18th century."], "pagination": "xvi, 277 p., [4] p. of plates :", "source_records": ["marc:marc_records_scriblio_net/part19.dat:77152176:1023"], "dewey_decimal_class": ["364.6/8"], "languages": [{"key": "/languages/eng"}], "lccn": ["87001625"], "subjects": ["Penal colonies -- Great Britain -- Colonies -- History -- 18th century", "Penal colonies -- Maryland -- History -- 18th century", "Penal colonies -- Virginia -- History -- 18th century", "Criminal justice, Administration of -- Great Britain -- History -- 18th century"], "publish_country": "enk", "by_statement": "A. Roger Ekirch.", "type": {"key": "/type/edition"}, "key": "/books/OL2373527M", "number_of_pages": 277, "works": [{"key": "/works/OL4956709W"}], "latest_revision": 6, "revision": 6, "created": {"type": "/type/datetime", "value": "2008-04-01T03:28:50.625462"}, "last_modified": {"type": "/type/datetime", "value": "2025-09-03T14:35:15.485304"}}}, "OLID:OL28050703M": {"bib_key": "OLID:OL28050703M", "info_url": "http://openlibrary.org/books/OL28050703M/Prisoners_of_Geography", "preview": "restricted", "preview_url": "https://archive.org/details/prisonersofgeogr0000mars", "thumbnail_url": "https://covers.openlibrary.org/b/id/9453474-S.jpg", "details": {"publishers": ["Elliott & Thompson Limited", "imusti"], "source_records": ["amazon:1783962437", "ia:prisonersofgeogr0000mars", "promise:bwb_daily_pallets_2022-03-17", "promise:bwb_daily_pallets_2021-07-13"], "title": "Prisoners of Geography", "covers": [9453474], "physical_format": "paperback", "full_title": "Prisoners Of Geography", "publish_date": "May 15, 2016", "key": "/books/OL28050703M", "authors": [{"key": "/authors/OL7492549A", "name": "Tim Marshall"}], "works": [{"key": "/works/OL20010115W"}], "type": {"key": "/type/edition"}, "local_id": ["urn:bwbsku:KP-701-726", "urn:bwbsku:O7-BXK-933"], "languages": [{"key": "/languages/eng"}], "description": "\"All leaders are constrained by geography. Their choices are limited by mountains, rivers, seas and concrete. Yes, to understand world events you need to understand people, ideas and movements ... but if you don't know geography, you'll never have the full picture.; To understand Putin's actions, for example, it is essential to consider that, to be a world power, Russia must have a navy. And if its ports freeze for six months each year then it must have access to a warm water port - hence, the annexation of Crimea was the only option for Putin. To understand the Middle East, it is crucial to know that geography is the reason why countries have logically been shaped as they are - and this is why invented countries (e.g. Syria, Iraq, Libya) will not survive as nation states.; Spread over ten chapters (covering Russia; China; the USA; Latin America; the Middle East; Africa; India and Pakistan; Europe; Japan and Korea; and Greenland and the Arctic), using maps, essays and occasionally the personal experiences of the widely travelled author, Prisoners of Geography looks at the past, present and future to offer an essential guide to one of the major determining factors in world history.\"--Wheelers.co.nz.", "number_of_pages": 303, "identifiers": {}, "ocaid": "prisonersofgeogr0000mars", "isbn_10": ["1783962437"], "isbn_13": ["9781783962433"], "oclc_numbers": ["952666189"], "lc_classifications": ["JC319 .M37 2016", "JC319 .M274 2016"], "subtitle": "Ten Maps that Tell You Everything You Need to Know About Global Politics", "latest_revision": 7, "revision": 7, "created": {"type": "/type/datetime", "value": "2020-05-15T15:17:59.923061"}, "last_modified": {"type": "/type/datetime", "value": "2026-06-27T10:55:21.684665"}}}, "OLID:OL61410982M": {"bib_key": "OLID:OL61410982M", "info_url": "http://openlibrary.org/books/OL61410982M/Prisoners_of_geography", "preview": "noview", "preview_