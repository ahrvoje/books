22890M/Atlantic", "details": {"type": {"key": "/type/edition"}, "authors": [{"key": "/authors/OL9924433A", "name": "Simon Winchester"}], "isbn_13": ["9780007423101"], "languages": [{"key": "/languages/eng"}], "pagination": "400", "publish_date": "2011", "publishers": ["HarperCollins Publishers Limited"], "source_records": ["bwb:9780007423101"], "subjects": ["Atlantic ocean"], "title": "Atlantic", "subtitle": "A Vast Ocean of a Million Stories", "full_title": "Atlantic A Vast Ocean of a Million Stories", "works": [{"key": "/works/OL27022262W"}], "key": "/books/OL44122890M", "latest_revision": 1, "revision": 1, "created": {"type": "/type/datetime", "value": "2022-12-17T06:23:04.825858"}, "last_modified": {"type": "/type/datetime", "value": "2022-12-17T06:23:04.825858"}}}, "OLID:OL35253923M": {"bib_key": "OLID:OL35253923M", "info_url": "http://openlibrary.org/books/OL35253923M/Being_Mortal", "preview": "restricted", "preview_url": "https://archive.org/details/beingmortalmedic0000gawa_v1j9", "thumbnail_url": "https://covers.openlibrary.org/b/id/12069679-S.jpg", "details": {"works": [{"key": "/works/OL17079567W"}], "title": "Being Mortal", "publishers": ["Picador"], "publish_date": "2017-09", "key": "/books/OL35253923M", "type": {"key": "/type/edition"}, "identifiers": {"goodreads": ["58614387"]}, "covers": [12069679], "ocaid": "beingmortalmedic0000gawa_v1j9", "isbn_10": ["1250076226"], "isbn_13": ["9781250076229"], "lccn": ["2014017442"], "oclc_numbers": ["1005264011"], "classifications": {}, "dewey_decimal_class": ["362.17' 5"], "lc_classifications": ["R726.8 .G39 2014"], "publish_places": ["New York"], "description": {"type": "/type/text", "value": "Modern medicine has transformed the dangers of birth, injury, and infectious disease from harrowing to manageable. But when it comes to the inescapable realities of aging and death, what medicine can do often runs counter to what it should do. Through eye-opening research and grip- ping stories of his own patients and family, Gawande reveals the suffering produced by medicine's neglect of the wishes people might have beyond mere survival. To find out what those wishes are, we need to ask. We haven't been asking, but we can learn.\r\n\r\nRiveting, honest, and humane, this remarkable book, which has already changed the national conversation on aging and death, shows how the ultimate goal is not a good death but a good life \u2014all the way to the very end.\r\n--back cover"}, "copyright_date": "2014", "edition_name": "First Picador Edition (1)", "pagination": "287p.", "number_of_pages": 287, "subtitle": "Medicine and What Matters in the End", "languages": [{"key": "/languages/eng"}], "notes": {"type": "/type/text", "value": "US"}, "physical_format": "Paperback", "source_records": ["idb:9781250076229"], "table_of_contents": [{"level": 0, "title": "Introduction", "pagenum": "1", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "1", "title": "The Independent Self", "pagenum": "11", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "2", "title": "Things Fall Apart", "pagenum": "25", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "3", "title": "Dependence", "pagenum": "55", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "4", "title": "Assistance", "pagenum": "79", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "5", "title": "A Better Life", "pagenum": "111", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "6", "title": "Letting Go", "pagenum": "149", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "7", "title": "Hard Conversations", "pagenum": "191", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "8", "title": "Courage", "pagenum": "231", "type": {"key": "/type/toc_item"}}, {"level": 0, "title": "Epilogue", "pagenum": "259", "type": {"key": "/type/toc_item"}}, {"level": 0, "title": "Notes on Sources", "pagenum": "265", "type": {"key": "/type/toc_item"}}, {"level": 0, "title": "Acknowledgments", "pagenum": "279", "type": {"key": "/type/toc_item"}}], "latest_revision": 5, "revision": 5, "created": {"type": "/type/datetime", "value": "2021-10-11T09:54:19.542825"}, "last_modified": {"type": "/type/datetime", "value": "2026-04-22T10:05:35.175772"}}}, "OLID:OL40204248M": {"bib_key": "OLID:OL40204248M", "info_url": "http://openlibrary.org/books/OL40204248M/Zui_hao_de_gao_bie", "preview": "borrow", "preview_url": "https://archive.org/details/zuihaodegaobiegu0000gawa", "thumbnail_url": "https://covers.openlibrary.org/b/id/12955689-S.jpg", "details": {"description": {"type": "/type/text", "value": "Atul Gawande tackles the hardest challenge of his profession: how medicine can not only improve life but also the process of its ending. Full of eye-opening research and riveting storytelling, Gawande asserts that medicine can comfort and enhance our experience even to the end, providing not only a good life but also a good end."}, "notes": {"type": "/type/text", "value": "Translation of: Being mortal : medicine and what matters in the end."}, "title": "Zui hao de gao bie", "subtitle": "guan yu shuai lao yu si wang, ni bi xu zhi dao de chang shi = Being mortal : medicine and what matters in the end", "authors": [{"key": "/authors/OL1485501A", "name": "Atul Gawande"}], "publish_date": "2015", "type": {"key": "/type/edition"}, "publish_country": "cc", "languages": [{"key": "/languages/chi"}], "oclc_numbers": ["933434228"], "lc_classifications": ["R726.8 .G39127 2015"], "dewey_decimal_class": ["616.029"], "work_titles": ["Being mortal : medicine and what matters in the end"], "other_titles": ["Guan yu shuai lao yu si wang, ni bi xu zhi dao de chang shi", "Being mortal :"], "edition_name": "Di 1 ban", "contributions": ["Wang, Yifang, editor", "Peng, Xiaohua, translator"], "subjects": ["Terminal care", "Critical care medicine", "Aging", "Physiological aspects", "Death", "Attitudes", "Prognosis", "Quality of life", "Critical Care", "Quality of Life", "Soins en phase terminale", "Soins intensif