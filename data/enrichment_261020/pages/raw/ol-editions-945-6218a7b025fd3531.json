06610"], "ia_loaded_id": ["angelasashesmemo00macc"], "lc_classifications": ["E184.I6 M117 1996", "E184.I6 .M117 1996", "E184.I6M117 1996"], "key": "/books/OL24938413M", "authors": [{"key": "/authors/OL26363A", "name": "Frank McCourt"}], "ocaid": "angelasashesmemo0929mcco", "publish_places": ["New York"], "subjects": ["Norteamericanos de origen irland\u00e9s", "Biograf\u00edas"], "isbn_13": ["9780684874357"], "pagination": "363 p.", "source_records": ["ia:angelasashesmemo00macc", "marc:marc_openlibraries_phillipsacademy/PANO_FOR_IA_05072019.mrc:17261519:2616", "marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run02.mrc:137005924:4004", "ia:angelasashesmemo0929mcco", "ia:angelasashesmemo0000mcco", "marc:marc_loc_2016/BooksAll.2016.part25.utf8:75631962:1097", "bwb:9780684874357", "marc:marc_gtu/KLF IA Export 5-5-22.mrc:63834229:1031", "marc:marc_scms/20220805_ADAM_MARC_records.mrc:102857957:1629", "promise:bwb_daily_pallets_2022-09-12", "marc:marc_nuls/NULS_PHC_180925.mrc:140432048:1138", "marc:marc_columbia/Columbia-extract-20221130-004.mrc:451625890:2150", "marc:harvard_bibliographic_metadata/20220215_023.bib.mrc:19194166:3799"], "title": "Angela's ashes", "lccn": ["96005335"], "number_of_pages": 363, "full_title": "Angela's ashes a memoir", "languages": [{"key": "/languages/eng"}], "isbn_10": ["0684874350"], "subject_people": ["MacCourt Familia"], "publish_country": "nyu", "publish_date": "1999", "by_statement": "Frank McCourt", "oclc_numbers": ["644804305", "34284265"], "works": [{"key": "/works/OL27634W"}], "type": {"key": "/type/edition"}, "description": {"type": "/type/text", "value": "\"When I look back on my childhood I wonder how I managed to survive at all. It was, of course, a miserable childhood: the happy childhood is hardly worth your while. Worse than the ordinary miserable childhood is the miserable Irish childhood, and worse yet is the miserable Irish Catholic childhood.\".\n\nSo begins the luminous memoir of Frank McCourt, born in Depression-era Brooklyn to recent Irish immigrants and raised in the slums of Limerick, Ireland. Frank's mother, Angela, has no money to feed the children since Frank's father, Malachy, rarely works, and when he does he drinks his wages. Yet Malachy - exasperating, irresponsible and beguiling - does nurture in Frank an appetite for the one thing he can provide: a story.\n\nFrank lives for his father's tales of Cuchulain, who saved Ireland, and of the Angel on the Seventh Step, who brings his mother babies."}, "latest_revision": 19, "revision": 19, "created": {"type": "/type/datetime", "value": "2011-08-08T06:40:17.491600"}, "last_modified": {"type": "/type/datetime", "value": "2025-11-28T14:09:53.286600"}}}, "OLID:OL7264737M": {"bib_key": "OLID:OL7264737M", "info_url": "http://openlibrary.org/books/OL7264737M/Angela's_Ashes", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL7264737M/Angela's_Ashes", "details": {"identifiers": {"goodreads": ["4916"], "librarything": ["5115"]}, "title": "Angela's Ashes", "authors": [{"key": "/authors/OL2624328A", "name": "McCourt"}], "publish_date": "1996", "publishers": ["Simon & Schuster", "Flamingo / HarperCollins"], "source_records": ["promise:bwb_daily_pallets_2020-12-28:KO-975-788", "amazon:0007718721:o-0:2711474859:172198", "amazon:0007718721:1:2443892911:177087", "promise:bwb_daily_pallets_2020-09-09:KO-059-602"], "type": {"key": "/type/edition"}, "isbn_13": ["9780007718726"], "isbn_10": ["0007718721"], "contributions": ["No Illustration (Illustrator)"], "local_id": ["urn:bwbsku:KO-975-788", "urn:bwbsku:KO-059-602"], "key": "/books/OL7264737M", "works": [{"key": "/works/OL27634W"}], "latest_revision": 11, "revision": 11, "created": {"type": "/type/datetime", "value": "2008-04-29T13:35:46.876380"}, "last_modified": {"type": "/type/datetime", "value": "2025-09-29T00:39:28.631004"}}}, "OLID:OL9219452M": {"bib_key": "OLID:OL9219452M", "info_url": "http://openlibrary.org/books/OL9219452M/Angela's_Ashes", "previ