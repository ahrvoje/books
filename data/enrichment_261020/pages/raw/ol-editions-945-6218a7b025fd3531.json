e/edition"}, "authors": [{"key": "/authors/OL714410A", "name": "Tad Richards"}], "isbn_13": ["9781438496016"], "languages": [{"key": "/languages/eng"}], "lc_classifications": ["ML3508.R53 2023"], "pagination": "188", "publish_date": "2024", "publishers": ["State University of New York Press"], "source_records": ["bwb:9781438496016"], "subjects": ["Music, history and criticism"], "title": "Jazz with a Beat", "weight": "0.227", "subtitle": "Small Group Swing, 1940-1960", "full_title": "Jazz with a Beat Small Group Swing, 1940-1960", "works": [{"key": "/works/OL37572208W"}], "key": "/books/OL50652152M", "covers": [14729190], "latest_revision": 2, "revision": 2, "created": {"type": "/type/datetime", "value": "2024-01-31T01:30:11.057442"}, "last_modified": {"type": "/type/datetime", "value": "2024-08-23T12:25:45.785970"}}}, "OLID:OL50630765M": {"bib_key": "OLID:OL50630765M", "info_url": "http://openlibrary.org/books/OL50630765M/Jazz_with_a_Beat", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL50630765M/Jazz_with_a_Beat", "thumbnail_url": "https://covers.openlibrary.org/b/id/14747206-S.jpg", "details": {"type": {"key": "/type/edition"}, "authors": [{"key": "/authors/OL714410A", "name": "Tad Richards"}], "isbn_13": ["9781438496009"], "languages": [{"key": "/languages/eng"}], "lc_classifications": ["ML3508.R53 2024"], "pagination": "188", "publish_date": "2024", "publishers": ["State University of New York Press"], "source_records": ["bwb:9781438496009"], "subjects": ["Music, history and criticism"], "title": "Jazz with a Beat", "weight": "0.227", "subtitle": "Small Group Swing, 1940-1960", "works": [{"key": "/works/OL37572208W"}], "key": "/books/OL50630765M", "covers": [14747206], "latest_revision": 2, "revision": 2, "created": {"type": "/type/datetime", "value": "2024-01-31T00:02:56.196405"}, "last_modified": {"type": "/type/datetime", "value": "2024-08-23T18:24:32.746568"}}}, "OLID:OL27218504M": {"bib_key": "OLID:OL27218504M", "info_url": "http://openlibrary.org/books/OL27218504M/The_golden_rules", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL27218504M/The_golden_rules", "details": {"table_of_contents": [{"level": 0, "label": "", "title": "Foreword / by Michael Phelps", "pagenum": "", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "", "title": "A champion's pursuit", "pagenum": "", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "", "title": "Rule 1. A champion sets a \"dream big\" vision", "pagenum": "", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "", "title": "Rule 2. Adopt an \"all-in!\" attitude, not a \"get out!\" one", "pagenum": "", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "", "title": "Rule 3. Take risks", "pagenum": "", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "", "title": "and then enjoy the rewards", "pagenum": "", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "", "title": "Rule 4. Short-term goals lead to long-term success", "pagenum": "", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "", "title": "Rule 5. Live the vision every day", "pagenum": "", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "", "title": "Rule 6. A team approach can bring individual success", "pagenum": "", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "", "title": "Rule 7. Stay motivated over the long haul", "pagenum": "", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "", "title": "Rule 8. Adversity will make you stronger", "pagenum": "", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "", "title": "Rule 9. When the time comes, perform with confidence", "pagenum": "", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "", "title": "Rule 10. Celebrate your achievement, then decide what's next", "pagenum": "", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "", "title": "Appendix I. Bob Bowman's record of excellence", "pagenum": "", "type": {"key": "/type/toc_item"}}, {"level": 0, "label": "", "title": "Appendix II. In his own words : the quotable Bob Bowman.", "pagenum": "", "type": {"key": "/type/toc_item"}}], "description": {"type": "/type/text", "value": "\"Bob Bowman, best known as the coach for the record-breaking run of Michael Phelps, is one of the most successful coaches in Olympic history. He is lauded for his intense personality, incredible dedication to his athletes, and his ability to nurture talent in athletes who have the heart and drive to win. This is his motivational book about winning in all walks of life and what you have to do to get there. He presents ten key concepts that all people should live by. Illuminating his lessons with spirited anecdotes, Bowman will teach you how to get gold out of every day by setting goals and getting motivated to achieve them. He will explain that taking risks is the key to success in any pursuit, and coach you on how you can make yourself risk-averse. By following The Golden Rules, you will learn to visualize in order to achieve your goals, and that above all else, dedication to your training, your job, or whatever area it is you are seeking to triumph in is paramount for success.\"--"}, "local_id": ["urn:sfpl:31223118733527", "urn:sfpl:31223118733519", "urn:sfpl:31223118733535"], "full_title": "The golden rules 10 steps to world-class excellence in your life and work", "lc_classifications": ["BF637.S8 B597 2016", "BF637.S8B597 2016"], "key": "/books/OL27218504M", "authors": [{"key": "/authors/OL1400361A", "name": "Bob Bowman"}], "subtitle": "10 steps to world-class excellence in your life and work", "contributions": ["Butler, Charles"], "subjects": ["Performance", "Success", "Goal (Psychology)", "Psychological aspects"], "languages": [{"key": "/languages/eng"}], "pagination": "xiv, 270 pages", "source_records": ["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run05.mrc:364574700:4199", "bwb:9781250059505"], "title": "The golden rules", "lccn": ["2016001123"], "number_of_pages": 270, "isbn_13": ["9781250059505"], "edition_name": "First edition.", "dewey_decimal_class": ["650.1"], "isbn_10": ["125005950X"], "publish_date": "2016", "publish_country": "nyu", "by_statement": "Bob Bowman, coach of 18-time Olympic Gold medalist Michael Phelps ; with Charles Butler", "oclc_numbers": ["944179615"], "works": [{"key": "/works/OL20038467W"}], "type": {"key": "/type/edition"}, "latest_revision": 3, "revision": 3, "created": {"type": "/type/datetime", "value": "2019-07-19T17:01:03.498952"}, "last_modified": {"type": "/type/datetime", "value": "2021-10-03T07:28:03.417430"}}}, "OLID:OL37433050M": {"bib_key": "OLID:OL37433050M", "info_url": "http://openlibrary.org/books/OL37433050M/Golden_Rules", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL37433050M/Golden_Rules", "details": {"type": {"key": "/type/edition"}, "authors": [{"key": "/authors/OL1400361A", "name": "Bob Bowman"}, {"key": "/authors/OL1800765A", "name": "Butler, Charles"}], "isbn_13": ["9781466864573"], "languages": [{"key": "/languages/eng"}], "pagination": "240", "publish_date": "2016", "publishers": ["St. Martin's Press"], "source_records": ["bwb:9781466864573"], "subjects": ["Self-actualization (psychology)"], "title": "Golden Rules", "subtitle": "Finding World-Class Excellence in Your Life and Work", "full_title": "Golden Rules Finding World-Class Excellence in Your Life and Work", "works": [{"key": "/works/OL20038467W"}], "key": "/books/OL37433050M", "latest_revision": 1, "revision": 1, "created": {"type": "/type/datetime", "value": "2022-03-01T17:47:49.822348"}, "last_modified": {"type": "/type/datetime", "value": "2022-03-01T17:47:49.822348"}}}, "OLID:OL28880798M": {"bib_key": "OLID:OL28880798M", "info_url": "http://openlibrary.org/books/OL28880798M/Golden_Rules", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL28880798M/Golden_Rules", "details": {"publishers": ["St. Martin's Press"], "subtitle": "10 Steps t