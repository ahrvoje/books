e": "Immense World", "subtitle": "How Animal Senses Reveal the Hidden Realms Around Us", "full_title": "Immense World How Animal Senses Reveal the Hidden Realms Around Us", "works": [{"key": "/works/OL25815646W"}], "key": "/books/OL40322237M", "latest_revision": 3, "revision": 3, "created": {"type": "/type/datetime", "value": "2022-11-17T06:48:44.225875"}, "last_modified": {"type": "/type/datetime", "value": "2023-10-04T18:13:54.373269"}}}, "OLID:OL39366787M": {"bib_key": "OLID:OL39366787M", "info_url": "http://openlibrary.org/books/OL39366787M/Immense_World", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL39366787M/Immense_World", "details": {"type": {"key": "/type/edition"}, "authors": [{"key": "/authors/OL637198A", "name": "Ed Yong"}], "isbn_13": ["9780593133248"], "languages": [{"key": "/languages/eng"}], "pagination": "464", "publish_date": "2022", "publishers": ["Random House Publishing Group"], "source_records": ["bwb:9780593133248"], "subjects": ["Senses and sensation", "Animal behavior", "Physiology", "Neurosciences"], "title": "Immense World", "subtitle": "How Animal Senses Reveal the Hidden Realms Around Us", "full_title": "Immense World How Animal Senses Reveal the Hidden Realms Around Us", "works": [{"key": "/works/OL25815646W"}], "key": "/books/OL39366787M", "latest_revision": 2, "revision": 2, "created": {"type": "/type/datetime", "value": "2022-08-18T11:22:56.563821"}, "last_modified": {"type": "/type/datetime", "value": "2023-10-04T18:09:20.754690"}}}, "OLID:OL38000852M": {"bib_key": "OLID:OL38000852M", "info_url": "http://openlibrary.org/books/OL38000852M/An_Immense_World", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL38000852M/An_Immense_World", "thumbnail_url": "https://covers.openlibrary.org/b/id/12873284-S.jpg", "details": {"type": {"key": "/type/edition"}, "authors": [{"key": "/authors/OL637198A", "name": "Ed Yong"}], "languages": [{"key": "/languages/eng"}], "publish_date": "2022", "publishers": ["Random House"], "source_records": ["bwb:9781847926098"], "subjects": ["Zoology"], "title": "An Immense World", "subtitle": "How Animal Senses Reveal the Hidden Realms Around Us", "full_title": "Immense World How Animal Senses Reveal the Hidden Realms Around Us", "works": [{"key": "/works/OL25815646W"}], "key": "/books/OL38000852M", "covers": [12873284], "identifiers": {"goodreads": ["59778664"], "amazon": ["B09JBJS1MF"]}, "isbn_13": ["9781847926098"], "lccn": ["2021046049"], "isbn_10": ["0593133242"], "oclc_numbers": ["9521640712"], "classifications": {}, "lc_classifications": ["QL751"], "dewey_decimal_class": ["591.5"], "physical_format": "ebook", "publish_places": ["New York"], "description": {"type": "/type/text", "value": "\"The Earth teems with sights and textures, sounds and vibrations, smells and tastes, electric and magnetic fields. But every animal is enclosed within its own unique sensory bubble, perceiving but a tiny sliver of an immense world.This book welcomes us into a previously unfathomable dimension-the world as it is truly perceived by other animals. We encounter beetles that are drawn to fires (and fireworks), songbirds that can see the Earth's magnetic fields, and brainless jellyfish that nonetheless have complex eyes. We discover that a crocodile's scaly face is as sensitive as a lover's fingertips, that the eyes of a giant squid evolved to see sparkling whales, and that even fingernail-sized spiders can make out the craters of the moon. We meet people with unusual senses, from women who can make out extra colors to blind individuals who can navigate using reflected echoes like bats. Yong tells the stories of pivotal discoveries in the field, and also looks ahead at the many mysteries which lie unsolved\"-- Provided by publisher."}, "copyright_date": "2022", "latest_revision": 4, "revision": 4, "created": {"type": "/type/datetime", "value": "2022-05-25T19:09:10.187496"}, "last_modified": {"type": "/type/datetime", "value": "2023-10-04T18:09:20.754690"}}}, "OLID:OL36099189M": {"bib_key": "OLID:OL36099189M", "info_url": "http://openlibrary.org/books/OL36099189M/Immense_World", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL36099189M/Immense_World", "thumbnail_url": "https://covers.openlibrary.org/b/id/12835209-S.jpg", "details": {"type": {"key": "/type/edition"}, "authors": [{"key": "/authors/OL637198A", "name": "Ed Yong"}], "isbn_13": ["9780593133231"], "languages": [{"key": "/languages/eng"}], "pagination": "480", "publish_date": "2022", "publishers": ["Random House Publishing Group"], "source_records": ["bwb:9780593133231", "promise:bwb_daily_pallets_2022-10-04", "marc:marc_columbia/Columbia-extract-20221130-034.mrc:63807363:4044"], "title": "Immense World", "weight": "0.568", "subtitle": "How Animal Senses Reveal the Hidden Realms Around Us", "full_title": "Immense World How Animal Senses Reveal the Hidden Realms Around Us", "works": [{"key": "/works/OL25815646W"}], "key": "/books/OL36099189M", "covers": [12835209], "local_id": ["urn:bwbsku:O8-BUS-458"], "lccn": ["2021046049"], "lc_classifications": ["QP431 .Y68 2022"], "oclc_numbers": ["1290244704"], "latest_revision": 5, "revision": 5, "created": {"type": "/type/datetime", "value": "2021-12-28T09:21:31.997566"}, "last_modified": {"type": "/type/datetime", "value": "2023-10-04T18:09:20.754690"}}}, "OLID:OL22119311M": {"bib_key": "OLID:OL22119311M", "info_url": "http://openlibrary.org/books/OL22119311M/The_years_of_Lyndon_Johnson", "preview": "restricted", "preview_url": "https://archive.org/details/yearsoflyndonjoh0001caro", "thumbnail_url": "https://covers.openlibrary.org/b/id/12869910-S.jpg", "details": {"identifiers": {"goodreads": ["1375400"], "librarything": ["12622"]}, "title": "The years of Lyndon Johnson", "subtitle": "The Path to Power", "authors": [{"key": "/authors/OL797731A", "name": "Robert A. Caro"}], "publish_date": "1982", "pagination": "2 v. : ill., ports. ; 24 cm.", "edition_name": "1st ed.", "subjects": ["Johnson, 