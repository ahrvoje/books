092573105", "urn:sfpl:31223093031517", "urn:sfpl:31223094346989", "urn:sfpl:31223125616186", "urn:sfpl:31223092573022", "urn:sfpl:31223096270435", "urn:sfpl:31223093031590", "urn:sfpl:31223092572933", "urn:sfpl:31223092567818", "urn:sfpl:31223125616269", "urn:sfpl:31223092573048", "urn:sfpl:31223125616228", "urn:sfpl:31223125616210", "urn:sfpl:31223092573139", "urn:sfpl:31223125616202", "urn:sfpl:31223092573063", "urn:sfpl:31223125616145", "urn:sfpl:31223125616194", "urn:sfpl:31223093031467", "urn:sfpl:31223092572974", "urn:sfpl:31223092572941", "urn:sfpl:31223125616244", "urn:sfpl:31223083660234", "urn:sfpl:31223125616152", "urn:sfpl:31223092567826", "urn:sfpl:31223125616137", "urn:nuls:31786102633101"], "lc_classifications": ["E185.6 .W685 2010", "E185.6.W685 2010"], "key": "/books/OL23962677M", "authors": [{"key": "/authors/OL3553076A", "name": "Isabel Wilkerson"}], "ocaid": "greatmigration00wilk", "publish_places": ["New York"], "languages": [{"key": "/languages/eng"}], "pagination": "p. cm.", "classifications": {}, "source_records": ["marc:marc_loc_updates/v37.i50.records.utf8:11402662:819", "ia:greatmigration00wilk", "marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run04.mrc:91207328:10904", "bwb:9780679444329", "marc:marc_loc_2016/BooksAll.2016.part36.utf8:156287306:2312", "marc:marc_columbia/Columbia-extract-20221130-030.mrc:182385463:2805", "marc:marc_columbia/Columbia-extract-20221130-016.mrc:183140497:2720", "marc:harvard_bibliographic_metadata/ab.bib.12.20150123.full.mrc:430772423:2436", "marc:marc_nuls/NULS_PHC_180925.mrc:107953947:2839", "idb:9780679444329", "marc:harvard_bibliographic_metadata/20220215_025.bib.mrc:80323761:7053"], "title": "The Warmth of Other Suns", "lccn": ["2009049753"], "notes": "Includes bibliographical references.", "identifiers": {}, "isbn_13": ["9780679444329"], "edition_name": "1st ed.", "dewey_decimal_class": ["304.80973"], "subjects": ["African Americans -- Migrations -- History -- 20th century", "Migration, Internal -- United States -- History -- 20th century", "Rural-urban migration -- United States -- History -- 20th century"], "publish_date": "2010", "publish_country": "nyu", "by_statement": "Isabel Wilkerson.", "works": [{"key": "/works/OL15380640W"}], "type": {"key": "/type/edition"}, "oclc_numbers": ["1176487329", "477270924"], "number_of_pages": 622, "description": {"type": "/type/text", "value": "In this epic, beautifully written masterwork, Pulitzer Prize-winning author Isabel Wilkerson chronicles one of the great untold stories of American history: the decades-long migration of black citizens who fled the South for northern and western cities, in search of a better life. From 1915 to 1970, this exodus of almost six million people changed the face of America."}, "latest_revision": 17, "revision": 17, "created": {"type": "/type/datetime", "value": "2009-12-18T09:59:13.908102"}, "last_modified": {"type": "/type/datetime", "value": "2025-12-18T04:17:05.154928"}}}, "OLID:OL27583624M": {"bib_key": "OLID:OL27583624M", "info_url": "http://openlibrary.org/books/OL27583624M/The_Warmth_of_Other_Suns", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL27583624M/The_Warmth_of_Other_Suns", "thumbnail_url": "https://covers.openlibrary.org/b/id/9037326-S.jpg", "details": {"publishers": ["Brilliance Audio"], "subtitle": "The Epic Story of America's Great Migration", "covers": [9037326], "physical_format": "audio cd", "full_title": "The Warmth of Other Suns The Epic Story of America's Great Migration", "last_modified": {"type": "/type/datetime", "value": "2019-10-30T00:30:22.948996"}, "latest_revision": 1, "key": "/books/OL27583624M", "authors": [{"key": "/authors/OL3553076A", "name": "Isabel Wilkerson"}], "source_records": ["amazon:1469233010"], "title": "The Warmth of Other Suns", "notes": {"type": "/type/text", "value": "Source title: The Warmth of Other Suns: The Epic Story of America's Great Migration"}, "identifiers": {"amazon": ["1469233010"]}, "created": {"type": "/type/datetime", "value": "2019-10-30T00:30:22.948996"}, "isbn_13": ["9781469233017"], "isbn_10": ["1469233010"], "publish_date": "Aug 20, 2013", "works": [{"key": "/works/OL15380640W"}], "type": {"key": "/type/edition"}, "revision": 1}}, "OLID:OL51727969M": {"bib_key": "OLID:OL51727969M", "info_url": "http://openlibrary.org/books/OL51727969M/The_Warmth_of_Other_Suns", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL51727969M/The_Warmth_of_Other_Suns", "thumbnail_url": "https://covers.openlibrary.org/b/id/14632526-S.jpg", "details": {"works": [{"key": "/works/OL15380640W"}], "title": "The Warmth of Other Suns", "publishers": ["Vintage Books"], "publish_date": "2011", "key": "/books/OL51727969M", "type": {"key": "/type/edition"}, "identifiers": {"amazon": ["B003EY7JGM"]}, "isbn_13": ["9780679604075"], "oclc_numbers": ["971415031"], "classifications": {}, "subtitle": "the epic story of America's great migration", "publish_places": ["New York"], "copyright_date": "2010", "edition_name": "First Vintage Books Edition", "languages": [{"key": "/languages/eng"}], "description": {"type": "/type/text", "value": "From 1915 to 1970, this exodus of almost six million people changed the face of America. Wilkerson compares this epic migration to the migrations of other peoples in history. She interviewed more than a thousand people, and gained access to new data and official records, to write this definitive and vividly dramatic account of how these American journeys unfolded, altering our cities, our country, and ourselves.\r\n \r\nWith stunning historical detail, Wilkerson tells this story through the lives of three unique individuals: Ida Mae Gladney, who in 1937 left sharecropping and prejudice in Mississippi for Chicago, where she achieved quiet blue-collar success and, in old age, voted for Barack Obama when he ran for an Illinois Senate seat; sharp and quick-tempered George Starling, who in 1945 fled Florida for Harlem, where he endangered his job fighting for civil rights, saw his family fall, and finally found peace in God; and Robert Foster, who left Louisiana in 1953 to pursue a medical career, the personal physician to Ray Charles as part of a glitteringly successful medical career, which allowed him to purchase a grand home where he often threw exuberant parties.\r\n\r\nWilkerson brilliantly captures their first treacherous and exhausting cross-country trips by car and train and their new lives in colonies that grew into ghettos, as well as how they changed these cities with southern food, faith, and culture and improved them with discipline, drive, and hard work. Both a riveting microcosm and a major assessment, The Warmth of Other Suns is a bold, remarkable, and riveting work, a superb account of an \u201cunrecognized immigration\u201d within our own land. Through the breadth of its narrative, the beauty of the writing, the depth of its research, and the fullness of the people and lives portrayed herein, this book is destined to become a classic."}, "physical_format": "ebook", "number_of_pages": 640, "covers": [14632526], "latest_revision": 3, "revision": 3, "created": {"type": "/type/datetime", "value": "2024-06-04T07:36:18.109825"}, "last_modified": {"type": "/type/datetime", "value": "2024-06-04T07:43:43.999409"}}}, "OLID:OL38810531M": {"bib_key": "OLID:OL38810531M", "info_url": "http://openlibrary.org/books/OL38810531M/Warmth_of_Other_Suns", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL38810531M/Warmth_of_Other_Suns", "details": {"type": {"key": "/type/edition"}, "authors": [{"key": "/authors/OL3553076A", "name": "Isabel Wilkerson"}], "isbn_13": ["9780141995168"], "languages": [{"key": "/languages/eng"}], "publish_date": "2020", "publishers": ["Penguin Books, Limited"], "source_records": ["bwb:9780141995168"], "title": "Warmth of Other Suns", "subtitle": "The Epic Story of America's Great Migration", "full_title": "Warmth of Other Suns The Epic Story of America's Great Migration", "works": [{"key": "/works/OL15380640W"}], "key": "/books/OL38810531M", "latest_revision": 2, "revision": 2, "created": {"type": "/type/datetime", "value": "2022-07-18T19:05:18.663208"}, "last_modified": {"type": "/type/datetime", "value": "2024-01-02T13:13:51.097920"}}}, "OLID:OL32935728M": {"bib_key": "OLID:OL32935728M", "info_url": "http://openlibrary.org/books/OL32935728M/The_Warmth_of_Other_Suns", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL32935728M/The_Warmth_of_Other_Suns", "thumbnail_url": "https://covers.openlibrary.org/b/id/11555234-S.jpg", "details": {"type": {"key": "/type/edition"}, "title": "The Warmth of Other Suns", "authors": [{"key": "/authors/OL3553076A", "name": "Isabel Wilkerson"}, {"key": "/authors/OL2859542A", "name": "Robin Miles"}], "publish_date": "Oct 04, 2011", "source_records": ["amazon:1455814210"], "publishers": ["Brilliance Audio"], "isbn_10": ["1455814210"], "isbn_13": ["9781455814213"], "physical_format": "audio cd", "full_title": "The Warmth of Other Suns The Epic Story of America's Great Migration", "subtitle": "The Epic Story of America's Great Migration", "notes": {"type": "/type/text", "value": "Source title: The Warmth of Other Suns: The Epic Story of America's Great Migration"}, "covers": [11555234], "works": [{"key": "/works/OL15380640W"}], "key": "/books/OL32935728M", "latest_revision": 2, "revision": 2, "created": {"type": "/type/datetime", "value": "2021-08-05T15:20:11.998809"}, "last_modified": {"type": "/type/datetime", "value": "2024-01-02T13:13:51.097920"}}}, "OLID:OL11129251M": {"bib_key": "OLID:OL11129251M", "info_url": "http://openlibrary.org/books/OL11129251M/The_Great_Migration", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL11129251M/The_Great_Migration", "details": {"publishers": ["Random House"], "physical_format": "Paperback", "classifications": {}, "source_records": ["marc:marc_openlibraries_phillipsacademy/PANO_FOR_IA_05072019.mrc:88341496: