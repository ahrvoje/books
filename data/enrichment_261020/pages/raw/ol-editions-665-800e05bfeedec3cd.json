e", "value": "2024-04-17T02:24:12.161176"}}}, "OLID:OL34664850M": {"bib_key": "OLID:OL34664850M", "info_url": "http://openlibrary.org/books/OL34664850M/Victory_in_the_Kitchen", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL34664850M/Victory_in_the_Kitchen", "details": {"type": {"key": "/type/edition"}, "authors": [{"key": "/authors/OL8122484A", "name": "Annie Gray"}], "isbn_13": ["9781788160445"], "languages": [{"key": "/languages/eng"}], "lc_classifications": ["TX649.G73 2020"], "publish_date": "2020", "publishers": ["Profile Books Limited"], "source_records": ["bwb:9781788160445"], "subjects": ["Home economics"], "title": "Victory in the Kitchen", "weight": "0.529", "pagination": "384", "subtitle": "The Life of Churchill's Cook", "works": [{"key": "/works/OL25755547W"}], "key": "/books/OL34664850M", "latest_revision": 1, "revision": 1, "created": {"type": "/type/datetime", "value": "2021-10-06T23:27:55.859480"}, "last_modified": {"type": "/type/datetime", "value": "2021-10-06T23:27:55.859480"}}}, "OLID:OL27907329M": {"bib_key": "OLID:OL27907329M", "info_url": "http://openlibrary.org/books/OL27907329M/Race_Against_Time", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL27907329M/Race_Against_Time", "thumbnail_url": "https://covers.openlibrary.org/b/id/9261623-S.jpg", "details": {"publishers": ["Simon & Schuster"], "physical_format": "Hardcover", "subtitle": "A Reporter Reopens the Unsolved Murder Cases of the Civil Rights Era", "source_records": ["bwb:9781451645132", "marc:marc_columbia/Columbia-extract-20221130-030.mrc:193505842:4036", "marc:harvard_bibliographic_metadata/20220215_010.bib.mrc:248746877:6220"], "title": "Race Against Time", "identifiers": {}, "covers": [9261623], "isbn_13": ["9781451645132"], "publish_date": "2020", "key": "/books/OL27907329M", "copyright_date": "2020", "classifications": {}, "publish_places": ["New York, USA"], "works": [{"key": "/works/OL20642136W"}], "type": {"key": "/type/edition"}, "lccn": ["2019030562"], "lc_classifications": ["PN4874.M543 A3 2020"], "oclc_numbers": ["1110672375"], "languages": [{"key": "/languages/eng"}], "description": {"type": "/type/text", "value": "\"An award-winning investigative reporter shares the real-life detective story of how Klansmen came to justice in notorious unsolved civil rights cold cases--decades after they had gotten away with murder\"--\n\nMitchell takes readers on the twisting, pulse-racing road that led to the reopening of four of the most infamous killings from the days of the civil rights movement. His work played a central role in bringing killers to justice for the assassination of Medgar Evers, the firebombing of Vernon Dahmer, the 16th Street Church bombing in Birmingham and the June 21, 1964 murder of three civil rights workers by more than twenty Klansmen. Mitchell reveals how he unearthed secret documents, found long-lost suspects and witnesses, and built up evidence strong enough to take on the Klan. -- adapted from jacket"}, "number_of_pages": 421, "latest_revision": 6, "revision": 6, "created": {"type": "/type/datetime", "value": "2020-02-03T15:25:03.043262"}, "last_modified": {"type": "/type/datetime", "value": "2025-07-21T10:11:03.856559"}}}, "OLID:OL29822155M": {"bib_key": "OLID:OL29822155M", "info_url": "http://openlibrary.org/books/OL29822155M/Race_Against_Time", "preview": "noview", "preview_url": "http://openlibrary.org/books/OL29822155M/Race_Against_Time", "thumbnail_url": "https://covers.openlibrary.org/b/id/14720628-S.jpg", "details": {"publishers": ["Simon & Schuster"], "subtitle": "A Reporter Reopens the Unsolved Murder Cases of the Civil Rights Era", "source_records": ["bwb:9781451645156"], "title": "Race Against Time", "number_of_pages": 432, "isbn_13": ["9781451645156"], "languages": [{"key": "/languages/eng"}], "full_title": "Race Against Time A Reporter Reopens the Unsolved Murder Cases of the Civil Rights Era", "lc_classifications": [""], "publish_date": "2020", "key": "/books