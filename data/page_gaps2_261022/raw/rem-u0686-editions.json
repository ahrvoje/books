11669","urn:sfpl:31223099112436","urn:sfpl:31223099112493","urn:bwbsku:P7-ACV-329","urn:nuls:31786102847362"],"full_title":"Devil in the grove Thurgood Marshall, the Groveland Boys, and the dawn of a new America","lc_classifications":["HV9956.G76 K56 2012","KF224.G76 K56 2012","HV9956.G76K56 2012"],"publish_places":["New York"],"edition_name":"1st ed.","pagination":"p. cm.","source_records":["promise:bwb_daily_pallets_2022-06-01:T2-DEC-250","marc:marc_loc_updates/v39.i34.records.utf8:16646360:1689","marc:marc_loc_updates/v40.i16.records.utf8:6866800:1633","marc:marc_loc_updates/v40.i30.records.utf8:11180571:1633","marc:marc_openlibraries_phillipsacademy/PANO_FOR_IA_05072019.mrc:39842424:3317","marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run04.mrc:205588964:5845","bwb:9780061792281","bwb:9780061792267","bwb:9780062097712","marc:marc_loc_2016/BooksAll.2016.part38.utf8:202044076:1633","ia:devilingrovethur0000king","marc:harvard_bibliographic_metadata/ab.bib.13.20150123.full.mrc:169834860:3483","marc:marc_columbia/Columbia-extract-20221130-019.mrc:100330867:2143","promise:bwb_daily_pallets_2021-08-26:P7-ACV-329","marc:marc_nuls/NULS_PHC_180925.mrc:132159422:3345","marc:harvard_bibliographic_metadata/20220215_067.bib.mrc:105769537:5100"],"lccn":["2011033757"],"isbn_13":["9780061792281","9780061792267","9780062097712"],"languages":[{"key":"/languages/eng"}],"dewey_decimal_class":["305.896/073075922"],"subject_places":["Florida","Groveland (Fla.)","Groveland"],"subjects":["Race relations","National Association for the Advancement of Colored People","Discrimination in criminal justice administration","Civil rights","African Americans","Rape","HISTORY / United States / 20th Century"],"subject_people":["Thurgood Marshall (1908-1993)"],"publish_country":"nyu","by_statement":"Gilbert King","type":{"key":"/type/edition"},"ocaid":"devilingrovethur0000king","oclc_numbers":["733223740"],"key":"/books/OL25005448M","works":[{"key":"/works/OL16117741W"}],"number_of_pages":434,"description":{"type":"/type/text","value":"In 1949, Florida's orange industry was booming with cheap Jim Crow labor. When a white seventeen-year-old Groveland girl cried rape, vicious Sheriff McCall was fast on the trail of four young blacks who dared to envision a future for themselves. Then the Ku Klux Klan rolled into town, burning homes and chasing hundreds of blacks into the swamps. So began the chain of events that would bring Thurgood Marshall, the man known as \"Mr. Civil Rights,\" into the fray. Associates thought it was suicidal for him to wade into the \"Florida Terror\" at a time when he was irreplaceable to the burgeoning civil rights movement, but the lawyer would not shrink from the fight--not after the Klan had murdered one of Marshall's NAACP associates and Marshall had endured threats that he would be next. Drawing on a wealth of never-before-published material, including the FBI's unredacted Groveland case files, as well as the NAACP's Legal Defense Fund files, King shines new light on this remarkable civil rights crusader against a heroic backdrop.--From publisher description."},"latest_revision":21,"revision":21,"created":{"type":"/type/datetime","value":"2011-10-20T09:36:21.523189"},"last_modified":{"type":"/type/datetime","value":"2025-05-16T22:18:53.781581"}}]}