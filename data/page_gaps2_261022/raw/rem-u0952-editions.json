:16:859511312:148080","idb:9780224041621","marc:harvard_bibliographic_metadata/20220215_009.bib.mrc:275908702:1820"],"title":"A People's Tragedy ","number_of_pages":923,"isbn_13":["9780224041621"],"covers":[138650],"languages":[{"key":"/languages/eng"}],"isbn_10":["0224041622"],"publish_date":"1996","key":"/books/OL7414321M","authors":[{"key":"/authors/OL35496A"}],"works":[{"key":"/works/OL72141W"}],"type":{"key":"/type/edition"},"oclc_numbers":["35657827"],"description":{"type":"/type/text","value":"This is a single-volume history of the century's most tragic and brutal revolution. The author has been able to exploit the newly opened files in Moscow and other cities and to take a free look at these nightmare years, including the long civil war."},"latest_revision":9,"revision":9,"created":{"type":"/type/datetime","value":"2008-04-29T13:35:46.876380"},"last_modified":{"type":"/type/datetime","value":"2025-07-23T12:37:13.968993"}},{"publishers":["Vintage Books"],"number_of_pages":10,"last_modified":{"type":"/type/datetime","value":"2011-04-28T13:58:53.853203"},"source_records":["amazon:0099701219:o-6:2926674477:140326","amazon:0099701219:7:2530505151:142871"],"title":"A People's Tragedy","identifiers":{"goodreads":["6474251"],"librarything":["23821"]},"isbn_13":["9780099701217"],"created":{"type":"/type/datetime","value":"2008-04-30T09:38:13.731961"},"physical_format":"Paperback","isbn_10":["0099701219"],"latest_revision":6,"key":"/books/OL9274404M","authors":[{"key":"/authors/OL35496A"}],"oclc_numbers":["48866185"],"works":[{"key":"/works/OL72141W"}],"type":{"key":"/type/edition"},"subjects":["European history: from c 1900 -","First World War, 1914-1918","Inter-war period, 1918-1939","Revolutions & coups","Russia"],"revision":6},{"table_of_contents":[{"level":0,"title":"The dynasty","type":{"key":"/type/toc_item"}},{"level":0,"title":"Unstable pillars","type":{"key":"/type/toc_item"}},{"level":0,"title":"Icons and cockroaches","type":{"key":"/type/toc_item"}},{"level":0,"title":"Red ink","type":{"key":"/type/toc_item"}},{"level":0,"title":"First blood","type":{"key":"/type/toc_item"}},{"level":0,"title":"Last hopes","type":{"key":"/type/toc_item"}},{"level":0,"title":"A war on three fronts","type":{"key":"/type/toc_item"}},{"level":0,"title":"Glorious February","type":{"key":"/type/toc_item"}},{"level":0,"title":"The freest country in the world","type":{"key":"/type/toc_item"}},{"level":0,"title":"The agony of the provisional government","type":{"key":"/type/toc_item"}},{"level":0,"title":"Lenin's revolution","type":{"key":"/type/toc_item"}},{"level":0,"title":"Last dreams of the old world","type":{"key":"/type/toc_item"}},{"level":0,"title":"The revolution goes to war","type":{"key":"/type/toc_item"}},{"level":0,"title":"The new regime triumphant","type":{"key":"/type/toc_item"}},{"level":0,"title":"Defeat in victory","type":{"key":"/type/toc_item"}},{"level":0,"title":"Deaths and departures.","type":{"key":"/type/toc_item"}}],"covers":[6792104],"local_id":["urn:phillips:31867001177950","urn:sfpl:31223072725717","urn:sfpl:31223043940007"],"lc_classifications":["DK260 .F54 1997","DK260.F54 1997"],"ocaid":"peoplestragedyhi00fige","languages":[{"key":"/languages/eng"}],"source_records":["ia:peoplestragedyhi00fige","marc:marc_openlibraries_phillipsacademy/PANO_FOR_IA_05072019.mrc:46405037:1205","marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run02.mrc:146338977:1884","ia:peoplestragedyhi00fige_706","amazon:0670859168","bwb:9780670859160","marc:marc_columbia/Columbia-extract-20221130-004.mrc:585281536:3394","marc:harvard_bibliographic_metadata/20220215_030.bib.mrc:261530169:3627"],"title":"A people's tragedy","edition_name":"1st American ed.","subjects":["History","Revolution","Bürgerkrieg","Geschichte"],"publish_country":"nyu","by_statement":"Orlando Figes","oclc_numbers":["36496487","36466776","228091851"],"type":{"key":"/type/edition"},"publishers":["Viking"],"ia_box_id":["IA119523"],"full_title":"A people's tragedy a history of the Russian Revolution","key":"/books/OL24738417M","authors":[{"key":"/authors/OL35496A"}],"publish_places":["New York, NY"],"pagination":"xx, 923 p., [70] p. of plates :","subtitle":"a history of the Russian Revolution","dewey_decimal_class":["947.08/3"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. [862]-894) and index."},"number_of_pages":923,"isbn_13":["9780670859160"],"subject_places":["Sowjetunion","Russia","Russland","Soviet Union"],"isbn_10":["0670859168"],"publish_date":"1997","copyright_date":"1996","subject_times":["Revolution, 1917-1921","Nicholas II, 1894-1917","1917-1936"],"works":[{"key":"/works/OL72141W"}],"lccn":["96036761"],"description":{"type":"/type/text","value":"It is a history on an epic yet human scale. Orlando Figes provides a panorama of Russian society on the eve of the revolution, and then narrates the story of how these social forces were violently suppressed. Within the broad strokes of war and revolution are miniature histories of individuals - pieced together from their private writings - in which Figes follows the main players' fortunes as they saw their hopes die and their world crash into ruins.\n\nThere is the patriotic general Brusilov, the progressive peasant Semenov, the critical socialist Maxim Gorky...individuals whose lives collapsed under the weight of history.\n\nThus develops a remarkable and unique perspective on what is considered by some to be the century's most important event. Figes depicts the revolution as a tragedy - both for the Russians as a people and for so many individuals whose lives became caught up in the storm. Yet he also shows that the major social forces - the peasantry, the workers, the soldiers, and the subject people of the empire - were not just the victims of the Bolsheviks but also actors in their own complex revolutionary tragedies.\n\nFiges argues that the failure of democracy in 1917 was deeply rooted in Russian culture and social history and that what had begun as a people's revolution contained the seeds of its degeneration into violence and dictatorship."},"latest_revision":11,"revision":11,"created":{"type":"/type/datetime","value":"2011-07-06T21:37:50.895356"},"last_modified":{"type":"/type/datetime","value":"2026-02-06T15:58:17.442977"}}]}