libraries_phillipsacademy/PANO_FOR_IA_05072019.mrc:20883439:1416","marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run04.mrc:144440153:2293","marc:marc_marygrove/marygrovecollegelibrary.full.D20191108.T213022.internetarchive2nd_REPACK.mrc:122766849:9738","bwb:9780393314250","marc:marc_loc_2016/BooksAll.2016.part24.utf8:123725399:800","marc:marc_loc_2016/BooksAll.2016.part35.utf8:164055724:778","ia:mismeasureofman0000goul_h4k3","marc:marc_columbia/Columbia-extract-20221130-009.mrc:72483400:2992","marc:marc_nuls/NULS_PHC_180925.mrc:258602772:1483","idb:9780393314250","marc:marc_columbia/Columbia-extract-20221130-004.mrc:382563729:2974"],"title":"The mismeasure of man","notes":"Includes bibliographical references (p. [425]-432) and index.","identifiers":{"goodreads":["54218"],"librarything":["21246"]},"edition_name":"Rev. and expanded, with a new introduction.","subjects":["Intelligence tests -- History.","Ability -- Testing -- History.","Personality tests -- History.","Craniometry -- History."],"publish_date":"2008","publish_country":"nyu","by_statement":"by Stephen Jay Gould.","works":[{"key":"/works/OL473565W"}],"type":{"key":"/type/edition"},"ocaid":"mismeasureofman00goul_1","isbn_13":["9780393314250"],"lccn":["2008271440","95044442"],"oclc_numbers":["1154266681","33276490"],"classifications":{},"lc_classifications":["BF431 .G68 2008","BF431.G68 1996","BF431 .G68 1996","BF431.G68"],"description":{"type":"/type/text","value":"When published in 1981, The Mismeasure of Man was immediately hailed as a masterwork, the ringing answer to those who would classify people, rank them according to their supposed genetic gifts and limits.\n\nAnd yet the idea of innate limits - of biology as destiny - dies hard, as witness the attention devoted to The Bell Curve, whose arguments are here so effectively anticipated and thoroughly undermined by Stephen Jay Gould. In this edition Dr.\n\nGould has written a substantial new introduction telling how and why he wrote the book and tracing the subsequent history of the controversy on innateness right through The Bell Curve, Further, he has added five essays, in a separate section at the end, on questions of The Bell Curve in particular and on race, racism, and biological determinism in general. These additions strengthen the claim of this book to be, as Leo J.\n\nKamin of Princeton University has said, \"a major contribution toward deflating pseudobiological 'explanations' of our present social woes.\""},"latest_revision":21,"revision":21,"created":{"type":"/type/datetime","value":"2008-09-25T12:21:33.372728"},"last_modified":{"type":"/type/datetime","value":"2024-07-30T15:09:59.870328"}},{"publishers":["Norton"],"source_records":["bwb:9780393300567"],"title":"The Mismeasure of Man","created":{"type":"/type/datetime","value":"2012-08-01T18:34:43.613907"},"covers":[9701229],"physical_format":"Paperback","isbn_10":["0393300560"],"publish_date":"1981","key":"/books/OL25397175M","last_modified":{"type":"/type/datetime","value":"2020-08-27T15:23:20.972675"},"ocaid":"isbn_9780393300567","latest_revision":6,"works":[{"key":"/works/OL473565W"}],"type":{"key":"/type/edition"},"revision":6}]}