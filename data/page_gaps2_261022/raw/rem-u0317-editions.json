es/eng"}],"notes":"Duration: 53,514 seconds","other_titles":["Persian Fire: The First World Empire and the Battle for the West"],"physical_format":"eAudiobook","isbn_10":["1515976211"],"isbn_13":["9781515976219"],"oclc_numbers":["956710148"],"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2026-06-10T22:57:32.859434"},"last_modified":{"type":"/type/datetime","value":"2026-06-12T19:15:21.521344"}},{"type":{"key":"/type/edition"},"title":"Persian Fire","authors":[{"key":"/authors/OL1157403A"}],"publish_date":"Jun 10, 2005","source_records":["amazon:1405501162"],"number_of_pages":5,"publishers":["Time Warner AudioBooks"],"isbn_10":["1405501162"],"isbn_13":["9781405501163"],"physical_format":"audio cd","full_title":"Persian Fire","covers":[10678666],"works":[{"key":"/works/OL17743875W"}],"key":"/books/OL32011738M","latest_revision":2,"revision":2,"created":{"type":"/type/datetime","value":"2021-03-07T04:47:01.392210"},"last_modified":{"type":"/type/datetime","value":"2024-08-30T19:02:06.880645"}},{"number_of_pages":418,"table_of_contents":[{"level":0,"label":"","title":"1. The Khorasan highway","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"2. Babylon","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"3. Sparta","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"4. Athens","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"5. Singeing the king of Persia's beard","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"6. The gathering storm","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"7. At bay","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"8. Nemesis.","pagenum":"","type":{"key":"/type/toc_item"}}],"covers":[9292412,8024259],"lc_classifications":["DS281 .H65 2006","ML420.P96"],"ocaid":"persianfirefirst00tomh","source_records":["ia:persianfirefirst00tomh","bwb:9780349117171"],"title":"Persian Fire","languages":[{"key":"/languages/eng"}],"subjects":["Salamis, Battle of (Greece : 480 B.C.) fast (OCoLC)fst01103757","Salamis, Battle of, Greece, 480 B.C.","Persian Wars (Greece : 500-449 B.C.) fast (OCoLC)fst01353977","History"],"publish_country":"enk","by_statement":"Tom Holland","oclc_numbers":["71139318"],"type":{"key":"/type/edition"},"publishers":["Abacus"],"description":"In 480 B.C.E., Xerxes, the King of Persia, led an invasion of mainland Greece. Its success should have been a formality. For seventy years, victory--rapid, spectacular victory--had seemed the birthright of the Persian Empire. They had swept across the Near East, shattering ancient kingdoms, storming famous cities, putting together an empire which stretched from India to the shores of the Aegean. Xerxes ruled as the most powerful man on the planet. Yet somehow, astonishingly, against the largest expeditionary force ever assembled, the Greeks managed to hold out. Had the Greeks been defeated in the epochal naval battle at Salamis, not only would the West have lost its first struggle for independence and survival, but it is unlikely that there would ever have been such an entity as the West at all. Historian Holland combines scholarly rigor with novelistic depth and finds extraordinary parallels between the ancient world and our own.--From publisher description.","physical_format":"Paperback","full_title":"Persian fire the first world empire and the battle for the West","key":"/books/OL26342439M","authors":[{"key":"/authors/OL1157403A"}],"publish_places":["London"],"pagination":"xxv, 418 pages, [16] pages of plates :","classifications":{},"subtitle":"the first world empire and the battle for the West","dewey_decimal_class":["938.03"],"notes":{"type":"/type/text","value":"Includes bibliographical references and index.\r\n\r\nOriginally published: Little, Brown, 2005."},"identifiers":{},"isbn_13":["9780349117171"],"subject_places":["Greece"],"isbn_10":