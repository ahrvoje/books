D175F1AB-28A8-4508-9B7D-D21A966926CD"]},"isbn_13":["9781400043767"],"covers":[6419279],"created":{"type":"/type/datetime","value":"2010-06-18T00:07:05.177231"},"physical_format":"Electronic resource","last_modified":{"type":"/type/datetime","value":"2012-08-04T21:51:09.511285"},"publish_date":"2004","publish_country":"nyu","key":"/books/OL24270007M","authors":[{"key":"/authors/OL34354A"}],"latest_revision":3,"publish_places":["New York"],"works":[{"key":"/works/OL53119W"}],"type":{"key":"/type/edition"},"revision":3},{"notes":{"type":"/type/text","value":"Includes bibliographical references and index."},"identifiers":{"librarything":["3344"],"goodreads":["795923"],"wikidata":["Q124329271"]},"title":"His Excellency","subtitle":"George Washington","authors":[{"key":"/authors/OL34354A"}],"publish_date":"2004","isbn_10":["1400040310"],"subject_place":["United States"],"covers":[745169],"lc_classifications":["E312 .E245 2004"],"url":["http://www.loc.gov/catdir/bios/random056/2004046576.html","http://www.loc.gov/catdir/samples/random051/2004046576.html","http://www.loc.gov/catdir/description/random051/2004046576.html"],"ocaid":"hisexcellencygeo00elli","uri_descriptions":["Contributor biographical information","Sample text","Publisher description"],"edition_name":"1st ed.","genres":["Biography."],"source_records":["marc:marc_records_scriblio_net/part15.dat:25087573:1074","ia:hisexcellencygeo00elli","ia:hisexcellencygeo00elli","ia:hisexcellencygeo00elli","marc:marc_openlibraries_phillipsacademy/PANO_FOR_IA_05072019.mrc:50633334:3672","marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run03.mrc:73083865:4323","marc:marc_marygrove/marygrovecollegelibrary.full.D20191108.T213022.internetarchive2nd_REPACK.mrc:155897476:5283","ia:hisexcellencygeo0000elli","ia:hisexcellencygeo0000elli_u0f9","amazon:1400040310","bwb:9781400040315","marc:marc_loc_2016/BooksAll.2016.part31.utf8:178489288:1074","promise:bwb_daily_pallets_2022-05-25","marc:marc_nuls/NULS_PHC_180925.mrc:297446889:1568","marc:marc_columbia/Columbia-extract-20221130-010.mrc:443380943:3195","marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:464525816:1400","marc:harvard_bibliographic_metadata/20220215_033.bib.mrc:177164032:2400"],"languages":[{"key":"/languages/eng"}],"subjects":["Washington, George, 1732-1799","Presidents -- United States -- Biography","Generals -- United States -- Biography"],"publish_country":"nyu","by_statement":"Joseph J. Ellis.","type":{"key":"/type/edition"},"uris":["http://www.loc.gov/catdir/bios/random056/2004046576.html","http://www.loc.gov/catdir/samples/random051/2004046576.html","http://www.loc.gov/catdir/description/random051/2004046576.html"],"publishers":["Alfred A. Knopf"],"ia_box_id":["IA138419"],"publish_places":["New York"],"pagination":"xiv, 320 p. :","dewey_decimal_class":["973.4/1/092","B"],"lccn":["2004046576"],"local_id":["urn:phillips:31867001388193","urn:sfpl:31223060669539","urn:sfpl:31223071676663","urn:sfpl:31223060669422","urn:sfpl:31223060669521","urn:sfpl:31223069361005","urn:sfpl:31223060669547","urn:sfpl:31223069360981","urn:sfpl:31223060669406","urn:sfpl:31223060669497","urn:sfpl:31223060669315","urn:sfpl:31223060669562","urn:sfpl:31223060669414","urn:sfpl:31223060669398","urn:mgc:31927000827649","urn:bwbsku:W7-BZH-115","urn:nuls:31786101861893"],"oclc_numbers":["54817026"],"key":"/books/OL3304276M","number_of_pages":320,"works":[{"key":"/works/OL53119W"}],"description":{"type":"/type/text","value":"\"Drawing from the newly catalogued Washington papers at the University of Virginia, Joseph Ellis paints a full portrait of George Washington's life and career - from his military years through his two terms as president. Ellis illuminates the difficulties the first executive confronted as he worked to keep the emerging country united in the face of adversarial factions. He richly details Washington's private life and illustrates the ways in which it influenced his public persona. Through Ellis's artful narration, we look inside Washington's marriage and his subsequent entrance into the upper echelons of Virginia's plantation society. We come to understand that it was by managing his own large debts to British merchants that he experienced firsthand the imperiousness of the British Empire. And we watch the evolution of his attitude towards slavery, which led to his emancipating his own slaves in his will. Throughout, Ellis peels back the layers of myth and uncovers for us Washington in the context of eighteenth-century America, allowing us to comprehend the magnitude of his accomplishments and the character of his spirit and mind.\" \"When Washington died in 1799, Ellis tells us, he was eulogized as \"first in the hearts of his countrymen.\" Since then, however, his image has been chisled onto Mount Rushmore and printed on the dollar bill. He is on our landscape and in our wallets but not, Ellis argues, in our hearts. Ellis strips away the ivy and legend that have grown up over the Washington statue and recovers the flesh-and-blood man in all his passionate and fully human prowess.\" \"In the pantheon of our republic's founders, there were many outstanding individuals. And yet each of them - Franklin, Hamilton, Adams, Jefferson, and Madison - acknowledged Washington to be his superior, the only indispensable figure, the one and only \"His Excellency.\" Both physically and politically, Washington towered over his peers for reasons this book elucidates.\"--BOOK JACKET."},"latest_revision":25,"revision":25,"created":{"type":"/type/datetime","value":"2008-04-01T03:28:50.625462"},"last_modified":{"type":"/type/datetime","value":"2026-03-24T18:22:01.551266"}}]}