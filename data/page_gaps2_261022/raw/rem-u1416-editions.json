{"links":{"self":"/works/OL4452488W/editions.json?limit=100","work":"/works/OL4452488W"},"size":12,"entries":[{"works":[{"key":"/works/OL4452488W"}],"title":"All the Shah's Men","publishers":["John Wiley & Sons, Inc."],"publish_date":"2003","key":"/books/OL51170519M","type":{"key":"/type/edition"},"identifiers":{},"isbn_10":["0471265179"],"classifications":{},"subtitle":"An American Coup and the Roots of Middle East Terror","publish_places":["Hoboken, New Jersey"],"copyright_date":"2003","physical_format":"Hardcover","number_of_pages":272,"pagination":"258","first_sentence":{"type":"/type/text","value":"Most of Tehran was asleep when an odd caravan set out through the darkness shortly before midnight on August 15, 1953."},"covers":[14592205],"lccn":["2003009968"],"lc_classifications":["DS318 .K49 2003"],"oclc_numbers":["52165724"],"source_records":["marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:116157444:2346","marc:harvard_bibliographic_metadata/20220215_029.bib.mrc:65169283:3644"],"description":{"type":"/type/text","value":"\"Half a century ago, the United States overthrew a Middle Eastern government for the first time. The victim was Mohammad Mossadegh, the democratically elected prime minister of Iran. Although the coup seemed a success at first, today it serves as a chilling lesson about the dangers of foreign intervention.\" \"In this book, veteran New York Times correspondent Stephen Kinzer gives the first full account of this fateful operation. His account is centered around an hour-by-hour reconstruction of the events of August 1953, and concludes with an assessment of the coup's \"haunting and terrible legacy.\"\"--Jacket."},"languages":[{"key":"/languages/eng"}],"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2024-03-02T22:15:39.466183"},"last_modified":{"type":"/type/datetime","value":"2026-01-29T16:55:22.048932"}},{"publishers":["Wiley","John Wiley & Sons"],"identifiers":{"goodreads":["191780"],"librarythin