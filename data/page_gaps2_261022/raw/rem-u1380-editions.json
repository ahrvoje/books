orks/OL1890328W"}],"type":{"key":"/type/edition"},"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2018-06-12T14:49:24.773599"},"last_modified":{"type":"/type/datetime","value":"2024-01-29T22:02:52.018858"}},{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL226273A"},{"key":"/authors/OL217774A"},{"key":"/authors/OL6530293A"}],"languages":[{"key":"/languages/eng"}],"pagination":"256","publish_date":"2018","publishers":["HarperCollins Publishers"],"source_records":["bwb:9780062748225"],"subjects":["Slaves, united states","Slave trade","Slavery, united states, history","Alabama, history"],"title":"Barracoon","subtitle":"The Story of the Last Black Cargo","full_title":"Barracoon The Story of the Last Black Cargo","works":[{"key":"/works/OL1890328W"}],"key":"/books/OL36329311M","identifiers":{},"isbn_13":["9780062748225"],"classifications":{},"physical_format":"eBook","covers":[14421758],"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2021-12-30T11:50:46.521756"},"last_modified":{"type":"/type/datetime","value":"2023-09-13T18:37:57.666396"}},{"subtitle":"the story of the last \"black cargo\"","description":{"type":"/type/text","value":"The true story of the last known survivor of the Atlantic slave trade, illegally smuggled from Africa on the last \"black cargo\" ship to arrive in the United States."},"local_id":["urn:sfpl:31223129817111","urn:sfpl:31223129817129","urn:sfpl:31223129817137"],"physical_format":"[sound recording] :","subject_times":["19th century"],"full_title":"Barracoon the story of the last \"black cargo\"","lc_classifications":["E444.L49 H87 2018ab"],"key":"/books/OL26960461M","authors":[{"key":"/authors/OL226273A"}],"contributions":["Plant, Deborah G., 1956- editor","Miles, Robin, narrator"],"subjects":["Slave trade","West Africans","Slaves","Slave ships","Clotilda (Ship)","Slavery","Biography","History"],"languages":[{"key":"/languages/eng"}],"pagination":"3 audio discs (3 3/4 hr.)","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run06.mrc:153384014:3227","amazon:1538519283"],"title":"Barracoon","dewey_decimal_class":["306.3/62092"],"notes":{"type":"/type/text","value":"Compact discs.\n\nRead by Robin Miles."},"isbn_13":["9781538519288","9781538519295"],"edition_name":"Unabridged.","subject_places":["Mobile","Mobile (Ala.)","Alabama"],"isbn_10":["1538519283","1538519291"],"subject_people":["Cudjo Lewis"],"publish_country":"nyu","publish_date":"2018","by_statement":"Zora Neale Hurston ; edited and with an introduction by Deborah G. Plant","oclc_numbers":["1032263986"],"works":[{"key":"/works/OL1890328W"}],"type":{"key":"/type/edition"},"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2019-05-24T08:23:13.798831"},"last_modified":{"type":"/type/datetime","value":"2023-03-09T20:04:32.605056"}},{"subtitle":"the story of the last \"black cargo\"","description":{"type":"/type/text","value":"In 1927, Zora Neale Hurston went to Plateau, Alabama, just outside Mobile, to interview eighty-six-year-old Cudjo Lewis. Of the millions of men, women, and children transported from Africa to America as slaves, Cudjo was then the only person alive to tell the story of this integral part of the nation's history. Hurston was there to record Cudjo's firsthand account of the raid that led to his capture and bondage fifty years after the Atlantic slave trade was outlawed in the United States. In 1931, Hurston returned to Plateau, the African-centric community three miles from Mobile founded by Cudjo and other former slaves from his ship. Spending more than three months there, she talked in depth with Cudjo about the details of his life. During those weeks, the young writer and the elderly formerly enslaved man ate peaches and watermelon that grew in the backyard and talked about Cudjo's past--memories from his childhood in Africa, the horrors of being captured and held in a barracoon for selection by American slavers, the harrowing experience of the Middle Passage packed with more than 100 other souls aboard the Clotilda, and the years he spent in slavery until the end of the Civil War. Based on those interviews, featuring Cudjo's unique vernacular, and written from Hurston's perspective with the compassion and singular style that have made her one of the preeminent American authors of the twentieth-century, Barracoon masterfully illustrates the tragedy of slavery and of one life forever defined by it. Offering insight into the pernicious legacy that continues to haunt us all, black and white, this poignant and powerful work is an invaluable contribution to our shared history and culture."},"isbn_10":["0062748203"],"subject_times":["19th century"],"full_title":"Barracoon the story of the last \"black cargo\"","lc_classifications":["E444 .H897 2018","E443","E444.L49 H87 2018","E444 .H87 2018"],"key":"/books/OL26952387M","authors":[{"key":"/authors/OL226273A"}],"contributions":["Plant, Deborah G., 1956- editor, writer of introduction","Walker, Alice, writer of foreword"],"subjects":["Slave trade","West Africans","Slaves","Clotilda (Ship)","Slavery","Biography","History"],"languages":[{"key":"/languages/eng"}],"pagination":"xxviii, 171 pages","source_records":["marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run06.mrc:120115003:13340","bwb:9780062748201","promise:bwb_daily_pallets_2021-03-24","marc:marc_columbia/Columbia-extract-20221130-027.mrc:152342537:6931","marc:marc_nuls/NULS_PHC_180925.mrc:263801160:4558","idb:9780062748201","marc:harvard_bibliographic_metadata/20220215_067.bib.mrc:54743926:9907"],"title":"Barracoon","dewey_decimal_class":["306.3/62092","B"],"notes":{"type":"/type/text","value":"Foreword by Alice Walker -- on jacket\n\nIncludes bibliographical references (pages 155-171)."},"number_of_pages":171,"isbn_13":["9780062748201"],"edition_name":"First edition.","subject_places":["United States","Alabama","Africa"],"local_id":["u