"Translator","name":"Alejandro Pradera Sánchez"}],"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2017-05-09T07:04:02.691700"},"last_modified":{"type":"/type/datetime","value":"2026-07-01T23:06:57.143915"}},{"publishers":["Galaxia Gutenberg"],"title":"Sobre la tiranía","covers":[7985212],"publish_date":"2017","key":"/books/OL26311688M","publish_places":["Barcelona"],"works":[{"key":"/works/OL17710110W"}],"type":{"key":"/type/edition"},"identifiers":{},"isbn_13":["9788416734979"],"contributors":[{"role":"Translator","name":"Alejandro Pradera Sánchez"}],"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2017-05-09T07:12:31.326928"},"last_modified":{"type":"/type/datetime","value":"2026-07-01T23:11:47.904357"}},{"publishers":["Galaxia Gutenberg"],"last_modified":{"type":"/type/datetime","value":"2020-08-22T14:07:47.793422"},"latest_revision":3,"key":"/books/OL26311687M","created":{"type":"/type/datetime","value":"2017-05-09T07:07:46.613524"},"title":"Sobre la tiranía","isbn_13":["9788416734979"],"publish_date":"2017","works":[{"key":"/works/OL17710110W"}],"type":{"key":"/type/edition"},"revision":3},{"publishers":["Galaxia Gutenberg"],"translated_from":[{"key":"/languages/eng"}],"identifiers":{},"subtitle":"Veinte lecciones que aprender del siglo XX","description":"La historia no se repite, pero sí alecciona. Tanto el nazismo como el comunismo fueron reacciones a la globalización: a las desigualdades reales o imaginadas que creaba, y a la aparente impotencia de las democracias para afrontarlas. Eran movimientos en los que un líder o un partido decían dar voz al pueblo, prometían protegerlo de las amenazas globales existentes y rechazaban la razón en favor del mito. La historia europea nos muestra que las sociedades pueden quebrarse, las democracias pueden caer, la ética puede venirse abajo y la gente corriente puede encontrarse en situaciones inimaginables. Hoy en día nos resultaría muy útil comprender por qué.\r\n\r\nLa historia puede familiarizar y puede servir de advertencia. No somos más sabios que los europeos que vieron cómo la democracia se rendía ante el autoritarismo durante el siglo XX. Pero cuando el orden político parece amenazado, nuestra ventaja es que podemos aprender de su experiencia para impedir el avance de la tiranía. Ahora es un buen momento para hacerlo.\r\n\r\nEste libro presenta veinte lecciones que aprender del siglo XX, adaptadas a las circunstancias de hoy.","contributors":[{"role":"Translator","name":"Alejandro Pradera"}],"covers":[7984844],"physical_format":"Print book","last_modified":{"type":"/type/datetime","value":"2019-10-15T12:26:47.218410"},"latest_revision":6,"key":"/books/OL26311427M","table_of_contents":[{"type":{"key":"/type/toc_item"},"label":"Prólogo: la historia y la tiranía","pagenum":"11","level":1},{"type":{"key":"/type/toc_item"},"label":"1. No obedezcas por anticipado","pagenum":"15","level":1},{"type":{"key":"/type/toc_item"},"label":"2. Defiende las instituciones","pagenum":"21","level":1},{"type":{"key":"/type/toc_item"},"label":"3. Cuidado con el Estado de partido único","pagenum":"27","level":1},{"type":{"key":"/type/toc_item"},"label":"4. Asume tu responsabilidad por el aspectodel mundo","pagenum":"35","level":1},{"type":{"key":"/type/toc_item"},"label":"5. Recuerda la ética profesional","pagenum":"43","level":1},{"type":{"key":"/type/toc_item"},"label":"6. Desconfía de las fuerzas paramilitares","pagenum":"49","level":1},{"type":{"key":"/type/toc_item"},"label":"7. Sé reflexivo si tienes que ir armado","pagenum":"55","level":1},{"type":{"key":"/type/toc_item"},"label":"8. Desmárcate del resto","pagenum":"61","level":1},{"type":{"key":"/type/toc_item"},"label":"9. Trata bien nuestra lengua","pagenum":"69","level":1},{"type":{"key":"/type/toc_item"},"label":"10.Cree en la verdad","pagenum":"75","level":1},{"type":{"key":"/type/toc_item"},"label":"11. Investiga","pagenum":"83","level":1},{"type":{"key":"/type/toc_item"},"label":"12. Mira a los ojos y habla de las cosas cotidianas","pagenum":"93","level":1},{"type":{"key":"/type/toc_item"},"label":"13. Practica una política corporal","pagenum":"97","level":1},{"type":{"key":"/type/toc_item"},"label":"14. Consolida una vida privada","pagenum":"103","level":1},{"type":{"key":"/type/toc_item"},"label":"15. Contribuye a las buenas causas","pagenum":"109","level":1},{"type":{"key":"/type/toc_item"},"label":"16. Aprende de tus conocidos de otros países","pagenum":"115","level":1},{"type":{"key":"/type/toc_item"},"label":"17. Presta atención a las palabras peligrosas","pagenum":"121","level":1},{"type":{"key":"/type/toc_item"},"label":"18. Mantén la calma cuando ocurralo impensable","pagenum":"127","level":1},{"type":{"key":"/type/toc_item"},"label":"19. Sé patriota","pagenum":"135","level":1},{"type":{"key":"/type/toc_item"},"label":"20. Sé todo lo valiente que puedas","pagenum":"141","level":1},{"type":{"key":"/type/toc_item"},"label":"Epílogo: la historia y la libertad","pagenum":"143","level":1}],"publish_places":["Barcelona, Spain"],"languages":[{"key":"/languages/spa"}],"classifications":{},"title":"Sobre la tiranía","translation_of":"On Tyranny: Twenty Lessons from the Twentieth Century","number_of_pages":150,"isbn_13":["9788416734979"],"created":{"type":"/type/datetime","value":"2017-05-08T12:02:52.857449"},"edition_name":"1st edition","isbn_10":["8416734976"],"publish_date":"2017","oclc_numbers":["1013975890"],"works":[{"key":"/works/OL17710110W"}],"type":{"key":"/type/edition"},"physical_dimensions":"21 x  x  centimeters","revision":6}]}