45835W"}],"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2019-02-24T05:49:12.189567"},"last_modified":{"type":"/type/datetime","value":"2024-03-20T08:15:25.552347"}},{"publishers":["Penguin Books","Penguin"],"physical_format":"paperback","source_records":["amazon:0141009756","bwb:9780141009759","promise:bwb_daily_pallets_2022-03-17"],"title":"Coming of the Third Reich","number_of_pages":656,"covers":[10288042],"isbn_13":["9780141009759"],"full_title":"Coming of the Third Reich","isbn_10":["0141009756"],"publish_date":"Jun 01, 2007","key":"/books/OL28339402M","authors":[{"key":"/authors/OL201893A"}],"works":[{"key":"/works/OL1745835W"}],"type":{"key":"/type/edition"},"lc_classifications":["DD221.E94 2004"],"local_id":["urn:bwbsku:KQ-170-666"],"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2020-07-17T07:31:36.946990"},"last_modified":{"type":"/type/datetime","value":"2022-12-07T04:21:48.625394"}},{"publishers":["The Penguin Press"],"identifiers":{"goodreads":["1226182"]},"table_of_contents":[{"level":0,"label":"","title":"The legacy of the past","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"German peculiarities","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Gospels of hate","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The spirit of 1914","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Descent into chaos","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The failure of democracy","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The weaknesses of Weimar","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The great inflation","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Culture wars","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The fit and the unfit","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The rise of Nazism","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Bohemian revolutionaries","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The beer-hall Putsch","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Rebuilding the movement","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The roots of commitment","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Towards the seizure of power","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The great depression","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The crisis of democracy","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The victory of violence","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Fateful decisions","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Creating the Third Reich","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The terror begins","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Fire in the Reichstag","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Democracy destroyed","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Bringing Germany into line","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Hitler's cultural revolution","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Discordant notes","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"The purge of the arts","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Against the un-German spirit","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"A revolution of destruction?","pagenum":"","type":{"key":"/type/toc_item"}}],"description":{"type":"/type/text","value":"\"In 1900, Germany was one of modernity's great success stories: The most progressive and dynamic nation in Europe, it was the only country whose rapid economic growth and innovation rivaled that of the United States. Its political culture was far less authoritarian than Russia's and less anti-Semitic than France's. Representative institutions thrived, and competing political parties and elections were a central part of life. How, then, could it be that in little more than a generation this stable modern country would fall into the hands of Adolf Hitler and the violent, racist, extremist political movement he led, a movement that would lead Germany and then all of Europe into utter moral, physical, and cultural ruin?\" \"There is no story in twentieth-century history more important to understand, and Richard Evans has written the definitive account for our time. A masterful synthesis of a vast body of scholarly work integrated with important new research and interpretations, Evans's history restores drama and contingency to the rise to power of Hitler and the Nazis, even as he shows how ready Germany was by the early 1930s for such a takeover to occur. Its citizens were angry and embittered by military defeat and economic ruin, and its young democracy undermined by a civil service, an army, and a law enforcement system deeply alienated from the new order. The electorate was beset by growing extremism and panic about communism; and the small but successful Jewish community was subject to wide-spread suspicion and resentment. In the end, though nothing about what happened was preordained, Germany proved to be fertile ground for Nazism's ideology of hatred.\"--BOOK JACKET"},"covers":[872233],"local_id":["urn:trent:13368198","urn:trent:0116404972550","urn:trent:0116411163458","urn:phillips:31867001384754","urn:sfpl:31223059150129","urn:sfpl:31223048923636","urn:sfpl:31223048923743","urn:sfpl:31223048923644","urn:sfpl:31223048923651"],"lc_classifications":["DD221 .E94 2004","DD221.E94 2004"],"key":"/books/OL13635947M","authors":[{"key":"/authors/OL201893A"}],"ocaid":"isbn_9781594200045","publish_places":["New York"],"subjects":["National socialism -- History","Germany -- History -- 1871-1918","Germany -- History -- 1918-1933"],"languages":[{"key":"/languages/eng"}],"pagination":"xxxiv, 622 p., [16] p. of plates :","source_records":["marc:marc_western_washington_univ/wwu_bibs.mrc_revrev.mrc:885269148:3452","marc:marc_loc_updates/v35.i20.records.utf8:13200672:1118","marc:CollingswoodLibraryMarcDump10-27-2008/Collingswood.out:60449760:1722","marc:marc_loc_updates/v40.i06.records.utf8:2616137:1109","ia:isbn_9781594200045","marc:OpenLibraries-Trent-MARCs/multi1.mrc:2768999:916","marc:marc_openlibraries_phillipsacademy/PANO_FOR_IA_05072019.mrc:91163668:1499","marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run03.mrc:57184481:2669","amazon:1594200041","marc:marc_loc_2016/BooksAll.2016.part30.utf8:201550140:1109","ia:comingofthirdrei0000evan","bwb:9781594200045","marc:marc_columbia/Columbia-extract-20221130-010.mrc:293375307:3740","marc:harvard_bibliographic_metadata/ab.bib.09.20150123.full.mrc:328250117:950"],"title":"The coming of the Third Reich","lccn":["2003063205"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. [535]-584) and index."},"number_of_pages":622,"edition_name":"1st American ed.","isbn_10":["1594200041"],"publish_date":"2004","publish_country":"nyu","by_statement":"Richard J. Evans.","oclc_numbers":["53186626"],"works":[{"key":"/works/OL1745835W"}],"type":{"key":"/type/edition"},"latest_revision":20,"revision":20,"created":{"type":"/type/datetime","value":"2008-08-29T19:54:49.599168"},"last_modified":{"type":"/type/datetime","value":"2024-09-29T07:17:42.344662"}},{"publishers":["A. Lane"],"number_of_pages":622,"isbn_10":["071399648X"],"subject_place":["G