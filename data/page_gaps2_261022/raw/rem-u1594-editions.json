b:9780753559710"],"title":"World Without Us","weight":"0.500","full_title":"World Without Us","works":[{"key":"/works/OL2746364W"}],"key":"/books/OL35857339M","latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2021-12-26T07:02:28.675427"},"last_modified":{"type":"/type/datetime","value":"2022-01-24T18:34:46.770085"}},{"title":"The World Without Us","publish_date":"2008","publishers":["Picador"],"source_records":["bwb:9780312427900","marc:marc_columbia/Columbia-extract-20221130-022.mrc:244175377:2112","ia:worldwithoutus0000unse","idb:9780312427900"],"covers":[8097559],"type":{"key":"/type/edition"},"isbn_13":["9780312427900"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["GF75 .W455 2008"],"oclc_numbers":["191924881"],"ocaid":"worldwithoutus0000unse","key":"/books/OL26399852M","works":[{"key":"/works/OL2746364W"}],"number_of_pages":432,"latest_revision":9,"revision":9,"created":{"type":"/type/datetime","value":"2017-11-19T20:59:31.287146"},"last_modified":{"type":"/type/datetime","value":"2023-12-19T21:46:37.666288"}},{"publishers":["Piper"],"subtitle":"Reise u ber eine unbevol lkerte Erde","description":"Journalist Weisman offers an original approach to questions of humanity's impact on the planet. Drawing on the expertise of engineers, atmospheric scientists, art conservators, zoologists, oil refiners, marine biologists, astrophysicists, religious leaders, and paleontologists, he illustrates what the planet might be like today if humans disappeared. He explains how our massive infrastructure would collapse and finally vanish without human presence; which everyday items may become immortalized as fossils; how copper pipes and wiring would be crushed into mere seams of reddish rock; why some of our earliest buildings might be the last architecture left; and how plastic, bronze sculpture, radio waves, and some man-made molecules may be our most lasting gifts to the universe. As he shows which human devastations are indelible, and which examples of our highest art and culture would endure longest, Weisman's narrative ultimately drives toward a radical but persuasive solution that needn't depend on our demise.--From publisher description.","covers":[9969938],"key":"/books/OL25558703M","authors":[{"key":"/authors/OL402867A"}],"publish_places":["Mu nche"],"contributions":["Kober, Hainer, 1942-"],"pagination":"378 p. ;","source_records":["ia:dieweltohneunsre00weis","promise:bwb_daily_pallets_2023-05-16:O7-DCU-389"],"title":"Die Welt ohne uns","work_titles":["World without us"],"notes":"Includes bibliographical references (p. 373-[379])","number_of_pages":378,"languages":[{"key":"/languages/ger"}],"subjects":["Material culture","Nature","Human-plant relationships","Effect of human beings on","Human-animal relationships"],"publish_date":"2007","publish_country":"gw ","by_statement":"Alan Weisman ; aus dem Amerikanischen von Hainer Kober","works":[{"key":"/works/OL2746364W"}],"type":{"key":"/type/edition"},"identifiers":{},"isbn_10":["3492051324"],"isbn_13":["9783492051323"],"oclc_numbers":["794684407"],"classifications":{},"contributors":[{"role":"Translator","name":"Hainer Kober"}],"translated_from":[{"key":"/languages/eng"}],"translation_of":"The World Without Us","local_id":["urn:bwbsku:O7-DCU-389"],"latest_revision":6,"revision":6,"created":{"type":"/type/datetime","value":"2014-07-29T15:55:56.615700"},"last_modified":{"type":"/type/datetime","value":"2025-03-28T16:04:53.910961"}},{"title":"World without us.","authors":[{"key":"/authors/OL402867A"}],"type":{"key":"/type/edition"},"source_records":["marc:marc_cca/b10621386.out:54628964:264"],"key":"/books/OL22486950M","works":[{"key":"/works/OL2746364W"}],"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2008-11-15T00:13:18.733690"},"last_modified":{"type":"/type/datetime","value":"2026-01-04T19:49:31.951282"}},{"publishers":["HarperCollins"],"identifiers":{"librarything":["2141148"],"goodreads":["1730266"]},"key":"