"},"last_modified":{"type":"/type/datetime","value":"2022-01-12T17:51:39.216195"}},{"publishers":["Orion Publishing Group","Orion Publishing Group, Limited"],"identifiers":{"amazon":["0297866923"]},"subtitle":"The Biography","covers":[9097705],"physical_format":"paperback","full_title":"Jerusalem The Biography","key":"/books/OL27653545M","authors":[{"key":"/authors/OL1616357A"}],"source_records":["amazon:0297866923","ia:jerusalembiograp0000seba_q0p2","bwb:9780297866923"],"title":"Jerusalem","notes":{"type":"/type/text","value":"Source title: Jerusalem: The Biography"},"number_of_pages":672,"isbn_13":["9780297866923"],"isbn_10":["0297866923"],"publish_date":"May 01, 2011","works":[{"key":"/works/OL15947840W"}],"type":{"key":"/type/edition"},"ocaid":"jerusalembiograp0000seba_q0p2","lc_classifications":["DS109.9 .S37 2011b"],"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2019-11-08T23:26:15.475818"},"last_modified":{"type":"/type/datetime","value":"2023-06-17T04:33:50.217742"}},{"publishers":["Phoenix","Orion Publishing Group, Limited"],"subtitle":"The Biography. Simon Sebag Montefiore","covers":[9099056],"physical_format":"paperback","full_title":"Jerusalem The Biography. Simon Sebag Montefiore","key":"/books/OL27654947M","authors":[{"key":"/authors/OL1616357A"}],"source_records":["amazon:0753828790","promise:bwb_daily_pallets_2022-07-11","bwb:9780753828793"],"title":"Jerusalem","notes":{"type":"/type/text","value":"Source title: Jerusalem: The Biography. Simon Sebag Montefiore"},"identifiers":{"amazon":["0753828790"]},"isbn_13":["9780753828793"],"isbn_10":["0753828790"],"publish_date":"Oct 01, 2011","works":[{"key":"/works/OL15947840W"}],"type":{"key":"/type/edition"},"local_id":["urn:bwbsku:KQ-281-515"],"lc_classifications":["DS109.9"],"latest_revision":5,"revision":5,"created":{"type":"/type/datetime","value":"2019-11-09T03:35:08.700666"},"last_modified":{"type":"/type/datetime","value":"2023-06-17T04:21:48.340671"}},{"publishers":["BooksOnTape"],"subtitle":"The Biography","covers":[9103894],"physical_format":"audio cd","full_title":"Jerusalem The Biography","key":"/books/OL27660593M","authors":[{"key":"/authors/OL1616357A"}],"source_records":["amazon:0307878678"],"title":"Jerusalem","notes":{"type":"/type/text","value":"Source title: Jerusalem: The Biography"},"identifiers":{"amazon":["0307878678"]},"isbn_13":["9780307878670"],"isbn_10":["0307878678"],"publish_date":"2011","works":[{"key":"/works/OL15947840W"}],"type":{"key":"/type/edition"},"latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2019-11-09T14:30:53.541302"},"last_modified":{"type":"/type/datetime","value":"2022-01-12T17:51:39.216195"}},{"publishers":["Orion Publishing Group, Limited"],"subtitle":"The Biography","source_records":["bwb:9781474614399"],"title":"Jerusalem","number_of_pages":784,"isbn_13":["9781474614399"],"languages":[{"key":"/languages/eng"}],"full_title":"Jerusalem The Biography","lc_classifications":["DS109.9"],"publish_date":"2020","key":"/books/OL29448463M","authors":[{"key":"/authors/OL1616357A"}],"works":[{"key":"/works/OL15947840W"}],"type":{"key":"/type/edition"},"subjects":["Asia, history"],"covers":[14749567],"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2020-08-25T23:42:53.772112"},"last_modified":{"type":"/type/datetime","value":"2024-08-23T19:19:19.109741"}},{"subtitle":"the biography","description":{"type":"/type/text","value":"\"Jerusalem is the universal city, the capital of two peoples, the shrine of three faiths; it is the prize of empires, the site of Judgment Day and the battlefield of today's clash of civilizations. From King David to Barack Obama, from the birth of Judaism, Christianity and Islam to the Israel-Palestine conflict, this is the epic history of three thousand years of faith, slaughter, fanaticism and coexistence. How did this small, remote town become the Holy City, the \"center of the world\" and now the key to peace in the Middle East? In a gripping narrative, Simon Sebag Montefiore reveals this ever-changing city in its many incarnations, bringing every epoch and character blazingly to life. Jerusalem's biography is told through the wars, love affairs and revelations of the men and women -- kings, empresses, prophets, poets, saints, conquerors and whores -- who created, destroyed, chronicled and believed in Jerusalem. As well as the many ordinary Jerusalemites who have left their mark on the city, its cast varies from Solomon, Saladin and Suleiman the Magnificent to Cleopatra, Caligula and Churchill; from Abraham to Jesus and Muhammad; from the ancient world of Jezebel, Nebuchadnezzar, Herod and Nero to the modern times of the Kaiser, Disraeli, Mark Twain, Lincoln, Rasputin, Lawrence of Arabia and Moshe Dayan. Drawing on new archives, current scholarship, his own family papers and a lifetime's study, Montefiore illuminates the essence of sanctity and mysticism, identity and empire in a unique chronicle of the city that many believe will be the setting for the Apocalypse. This is how Jerusalem became Jerusalem, and the only city that exists twice -- in heaven and on earth.\""},"isbn_10":["0307280500"],"covers":[8330019],"full_title":"Jerusalem the biography","lc_classifications":["DS109.9 .S43 2012"],"key":"/books/OL26643965M","authors":[{"key":"/authors/OL1616357A"}],"ocaid":"isbn_9780307280503","edition_name":"First Vintage Books edition.","pagination":"xxxiii, 650 pages, 32 unnumbered pages of plates :","source_records":["ia:isbn_9780307280503","bwb:9780307280503","idb:9780307280503"],"title":"Jerusalem","dewey_decimal_class":["956.94420099"],"notes":{"type":"/type/text","value":"Includes bibliographical references (p. [609]-627) and index."},"number_of_pages":650,"isbn_13":["9780307280503"],"languages":[{"key":"/languages/eng"}],"subject_places":["Jerusalem"],"subjects":["History"],"publish_date":"2012","publish_country":"nyu","by_statement":"Simon Sebag Montefiore","oclc_numbers":["