}},{"level":0,"label":"","title":"World","pagenum":"","type":{"key":"/type/toc_item"}},{"level":0,"label":"","title":"Sense of self.","pagenum":"","type":{"key":"/type/toc_item"}}],"isbn_10":["0393020185","0593047575"],"covers":[9473642],"lc_classifications":["GN289 .S94 2001","GN289.S94 2001","GN 289 S94 2001"],"key":"/books/OL15542469M","authors":[{"key":"/authors/OL1437163A"}],"ocaid":"sevendaughtersof00syke","publish_places":["London","New York"],"subjects":["Human population genetics","Human evolution","Women -- Anthropometry","Evolutionary genetics"],"pagination":"x, 306 p. :","source_records":["marc:marc_western_washington_univ/wwu_bibs.mrc_revrev.mrc:804716246:1293","marc:CollingswoodLibraryMarcDump10-27-2008/Collingswood.out:26778887:1571","ia:sevendaughtersof00syke","marc:marc_openlibraries_sanfranciscopubliclibrary/sfpl_chq_2018_12_24_run02.mrc:230586835:1722","bwb:9780393020182","marc:marc_loc_2016/BooksAll.2016.part28.utf8:208609564:700","ia:sevendaughtersof0000syke","amazon:0393020185","marc:marc_nuls/NULS_PHC_180925.mrc:248386155:1517","marc:marc_columbia/Columbia-extract-20221130-007.mrc:81768863:2624"],"title":"The seven daughters of Eve","lccn":["2001030820"],"notes":{"type":"/type/text","value":"Includes index."},"identifiers":{"goodreads":["222637","1024904"],"librarything":["6049"]},"languages":[{"key":"/languages/eng"}],"local_id":["urn:sfpl:31223055479118","urn:sfpl:31223055479142","urn:nuls:31786101453204"],"publish_date":"2001","publish_country":"enk","by_statement":"Bryan Sykes.","oclc_numbers":["46434011"],"works":[{"key":"/works/OL5854298W"}],"type":{"key":"/type/edition"},"description":{"type":"/type/text","value":"\"In 1994 Professor Bryan Sykes, a leading world authority on DNA and human evolution, was called in to examine the frozen remains of a man trapped in glacial ice in northern Italy. News of the discovery of the Ice Man and his age, which was put at over five thousand years, fascinated the world. But what made the story particularly extraordinary was that Professor Sykes was also able to track down a genetic descendant of the Ice Man, a woman living in Britain today.\".\n\n\"How was he able to locate a living relative of a man who died thousands of years ago? In The Seven Daughters of Eve, Bryan Sykes gives us a first-hand account of his research into a remarkable gene which passes undiluted from generation to generation through the maternal line, and shows how it is being used to track our genetic ancestors through time and space. After plotting thousands of DNA sequences from all over the world, he found that they had clustered around a handful of distinct groups.\n\nIn Europe there are only seven. The conclusion: almost everyone of native European descent, wherever they live in the world, can trace their ancestry back to one of seven women, the Seven Daughters of Eve. He has named them Ursula, Xenia, Helena, Velda, Tara, Katrine and Jasmine.\"--BOOK JACKET."},"latest_revision":19,"revision":19,"created":{"type":"/type/datetime","value":"2008-09-20T10:50:00.472021"},"last_modified":{"type":"/type/datetime","value":"2023-11-14T03:18:26.596848"}},{"identifiers":{"goodreads":["1024903"],"librarything":["6049"]},"title":"The Seven Daughters of Eve","authors":[{"key":"/authors/OL1437163A"}],"publish_date":"May 1, 2002","publishers":["Corgi Adult"],"weight":"7.8 ounces","physical_format":"Paperback","subjects":["Genetics (non-medical)","Popular science","Science/Mathematics"],"isbn_13":["9780552148764"],"first_sentence":{"type":"/type/text","value":"On Thursday 19 September 1991 Erika and Helmut Simon, two experienced climbers from Nuremberg in Germany, were nearing the end of their walking holiday in the Italian Alps."},"edition_name":"New Ed edition","isbn_10":["0552148768"],"type":{"key":"/type/edition"},"physical_dimensions":"6.8 x 4.2 x 1.2 inches","source_records":["amazon:0552148768"],"key":"/books/OL7815360M","number_of_pages":368,"works":[{"key":"/works/OL5854298W"}],"latest_revision