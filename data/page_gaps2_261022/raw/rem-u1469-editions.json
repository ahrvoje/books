{"links":{"self":"/works/OL1811905W/editions.json?limit=100","work":"/works/OL1811905W"},"size":34,"entries":[{"type":{"key":"/type/edition"},"title":"Antropology Bat Marten ","authors":[{"key":"/authors/OL217344A"}],"publish_date":"2003","languages":[{"key":"/languages/eng"}],"number_of_pages":350,"ocaid":"antropologybatma0000oliv","source_records":["ia:antropologybatma0000oliv"],"works":[{"key":"/works/OL1811905W"}],"key":"/books/OL58561786M","latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2025-04-25T01:12:12.251727"},"last_modified":{"type":"/type/datetime","value":"2025-12-14T20:01:35.758908"}},{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL217344A"}],"isbn_13":["9781035068357"],"languages":[{"key":"/languages/eng"}],"number_of_pages":336,"publish_date":"2025","publishers":["Pan Macmillan"],"source_records":["bwb:9781035068357"],"title":"Anthropologist on Mars","full_title":"Anthropologist on Mars","works":[{"key":"/works/OL1811905W"}],"key":"/books/OL57537114M","latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2025-01-24T21:49:01.942228"},"last_modified":{"type":"/type/datetime","value":"2025-12-14T20:01:35.758908"}},{"works":[{"key":"/works/OL1811905W"}],"title":"Um antropólogo em marte","publishers":["Companhia de Bolso"],"publish_date":"6 setembro 2006","key":"/books/OL59265424M","type":{"key":"/type/edition"},"identifiers":{},"covers":[15092297,15092296],"isbn_13":["9788535908961"],"physical_dimensions":"17.8 x 12.6 x 1.8 centimeters","languages":[{"key":"/languages/por"}],"translation_of":"An Anthropologist on Mars","translated_from":[{"key":"/languages/eng"}],"description":{"type":"/type/text","value":"O que têm em comum o pintor que, em decorrência de um acidente, passa a enxergar o mundo em preto-e-branco, o rapaz cujas únicas lembranças se restringem ao final dos anos 60 e o exímio cirurgião tomado por todo tipo de tiques (verbais e físicos) na vida cotidiana? Para o neurologista Oliver Sacks, esses não são apenas casos clínicos extraordinários. Antes de mais nada, eles dizem respeito a indivíduos cujas vidas, pressionadas por situações-limite (por vezes trágicas, em geral dramáticas), podem nos ajudar a compreender melhor o que somos. Em Um antropólogo em Marte, Sacks confirma a originalidade de sua prosa, já consagrada em Tempo de despertar e O homem que confundiu sua mulher com um chapéu. Uma prosa que dá ao relato clínico a dramaticidade de um verdadeiro gênero literário."},"physical_format":"Brochura","number_of_pages":360,"latest_revision":4,"revision":4,"created":{"type":"/type/datetime","value":"2025-06-06T17:03:05.369343"},"last_modified":{"type":"/type/datetime","value":"2025-06-06T17:05:05.759410"}},{"type":{"key":"/type/edition"},"title":"An Anthropologist on Mars","authors":[{"key":"/authors/OL217344A"}],"publish_date":"Nov 15, 1995","source_records":["amazon:0679767177"],"publishers":["Vintage Books","Brand: Vintage Books"],"isbn_10":["0679767177"],"isbn_13":["9780679767176"],"physical_format":"paperback","full_title":"An Anthropologist on Mars","works":[{"key":"/works/OL1811905W"}],"key":"/books/OL40432241M","latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2022-11-18T18:51:28.960762"},"last_modified":{"type":"/type/datetime","value":"2023-09-11T16:39:18.595231"}},{"type":{"key":"/type/edition"},"title":"Mars'ta Bir Antropolog","authors":[{"key":"/authors/OL217344A"}],"publish_date":"Nov 01, 2015","source_records":["amazon:9754705933"],"publishers":["Iletisim Yayincilik"],"isbn_10":["9754705933"],"isbn_13":["9789754705935"],"physical_format":"paperback","covers":[12280398],"works":[{"key":"/works/OL1811905W"}],"key":"/books/OL35439161M","latest_revision":3,"revision":3,"created":{"type":"/type/datetime","value":"2021-11-01T11:22:28.795042"},"last_modified":{"type":"/type/datetime","value":"2023-09-11T16:39:18.595231"}},{"type":{"key":"/type/edition"},"title":"Mars'ta Bir Antropolog","authors":[{"key":"