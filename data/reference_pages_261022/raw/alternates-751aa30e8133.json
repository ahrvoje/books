      "weight": "0.300 ",
      "subtitle": "A History of California, Capitalism, and the World",
      "full_title": "Palo Alto A History of California, Capitalism, and the World",
      "works": [
        {
          "key": "/works/OL28091094W"
        }
      ],
      "key": "/books/OL48180685M",
