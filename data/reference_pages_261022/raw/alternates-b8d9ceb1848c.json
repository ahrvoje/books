      ],
      "physical_format": "hardcover",
      "full_title": "The Bomber Mafia : A Dream, a Temptation, and the Longest Night of the Second World War",
      "subtitle": "A Dream, a Temptation, and the Longest Night of the Second World War",
      "notes": {
        "type": "/type/text",
        "value": "Source title: The Bomber Mafia: A Dream, a Temptation, and the Longest Night of the Second World War"
      },
      "covers": [
